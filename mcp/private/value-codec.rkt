#lang racket/base
(require "../schema.rkt" "../json.rkt" "codec-fields.rkt")
(provide (struct-out value-codec) make-value-codec make-codec-registry lookup-codec encode-value decode-value codec-storage-schema check-value-codec!)
(struct value-codec (name version schema encoder decoder) #:transparent)
(define (check-value-codec! codec [who 'codec])
  (unless (value-codec? codec) (raise-argument-error who "value-codec?" codec))
  (check-codec-fields! who (value-codec-name codec) (value-codec-version codec)
                       (value-codec-schema codec) (value-codec-encoder codec) (value-codec-decoder codec)))
(define (make-value-codec name version schema encoder decoder)
  (check-codec-fields! 'make-value-codec name version schema encoder decoder)
  (value-codec name version schema encoder decoder))
(define (make-codec-registry codecs)
  (unless (list? codecs) (raise-argument-error 'make-codec-registry "list?" codecs))
  (for/fold ([registry (hash)]) ([codec (in-list codecs)])
    (check-value-codec! codec 'make-codec-registry)
    (define key (cons (value-codec-name codec) (value-codec-version codec)))
    (when (and (hash-has-key? registry key) (not (eq? (hash-ref registry key) codec)))
      (error 'make-codec-registry "conflicting codec registration: ~a" key))
    (hash-set registry key codec)))
(define (lookup-codec registry name version)
  (hash-ref registry (cons name version) (lambda () (error 'lookup-codec "unregistered codec or incompatible version: ~a/~a" name version))))
(define (codec-storage-schema codec)
  (check-value-codec! codec 'codec-storage-schema)
  (object-schema (hasheq '$mcp/codec (hasheq 'const (value-codec-name codec))
                         'version (hasheq 'const (value-codec-version codec)) 'value (value-codec-schema codec))))
(define (encode-value codec value)
  (check-value-codec! codec 'encode-value)
  (define encoded ((value-codec-encoder codec) value))
  (unless (and (json-value? encoded) (valid? (value-codec-schema codec) encoded))
    (error 'encode-value "codec ~a produced an invalid JSON representation" (value-codec-name codec)))
  (hasheq '$mcp/codec (value-codec-name codec) 'version (value-codec-version codec) 'value encoded))
(define (decode-value codec encoded)
  (check-value-codec! codec 'decode-value)
  (unless (and (hash? encoded) (json-value? encoded) (equal? (hash-ref encoded '$mcp/codec #f) (value-codec-name codec))
               (equal? (hash-ref encoded 'version #f) (value-codec-version codec))
               (hash-has-key? encoded 'value) (valid? (value-codec-schema codec) (hash-ref encoded 'value)))
    (error 'decode-value "invalid or incompatible saved codec representation"))
  ((value-codec-decoder codec) (hash-ref encoded 'value)))

