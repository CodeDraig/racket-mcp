#lang racket/base
(require racket/async-channel racket/list racket/port net/url "stdio.rkt" "http.rkt" "json.rkt")
(provide call-with-scenario-process scenario-process? scenario-process-running?
         scenario-process-pid scenario-process-status scenario-process-stderr scenario-process-kill!
         scenario-process-restart! scenario-process-request scenario-process-call
         (struct-out exn:fail:scenario-process-loss))
(struct exn:fail:scenario-process-loss exn:fail (pid status) #:transparent)
(struct generation (process owner input output error tail client request pending))
(struct scenario-process (start owner lock timeout shutdown caps [current #:mutable] [active? #:mutable]))
(define (scenario-process-running? session)
  (and (scenario-process-active? session) (scenario-process-current session)
       (eq? (subprocess-status (generation-process (scenario-process-current session))) 'running) #t))
(define (scenario-process-pid session)
  (and (scenario-process-current session) (subprocess-pid (generation-process (scenario-process-current session)))))
(define (scenario-process-status session)
  (and (scenario-process-current session) (subprocess-status (generation-process (scenario-process-current session)))))
(define (scenario-process-stderr session)
  (if (scenario-process-current session) (unbox (generation-tail (scenario-process-current session))) #""))
(define (lost generation)
  (exn:fail:scenario-process-loss "Scenario process terminated" (current-continuation-marks)
    (subprocess-pid (generation-process generation)) (subprocess-status (generation-process generation))))
(define (check-active session who)
  (unless (scenario-process-active? session) (error who "scenario process scope has closed")))
(define (stop-generation! session generation hard?)
  (define process (generation-process generation))
  (when (eq? (subprocess-status process) 'running)
    (if hard? (subprocess-kill process #t) (close-output-port (generation-output generation)))
    (unless (sync/timeout (scenario-process-shutdown session) process)
      (subprocess-kill process #t)
      (unless (sync/timeout (scenario-process-shutdown session) process)
        (error 'scenario-process "child did not terminate within the cleanup deadline"))))
  ;; Settle public handles from real process state before destroying client workers.
  (define deadline (+ (current-inexact-monotonic-milliseconds) (* 1000 (scenario-process-shutdown session))))
  (for ([finish (in-hash-values (generation-pending generation))]) (finish deadline))
  (hash-clear! (generation-pending generation))
  (when (generation-client generation) (client-close! (generation-client generation)))
  (close-output-port (generation-output generation))
  ;; Let the stderr drainer consume the terminal bytes before closing its owner.
  (sync/timeout (scenario-process-shutdown session) (port-closed-evt (generation-error generation)))
  (custodian-shutdown-all (generation-owner generation))
  (close-input-port (generation-input generation))
  (close-input-port (generation-error generation)))
(define (scenario-process-kill! session)
  (call-with-semaphore (scenario-process-lock session)
    (lambda ()
      (check-active session 'scenario-process-kill!)
      (when (scenario-process-current session)
        (stop-generation! session (scenario-process-current session) #t)))))
(define (scenario-process-restart! session)
  (call-with-semaphore (scenario-process-lock session)
    (lambda ()
      (check-active session 'scenario-process-restart!)
      (when (scenario-process-current session)
        (stop-generation! session (scenario-process-current session) #t))
      (set-scenario-process-current! session
        (parameterize ([current-custodian (scenario-process-owner session)])
          ((scenario-process-start session)))))))
(define (scenario-process-request session method [params (hasheq)]
                                  #:capabilities [caps (scenario-process-caps session)]
                                  #:timeout [timeout (and (not (equal? method "subscriptions/listen"))
                                                          (scenario-process-timeout session))])
  (unless (or (not timeout) (and (rational? timeout) (positive? timeout)))
    (raise-argument-error 'scenario-process-request "#f or positive finite timeout" timeout))
  (call-with-semaphore (scenario-process-lock session)
    (lambda ()
      (check-active session 'scenario-process-request)
      (unless (scenario-process-running? session) (error 'scenario-process-request "scenario process is not running"))
      (define generation (scenario-process-current session))
      (define native
        (parameterize ([current-custodian (generation-owner generation)])
          ((generation-request generation) method params caps timeout)))
      (define ready (make-semaphore 0))
      (define result (box #f))
      (define lock (make-semaphore 1))
      (define (finish! [deadline (+ (current-inexact-monotonic-milliseconds)
                                   (* 1000 (scenario-process-shutdown session)))])
        (call-with-semaphore lock
          (lambda ()
            (unless (sync/timeout 0 (semaphore-peek-evt ready))
              (set-box! result (or (sync/timeout 0 native)
                                  (sync/timeout (max 0 (/ (- deadline (current-inexact-monotonic-milliseconds)) 1000)) native)
                                  (lost generation)))
              (semaphore-post ready)))))
      (define handle (request-handle (request-handle-id native) ready result
                       (lambda () (request-cancel! native)) (request-handle-notifications native)))
      (hash-set! (generation-pending generation) handle finish!)
      (parameterize ([current-custodian (scenario-process-owner session)])
        (thread (lambda ()
                  (sync native (generation-process generation))
                  (finish!)
                  (call-with-semaphore (scenario-process-lock session)
                    (lambda () (hash-remove! (generation-pending generation) handle))))))
      handle)))
(define (scenario-process-call session method [params (hasheq)]
                               #:capabilities [caps (scenario-process-caps session)]
                               #:timeout [timeout (and (not (equal? method "subscriptions/listen"))
                                                       (scenario-process-timeout session))])
  (define handle (scenario-process-request session method params #:capabilities caps #:timeout timeout))
  (dynamic-wind void
    (lambda () (define result (sync handle)) (if (exn? result) (raise result) result))
    (lambda () (unless (sync/timeout 0 handle) (request-cancel! handle)))))
(define (call-with-scenario-process command proc #:transport [transport 'stdio]
          #:capabilities [caps (hasheq)] #:timeout [timeout 5] #:shutdown-timeout [shutdown 2]
          #:stderr-limit [limit 65536] #:directory [directory (current-directory)]
          #:environment [environment (current-environment-variables)])
  (unless (and (list? command) (pair? command) (andmap path-string? command))
    (raise-argument-error 'call-with-scenario-process "nonempty list of path strings" command))
  (unless (and (procedure? proc) (procedure-arity-includes? proc 1))
    (raise-argument-error 'call-with-scenario-process "procedure accepting one argument" proc))
  (unless (memq transport '(stdio http)) (raise-argument-error 'call-with-scenario-process "'stdio or 'http" transport))
  (for ([seconds (in-list (list timeout shutdown))])
    (unless (and (rational? seconds) (positive? seconds))
      (raise-argument-error 'call-with-scenario-process "positive finite timeouts" seconds)))
  (unless (exact-positive-integer? limit) (raise-argument-error 'call-with-scenario-process "positive stderr byte limit" limit))
  (define cwd (path->complete-path directory))
  (define env (environment-variables-copy environment))
  (define arguments (for/list ([arg (in-list (cdr command))])
                      (string->immutable-string (if (path? arg) (path->string arg) arg))))
  (define executable
    (parameterize ([current-directory cwd] [current-environment-variables env])
      (or (find-executable-path (car command)) (error 'call-with-scenario-process "executable not found"))))
  (define capabilities (string->json (json->string caps)))
  (unless (hash? capabilities) (raise-argument-error 'call-with-scenario-process "capabilities object" caps))
  (define owner (make-custodian))
  (define (start)
    (define child-owner (make-custodian))
    (define complete? #f)
    (dynamic-wind void
      (lambda ()
        (parameterize ([current-custodian child-owner] [current-subprocess-custodian-mode 'kill]
                       [current-directory cwd] [current-environment-variables (environment-variables-copy env)])
          (define-values (process input output error-port) (apply subprocess #f #f #f executable arguments))
          (define tail (box #""))
          (thread (lambda ()
                    (define buffer (make-bytes 4096))
                    (dynamic-wind void
                      (lambda ()
                        (let loop ()
                          (define count (read-bytes-avail! buffer error-port))
                          (define bytes (if (eof-object? count) count (subbytes buffer 0 count)))
                          (unless (eof-object? bytes)
                            (define combined (bytes-append (unbox tail) bytes))
                            (set-box! tail (bytes->immutable-bytes (subbytes combined (max 0 (- (bytes-length combined) limit)))))
                            (loop))))
                      (lambda () (close-input-port error-port)))))
          (define client #f)
          (define request
            (case transport
              [(stdio)
               (set! client (make-stdio-client input output #:timeout timeout))
               (lambda (method params caps seconds) (client-request client method params #:capabilities caps #:timeout seconds))]
              [(http)
               (define endpoint-result (make-async-channel 1))
               (thread (lambda ()
                         (async-channel-put endpoint-result
                           (with-handlers ([exn:fail? values])
                             (read-line (make-limited-input-port input 8192 #f) 'any)))))
               (define endpoint (sync/timeout timeout endpoint-result))
               (unless (and (string? endpoint) (< (bytes-length (string->bytes/utf-8 endpoint)) 8192)) (error 'scenario-process "child did not publish an HTTP endpoint before the deadline"))
               (define url (string->url endpoint))
               (unless (and (equal? (url-scheme url) "http")
                            (member (url-host url) '("127.0.0.1" "localhost" "::1"))
                            (url-port url) (not (url-user url)))
                 (error 'scenario-process "expected a loopback HTTP endpoint"))
               (thread (lambda () (copy-port input (open-output-nowhere))))
               (define http (make-http-client endpoint #:timeout timeout #:header-timeout timeout))
               (lambda (method params caps seconds) (http-client-request http method params #:capabilities caps #:timeout seconds))]))
          (define created (generation process child-owner input output error-port tail client request (make-hasheq)))
          (set! complete? #t)
          created))
      (lambda () (unless complete? (custodian-shutdown-all child-owner)))))
  (define session (scenario-process start owner (make-semaphore 1) timeout shutdown capabilities #f #t))
  (dynamic-wind void
    (lambda () (scenario-process-restart! session) (proc session))
    (lambda ()
      (call-with-semaphore (scenario-process-lock session)
        (lambda ()
          (set-scenario-process-active?! session #f)
          (dynamic-wind void
            (lambda () (when (scenario-process-current session)
                         (stop-generation! session (scenario-process-current session) #f)))
            (lambda () (custodian-shutdown-all owner))))))))
