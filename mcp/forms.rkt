#lang racket/base
(require racket/match "descriptor.rkt" "schema.rkt" "json.rkt" "workflow.rkt" "completion.rkt" "authorization.rkt" "private/handler.rkt" "private/registration.rkt"
         (for-syntax racket/base racket/list racket/syntax syntax/parse "private/resource-binding.rkt" (only-in "schema.rkt" check-schema!)))
(provide server tool resource prompt schema shape workflow checkpoint await-input perform completion scenario define-mcp-extension)
(begin-for-syntax
  (define-syntax-class arg
    #:attributes (id spec optional default)
    (pattern [id:id spec:expr] #:attr optional #'#f #:attr default #f)
    (pattern [id:id spec:expr #:optional] #:attr optional #'#t #:attr default #f)
    (pattern [id:id spec:expr #:default default:expr] #:attr optional #'#t))
  (define (argument-code ids specs opts defaults)
    (for/list ([id ids] [spec specs] [opt opts] [default defaults] [i (in-naturals)])
      #`(argument '#,id #,spec #,opt
                  #,(if default
                        #`(lambda (previous)
                            (let (#,@(for/list ([earlier (in-list (take ids i))]) #`[#,earlier (hash-ref previous '#,earlier)])) #,default)) #'#f))))
  (define (check-binders ids stx)
    (define duplicate (check-duplicate-identifier ids))
    (when duplicate (raise-syntax-error #f "duplicate argument binder" stx duplicate)))
  (define (manifest-info kind name source)
    (hasheq 'kind kind 'name (syntax-e name) 'source (format "~a" (syntax-source name))
            'line (syntax-line name) 'dynamic-metadata #t)))
(define-syntax (server stx)
  (syntax-parse stx
    [(_ #:name name:expr #:version version:expr (~optional (~seq #:instructions instructions:expr) #:defaults ([instructions #'""])))
     #'(let ([descriptor (server-descriptor name version instructions)]) (register-declaration descriptor) descriptor)]))
(define-syntax (schema stx)
  (syntax-parse stx
    [(_ name:id value:expr)
     (define datum (syntax->datum #'value))
     (define literal (if (and (pair? datum) (eq? (car datum) 'quote) (= (length datum) 2)) (cadr datum) datum))
     (when (or (boolean? literal) (hash? literal))
       (with-handlers ([exn:fail? (lambda (e) (raise-syntax-error #f (exn-message e) stx #'value))]) (check-schema! literal)))
     #'(define name (check-schema! value))]))
(define-syntax (tool stx)
  (syntax-parse stx
    [(_ (name:id a:arg ...) (~optional (~seq #:description description:expr) #:defaults ([description #'""]))
        (~optional (~seq #:output output:expr) #:defaults ([output #'#f]))
        (~optional (~seq #:annotations annotations:expr) #:defaults ([annotations #'(hasheq)]))
        body:expr ...+)
     (define ids (syntax->list #'(a.id ...)))
     (check-binders ids stx)
     (define args (argument-code ids (syntax->list #'(a.spec ...)) (syntax->list #'(a.optional ...)) (attribute a.default)))
     #`(begin (define name
         (make-tool (symbol->string 'name) (list #,@args)
                    (lambda (bound)
                      (apply (mcp-handler (a.id ...) body ...) (list #,@(for/list ([id ids]) #`(hash-ref bound '#,id)))))
                    #:description description #:output output #:annotations annotations)) (register-declaration name '#,(manifest-info 'tool #'name stx)))]))
(define-syntax (resource stx)
  (syntax-parse stx
    [(_ (name:id a:arg ...) #:uri uri:expr
        (~optional (~seq #:description description:expr) #:defaults ([description #'""]))
        (~optional (~seq #:mime-type mime:expr) #:defaults ([mime #'"text/plain"]))
        (~optional (~seq #:matcher matcher:expr) #:defaults ([matcher #'#f])) body:expr ...+)
     (define ids (syntax->list #'(a.id ...))) (check-binders ids stx)
     (define args (argument-code ids (syntax->list #'(a.spec ...)) (syntax->list #'(a.optional ...)) (attribute a.default)))
     (define hidden (car (generate-temporaries #'(name))))
     #`(begin (define #,hidden (make-resource (symbol->string 'name) uri (mcp-handler (a.id ...) body ...) #:description description #:mime-type mime #:arguments (list #,@args) #:matcher matcher))
              (define-syntax name (resource-binding (quote-syntax #,hidden) #,(length ids)))
              (register-declaration name '#,(manifest-info 'resource #'name stx)))]))

(define-syntax (shape stx)
  (syntax-parse stx
    [(_ name:id [field:id spec:expr] ...)
     (check-binders (syntax->list #'(field ...)) stx)
     (define internal (car (generate-temporaries #'(name))))
     (with-syntax ([record internal] [constructor (format-id #'name "make-~a" #'name)]
                   [encoder (format-id #'name "~a->json" #'name)] [decoder (format-id #'name "json->~a" #'name)]
                   [(accessor ...) (for/list ([f (in-list (syntax->list #'(field ...)))]) (format-id #'name "~a-~a" #'name f))]
                   [(internal-accessor ...) (for/list ([f (in-list (syntax->list #'(field ...)))]) (format-id internal "~a-~a" internal f))])
       #'(begin (struct record (field ...) #:transparent)
                (define name (object-schema (make-immutable-hasheq (list (cons 'field spec) ...))))
                (define (constructor field ...)
                  (define v (record field ...)) (encoder v) v)
                (define accessor internal-accessor) ...
                (define (encoder v)
                  (define data (make-immutable-hasheq (list (cons 'field (internal-accessor v)) ...)))
                  (unless (valid? name data) (error 'encoder "shape failed its schema")) data)
                (define (decoder data)
                  (unless (valid? name data) (error 'decoder "shape failed its schema"))
                  (record (hash-ref data 'field) ...))))]))
(define-syntax (prompt stx)
  (syntax-parse stx
    [(_ (name:id a:arg ...) (~optional (~seq #:description description:expr) #:defaults ([description #'""])) body:expr ...+)
     (define ids (syntax->list #'(a.id ...))) (check-binders ids stx)
     (define args (argument-code ids (syntax->list #'(a.spec ...)) (syntax->list #'(a.optional ...)) (attribute a.default)))
     #`(begin (define name (make-prompt (symbol->string 'name) (list #,@args)
                                (lambda (bound) (apply (mcp-handler (a.id ...) body ...) (list #,@(for/list ([id ids]) #`(hash-ref bound '#,id)))))
                                #:description description)) (register-declaration name '#,(manifest-info 'prompt #'name stx)))]))

(define-syntax (checkpoint stx) (raise-syntax-error #f "only valid as a workflow stage" stx))
(define-syntax (completion stx)
  (syntax-parse stx
    [(_ (target:id argument:id) handler:expr)
     #'(register-declaration (completion-descriptor target 'argument handler))]))
(define-syntax (scenario stx)
  (syntax-parse stx [(_ name:id body ...+) #'(module+ test (require rackunit) (test-case (symbol->string 'name) body ...))]))
(define-syntax (define-mcp-extension stx)
  (syntax-parse stx [(_ name:id transformer:expr) #'(define-syntax name transformer)]))
(define-syntax (await-input stx) (raise-syntax-error #f "only valid as a workflow stage" stx))
(define-syntax (perform stx) (raise-syntax-error #f "only valid as a workflow stage" stx))
(define-syntax (workflow stx)
  (syntax-parse stx
    [(_ (name:id a:arg ...) #:version version:str
        (~optional (~seq #:execution execution:id) #:defaults ([execution #'mrtr]))
        (~optional (~seq #:description description:expr) #:defaults ([description #'""]))
        (~optional (~seq #:key key:expr) #:defaults ([key #'#f]))
        stage ...+)
     (define ids (syntax->list #'(a.id ...))) (check-binders ids stx)
     (define args (argument-code ids (syntax->list #'(a.spec ...)) (syntax->list #'(a.optional ...)) (attribute a.default)))
     (define (stage-key prefix id) (string->symbol (string-append prefix (symbol->string (syntax-e id)))))
     (define (block body) (syntax-parse body #:literals (begin) [(begin form ...+) (syntax->list #'(form ...))] [_ (list body)]))
     (define (compile-sequence forms bound prefix wrap)
       (when (null? forms) (raise-syntax-error #f "workflow requires a completion expression" stx))
       (define (proc expression)
         #`(lambda (env) (let (#,@(for/list ([binding (in-list bound)]) #`[#,(car binding) (hash-ref env '#,(cdr binding) missing)])) #,(wrap expression))))
       (define first (car forms)) (define tail (cdr forms))
       (syntax-parse first #:literals (checkpoint await-input perform if match)
         [((~and kind (~or checkpoint await-input)) [id:id spec:expr] value:expr)
          (check-binders (append (map car bound) (list #'id)) stx)
          (define wire-id (stage-key prefix #'id))
          (cons #`(workflow-stage '#,wire-id '#,(if (free-identifier=? #'kind #'checkpoint) 'checkpoint 'input) spec #,(proc #'value) #f #f)
                (compile-sequence tail (append bound (list (cons #'id wire-id))) prefix wrap))]
         [(perform [id:id spec:expr] #:adapter adapter:id #:policy policy:id value:expr)
          (unless (memq (syntax-e #'policy) '(transactional idempotent manual)) (raise-syntax-error #f "unknown effect policy" stx #'policy))
          (check-binders (append (map car bound) (list #'id)) stx)
          (define wire-id (stage-key prefix #'id))
          (cons #`(workflow-stage '#,wire-id 'effect spec #,(proc #'value) 'adapter 'policy)
                (compile-sequence tail (append bound (list (cons #'id wire-id))) prefix wrap))]
         [(if condition then otherwise)
          (unless (null? tail) (raise-syntax-error #f "conditional workflow blocks must be in tail position" stx first))
          (define branch-id (string->symbol (string-append prefix "$branch")))
          (define yes (compile-sequence (block #'then) bound (string-append prefix "then/") wrap))
          (define no (compile-sequence (block #'otherwise) bound (string-append prefix "else/") wrap))
          (define (entry stages) (cadr (syntax->datum (cadr (syntax->list (car stages))))))
          (cons #`(workflow-stage '#,branch-id 'branch Integer #,(proc #'(if condition 0 1)) '(#,(entry yes) #,(entry no)) #f) (append yes no))]
         [(match subject [pattern body ...+] ...+)
          (unless (null? tail) (raise-syntax-error #f "matching workflow blocks must be in tail position" stx first))
          (define subject-id (string->symbol (string-append prefix "$subject")))
          (define branch-id (string->symbol (string-append prefix "$match")))
          (define patterns (syntax->list #'(pattern ...)))
          (define bodies (map syntax->list (syntax->list #'((body ...) ...))))
          (define branches
            (for/list ([pattern (in-list patterns)] [body (in-list bodies)] [i (in-naturals)])
              (compile-sequence body bound (format "~acase~a/" prefix i)
                                (lambda (expr) (wrap #`(match (hash-ref env '#,subject-id) [#,pattern #,expr]))))))
          (define selector #`(match (hash-ref env '#,subject-id) #,@(for/list ([pattern (in-list patterns)] [i (in-naturals)]) #`[#,pattern #,i])))
          (define targets (for/list ([branch (in-list branches)]) (cadr (syntax->datum (cadr (syntax->list (car branch)))))))
          (append (list #`(workflow-stage '#,subject-id 'checkpoint Any #,(proc #'subject) #f #f)
                        #`(workflow-stage '#,branch-id 'branch Integer #,(proc selector) '#,targets #f)) (apply append branches))]
         [value:expr
          (unless (null? tail) (raise-syntax-error #f "expected a persistent stage or final result" stx first))
          (list #`(workflow-stage '#,(string->symbol (string-append prefix "completion")) 'complete Any #,(proc #'value) #f #f))]))
     (define stages (compile-sequence (syntax->list #'(stage ...)) (map (lambda (id) (cons id (syntax-e id))) ids) "" values))
     ;; Source datum is included in the code fingerprint; no user expression is evaluated.
     (define fingerprint (format "~s" (syntax->datum stx)))
     #`(begin (define name
         (let ([program (make-workflow (symbol->string 'name) version #,fingerprint (list #,@stages) #:key key)])
           (make-tool (symbol->string 'name) (list #,@args)
                      (lambda (bound)
                        (unless (current-workflow-store) (error 'workflow "a configured workflow store is required"))
                        (run-workflow program (current-workflow-store) (for/hasheq ([(k v) (in-hash bound)] #:unless (missing? v)) (values k v))
                                      #:principal (principal-key (request-context-principal (current-request-context)))
                                      #:state (current-workflow-state) #:responses (current-workflow-responses)
                                      #:adapters (current-workflow-adapters))) #:description description #:workflow program #:execution 'execution))) (register-declaration name '#,(manifest-info 'workflow #'name stx)))]))
