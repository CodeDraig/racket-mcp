#lang racket/base
(require rackunit racket/file racket/path racket/port racket/runtime-path
         compiler/cm file/sha1 mcp/private/native-executable)
(define-runtime-path worker "../dev/native-executable-worker.rkt")
(define (file-digest path)
  (call-with-input-file path (lambda (in) (bytes->hex-string (sha256-bytes in)))))
(test-case "running executable evidence has a platform-specific contract"
  (define identity (running-executable-identity))
  (cond [(and (eq? (system-type 'os*) 'linux) (file-exists? "/proc/self/exe"))
         (check-equal? identity (string-append "linux-proc-exe/1:" (file-digest "/proc/self/exe")))
         (check-eq? identity (running-executable-identity))]
        [else (check-false identity)]))
(test-case "unreadable executable evidence stays explicitly unavailable"
  (define query
    (parameterize ([current-namespace (make-base-namespace)])
      (dynamic-require 'mcp/private/native-executable 'running-executable-identity)))
  (define denied
    (make-security-guard (current-security-guard)
      (lambda (who path modes)
        (when (equal? path (string->path "/proc/self/exe"))
          (raise (exn:fail:filesystem "fixture: executable image unavailable"
                                     (current-continuation-marks)))))
      (lambda (who host port mode) (void))))
  (check-false (parameterize ([current-security-guard denied]) (query)))
  ;; A process-local identity does not change when permissions later change.
  (check-false (query)))
(when (and (eq? (system-type 'os*) 'linux) (file-exists? "/proc/self/exe"))
  (test-case "late identity query and sealed build follow running image after path replacement"
    (define directory (make-temporary-file "mcp-native-executable-~a" 'directory "/tmp"))
    (define executable (build-path directory "racket"))
    (define replacement (build-path directory "replacement"))
    (define root (build-path directory "root.rkt"))
    (define processes '())
    (define owner (make-custodian))
    (define original-directory (path-only (resolve-path "/proc/self/exe")))
    (define collects (path->complete-path (find-system-path 'collects-dir) original-directory))
    (define config (path->complete-path (find-system-path 'config-dir) original-directory))
    (define (start)
      (define-values (process out in err)
        (subprocess #f #f #f executable
          "-X" collects "-G" config
          worker root))
      (set! processes (cons process processes))
      (define watcher
        (thread (lambda () (unless (sync/timeout 30 process) (subprocess-kill process #t)))))
      (define ready (read-line out))
      (unless (equal? ready "ready")
        (error 'native-executable "child did not start: ~s; ~a" ready (port->string err)))
      (list process out in err watcher))
    (define (finish child)
      (define process (car child))
      (define out (cadr child))
      (define in (caddr child))
      (define err (cadddr child))
      (newline in) (flush-output in) (close-output-port in)
      (define stdout (port->string out))
      (define stderr (port->string err))
      (subprocess-wait process)
      (thread-wait (list-ref child 4))
      (close-input-port out) (close-input-port err)
      (check-equal? (subprocess-status process) 0 stderr)
      (read (open-input-string stdout)))
    (dynamic-wind void
      (lambda ()
        (parameterize ([current-custodian owner])
        (copy-file "/proc/self/exe" executable)
        (file-or-directory-permissions executable #o700)
        (display-to-file "#lang racket/base\n(provide value)\n(define value 1)\n" root)
        (managed-compile-zo root)
        (define original (file-digest executable))
        (define first (start))
        (copy-file executable replacement)
        (file-or-directory-permissions replacement #o700)
        (call-with-output-file replacement #:exists 'append
          (lambda (out) (display "\nchanged executable fixture\n" out)))
        (define changed (file-digest replacement))
        (rename-file-or-directory replacement executable #t)
        (define before (finish first))
        (define after (finish (start)))
        (check-equal? (car before) (string-append "linux-proc-exe/1:" original))
        (check-equal? (car after) (string-append "linux-proc-exe/1:" changed))
        (check-not-equal? original changed)
        (check-not-equal? (cadr before) (cadr after))))
      (lambda ()
        (for ([process (in-list processes)])
          (when (eq? (subprocess-status process) 'running) (subprocess-kill process #t))
          (subprocess-wait process))
        (custodian-shutdown-all owner)
        (delete-directory/files directory)))))
