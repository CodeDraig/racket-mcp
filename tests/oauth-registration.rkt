#lang racket/base
(require rackunit racket/async-channel racket/port racket/string racket/tcp net/uri-codec mcp/oauth-http mcp/oauth-registration mcp/json)
(define (peer response proc)
  (define owner (make-custodian))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define listener (tcp-listen 0 4 #t "127.0.0.1"))
        (define-values (_ port _host _port) (tcp-addresses listener #t))
        (define request (make-async-channel))
        (define closed (make-async-channel))
        (thread
         (lambda ()
           (define-values (in out) (tcp-accept listener))
           (define first (read-line in 'any))
           (define headers
             (let loop ([lines '()])
               (define line (read-line in 'any))
               (if (equal? line "") (reverse lines) (loop (cons line lines)))))
           (define length
             (for/first ([h (in-list headers)] #:do [(define m (regexp-match #px"(?i:^Content-Length:) *([0-9]+)$" h))] #:when m)
               (string->number (cadr m))))
           (define body (read-bytes (or length 0) in))
           (async-channel-put request (list first headers body))
           (when response (write-bytes response out) (flush-output out))
           (async-channel-put closed (eof-object? (read-byte in)))
           (close-input-port in) (close-output-port out)))
        (proc (format "http://127.0.0.1:~a/meta?x=1" port) request closed)))
    (lambda () (custodian-shutdown-all owner))))
(define requested
  (hasheq 'redirect_uris '("http://localhost:3080/callback") 'application_type "native"
          'client_name "Racket 雪" 'token_endpoint_auth_method "none"
          'grant_types '("authorization_code" "refresh_token") 'response_types '("code")))
(define returned (hash-set requested 'client_id "issued-client"))
(define (as url)
  (hasheq 'issuer "https://issuer.example" 'authorization_endpoint "https://issuer.example/authorize"
          'token_endpoint "https://issuer.example/token" 'registration_endpoint url
          'response_types_supported '("code") 'code_challenge_methods_supported '("S256")))
(define (response code body [type "application/json"])
  (define data (string->bytes/utf-8 body))
  (bytes-append (string->bytes/utf-8
    (format "HTTP/1.1 ~a Reply\r\nContent-Type: ~a\r\nContent-Length: ~a\r\n\r\n" code type (bytes-length data))) data))
(peer (response 201 (json->string returned))
  (lambda (url request closed)
    (define result (register-oauth-client! (as url) requested #:allow-loopback-http? #t
                                         #:initial-access-token "initial-token"))
    (check-true (oauth-registration-result? result))
    (check-equal? (oauth-registration-result-issuer result) "https://issuer.example")
    (check-equal? (oauth-registration-result-metadata result) returned)
    (check-false (regexp-match? #rx"issued-client" (format "~s" result)))
    (define got (sync/timeout 2 request))
    (check-equal? (car got) "POST /meta?x=1 HTTP/1.1")
    (check-not-false (member "Content-Type: application/json" (cadr got)))
    (check-not-false (member "Authorization: Bearer initial-token" (cadr got)))
    (check-equal? (string->json (bytes->string/utf-8 (caddr got))) requested)
    (check-equal? (sync/timeout 2 closed) #t)))
(define secret-response
  (hash-set (hash-set (hash-set returned 'token_endpoint_auth_method "client_secret_post")
                     'client_secret "secret") 'client_secret_expires_at 0))
(check-equal? (validate-oauth-registration-response requested secret-response) secret-response)
(check-equal? (validate-oauth-registration-response requested (hash-set returned 'client_name "Renamed"))
              (hash-set returned 'client_name "Renamed"))
(check-equal? (validate-oauth-registration-response requested (hash-set returned 'vendor_extension (hasheq 'x #t)))
              (hash-set returned 'vendor_extension (hasheq 'x #t)))
(for ([bad (list (hash-remove returned 'client_id)
                 (hash-set returned 'client_id #f)
                 (hash-set returned 'client_id "")
                 (hash-set returned 'client_secret #f)
                 (hash-set returned 'client_secret "secret")
                 (hash-set secret-response 'client_secret_expires_at -1)
                 (hash-set returned 'client_id_issued_at 1/2)
                 (hash-set returned 'redirect_uris '("https://foreign.example/callback"))
                 (hash-set returned 'redirect_uris '("relative"))
                 (hash-set returned 'redirect_uris '("http://evil.example/callback"))
                 (hash-set returned 'token_endpoint_auth_method "private_key_jwt")
                 (hash-set returned 'token_endpoint_auth_method "client_secret_basic")
                 (hash-set returned 'grant_types '("authorization_code"))
                 (hash-set returned 'response_types '("token"))
                 (hash-set returned 'client_name 10)
                 (hash-set returned 'scope "read  write")
                 (hash-set returned 'scope "read\nwrite")
                 (hash-set returned 'jwks (hasheq 'keys '(#f)))
                 (hash-set returned 'application_type "invalid"))])
  (with-check-info (['response bad])
    (check-exn exn:fail? (lambda () (validate-oauth-registration-response requested bad)))))
(for ([code '(200 302 400 401 500)])
  (peer (response code "{\"error\":\"invalid_client_metadata\"}")
    (lambda (url request closed)
      (check-exn (lambda (e) (and (exn:fail:oauth-http? e) (= code (exn:fail:oauth-http-status e))))
        (lambda () (register-oauth-client! (as url) requested #:allow-loopback-http? #t)))
      (check-equal? (sync/timeout 2 closed) #t))))
(for ([body '("[]" "{\"client_id\":\"a\",\"client_id\":\"b\"}" "null" "{")])
  (peer (response 201 body)
    (lambda (url request closed)
      (check-exn exn:fail? (lambda () (register-oauth-client! (as url) requested #:allow-loopback-http? #t)))
      (check-equal? (sync/timeout 2 closed) #t))))
(peer (response 201 (json->string returned) "text/html")
  (lambda (url request closed)
    (check-exn #rx"application/json" (lambda () (register-oauth-client! (as url) requested #:allow-loopback-http? #t)))
    (check-equal? (sync/timeout 2 closed) #t)))
(peer (response 201 (json->string returned))
  (lambda (url request closed)
    (check-exn #rx"byte limit" (lambda () (register-oauth-client! (as url) requested
                                           #:allow-loopback-http? #t #:max-response-bytes 8)))
    (check-equal? (sync/timeout 2 closed) #t)))
(peer #f
  (lambda (url request closed)
    (check-exn #rx"timed out" (lambda () (register-oauth-client! (as url) requested
                                          #:allow-loopback-http? #t #:timeout 0.1)))
    (check-equal? (sync/timeout 2 closed) #t)))
(check-exn exn:fail? (lambda () (register-oauth-client! (as "http://127.0.0.1/register") requested)))
(check-exn exn:fail? (lambda () (register-oauth-client! (as "https://as.example/register") requested
                                #:initial-access-token "a\r\nInjected: yes")))
(check-exn exn:fail? (lambda () (register-oauth-client! (as "https://as.example/register")
                                (hash-remove requested 'application_type))))
(peer (response 201 (json->string secret-response))
  (lambda (url request closed)
    (define result (register-oauth-client! (as url) requested #:allow-loopback-http? #t))
    (check-equal? (oauth-registration-result-metadata result) secret-response)
    (check-false (regexp-match? #rx"secret" (format "~s" result)))
    (define got (sync/timeout 2 request))
    (check-false (ormap (lambda (h) (string-prefix? (string-downcase h) "authorization:")) (cadr got)))
    (check-equal? (sync/timeout 2 closed) #t)))
(for ([bad (list (hash-set returned 'error "invalid_client_metadata")
                 (hash-set returned 'client_secret_expires_at 0))])
  (check-exn exn:fail? (lambda () (validate-oauth-registration-response requested bad))))
(peer #f
  (lambda (url request closed)
    (define caller (thread (lambda () (with-handlers ([exn:break? void])
      (register-oauth-client! (as url) requested #:allow-loopback-http? #t)))))
    (check-not-false (sync/timeout 2 request))
    (break-thread caller)
    (check-not-false (sync/timeout 2 (thread-dead-evt caller)))
    (check-equal? (sync/timeout 2 closed) #t)))
