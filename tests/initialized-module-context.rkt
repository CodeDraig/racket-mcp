#lang racket/base
(require rackunit racket/runtime-path
         mcp/private/module-build-context mcp/private/executable-build
         mcp/private/executable-capture)
(module shared racket/base
  (provide escaped)
  (define escaped (box #f)))
(module language racket/base
  (require mcp/private/module-build-context mcp/private/module-observation)
  (provide (except-out (all-from-out racket/base) #%module-begin)
           (rename-out [module-begin/build-context #%module-begin]))
  (install-module-observation!))
(module application (submod ".." language)
  (require mcp/private/module-build-context mcp/private/executable-build
           (for-syntax racket/base))
  (provide first second factory before early-seal late?)
  (define first (with-module-build-context ctx ctx))
  (define second (with-module-build-context ctx ctx))
  (define before (module-build-context-initialized? first))
  (define early-seal
    (with-handlers ([exn:fail? exn-message])
      (seal-module-build-context! first #:require-initialized? #t)))
  (define (factory)
    (with-module-build-context ctx (cons ctx (current-executable-build))))
  (define late? #f)
  (define-syntax (late stx)
    (syntax-local-lift-module-end-declaration
      #'(begin
          (when (module-build-context-initialized? first)
            (error 'fixture "context finalized before late work"))
          (parameterize ([current-module-declare-name (make-resolved-module-path 'late-context-helper)])
            (eval #'(module late-context-helper racket/base (provide value) (define value 42))))
          (set! late? #t)))
    #'(void))
  (late))
(module failed (submod ".." language)
  (require mcp/private/module-build-context (submod ".." shared)
           (for-syntax racket/base))
  (with-module-build-context ctx (set-box! escaped ctx))
  (define-syntax (late stx)
    (syntax-local-lift-module-end-declaration #'(error 'fixture "late failure"))
    #'(void))
  (late))
(module inherited (submod ".." language)
  (require mcp/private/module-build-context)
  (provide context)
  (define context (with-module-build-context ctx ctx)))
(require (submod "." shared))
(define-runtime-path self "initialized-module-context.rkt")
(define (load name export) (dynamic-require `(submod ,self ,name) export))
(test-case "shared module context completes only after late initialization"
  (define ctx (load 'application 'first))
  (check-eq? ctx (load 'application 'second))
  (check-false (load 'application 'before))
  (check-regexp-match #rx"initialization has not completed" (load 'application 'early-seal))
  (check-true (load 'application 'late?))
  (check-true (module-build-context-initialized? ctx))
  (define capture (module-build-context-capture ctx))
  (check-true (module-code-capture? capture))
  (check-true (for/or ([name (in-hash-keys (module-code-capture-observed capture))])
                (regexp-match? #rx"late-context-helper" name)))
  (check-exn #rx"not sealed"
    (lambda () (executable-build-fingerprint (module-build-context-build ctx))))
  (void (seal-module-build-context! ctx #:require-initialized? #t
          #:dependencies (for/hash ([name (in-list (module-code-capture-unobserved capture))])
                           (values name "explicit-test-fixture-build/1"))))
  (check-true (string? (executable-build-fingerprint (module-build-context-build ctx)))))
(test-case "factories retain the lexical context and accept an explicit build override"
  (define ctx (load 'application 'first))
  (define factory (load 'application 'factory))
  (check-eq? (car (factory)) ctx)
  (check-eq? (cdr (factory)) (module-build-context-build ctx))
  (define build (make-executable-build))
  (parameterize ([current-executable-build build])
    (check-eq? (car (factory)) ctx)
    (check-eq? (cdr (factory)) build)))
(test-case "late failure and repeated require cannot certify an escaped context"
  (check-exn #rx"late failure" (lambda () (load 'failed #f)))
  (define ctx (unbox escaped))
  (check-false (module-build-context-initialized? ctx))
  (check-false (module-build-context-capture ctx))
  (load 'failed #f)
  (check-false (module-build-context-initialized? ctx))
  (check-exn #rx"initialization has not completed"
    (lambda () (seal-module-build-context! ctx #:require-initialized? #t))))
(test-case "the enclosing loader keeps ownership after module completion"
  (define build (make-executable-build))
  (define ctx
    (parameterize ([current-executable-build build]) (load 'inherited 'context)))
  (check-eq? (module-build-context-build ctx) build)
  (check-true (module-build-context-initialized? ctx))
  (check-false (module-build-context-capture ctx))
  (check-exn #rx"enclosing loader owns"
    (lambda () (seal-module-build-context! ctx #:require-initialized? #t))))

(module mcp-language racket/base
  (require (except-in mcp/lang #%module-begin)
           (only-in mcp/lang [#%module-begin mcp-begin])
           mcp/private/module-build-context (for-syntax racket/base))
  (provide (except-out (all-from-out mcp/lang) mcp-begin)
           (rename-out [body #%module-begin]))
  (define-syntax-rule (body form ...)
    (module-begin/build-context #:module-begin mcp-begin form ...)))
(module mcp-application (submod ".." mcp-language)
  (require mcp/private/module-build-context)
  (provide context)
  (define context (with-module-build-context ctx ctx))
  (server #:name "initialized-context" #:version "1")
  (workflow (complete) #:version "1" (text-result "done")))
(require (only-in mcp/descriptor interface-descriptor-tools tool-descriptor-workflow)
         (only-in mcp/workflow workflow-executable-fingerprint)
         (only-in mcp/runtime make-runtime dispatch request-meta)
         (only-in mcp/storage open-memory-store close-store!))
(test-case "MCP workflow declarations use the shared initialized context"
  (define interface (load 'mcp-application 'mcp-interface))
  (define ctx (load 'mcp-application 'context))
  (define program (tool-descriptor-workflow (car (interface-descriptor-tools interface))))
  (check-true (module-build-context-initialized? ctx))
  (check-exn #rx"not sealed" (lambda () (workflow-executable-fingerprint program (hasheq))))
  (define capture (module-build-context-capture ctx))
  (void (seal-module-build-context! ctx #:require-initialized? #t
          #:dependencies (for/hash ([name (in-list (module-code-capture-unobserved capture))])
                           (values name "explicit-test-fixture-build/1"))))
  (check-true (string? (workflow-executable-fingerprint program (hasheq))))
  (define owner (make-custodian))
  (define store (open-memory-store))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define result
          (dispatch (make-runtime interface #:store store) "tools/call"
                    (hasheq '_meta (request-meta) 'name "complete")))
        (check-equal? (hash-ref result 'content)
                      (list (hasheq 'type "text" 'text "done")))))
    (lambda () (custodian-shutdown-all owner) (close-store! store))))
