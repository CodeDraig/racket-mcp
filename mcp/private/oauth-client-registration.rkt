#lang racket/base
(require net/url "../json.rkt" "oauth-uri-policy.rkt" "oauth-types.rkt" "principal.rkt")
(provide check-client-id-metadata! client-id-metadata-document select-oauth-registration)
(define (client-id-url! id)
  (https-uri! id 'client-id-metadata #:loopback? #f)
  (define path (url-path (string->url id)))
  (unless (and (pair? path)
               (for/and ([part (in-list path)])
                 (not (member (path/param-path part) '(same up "." "..")))))
    (error 'client-id-metadata "client ID requires a path without dot segments"))
  id)
(define (check-client-id-metadata! document url)
  (client-id-url! url)
  (unless (and (hash? document) (equal? (hash-ref document 'client_id #f) url))
    (error 'client-id-metadata "document client_id must exactly match its URL"))
  (define name (hash-ref document 'client_name #f))
  (unless (and (string? name) (positive? (string-length name)))
    (error 'client-id-metadata "client_name is required"))
  (define redirects (hash-ref document 'redirect_uris #f))
  (unless (and (list? redirects) (pair? redirects))
    (error 'client-id-metadata "nonempty redirect_uris is required"))
  (for ([uri (in-list redirects)]) (redirect-uri! uri))
  (for ([key '(client_secret client_secret_expires_at)])
    (when (hash-has-key? document key) (error 'client-id-metadata "shared-secret fields are forbidden")))
  (unless (equal? (hash-ref document 'token_endpoint_auth_method "none") "none")
    (error 'client-id-metadata "this client supports metadata documents with token_endpoint_auth_method none"))
  (for ([entry '((grant_types "authorization_code") (response_types "code"))])
    (define supported (hash-ref document (car entry) (cdr entry)))
    (unless (and (list? supported) (andmap string? supported) (member (cadr entry) supported))
      (error 'client-id-metadata "document must support authorization code flow")))
  (unless (json-value? document) (error 'client-id-metadata "document must contain JSON values"))
  document)
(define (client-id-metadata-document url name redirects #:extra [extra (hasheq)])
  (unless (hash? extra) (raise-argument-error 'client-id-metadata-document "hash?" extra))
  (for ([key '(client_id client_name redirect_uris)])
    (when (hash-has-key? extra key) (error 'client-id-metadata-document "duplicate core metadata field")))
  (define document
    (for/fold ([result (hasheq 'client_id url 'client_name name 'redirect_uris redirects
                               'grant_types '("authorization_code" "refresh_token") 'response_types '("code")
                               'token_endpoint_auth_method "none")]) ([(key value) (in-hash extra)])
      (hash-set result key value)))
  (check-client-id-metadata! document url))
(define (select-oauth-registration metadata resource redirect scopes
                                   #:pre-registered [registrations (hash)]
                                   #:client-metadata [document #f] #:client-metadata-url [document-url #f]
                                   #:request-registration [request-registration #f])
  (define issuer (hash-ref metadata 'issuer))
  (identifier-url! issuer 'select-oauth-registration)
  (https-uri! resource 'select-oauth-registration)
  (redirect-uri! redirect)
  (check-scopes! scopes)
  (define (check-registration value)
    (unless (and (oauth-registration? value) (equal? (oauth-registration-issuer value) issuer)
                 (equal? (oauth-registration-redirect-uri value) redirect)
                 (string? (oauth-registration-client-id value))
                 (positive? (string-length (oauth-registration-client-id value))))
      (error 'select-oauth-registration "pre-registration issuer, client ID, or redirect mismatch"))
    ;; Resource and scopes describe this authorization request, not the static
    ;; client registration. Never copy credentials from a different issuer.
    (struct-copy oauth-registration value [resource resource] [scopes scopes]))
  (define registered (hash-ref registrations issuer #f))
  (cond [registered (check-registration registered)]
        [(and document (eq? (hash-ref metadata 'client_id_metadata_document_supported #f) #t))
         (unless document-url (error 'select-oauth-registration "client metadata URL is required"))
         (check-client-id-metadata! document document-url)
         (unless (member redirect (hash-ref document 'redirect_uris))
           (error 'select-oauth-registration "redirect is absent from client metadata"))
         (oauth-registration issuer document-url redirect resource scopes)]
        [request-registration (check-registration (request-registration issuer redirect))]
        [else (error 'select-oauth-registration "no client registration for this issuer; configure pre-registration or supported client metadata")]))
