#lang racket/base
(require rackunit racket/async-channel mcp)
(define entered (make-async-channel))
(define release (make-semaphore 0))
(define completions 0)
(workflow (blocked) #:version "1" #:execution task
  (checkpoint [value Boolean]
    (begin (async-channel-put entered (cons (current-thread) (current-store-connection)))
           (semaphore-wait release) #t))
  (text-result (begin (set! completions (add1 completions)) "done")))
(define store (open-memory-store))
(define rt (make-runtime (make-interface #:tools (list blocked)) #:store store))
(define caps (hasheq 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define (call method params)
  (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps))))
(define task (call "tools/call" (hasheq 'name "blocked")))
(define entry (sync/timeout 5 entered))
(check-not-false entry)
(check-false (cdr entry))
(define params (hasheq 'taskId (hash-ref task 'taskId)))
(define answers (make-async-channel))
(define poller (thread (lambda () (async-channel-put answers (call "tasks/get" params)))))
(define polled (sync/timeout 2 answers))
(check-equal? (and polled (hash-ref polled 'status)) "working")
(define canceller (thread (lambda () (async-channel-put answers (call "tasks/cancel" params)))))
(check-equal? (sync/timeout 2 answers) (hasheq 'resultType "complete"))
(semaphore-post release)
(check-not-false (sync/timeout 5 (car entry)))
(check-equal? completions 0)
(check-equal? (hash-ref (call "tasks/get" params) 'status) "cancelled")
(define task-row (load-instance store (hash-ref task 'taskId)))
(define workflow-row (load-instance store (hash-ref (stored-instance-state task-row) 'workflow)))
(check-equal? (hash-ref (stored-instance-state workflow-row) 'position) 0)
(check-false (hash-has-key? (hash-ref (stored-instance-state workflow-row) 'values) 'value))
(custodian-shutdown-all (runtime-custodian rt))
(close-store! store)
