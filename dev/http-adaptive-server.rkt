#lang racket/base
(require racket/async-channel mcp mcp/http)
(define last-worker #f)
(define slow-count 0)
(tool (fast) (text-result "fast"))
(tool (slow)
  (set! slow-count (add1 slow-count))
  (sync (alarm-evt (+ (current-inexact-milliseconds) 200)))
  (text-result "slow"))
(tool (wait)
  (set! last-worker (current-thread))
  (sync never-evt))
(tool (worker-status)
  (text-result (cond [(not last-worker) "not-started"] [(thread-dead? last-worker) "stopped"] [else "running"])))
(tool (invocations) (text-result (number->string slow-count)))
(module+ main
  (define rt (make-runtime (make-interface #:tools (list fast slow wait worker-status invocations))))
  (define confirmation (make-async-channel))
  (define stop (serve-http rt #:port 0 #:confirmation confirmation #:stream-after 0.1 #:keepalive-seconds 0.02))
  (define port (sync confirmation))
  (when (exn? port) (raise port))
  (printf "http://127.0.0.1:~a/mcp\n" port) (flush-output)
  (dynamic-wind void (lambda () (sync never-evt))
    (lambda () (stop) (custodian-shutdown-all (runtime-custodian rt)))))
