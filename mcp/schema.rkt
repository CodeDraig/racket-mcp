#lang racket/base
(require racket/list racket/set racket/string net/url net/uri-codec "json.rkt" "private/pattern.rkt" "private/metaschema.rkt" "private/domain-bindings.rkt")
(provide (struct-out schema-error) (struct-out exn:fail:schema) validate valid? check-schema! String Integer Number Boolean Null Any
         object-schema array-schema)
(struct schema-error (schema-location instance-location message) #:transparent)
(define-schema-value String (hasheq 'type "string"))
(define-schema-value Integer (hasheq 'type "integer"))
(define-schema-value Number (hasheq 'type "number"))
(define-schema-value Boolean (hasheq 'type "boolean"))
(define-schema-value Null (hasheq 'type "null"))
(define-schema-value Any #t)
(define (object-schema properties #:required [required (map symbol->string (hash-keys properties))] #:additional [additional #f])
  (hasheq 'type "object" 'properties properties 'required required 'additionalProperties additional))
(define (array-schema items) (hasheq 'type "array" 'items items))
(struct exn:fail:schema exn:fail (errors) #:transparent)
(define checking-metaschema? (make-parameter #f))
(define default-schema-dialect "https://json-schema.org/draft/2020-12/schema")
(define (schema-registry registry)
  (for/fold ([combined (standard-metaschemas)]) ([(uri resource) (in-hash registry)])
    (when (and (hash-has-key? (standard-metaschemas) uri)
               (not (equal? (hash-ref (standard-metaschemas) uri) resource)))
      (error 'schema "cannot replace a pinned standard metaschema: ~a" uri))
    (hash-set combined uri resource)))
(define (check-schema! s #:registry [registry (hash)] #:max-depth [max-depth 128] #:max-nodes [max-nodes 50000])
  (unless (checking-metaschema?)
    ;; Reject non-JSON and cyclic host values before the recursive evaluator.
    (define active (make-hasheq))
    (define nodes 0)
    (define (json! value depth)
      (set! nodes (add1 nodes))
      (when (or (> nodes max-nodes) (> depth max-depth)) (error 'schema "schema construction limit exceeded"))
      (cond [(hash? value)
             (when (hash-ref active value #f) (error 'schema "cyclic schema value"))
             (hash-set! active value #t)
             (for ([(key child) (in-hash value)])
               (unless (symbol? key) (error 'schema "schema object keys must be symbols"))
               (json! child (add1 depth)))
             (hash-remove! active value)]
            [(list? value) (for ([child (in-list value)]) (json! child (add1 depth)))]
            [(not (or (string? value) (boolean? value) (eq? value json-null) (rational? value)))
             (error 'schema "schema contains a non-JSON value")]))
    (json! s 0)
    (unless (or (boolean? s) (hash? s)) (raise-argument-error 'schema "JSON Schema object or boolean" s))
    (when (hash? s)
      (define dialect (hash-ref s '$schema default-schema-dialect))
      (define combined (schema-registry registry))
      (define meta (hash-ref combined (if (equal? dialect (string-append default-schema-dialect "#")) default-schema-dialect dialect)
                             (lambda () (error 'schema "unsupported dialect: ~a" dialect))))
      (when (hash? meta)
        (for ([(uri required?) (in-hash (hash-ref meta '$vocabulary (hasheq)))])
          (when (and required?
                     (not (member (symbol->string uri)
                                  (for/list ([v '("core" "applicator" "validation" "unevaluated" "meta-data" "format-annotation" "content")])
                                    (string-append "https://json-schema.org/draft/2020-12/vocab/" v)))))
            (error 'schema "unsupported required vocabulary: ~a" uri))))
      (define errors
        (parameterize ([checking-metaschema? #t])
          (validate meta s #:registry combined #:max-depth 2048)))
      (unless (null? errors)
        (raise (exn:fail:schema
                (format "schema: malformed schema at ~a: ~a" (schema-error-instance-location (car errors)) (schema-error-message (car errors)))
                (current-continuation-marks) errors)))))
  s)
(define (pointer path k) (string-append path "/" (string-replace (string-replace (format "~a" k) "~" "~0") "/" "~1")))
(define current-validation-budget (make-parameter #f))
(define (spend-validation-step!)
  (define budget (current-validation-budget))
  (when budget
    (when (zero? (unbox budget)) (error 'validate "schema evaluation work limit exceeded"))
    (set-box! budget (sub1 (unbox budget)))))
(define (validate schema value #:registry [registry (hash)] #:max-depth [max-depth 128]
                  #:max-steps [max-steps 1000000])
  (unless (exact-positive-integer? max-steps) (raise-argument-error 'validate "exact-positive-integer?" max-steps))
  (unless (exact-nonnegative-integer? max-depth) (raise-argument-error 'validate "exact-nonnegative-integer?" max-depth))
  ;; Construction validation recursively uses this same budget. A reference or
  ;; applicator cannot reset its allowance by entering another validation call.
  (parameterize ([current-validation-budget (or (current-validation-budget) (box max-steps))])
    (validate/body schema value registry max-depth)))
(define (validate/body schema value registry max-depth)
  (set! registry (schema-registry registry))
  (check-schema! schema #:registry registry)
  (define resources (make-hash)) (define anchors (make-hash))
  (define bases (make-hasheq)) (define dialects (make-hasheq))
  (define (strip-fragment uri) (car (string-split uri "#" #:trim? #f)))
  (define (resolve base relative)
    (cond [(regexp-match? #px"^[a-zA-Z][a-zA-Z0-9+.-]*:" relative) relative]
          [(string-prefix? relative "#") (string-append (strip-fragment base) relative)]
          [else (url->string (combine-url/relative (string->url base) relative))]))
  (define default-dialect "https://json-schema.org/draft/2020-12/schema")
  (define known-vocabs '("core" "applicator" "validation" "unevaluated" "meta-data" "format-annotation" "content"))
  (define (vocabularies dialect)
    (cond [(member dialect (list default-dialect (string-append default-dialect "#"))) #f]
          [else (define meta (hash-ref registry dialect (lambda () (error 'validate "unknown dialect ~a" dialect))))
                (define vocab (hash-ref meta '$vocabulary (hasheq)))
                (for ([(uri required?) (in-hash vocab)])
                  (when (and required? (not (member (symbol->string uri) (map (lambda (v) (string-append "https://json-schema.org/draft/2020-12/vocab/" v)) known-vocabs))))
                    (error 'validate "unsupported required vocabulary ~a" uri))) vocab]))
  (define indexing (make-hasheq))
  (define (index! s base dialect)
    (spend-validation-step!)
    (when (hash? s)
      (when (hash-ref indexing s #f) (error 'validate "cyclic schema registry value"))
      (hash-set! indexing s #t)
      (define here (if (hash-has-key? s '$id) (resolve base (hash-ref s '$id)) base))
      (define language (hash-ref s '$schema dialect))
      (hash-set! bases s here) (hash-set! dialects s language)
      (when (hash-has-key? s '$id) (hash-set! resources (strip-fragment here) s))
      (for ([k '($anchor $dynamicAnchor)] #:when (hash-has-key? s k))
        (hash-set! anchors (string-append (strip-fragment here) "#" (hash-ref s k)) s))
      (for ([k '($defs definitions properties patternProperties dependentSchemas)] #:when (hash? (hash-ref s k #f)))
        (for ([v (in-hash-values (hash-ref s k))]) (index! v here language)))
      (for ([k '(allOf anyOf oneOf prefixItems)] #:when (list? (hash-ref s k #f)))
        (for ([v (in-list (hash-ref s k))]) (index! v here language)))
      (for ([k '(items additionalProperties unevaluatedProperties unevaluatedItems contains not if then else propertyNames)] #:when (hash-has-key? s k))
        (index! (hash-ref s k) here language))
      (hash-remove! indexing s)))
  (for ([(uri s) (in-hash registry)]) (hash-set! resources uri s) (index! s uri default-dialect))
  (define initial-base "mcp-schema:/root")
  (hash-set! resources initial-base schema) (index! schema initial-base default-dialect)
  (define (ref r base)
    (define absolute (resolve base r))
    (define parts (string-split absolute "#" #:trim? #f))
    (define target (hash-ref resources (car parts) (lambda () (error 'validate "unresolved schema resource ~a" (car parts)))))
    (define frag (uri-decode (if (pair? (cdr parts)) (cadr parts) "")))
    (cond [(equal? frag "") target]
          [(string-prefix? frag "/")
           (for/fold ([node target]) ([p (in-list (cdr (string-split frag "/" #:trim? #f)))])
             (define key (string-replace (string-replace p "~1" "/") "~0" "~"))
             (cond [(hash? node) (hash-ref node (string->symbol key) (lambda () (error 'validate "unresolved reference ~a" r)))]
                   [(list? node) (list-ref node (string->number key))] [else (error 'validate "invalid reference ~a" r)]))]
          [else (hash-ref anchors (string-append (car parts) "#" frag) (lambda () (error 'validate "unresolved anchor ~a" absolute)))]))
  (define (type? t v)
    (case (string->symbol t)
      [(null) (eq? v json-null)] [(boolean) (boolean? v)] [(object) (hash? v)]
      [(array) (list? v)] [(number) (rational? v)] [(integer) (and (rational? v) (integer? v))] [(string) (string? v)] [else #f]))
  ;; Each successful applicator returns evaluated property/item annotations.
  (define (walk original v sp ip depth root [scope '()])
    (spend-validation-step!)
    (when (> depth max-depth) (error 'validate "schema evaluation depth exceeded"))
    (define base (hash-ref bases original root))
    (define dynamic-scope (if (member base scope) scope (append scope (list base))))
    (define vocab (vocabularies (hash-ref dialects original default-dialect)))
    (define s
      (if (and (hash? original) vocab (not (hash-has-key? vocab 'https://json-schema.org/draft/2020-12/vocab/validation)))
          (for/fold ([s original]) ([k '(type const enum multipleOf minimum maximum exclusiveMinimum exclusiveMaximum minLength maxLength pattern minItems maxItems uniqueItems minContains maxContains minProperties maxProperties required dependentRequired)]) (hash-remove s k)) original))
    (define errors '()) (define evaluated (set))
    (define (bad k msg) (set! errors (cons (schema-error (pointer sp k) ip msg) errors)))
    (define (sub child x k [at ip]) (walk child x (for/fold ([path sp]) ([segment (in-list (if (list? k) k (list k)))]) (pointer path segment)) at (add1 depth) base dynamic-scope))
    (define (merge! es ev) (set! errors (append es errors)) (when (null? es) (set! evaluated (set-union evaluated ev))))
    (cond [(eq? s #f) (bad "" "false schema")]
          [(hash? s)
           (when (hash-has-key? s '$ref) (define-values (es ev) (sub (ref (hash-ref s '$ref) base) v '$ref)) (merge! es ev))
           (when (hash-has-key? s '$dynamicRef)
             (define r (hash-ref s '$dynamicRef))
             (define target (ref r base))
             (define anchor (and (regexp-match? #px"#[^/].*$" r) (hash? target) (hash-ref target '$dynamicAnchor #f)))
             (define dynamic-target
               (if anchor
                   (or (for/or ([uri (in-list dynamic-scope)])
                         (define candidate (hash-ref anchors (string-append (strip-fragment uri) "#" anchor) #f))
                         (and (hash? candidate) (equal? (hash-ref candidate '$dynamicAnchor #f) anchor) candidate)) target) target))
             (define-values (es ev) (sub dynamic-target v '$dynamicRef)) (merge! es ev))
           (when (hash-has-key? s 'type) (define ts (hash-ref s 'type)) (unless (ormap (lambda (t) (type? t v)) (if (list? ts) ts (list ts))) (bad 'type "type mismatch")))
           (when (and (hash-has-key? s 'const) (not (equal? v (hash-ref s 'const)))) (bad 'const "value differs from const"))
           (when (and (hash-has-key? s 'enum) (not (member v (hash-ref s 'enum)))) (bad 'enum "value absent from enum"))
           (for ([k '(allOf anyOf oneOf)] #:when (hash-has-key? s k))
             (define results (for/list ([child (in-list (hash-ref s k))] [i (in-naturals)]) (call-with-values (lambda () (sub child v (list k i))) list)))
             (define successes (filter (lambda (r) (null? (car r))) results))
             (if (case k [(allOf) (= (length successes) (length results))] [(anyOf) (pair? successes)] [(oneOf) (= 1 (length successes))])
                 (for ([r (in-list successes)]) (set! evaluated (set-union evaluated (cadr r))))
                 (begin
                   (bad k "composition failed")
                   (when (or (eq? k 'allOf) (null? successes))
                     (set! errors (append (append-map car results) errors))))))
           (when (hash-has-key? s 'not) (define-values (es ev) (sub (hash-ref s 'not) v 'not)) (when (null? es) (bad 'not "negated schema matched")))
           (when (hash-has-key? s 'if)
             (define-values (es ev) (sub (hash-ref s 'if) v 'if))
             (define branch (if (null? es) 'then 'else))
             (when (null? es) (set! evaluated (set-union evaluated ev)))
             (when (hash-has-key? s branch) (define-values (bs bv) (sub (hash-ref s branch) v branch)) (merge! bs bv)))
           (when (rational? v)
             (for ([k '(minimum maximum exclusiveMinimum exclusiveMaximum)] [p (list >= <= > <)] #:when (hash-has-key? s k))
               (unless (p v (hash-ref s k)) (bad k "numeric bound failed")))
             (when (and (hash-has-key? s 'multipleOf) (not (integer? (/ v (hash-ref s 'multipleOf))))) (bad 'multipleOf "not an exact multiple")))
           (when (string? v)
             (when (< (string-length v) (hash-ref s 'minLength 0)) (bad 'minLength "string too short"))
             (when (> (string-length v) (hash-ref s 'maxLength +inf.0)) (bad 'maxLength "string too long"))
             (when (and (hash-has-key? s 'pattern) (not (regexp-match? (schema-pattern (hash-ref s 'pattern)) v))) (bad 'pattern "pattern mismatch")))
           (when (hash? v)
             (when (< (hash-count v) (hash-ref s 'minProperties 0)) (bad 'minProperties "too few properties"))
             (when (> (hash-count v) (hash-ref s 'maxProperties +inf.0)) (bad 'maxProperties "too many properties"))
             (for ([k (in-list (hash-ref s 'required '()))]) (spend-validation-step!) (unless (hash-has-key? v (string->symbol k)) (bad 'required (format "missing property ~a" k))))
             (define props (hash-ref s 'properties (hasheq)))
             (define patterns (hash-ref s 'patternProperties (hasheq)))
             (for ([(k x) (in-hash v)])
               (spend-validation-step!)
               (define matched? #f)
               (define (apply-property child keyword)
                 (set! matched? #t) (set! evaluated (set-add evaluated k))
                 (define-values (es ev) (sub child x keyword (pointer ip k))) (set! errors (append es errors)))
               (when (hash-has-key? props k) (apply-property (hash-ref props k) (list 'properties k)))
               (for ([(p child) (in-hash patterns)] #:when (begin (spend-validation-step!) (regexp-match? (schema-pattern (symbol->string p)) (symbol->string k)))) (apply-property child (list 'patternProperties p)))
               (when (and (not matched?) (hash-has-key? s 'additionalProperties)) (apply-property (hash-ref s 'additionalProperties) 'additionalProperties))
               (when (hash-has-key? s 'propertyNames) (define-values (es ev) (sub (hash-ref s 'propertyNames) (symbol->string k) 'propertyNames (pointer ip k))) (set! errors (append es errors))))
             (for ([(k names) (in-hash (hash-ref s 'dependentRequired (hasheq)))] #:when (hash-has-key? v k))
               (for ([name (in-list names)]) (unless (hash-has-key? v (string->symbol name)) (bad 'dependentRequired (format "missing dependency ~a" name)))))
             (for ([(k child) (in-hash (hash-ref s 'dependentSchemas (hasheq)))] #:when (hash-has-key? v k)) (define-values (es ev) (sub child v (list 'dependentSchemas k))) (merge! es ev))
             (when (hash-has-key? s 'unevaluatedProperties)
               (for ([(k x) (in-hash v)] #:unless (set-member? evaluated k))
                 (define-values (es ev) (sub (hash-ref s 'unevaluatedProperties) x 'unevaluatedProperties (pointer ip k))) (set! errors (append es errors)) (set! evaluated (set-add evaluated k)))))
           (when (list? v)
             (when (< (length v) (hash-ref s 'minItems 0)) (bad 'minItems "array too short"))
             (when (> (length v) (hash-ref s 'maxItems +inf.0)) (bad 'maxItems "array too long"))
             (when (and (hash-ref s 'uniqueItems #f) (not (= (length v) (length (remove-duplicates v))))) (bad 'uniqueItems "duplicate items"))
             (define prefixes (list->vector (hash-ref s 'prefixItems '())))
             (for ([x (in-list v)] [i (in-naturals)])
               (spend-validation-step!)
               (define child (if (< i (vector-length prefixes)) (vector-ref prefixes i) (hash-ref s 'items missing)))
               (unless (missing? child) (define-values (es ev) (sub child x (if (< i (vector-length prefixes)) (list 'prefixItems i) 'items) (pointer ip i))) (set! errors (append es errors)) (set! evaluated (set-add evaluated i))))
             (when (hash-has-key? s 'contains)
               (define matches (for/list ([x (in-list v)] [i (in-naturals)] #:when (let-values ([(es ev) (sub (hash-ref s 'contains) x 'contains (pointer ip i))]) (null? es))) i))
               (if (<= (hash-ref s 'minContains 1) (length matches) (hash-ref s 'maxContains +inf.0))
                   (set! evaluated (set-union evaluated (list->set matches))) (bad 'contains "matching item count failed")))
             (when (hash-has-key? s 'unevaluatedItems)
               (for ([x (in-list v)] [i (in-naturals)] #:unless (set-member? evaluated i)) (define-values (es ev) (sub (hash-ref s 'unevaluatedItems) x 'unevaluatedItems (pointer ip i))) (set! errors (append es errors)) (set! evaluated (set-add evaluated i)))))] )
    (values (reverse errors) evaluated))
  (define-values (errors annotations) (walk schema value "" "" 0 initial-base)) errors)
(define (valid? s v #:registry [registry (hash)] #:max-depth [max-depth 128] #:max-steps [max-steps 1000000])
  (null? (validate s v #:registry registry #:max-depth max-depth #:max-steps max-steps)))
