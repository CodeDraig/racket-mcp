#lang racket/base
(require rackunit racket/async-channel racket/port mcp mcp/stdio)
(current-check-handler (lambda (failure) (raise failure)))
(define executable (vector-ref (current-command-line-arguments) 0))
(define owner (make-custodian))
(dynamic-wind void
  (lambda ()
    (parameterize ([current-custodian owner])
      (define-values (process in out err) (subprocess #f #f #f executable "serve-cancellation"))
      (thread (lambda () (copy-port err (current-error-port))))
      (define client (make-stdio-client in out))
      (define (outcome h)
        (define result (sync/timeout 5 h))
        (unless result (error 'interop "Timed out waiting for peer"))
        (when (exn? result) (raise result))
        result)
      (define (call method [params (hasheq)]) (outcome (client-request client method params)))
      (define listing (call "tools/list"))
      (check-equal? (length (hash-ref (hash-ref listing 'result) 'tools)) 2)
      (define h (client-request client "tools/call"
                  (hasheq 'name "wait" 'arguments (hasheq) '_meta (hasheq 'progressToken "cancel-probe"))))
      (for ([expected '(0 1/2 1)])
        (define event (sync/timeout 5 (request-handle-notifications h)))
        (unless event (error 'interop "Timed out waiting for progress"))
        (check-equal? (hash-ref event 'method) "notifications/progress")
        (define params (hash-ref event 'params))
        (check-equal? (hash-ref params 'progressToken) "cancel-probe")
        (check-equal? (hash-ref params 'progress) expected)
        (check-equal? (hash-ref params 'total) 1))
      (request-cancel! h)
      (define cancelled (sync/timeout 0 h))
      (check-true (exn:fail:request-cancelled? cancelled))
      (define deadline (+ (current-inexact-monotonic-milliseconds) 3000))
      (let loop ()
        (define result (call "tools/call" (hasheq 'name "worker-status" 'arguments (hasheq))))
        (define status (hash-ref (car (hash-ref (hash-ref result 'result) 'content)) 'text))
        (unless (equal? status "stopped")
          (check-equal? status "running")
          (when (>= (current-inexact-monotonic-milliseconds) deadline) (error 'interop "Peer worker did not stop"))
          (sync (alarm-evt (+ (current-inexact-monotonic-milliseconds) 20) #t))
          (loop)))
      (check-equal? (length (hash-ref (hash-ref (call "tools/list") 'result) 'tools)) 2)
      (check-eq? (sync h) cancelled)
      (client-close! client)
      (check-not-false (sync/timeout 3 process))
      (check-equal? (subprocess-status process) 0)
      (displayln "Racket client / official Go server: progress, cancellation, handler cleanup, and continued connection passed.")))
  (lambda () (custodian-shutdown-all owner)))
