#lang racket/base
(require rackunit racket/file racket/port racket/runtime-path mcp)
(define-runtime-path worker "external-change-worker.rkt")
(define directory (make-temporary-file "external-change-restart-~a" 'directory))
(define database (build-path directory "state.sqlite"))
(define feed (build-path directory "committed.json"))
(define delivery (build-path directory "delivered.jsonl"))
(define source (make-external-change-source "external-database" "1" (lambda args (error 'test "inspection must not read feed")) #:initial-cursor 0))
(define (run mode expected)
  (define-values (process out in err)
    (subprocess #f #f #f (find-executable-path "racket") worker database feed delivery mode))
  (close-output-port in)
  (define watchdog (thread (lambda () (unless (sync/timeout 30 process) (subprocess-kill process #t)))))
  (define stdout (port->string out)) (define stderr (port->string err))
  (subprocess-wait process) (thread-wait watchdog)
  (close-input-port out) (close-input-port err)
  (check-equal? (subprocess-status process) expected (string-append stdout stderr)))
(define (inspect proc)
  (define store (open-sqlite-store database))
  (dynamic-wind void (lambda () (proc store)) (lambda () (close-store! store))))
(dynamic-wind void
  (lambda ()
    (define committed (json->string (list (hasheq 'id "commit-1" 'principal "alice" 'keys '("docs")))))
    (call-with-output-file feed (lambda (out) (display committed out)))
    (run "read-crash" 16)
    (inspect (lambda (store)
      (check-equal? (external-change-cursor store source) 0)
      (check-equal? (list-instances store #:operation "change-outbox") '())))
    (run "record" 17)
    (inspect (lambda (store)
      (check-equal? (external-change-cursor store source) 1)
      (check-equal? (length (list-instances store #:operation "change-outbox")) 1)))
    (run "deliver-crash" 18)
    (inspect (lambda (store)
      (check-equal? (hash-ref (stored-instance-state (car (list-instances store #:operation "change-outbox"))) 'status) "pending")))
    (run "record" 17)
    (run "deliver" 0)
    (define deliveries (map string->json (file->lines delivery)))
    (check-equal? (length deliveries) 2)
    (check-equal? (car deliveries) (cadr deliveries))
    (run "deliver" 0)
    (check-equal? (map string->json (file->lines delivery)) deliveries)
    (check-equal? (file->string feed) committed)
    (inspect (lambda (store)
      (check-equal? (external-change-cursor store source) 1)
      (check-equal? (length (list-instances store #:operation "change-outbox")) 1)
      (check-equal? (hash-ref (stored-instance-state (car (list-instances store #:operation "change-outbox"))) 'status) "delivered"))))
  (lambda () (delete-directory/files directory)))
