#lang racket/base
(require rackunit racket/async-channel mcp mcp/subscription)
(define data (make-hash '(("alice" . "alice-old") ("bob" . "bob-old"))))
(define reads (make-hash))
(resource (document) #:uri "external:///document" #:depends-on '("docs") #:ttl-ms 60000
  (define who (request-context-principal (current-request-context)))
  (hash-update! reads who add1 0)
  (hash-ref data who))
(define store (open-memory-store))
(define rt (make-runtime (make-interface #:resources (list document)) #:store store #:clock (make-manual-clock #:seconds 10)))
(define owner (make-custodian))
(define (read-resource principal)
  (hash-ref (car (hash-ref (dispatch rt "resources/read"
    (hasheq 'uri "external:///document" '_meta (request-meta)) #:principal principal) 'contents)) 'text))
(define (listen principal)
  (define queue (make-async-channel))
  (parameterize ([current-custodian owner])
    (thread (lambda ()
      (dispatch rt "subscriptions/listen"
        (hasheq '_meta (request-meta) 'notifications (hasheq 'resourceSubscriptions '("external:///document")))
        #:principal principal #:id principal
        #:notify (lambda (message)
          (async-channel-put queue
            (if (equal? (hash-ref message 'method #f) "notifications/resources/updated")
                (cons message (read-resource principal)) message)))))))
  (check-equal? (hash-ref (sync/timeout 3 queue) 'method) "notifications/subscriptions/acknowledged")
  queue)
(dynamic-wind void
  (lambda ()
    (check-equal? (read-resource "alice") "alice-old")
    (check-equal? (read-resource "bob") "bob-old")
    (define alice (listen "alice"))
    (define bob (listen "bob"))
    (hash-set! data "bob" "bob-new")
    (define source (make-external-change-source "database" "1"
      (lambda (cursor limit)
        (external-change-page
          (if (zero? cursor) (list (external-change "committed-bob" "bob" '("docs"))) '()) 1))
      #:initial-cursor 0))
    (check-equal? (reconciliation-result-recorded (runtime-reconcile-changes! rt source)) 1)
    (define notification (sync/timeout 3 bob))
    (check-true (pair? notification))
    (check-equal? (cdr notification) "bob-new")
    (check-false (sync/timeout 0 alice))
    (check-equal? (read-resource "alice") "alice-old")
    (check-equal? (hash-ref reads "alice") 1)
    (check-equal? (hash-ref reads "bob") 2)
    (check-equal? (hash-ref (stored-instance-state (car (list-instances store #:operation "change-outbox"))) 'status) "delivered")
    (check-equal? (reconciliation-result-recorded (runtime-reconcile-changes! rt source)) 0)
    (check-false (sync/timeout 0 bob)))
  (lambda ()
    (close-subscriptions! (runtime-subscriptions rt))
    (custodian-shutdown-all owner)
    (custodian-shutdown-all (runtime-custodian rt))
    (close-store! store)))
