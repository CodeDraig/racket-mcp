#lang racket/base
(require rackunit racket/file racket/list racket/port racket/runtime-path mcp/json)
(define-runtime-path worker "task-recovery-worker.rkt")
(define dir (make-temporary-file "task-recovery-process-~a" 'directory))
(define (invoke database marker mode kill?)
  (define-values (process out in err)
    (subprocess #f #f #f (find-executable-path "racket") worker database marker mode))
  (close-output-port in)
  (dynamic-wind void
    (lambda ()
      (unless (sync/timeout 15 out) (error 'test "worker did not reach boundary: ~a" mode))
      (define line (read-line out))
      (when (eof-object? line) (error 'test "worker failed: ~a" (port->string err)))
      (define result (string->json line))
      (if kill?
          (begin (check-equal? (subprocess-status process) 'running) (subprocess-kill process #t))
          (unless (sync/timeout 15 process) (error 'test "worker did not finish: ~a" mode)))
      (subprocess-wait process)
      (unless kill? (check-equal? (subprocess-status process) 0 (port->string err)))
      result)
    (lambda ()
      (when (eq? (subprocess-status process) 'running) (subprocess-kill process #t))
      (subprocess-wait process)
      (close-input-port out) (close-input-port err))))
(define (root reports) (findf (lambda (r) (not (hash-ref r 'parent))) reports))
(define (child reports) (findf (lambda (r) (hash-ref r 'parent)) reports))
(define (status report) (hash-ref (hash-ref report 'task) 'status))
(dynamic-wind void
 (lambda ()
  (for ([boundary '("before" "queue" "effect" "complete")])
    (define database (path->string (build-path dir (string-append boundary ".sqlite"))))
    (define marker (path->string (build-path dir (string-append boundary ".effects"))))
    (define prepared (invoke database marker (if (equal? boundary "effect") "prepared-retry" "prepared") #t))
    (define original (root prepared))
    (check-equal? (status original) "failed")
    (check-equal? (length (file->lines marker)) 1)
    (cond
      [(equal? boundary "before")
       (define restarted (invoke database marker "resume" #f))
       (check-equal? restarted prepared)
       (check-equal? (length restarted) 1)
       (define replaced (invoke database marker "replace" #f))
       (check-equal? (status (child replaced)) "completed")
       (check-equal? (root replaced) original)]
      [else
       (define paused (invoke database marker (string-append "replace-" boundary) #t))
       (define replacement (child paused))
       (check-equal? (root paused) original)
       (check-equal? (status replacement) (if (equal? boundary "complete") "completed" "working"))
       (check-not-equal? (hash-ref replacement 'id) (hash-ref original 'id))
       (define restarted (invoke database marker "resume" #f))
       (check-equal? (root restarted) original)
       (check-equal? (hash-ref (child restarted) 'id) (hash-ref replacement 'id))
       (check-equal? (status (child restarted)) (if (equal? boundary "effect") "failed" "completed"))
       (cond
         [(equal? boundary "effect")
          (check-equal? (length (file->lines marker)) 2)
          (check-equal? (length (remove-duplicates (file->lines marker))) 1)
          (define repaired (invoke database marker "repair-replacement" #f))
          (check-equal? (length repaired) 3)
          (check-equal? (root repaired) original)
          (check-equal? (findf (lambda (r) (equal? (hash-ref r 'id) (hash-ref replacement 'id))) repaired)
                        (child restarted))
          (check-equal? (length (filter (lambda (r) (equal? (status r) "failed")) repaired)) 2)
          (check-equal? (length (filter (lambda (r) (equal? (status r) "completed")) repaired)) 1)]
         [else
          (define repeated (invoke database marker "replace" #f))
          (check-equal? repeated restarted)
          (check-equal? (hash-ref (hash-ref (hash-ref (child restarted) 'task) 'result) 'content)
                        (list (hasheq 'type "text" 'text "99")))])])
    (check-equal? (length (file->lines marker)) (if (equal? boundary "effect") 2 1))))
 (lambda () (delete-directory/files dir)))
