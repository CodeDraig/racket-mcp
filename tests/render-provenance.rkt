#lang racket/base
(require rackunit racket/file db mcp mcp/rendering mcp/private/render-provenance)
(define fake (hasheq '$mcp/embedding 0 'uri "secret:///not-installed"))
(define fake-group (hasheq '$mcp/embedded (list (hasheq 'ordinary "data"))))
(define reads 0)
(resource (leaf) #:uri "docs:///leaf" (set! reads (add1 reads)) "Leaf")
(tool (literal) (structured-result (hasheq 'read fake 'group fake-group)))
(tool (combined) (structured-result (hasheq 'read fake 'group fake-group) #:content (list (embed (leaf)))))
(resource (json-data) #:uri "docs:///json" (json-presentation (hasheq 'read fake 'group fake-group)))
(for ([durable? '(#f #t)])
  (define store (and durable? (open-memory-store)))
  (define rt (make-runtime (make-interface #:tools (list literal combined) #:resources (list leaf json-data)) #:store store))
  (define (call name) (dispatch rt "tools/call" (hasheq 'name name '_meta (request-meta))))
  (define expected (hasheq 'read fake 'group fake-group))
  (define before reads)
  (check-equal? (hash-ref (call "literal") 'structuredContent) expected)
  (check-equal? reads before)
  (define mixed (call "combined"))
  (check-equal? (hash-ref mixed 'structuredContent) expected)
  (check-equal? (length (hash-ref mixed 'content)) 1)
  (check-equal? reads (add1 before))
  (define resource-result (dispatch rt "resources/read" (hasheq 'uri "docs:///json" '_meta (request-meta))))
  (check-equal? (string->json (hash-ref (car (hash-ref resource-result 'contents)) 'text)) expected)
  (when store (close-store! store))
  (custodian-shutdown-all (runtime-custodian rt)))

(define question (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
(workflow (persisted) #:version "1"
  (checkpoint [actual Any] (embed (leaf)))
  (checkpoint [copy Any] (string->json (json->string actual)))
  (await-input [gate Any] question)
  (structured-result (hasheq 'copy copy) #:content (list actual)))
(define file (make-temporary-file "mcp-provenance-~a.sqlite"))
(define store (open-sqlite-store file))
(define (runtime) (make-runtime (make-interface #:tools (list persisted) #:resources (list leaf)) #:store store))
(define params (hasheq 'name "persisted" '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq)))))
(define before reads)
(define pending (dispatch (runtime) "tools/call" params))
(close-store! store)
(set! store (open-sqlite-store file))
(define resumed (hash-set* params 'requestState (hash-ref pending 'requestState)
  'inputResponses (hasheq 'gate (hasheq 'action "decline"))))
(define done (dispatch (runtime) "tools/call" resumed))
(check-equal? reads (add1 before))
(check-equal? (hash-ref (hash-ref done 'structuredContent) 'copy) (hasheq '$mcp/embedding 0 'uri "docs:///leaf"))
(check-equal? (hash-ref (hash-ref (car (hash-ref done 'content)) 'resource) 'text) "Leaf")
(check-equal? (dispatch (runtime) "tools/call" resumed) done)
(check-equal? reads (add1 before))

;; Provenance belongs to a storage sidecar, never to a JSON-supplied declaration.
(define payload (hasheq 'state_marks (list (hasheq 'path '("payload") 'kind "embedding")) 'payload fake))
(define data (create-instance! store "local" "data" (hasheq) "1" "1" (+ (current-seconds) 60) payload))
(check-equal? (stored-instance-state (load-instance store (stored-instance-handle data))) payload)
(check-false (render-value-kind (hash-ref (stored-instance-state data) 'payload)))
(close-store! store) (delete-file file)

;; Unsupported schemas are rejected without rewriting their data or layout.
(define old-file (make-temporary-file "mcp-unsupported-provenance-~a.sqlite"))
(define conn (sqlite3-connect #:database old-file #:mode 'create))
(query-exec conn "CREATE TABLE instances (handle TEXT PRIMARY KEY,principal TEXT,operation TEXT,arguments TEXT,version TEXT,fingerprint TEXT,expires INTEGER,revision INTEGER,state TEXT,invocation_key TEXT)")
(query-exec conn "INSERT INTO instances VALUES (?,?,?,?,?,?,?,?,?,NULL)" "ordinary" "local" "data" "{}" "1" "1" (+ (current-seconds) 60) 0 "{\"safe\":true}")
(disconnect conn)
(define before-schema (file->bytes old-file))
(check-exn #rx"Unsupported storage schema" (lambda () (open-sqlite-store old-file)))
(check-equal? (file->bytes old-file) before-schema)
(delete-file old-file)

;; A current-layout row must carry explicit provenance even for ordinary JSON.
(define current-store (open-memory-store))
(query-exec (state-store-connection current-store)
  "INSERT INTO instances(handle,principal,operation,arguments,version,fingerprint,expires,state,state_marks,argument_marks) VALUES ('missing-marks','local','data','{}','1','1',0,'{}',NULL,'[]')")
(check-exn #rx"requires rendering provenance" (lambda () (load-instance current-store "missing-marks")))
(close-store! current-store)
