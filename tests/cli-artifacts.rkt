#lang racket/base
(require rackunit racket/file racket/port racket/string racket/async-channel
         mcp mcp/http mcp/cli)
(define directory (make-temporary-file "mcp-cli-artifacts-~a" 'directory))
(define (command . args)
  (parameterize ([current-command-line-arguments (list->vector (map (lambda (v) (if (path? v) (path->string v) v)) args))])
    (with-output-to-string main)))
(dynamic-wind void
  (lambda ()
    (define before (build-path directory "before.rkt"))
    (define after (build-path directory "after.rkt"))
    (display-to-file "#lang mcp\n(tool (greet [name String]) #:description \"Greeting API\" (text-result name))\n(scenario greeting (error 'scenario \"documentation must not run me\"))\n(error 'parent \"inspection must not instantiate me\")\n" before)
    (display-to-file "#lang mcp\n(error 'parent \"diff must not instantiate me\")\n" after)
    (define inspected (read (open-input-string (command "inspect" before))))
    (check-equal? (map (lambda (entry) (hash-ref entry 'name)) inspected) '(greet))
    (check-true (string-contains? (command "diagram" before) "flowchart"))
    (check-true (string-contains? (command "diagram" before) "greet"))
    (define docs (command "docs" before))
    (check-true (string-contains? docs "Greeting API"))
    (check-true (string-contains? docs "Authored interaction examples"))
    (check-true (string-contains? docs "documentation must not run me"))
    (check-equal? (command "check" before) "Expansion checks passed.\n")
    (define difference (string->json (command "diff" before after)))
    (check-equal? (length difference) 1)
    (check-equal? (hash-ref (car difference) 'change) "breaking-removal")
    ;; Snapshot is an actual HTTP capture, including all listing families.
    (define rt
      (make-runtime (make-interface
        #:tools (list (make-tool "remote" '() (lambda (_) (error 'handler "snapshot must not call"))))
        #:resources (list (make-resource "document" "doc:///one" (lambda () (error 'reader "snapshot must not read"))))
        #:prompts (list (make-prompt "hint" '() (lambda (_) (error 'prompt "snapshot must not invoke")))))))
    (define confirmation (make-async-channel))
    (define stop (serve-http rt #:port 0 #:confirmation confirmation))
    (dynamic-wind void
      (lambda ()
        (define port (sync/timeout 5 confirmation))
        (check-true (exact-positive-integer? port))
        (define snapshot (string->json (command "snapshot" (format "http://127.0.0.1:~a/mcp" port))))
        (check-equal? (hash-ref (car (hash-ref (hash-ref snapshot 'tools/list) 'tools)) 'name) "remote")
        (check-equal? (hash-ref (car (hash-ref (hash-ref snapshot 'resources/list) 'resources)) 'uri) "doc:///one")
        (check-equal? (hash-ref (car (hash-ref (hash-ref snapshot 'prompts/list) 'prompts)) 'name) "hint")
        (check-equal? (hash-ref (hash-ref snapshot 'resources/templates/list) 'resourceTemplates) '()))
      (lambda () (stop) (custodian-shutdown-all (runtime-custodian rt)))))
  (lambda () (delete-directory/files directory)))
