#lang racket/base
(require rackunit racket/async-channel mcp)
(define store (open-memory-store))
(define computations 0)
(define request (hasheq 'mode "form" 'message "Choose" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
(define flow
  (make-workflow "rounds" "1" "round-test"
                 (list (workflow-stage 'first 'input Any (lambda (_) request) #f #f)
                       (workflow-stage 'between 'checkpoint Integer (lambda (_) (set! computations (add1 computations)) 1) #f #f)
                       (workflow-stage 'second 'input Any (lambda (_) request) #f #f)
                       (workflow-stage 'done 'complete Any (lambda (env) (structured-result env)) #f #f))))
(define (call token [responses (hasheq)])
  (run-workflow flow store (hasheq) #:principal "alice" #:state token #:responses responses))
(define first (call #f))
(define first-token (hash-ref first 'requestState))
(define yes (hasheq 'action "accept" 'content (hasheq 'ok #t)))
(define no (hasheq 'action "decline"))
(define outcomes (make-async-channel))
(for ([answer (list yes no)])
  (thread (lambda ()
            (async-channel-put outcomes
              (with-handlers ([exn:fail:mcp? values]) (cons answer (call first-token (hasheq 'first answer))))))))
(define results (list (sync outcomes) (sync outcomes)))
(check-equal? (length (filter exn:fail:mcp? results)) 1)
(define winner (car (filter pair? results)))
(define answer (car winner))
(define second (cdr winner))
(define second-token (hash-ref second 'requestState))
(check-not-equal? first-token second-token)
(check-equal? computations 1)
(check-equal? (call first-token (hasheq 'first answer)) second)
(check-equal? (call first-token (hasheq 'first answer 'unrecognized "ignored")) second)
(check-equal? (call second-token) second)
(check-exn exn:fail:mcp? (lambda () (call first-token (hasheq 'second yes))))
(check-exn exn:fail? (lambda () (run-workflow flow store (hasheq) #:principal "bob" #:state second-token)))
(check-exn exn:fail:mcp? (lambda () (call "tampered-token")))
(define done (call second-token (hasheq 'second yes)))
(check-equal? (call first-token (hasheq 'first answer)) done)
(check-equal? (call second-token (hasheq 'second yes)) done)
(check-exn exn:fail:mcp? (lambda () (call second-token (hasheq 'second no))))
(check-equal? computations 1)
(close-store! store)
