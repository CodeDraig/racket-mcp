#lang racket/base
(require rackunit racket/file db mcp)

(define request (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
(workflow (unkeyed [value Integer]) #:version "1" #:execution task-optional
  (perform [saved Integer] #:adapter writer #:policy idempotent value)
  (await-input [answer Any] request)
  (structured-result (list saved answer)))
(workflow (keyed [value Integer]) #:version "1" #:execution task-optional
  #:key (lambda (args) (number->string (hash-ref args 'value)))
  (perform [saved Integer] #:adapter writer #:policy idempotent value)
  (await-input [answer Any] request)
  (structured-result (list saved answer)))
(workflow (boundary [value Integer]) #:version "1" #:execution task-optional
  (perform [saved Integer] #:adapter writer #:policy idempotent value)
  (await-input [answer Any] request)
  (task-boundary launch)
  (structured-result (list saved answer)))
(define sync-caps (hasheq 'elicitation (hasheq)))
(define task-caps (hash-set sync-caps 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define answer (hasheq 'action "decline"))

(for ([name '("unkeyed" "keyed" "boundary")])
  (test-case (string-append name " continuation survives newly advertised Tasks capability")
    (define directory (make-temporary-file "mcp-task-mode-~a" 'directory))
    (define path (build-path directory "state.sqlite"))
    (define store (open-sqlite-store path))
    (define external (sqlite3-connect #:database (build-path directory "external.sqlite") #:mode 'create))
    (query-exec external "CREATE TABLE mutations (effect_key TEXT PRIMARY KEY, value INTEGER)")
    (define adapters (hasheq 'writer (effect-adapter 'idempotent
      (lambda (value key tx)
        (query-exec external "INSERT OR IGNORE INTO mutations VALUES (?,?)" key value) value))))
    (define iface (make-interface #:tools (list unkeyed keyed boundary)))
    (define rt (make-runtime iface #:store store #:adapters adapters))
    (define (call params caps [who "alice"])
      (dispatch rt "tools/call" (hash-set params '_meta (request-meta #:capabilities caps)) #:principal who))
    (define (poll id)
      (let loop ([left 200])
        (define detail (dispatch rt "tasks/get" (hasheq '_meta (request-meta #:capabilities task-caps) 'taskId id) #:principal "alice"))
        (cond [(not (equal? (hash-ref detail 'status) "working")) detail]
              [(zero? left) (error 'test "task did not settle")]
              [else (sync (alarm-evt (+ (current-inexact-milliseconds) 5))) (loop (sub1 left))])))
    (dynamic-wind void
      (lambda ()
        (define params (hasheq 'name name 'arguments (hasheq 'value 7)))
        (define initial (call params sync-caps))
        (check-equal? (query-value external "SELECT count(*) FROM mutations") 1)
        (define flow (car (list-instances store #:operation name)))
        (define retry (hash-set* params 'requestState (hash-ref initial 'requestState) 'inputResponses (hasheq 'answer answer)))
        (custodian-shutdown-all (runtime-custodian rt))
        (close-store! store)
        (set! store (open-sqlite-store path))
        (set! rt (make-runtime iface #:store store #:adapters adapters))
        (check-exn exn:fail? (lambda () (call retry task-caps "bob")))
        (define resumed (call retry task-caps))
        ;; Poll unexpected task receipts too, so the failing baseline records
        ;; the external mutation count after its worker has finished.
        (define done (if (equal? (hash-ref resumed 'resultType) "task") (poll (hash-ref resumed 'taskId)) resumed))
        (check-equal? (query-value external "SELECT count(*) FROM mutations") 1)
        (if (equal? name "boundary")
            (begin (check-equal? (hash-ref resumed 'resultType) "task")
                   (check-equal? (hash-ref done 'status) "completed")
                   (check-equal? (hash-ref (hash-ref done 'result) 'structuredContent) (list 7 answer)))
            (begin (check-equal? (hash-ref resumed 'resultType) "complete")
                   (check-equal? (hash-ref resumed 'structuredContent) (list 7 answer))))
        (check-equal? (call retry task-caps) resumed)
        (check-exn exn:fail? (lambda () (call (hash-set retry 'arguments (hasheq 'value 8)) task-caps)))
        (check-equal? (query-value external "SELECT count(*) FROM mutations") 1)
        (check-equal? (length (list-instances store #:operation name)) 1)
        (check-equal? (hash-ref (stored-instance-state (load-instance store (stored-instance-handle flow))) 'status)
                      "completed"))
      (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store)
        (disconnect external) (delete-directory/files directory)))))
