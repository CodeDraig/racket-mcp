#lang racket/base
(require rackunit racket/async-channel mcp mcp/stdio mcp/json)
(define (fixture #:close-ports? [close? #t])
  (define-values (in peer-out) (make-pipe))
  (define-values (peer-in out) (make-pipe))
  (values (make-stdio-client in out #:close-ports? close?) in out peer-in peer-out))
(define (send out value) (write-json value out) (newline out) (flush-output out))
(define (progress token n)
  (hasheq 'jsonrpc "2.0" 'method "notifications/progress"
          'params (hasheq 'progressToken token 'progress n)))
(define (params token) (hasheq '_meta (hasheq 'progressToken token)))
(define (reply h) (hasheq 'jsonrpc "2.0" 'id (request-handle-id h) 'result (hasheq 'resultType "complete")))
(define-values (c in out peer-in peer-out) (fixture))
(define a (client-request c "ping" (params "job-a")))
(define b (client-request c "ping" (params 0)))
(check-exn #rx"already belongs" (lambda () (client-request c "ping" (params "job-a"))))
(check-exn exn:fail? (lambda () (client-request c "ping" (params #f))))
(send peer-out (progress 0 1))
(send peer-out (progress "job-a" 2))
(check-equal? (sync/timeout 2 (request-handle-notifications b)) (progress 0 1))
(check-equal? (sync/timeout 2 (request-handle-notifications a)) (progress "job-a" 2))
(check-false (sync/timeout 0 a))
(send peer-out (reply b))
(check-equal? (sync/timeout 2 b) (reply b))
(define reused (client-request c "ping" (params 0)))
(send peer-out (progress 0 3))
(check-equal? (sync/timeout 2 (request-handle-notifications reused)) (progress 0 3))
(check-false (sync/timeout 0 (request-handle-notifications b)))
(close-output-port peer-out)
(check-true (exn:fail? (sync/timeout 2 a)))
(check-true (exn:fail? (sync/timeout 2 reused)))
;; EOF resolves handles before cleanup; wait for the owned ports' close events.
(check-not-false (sync/timeout 2 (port-closed-evt in)))
(check-not-false (sync/timeout 2 (port-closed-evt out)))
(check-equal? (sync/timeout 0 b) (reply b))
(check-not-exn (lambda () (request-cancel! b)))
(check-exn exn:fail? (lambda () (client-request c "ping")))
(close-input-port peer-in)

;; Explicit close can borrow ports while still terminating its own reader.
(define-values (borrowed bin bout bpeer-in bpeer-out) (fixture #:close-ports? #f))
(define waiting (client-request borrowed "ping"))
(client-close! borrowed)
(check-true (exn:fail? (sync/timeout 0 waiting)))
(check-false (port-closed? bin))
(check-false (port-closed? bout))
(send bpeer-out (hasheq 'still "available"))
(check-equal? (string->json (read-json-line bin)) (hasheq 'still "available"))
(close-input-port bin) (close-output-port bout)
(close-input-port bpeer-in) (close-output-port bpeer-out)

;; Malformed replies fail the connection instead of completing a request as success.
(for ([bad (in-list (list (hasheq 'jsonrpc "2.0" 'id 1 'method "ping")
                          (hasheq 'jsonrpc "2.0" 'id 1 'result (hasheq) 'error (hasheq))
                          (hasheq 'jsonrpc "1.0" 'id 1 'result (hasheq))))])
  (define-values (client i o pi po) (fixture))
  (define h (client-request client "ping"))
  (send po bad)
  (check-true (exn:fail? (sync/timeout 2 h)))
  (close-input-port pi) (close-output-port po))

;; A blocked writer cannot hold the state lock and prevent explicit close.
(define-values (wi wpo) (make-pipe))
(define-values (wpi wo) (make-pipe 1))
(define writer-client (make-stdio-client wi wo))
(define sender (thread (lambda () (with-handlers ([exn:fail? void])
                                  (client-request writer-client "ping")))))
(check-not-false (sync/timeout 2 wpi))
(client-close! writer-client)
(check-not-false (sync/timeout 2 (thread-dead-evt sender)))
(close-input-port wpi) (close-output-port wpo)

;; EOF has a bounded grace period even if a handler ignores cooperative cancellation.
(define started (make-channel))
(define rt (make-runtime (make-interface #:tools
  (list (make-tool "hang" '() (lambda (_)
    (channel-put started (current-thread)) (sync never-evt)))))))
(define-values (si co) (make-pipe))
(define so (open-output-string))
(define server (thread (lambda () (serve-stdio rt #:input si #:output so))))
(send co (hasheq 'jsonrpc "2.0" 'id 1 'method "tools/call"
                 'params (hasheq 'name "hang" '_meta (request-meta))))
(define handler (sync/timeout 2 started))
(check-true (thread? handler))
(close-output-port co)
(check-not-false (sync/timeout 2 (thread-dead-evt server)))
(check-true (thread-dead? handler))
(close-input-port si) (close-output-port so)
