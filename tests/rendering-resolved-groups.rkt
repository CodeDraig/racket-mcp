#lang racket/base
(require rackunit racket/file mcp)

(define reads 0)
(define (read!) (set! reads (add1 reads)))
(resource (pages) #:uri "resolved:///pages" (read!) (resource-contents "A" "B"))
(resource (empty) #:uri "resolved:///empty" (read!) (resource-contents))
(resource (tail) #:uri "resolved:///tail" "C")
(define question (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
(resource (delayed) #:uri "resolved:///delayed" #:workflow "1"
  (await-input [answer Any] question) "C")
(tool (show [prefix Any #:default (embed (pages))])
  (structured-result (hasheq 'pages prefix) #:content (list prefix (embed (tail)))))
(tool (show-empty [prefix Any #:default (embed (empty))])
  (hasheq 'resultType "complete" 'content (list prefix (embed (tail)))))
(prompt (read-pages [prefix Any #:default (embed (pages))])
  (role "user" prefix (embed (tail))))
(resource (joined [prefix Any #:default (embed (pages))]) #:uri "resolved:///joined"
  (text-presentation prefix (embed (tail))))
(tool (durable [prefix Any #:default (embed (pages))])
  (hasheq 'resultType "complete" 'content (list prefix (embed (delayed)))))
(define iface (make-interface #:tools (list show show-empty durable) #:prompts (list read-pages)
                              #:resources (list pages empty tail delayed joined)))
(define (texts items) (map (lambda (item) (hash-ref (hash-ref item 'resource) 'text)) items))

(for ([durable? '(#f #t)])
  (test-case (format "resolved groups survive deferred rendering, store: ~a" durable?)
    (define store (and durable? (open-memory-store)))
    (define rt (make-runtime iface #:store store))
    (define (call method params) (dispatch rt method (hash-set params '_meta (request-meta))))
    (dynamic-wind void
      (lambda ()
        (define result (call "tools/call" (hasheq 'name "show")))
        (check-equal? (texts (hash-ref result 'content)) '("A" "B" "C"))
        (check-equal? (texts (hash-ref (hash-ref result 'structuredContent) 'pages)) '("A" "B"))
        (check-equal? (texts (hash-ref (call "tools/call" (hasheq 'name "show-empty")) 'content)) '("C"))
        (define messages (hash-ref (call "prompts/get" (hasheq 'name "read-pages")) 'messages))
        (check-equal? (map (lambda (message) (hash-ref message 'role)) messages) '("user" "user" "user"))
        (check-equal? (texts (map (lambda (message) (hash-ref message 'content)) messages)) '("A" "B" "C"))
        (check-equal? (hash-ref (car (hash-ref (call "resources/read" (hasheq 'uri "resolved:///joined")) 'contents)) 'text) "ABC"))
      (lambda () (custodian-shutdown-all (runtime-custodian rt)) (when store (close-store! store))))))

(test-case "resolved groups retain provenance through a rendering continuation restart"
  (define path (make-temporary-file "mcp-resolved-groups-~a.sqlite"))
  (define store (open-sqlite-store path))
  (define rt (make-runtime iface #:store store))
  (define params (hasheq 'name "durable" '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq)))))
  (dynamic-wind void
    (lambda ()
      (define before reads)
      (define waiting (dispatch rt "tools/call" params))
      (check-equal? reads (add1 before))
      (custodian-shutdown-all (runtime-custodian rt))
      (close-store! store)
      (set! store (open-sqlite-store path))
      (set! rt (make-runtime iface #:store store))
      (define retry (hash-set* params 'requestState (hash-ref waiting 'requestState)
                              'inputResponses (hasheq 'e0/r0/answer (hasheq 'action "decline"))))
      (define result (dispatch rt "tools/call" retry))
      (check-equal? (texts (hash-ref result 'content)) '("A" "B" "C"))
      (check-equal? (dispatch rt "tools/call" retry) result)
      (check-equal? reads (add1 before)))
    (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store) (delete-file path))))
