#lang racket/base
(require rackunit mcp)
(define reads 0)
(resource (document [id String]) #:uri "doc:///{id}" (begin (set! reads (add1 reads)) id))
(resource (index) #:uri "index:///" "index")
(prompt (show [id String]) (role "user" (link (document id))))
(tool (open [id String]) (hasheq 'resultType "complete" 'content (list (link (document id)))))
(define graph (make-hasheq (list (cons open (list document document))
                               (cons show (list document)) (cons index (list document)))))
(define base (make-interface #:tools (list open) #:resources (list document index) #:prompts (list show) #:references graph))
(check-equal? (hash-ref (interface-resource-references base) open) (list document))
(check-true (immutable? (interface-resource-references base)))
(hash-clear! graph)
(check-equal? (hash-count (interface-resource-references base)) 3)
(check-equal? reads 0)
(check-exn #rx"absent resource" (lambda () (view base #:exclude '("document"))))
(check-exn #rx"absent resource" (lambda () (view base #:include '("open"))))
(check-exn #rx"absent resource" (lambda () (view base #:include '("index"))))
(check-equal? reads 0)
(define empty (view base #:exclude '("document" "open" "show" "index")))
(check-equal? (interface-resource-references empty) (hasheq))
(define remapped (view base #:namespace "public/" #:uris (hash "doc:///{id}" "public:///{id}")))
(define public-open (car (interface-descriptor-tools remapped)))
(define public-document (car (interface-descriptor-resources remapped)))
(check-eq? (car (hash-ref (interface-resource-references remapped) public-open)) public-document)
(check-equal? (resource-descriptor-uri public-document) "public:///{id}")
(define mounted (mount-interfaces remapped))
(check-equal? (interface-resource-references mounted) (interface-resource-references remapped))
(define rt (make-runtime mounted))
(define result (dispatch rt "tools/call" (hasheq '_meta (request-meta) 'name "public/open" 'arguments (hasheq 'id "a b"))))
(check-equal? (hash-ref (car (hash-ref result 'content)) 'uri) "public:///a%20b")
(check-equal? reads 0)
(custodian-shutdown-all (runtime-custodian rt))
(check-exn #rx"absent declaration" (lambda () (make-interface #:resources (list document) #:references (hasheq open (list document)))))
(check-exn #rx"list of resource descriptors" (lambda () (make-interface #:tools (list open) #:references (hasheq open (list show)))))
(check-exn exn:fail:contract? (lambda () (make-interface #:references 'bad)))
(check-exn #rx"absent resource" (lambda () (make-interface #:tools (list open) #:references (hasheq open (list document)))))
;; A same-named fresh declaration cannot satisfy an identity-bound reference.
(define impostor (make-resource "document" "doc:///{id}" values #:arguments (list (argument 'id String #f #f))))
(check-exn #rx"absent resource"
  (lambda () (make-interface #:tools (list open) #:resources (list impostor) #:references (hasheq open (list document)))))
;; Two URI views of one identity cannot choose a mapping for a retained reference.
(define sibling (view (make-interface #:resources (list document)) #:namespace "other/" #:uris (hash "doc:///{id}" "other:///{id}")))
(check-exn #rx"ambiguous mounted resource" (lambda () (mount-interfaces base sibling)))
;; Cycles describe links too; runtime embedding, not the graph, detects cycles.
(check-not-exn
  (lambda () (make-interface #:resources (list document index)
                            #:references (hasheq document (list index) index (list document)))))
(module provider racket/base
  (require mcp)
  (provide base)
  (resource (record [id String]) #:uri "record:///{id}" id)
  (tool (read-record) (text-result "record"))
  (define base (make-interface #:tools (list read-record) #:resources (list record)
                               #:references (hasheq read-record (list record)))))
(module consumer mcp/lang
  (require (submod ".." provider))
  (mount base))
(require (prefix-in consumer: (submod "." consumer)))
(check-equal? (hash-count (interface-resource-references consumer:mcp-interface)) 1)
(check-exn #rx"absent resource" (lambda () (view consumer:mcp-interface #:exclude '("record"))))
