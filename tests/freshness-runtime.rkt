#lang racket/base
(require rackunit racket/async-channel mcp mcp/subscription)
(define data (make-hash))
(define change-count 0)
(resource (document [id String]) #:uri "doc:///{id}" #:depends-on (list id)
  (hash-ref data id "empty"))
(tool (save [id String] [body String])
  #:changes [outcome (begin (set! change-count (add1 change-count))
                           (unless (equal? (hash-ref outcome 'resultType) "complete") (error 'test "wrong outcome"))
                           (list id))]
  (hash-set! data id body)
  (committed-result (text-result "saved") '()))
(tool (failed [id String]) #:changes [outcome (error 'test "failed mutation evaluated changes")]
  (error-result "not committed"))
(tool (unconfirmed [id String]) #:changes [outcome (error 'test "unconfirmed outcome evaluated changes")]
  (text-result "no commit acknowledgement"))
(define iface (view (make-interface #:resources (list document) #:tools (list save failed unconfirmed))
                    #:uris (hash "doc:///{id}" "mounted:///{id}")))
(define deny-alice? #f)
(define store (open-memory-store))
(define rt (make-runtime iface #:store store
  #:authorize (lambda (principal method params)
                (not (and deny-alice? (eq? principal 'alice) (equal? method "resources/read"))))))
(define (call method params [principal 'alice]) (dispatch rt method (hash-set params '_meta (request-meta)) #:principal principal))
(define (listen principal)
  (define queue (make-async-channel))
  (define worker (thread (lambda () (call-with-values
    (lambda () (dispatch rt "subscriptions/listen"
      (hasheq '_meta (request-meta) 'notifications (hasheq 'resourceSubscriptions '("mounted:///1")))
      #:principal principal #:id (symbol->string principal) #:notify (lambda (m) (async-channel-put queue m)))) void))))
  (check-equal? (hash-ref (sync/timeout 2 queue) 'method) "notifications/subscriptions/acknowledged")
  (values queue worker))
(define-values (alice alice-worker) (listen 'alice))
(define-values (bob bob-worker) (listen 'bob))
(define (cached who fallback)
  (cache-ref! (runtime-cache rt) who "mounted:///1" '("1") 100000 (lambda () fallback)))
(check-equal? (cached "alice" "old") "old")
(check-equal? (cached "bob" "bob-old") "bob-old")
(void (call "tools/call" (hasheq 'name "failed" 'arguments (hasheq 'id "1"))))
(void (call "tools/call" (hasheq 'name "unconfirmed" 'arguments (hasheq 'id "1"))))
(check-equal? change-count 0)
(check-false (sync/timeout 0 alice))
(check-equal? (list-instances store #:operation "change-outbox") '())
(void (call "tools/call" (hasheq 'name "save" 'arguments (hasheq 'id "1" 'body "fresh"))))
(check-equal? change-count 1)
(define notification (sync/timeout 2 alice))
(check-equal? (hash-ref notification 'method) "notifications/resources/updated")
(check-equal? (hash-ref (hash-ref notification 'params) 'uri) "mounted:///1")
(check-equal? (cached "alice" "fresh") "fresh")
(check-equal? (cached "bob" "incorrect") "bob-old")
(check-false (sync/timeout 0 bob))
(check-equal? (hash-ref (stored-instance-state (car (list-instances store #:operation "change-outbox"))) 'status) "delivered")
;; The resource need not have been read/cached for a declared dependency to notify.
(void (runtime-report-change! rt 'bob '("1")))
(check-equal? (hash-ref (sync/timeout 2 bob) 'method) "notifications/resources/updated")
;; Participating application transactions can append the outbox atomically.
(define count (length (list-instances store #:operation "change-outbox")))
(check-exn exn:fail? (lambda () (store-transaction store (lambda () (record-committed-change! store "alice" '("1")) (error 'mutation "rollback")))))
(check-equal? (length (list-instances store #:operation "change-outbox")) count)
(set! deny-alice? #t)
(void (record-committed-change! store "alice" '("1")))
(runtime-drain-changes! rt)
(check-false (sync/timeout 0 alice))
(close-subscriptions! (runtime-subscriptions rt))
(thread-wait alice-worker) (thread-wait bob-worker)
(close-store! store) (custodian-shutdown-all (runtime-custodian rt))
