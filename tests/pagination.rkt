#lang racket/base
(require rackunit racket/list mcp mcp/authorization)
(define now 0)
(define tools (for/list ([i (in-range 5)]) (make-tool (format "tool~a" i) '() (lambda (_) (error 'test "listing invoked a handler")))))
(define resources
  (append (for/list ([i (in-range 5)]) (make-resource (format "resource~a" i) (format "resource:///~a" i) (lambda () "")))
          (for/list ([i (in-range 5)]) (make-resource (format "template~a" i) (format "template:///~a/{id}" i) (lambda (id) id)
                                       #:arguments (list (argument 'id String #f #f))))))
(define prompts (for/list ([i (in-range 5)]) (make-prompt (format "prompt~a" i) '() (lambda (_) '()))))
(define iface (make-interface #:tools tools #:resources resources #:prompts prompts))
(define rt (make-runtime iface #:page-size 2 #:cursor-clock (lambda () now) #:cursor-ttl 10))
(define alice (verified-principal "alice" "issuer" "audience" '("read") (+ (current-seconds) 1000)))
(define (call method [cursor missing] [principal alice] [extra (hasheq)])
  (dispatch rt method (if (missing? cursor) (hash-set extra '_meta (request-meta))
                         (hash-set* extra '_meta (request-meta) 'cursor cursor)) #:principal principal))
(for ([method '("tools/list" "resources/list" "resources/templates/list" "prompts/list")]
      [field '(tools resources resourceTemplates prompts)])
  (define first (call method))
  (check-equal? (length (hash-ref first field)) 2)
  (check-equal? (hash-ref first 'ttlMs) 0)
  (check-equal? (hash-ref first 'cacheScope) "private")
  (define next (hash-ref first 'nextCursor))
  (define second (call method next))
  (check-equal? (call method next) second)
  (define last (call method (hash-ref second 'nextCursor)))
  (check-equal? (length (hash-ref last field)) 1)
  (check-false (hash-has-key? last 'nextCursor))
  (check-equal? (length (remove-duplicates (append (hash-ref first field) (hash-ref second field) (hash-ref last field)))) 5)
  (check-exn exn:fail:mcp? (lambda () (call method next "bob")))
  (check-exn exn:fail:mcp? (lambda () (call method next (struct-copy verified-principal alice [scopes '("other")]))))
  (check-exn exn:fail:mcp? (lambda () (call method next alice (hasheq 'changed #t)))))
(define first (call "tools/list"))
(define cursor (hash-ref first 'nextCursor))
(check-exn exn:fail:mcp? (lambda () (call "prompts/list" cursor)))
(check-exn exn:fail:mcp? (lambda () (call "tools/list" "")))
(check-exn exn:fail:mcp? (lambda () (call "tools/list" json-null)))
(set! now 11)
(check-exn exn:fail:mcp? (lambda () (call "tools/list" cursor)))
;; Capacity eviction is by complete snapshot, never arbitrary pages in a live chain.
(define small (make-runtime iface #:page-size 2 #:cursor-limit 2))
(define (small-list [cursor missing])
  (dispatch small "tools/list" (if (missing? cursor) (hasheq '_meta (request-meta)) (hasheq '_meta (request-meta) 'cursor cursor))))
(define old (hash-ref (small-list) 'nextCursor))
(define current (hash-ref (small-list) 'nextCursor))
(check-exn exn:fail:mcp? (lambda () (small-list old)))
(check-true (hash? (small-list current)))
;; Wire metadata is frozen across pages even when a dynamic caller mutates it.
(define annotations (make-hasheq '((readOnlyHint . #t))))
(define frozen (make-runtime (make-interface #:tools
  (list (make-tool "first" '() void) (make-tool "second" '() void #:annotations annotations))) #:page-size 1))
(define f (dispatch frozen "tools/list" (hasheq '_meta (request-meta))))
(hash-set! annotations 'readOnlyHint #f)
(define s (dispatch frozen "tools/list" (hasheq '_meta (request-meta) 'cursor (hash-ref f 'nextCursor))))
(check-true (hash-ref (hash-ref (car (hash-ref s 'tools)) 'annotations) 'readOnlyHint))
(for ([rt (in-list (list rt small frozen))]) (custodian-shutdown-all (runtime-custodian rt)))
