#lang racket/base
(require rackunit racket/async-channel mcp mcp/upstream)
(define bridge (make-upstream-bridge #:identity "rounds" #:version "1" #:credential-id (lambda (_) "account")))
(define store (open-memory-store))
(define snapshot (hasheq 'pin "1"))
(define caps (hasheq 'elicitation (hasheq)))
(define calls 0)
(define (request method params)
  (set! calls (add1 calls))
  (case calls
    [(1) (hasheq 'resultType "input_required" 'inputRequests
           (hasheq 'remote-input (hasheq 'method "elicitation/create" 'params
             (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))))]
    [(2)
     (check-false (hash-has-key? params 'requestState))
     (check-equal? (hash-ref params 'inputResponses) (hasheq 'remote-input (hasheq 'action "decline")))
     (hasheq 'resultType "input_required" 'requestState "remote-round-two")]
    [(3)
     (check-equal? (hash-ref params 'requestState) "remote-round-two")
     (check-false (hash-has-key? params 'inputResponses))
     (text-result "finished")]
    [else (error 'test "unexpected replay")]))
(define (invoke [token #f] [answers (hasheq)])
  (hash-ref (bridge-upstream-request bridge store snapshot request "tools/call" (hasheq 'name "work")
             #:principal "owner" #:credential-id "account" #:state token #:responses answers #:capabilities caps) 'result))
(dynamic-wind void
  (lambda ()
    (define first (invoke))
    (define id (car (hash-keys (hash-ref first 'inputRequests))))
    (define answers (hasheq id (hasheq 'action "decline")))
    (define second (invoke (hash-ref first 'requestState) answers))
    (check-equal? (hash-ref second 'inputRequests) (hasheq))
    (check-not-equal? (hash-ref second 'requestState) "remote-round-two")
    (check-equal? (invoke (hash-ref first 'requestState) answers) second)
    (check-equal? calls 2)
    (define final (invoke (hash-ref second 'requestState)))
    (check-equal? final (text-result "finished"))
    (check-equal? calls 3)
    (check-equal? (invoke (hash-ref first 'requestState) answers) final)
    (check-equal? calls 3))
  (lambda () (close-store! store)))
(define concurrent-store (open-memory-store))
(define owner (make-custodian))
(define entered (make-semaphore))
(define release (make-semaphore))
(define results (make-async-channel))
(define sends 0)
(define (slow _m _p)
  (set! sends (add1 sends)) (semaphore-post entered) (semaphore-wait release) (text-result "one"))
(define (start)
  (parameterize ([current-custodian owner])
    (thread (lambda () (async-channel-put results
      (bridge-upstream-request bridge concurrent-store snapshot slow "tools/call" (hasheq 'name "work")
                               #:principal "owner" #:credential-id "account" #:key "one"))))))
(dynamic-wind void
  (lambda ()
    (void (start))
    (check-not-false (sync/timeout 2 entered))
    (define handle (stored-instance-handle (car (list-instances concurrent-store))))
    (check-exn #rx"request is active"
      (lambda () (recover-upstream-request! bridge concurrent-store snapshot handle #:principal "owner" #:credential-id "account" #:action 'retry)))
    (void (start))
    (semaphore-post release)
    (check-equal? (sync/timeout 3 results) (hasheq 'result (text-result "one")))
    (check-equal? (sync/timeout 3 results) (hasheq 'result (text-result "one")))
    (check-equal? sends 1))
  (lambda () (custodian-shutdown-all owner) (close-store! concurrent-store)))
