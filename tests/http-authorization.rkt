#lang racket/base
(require rackunit racket/async-channel racket/port racket/string
         mcp mcp/authorization mcp/http mcp/private/http-wire)
(define resource "https://api.example/public/mcp")
(define issuer "https://issuer.example")
(define metadata (protected-resource-metadata resource (list issuer) #:scopes '("read")))
(check-equal? (protected-resource-metadata-url resource)
              "https://api.example/.well-known/oauth-protected-resource/public/mcp")
(check-equal? (protected-resource-metadata-url "https://api.example/")
              "https://api.example/.well-known/oauth-protected-resource")
(check-exn exn:fail? (lambda () (protected-resource-metadata resource '())))
(for ([scope '("two words" "bad\"quote" "bad\\slash" "bad\r\nheader" "")])
  (check-exn exn:fail? (lambda () (bearer-challenge (protected-resource-metadata-url resource) #:scopes (list scope)))))
(define calls 0)
(define rt (make-runtime (view (make-interface #:tools
  (list (make-tool "read" '() (lambda (_) (set! calls (add1 calls)) (text-result "ok")))))
  #:require-scopes '("read"))))
(check-exn #rx"authentication adapter" (lambda () (make-http-handler rt #:resource-metadata metadata)))
(define (principal scopes [iss issuer] [aud resource] [expiry (+ (current-seconds) 60)])
  (verified-principal "alice" iss aud scopes expiry))
(define verify
  (make-bearer-authenticator
    (lambda (token) (cond [(equal? token "good") (principal '("read"))]
                          [(equal? token "limited") (principal '())]
                          [(equal? token "foreign") (principal '("read") "https://other.example")]
                          [(equal? token "expired") (principal '("read") issuer resource 0)]
                          [else #f])) #:issuer issuer #:audience resource))
(define confirmation (make-async-channel))
(define stop (serve-http rt #:port 0 #:confirmation confirmation #:authenticate verify #:resource-metadata metadata #:sse? #t))
(define port (sync/timeout 5 confirmation))
(when (exn? port) (raise port))
(define params (hasheq 'name "read" '_meta (request-meta)))
(define data (json->string (hasheq 'jsonrpc "2.0" 'id 1 'method "tools/call" 'params params)))
(define base-headers (map (lambda (kv) (string-append (car kv) ": " (cdr kv))) (request-headers "tools/call" params)))
(define (fetch path method headers [body ""])
  (define-values (status hs in) (bounded-http-sendrecv "127.0.0.1" path #:port port #:method method #:headers headers #:data body))
  (define bytes (dynamic-wind void (lambda () (port->bytes in)) (lambda () (close-input-port in))))
  (values status hs bytes))
(define (header-value hs prefix)
  (for/first ([h (in-list hs)] #:when (string-prefix? (string-downcase (bytes->string/utf-8 h)) prefix))
    (bytes->string/utf-8 h)))
(dynamic-wind void
  (lambda ()
    (define-values (status hs body) (fetch "/.well-known/oauth-protected-resource/public/mcp" "GET" '("Origin: https://browser.example")))
    (check-true (regexp-match? #rx#"200" status))
    (check-equal? (string->json (bytes->string/utf-8 body)) metadata)
    (check-equal? (header-value hs "access-control-allow-origin:") "Access-Control-Allow-Origin: *")
    (for ([token (list #f "foreign" "expired")])
      (define-values (s headers b) (fetch "/public/mcp" "POST"
        (append base-headers (if token (list (string-append "Authorization: Bearer " token)) '())) data))
      (check-true (regexp-match? #rx#"401" s))
      (check-true (string-contains? (header-value headers "www-authenticate:")
                                  (protected-resource-metadata-url resource))))
    (define-values (denied dh db) (fetch "/public/mcp" "POST" (cons "Authorization: Bearer limited" base-headers) data))
    (check-true (regexp-match? #rx#"403" denied))
    (check-true (string-contains? (header-value dh "www-authenticate:") "error=\"insufficient_scope\""))
    (check-true (string-contains? (header-value dh "www-authenticate:") "scope=\"read\""))
    (check-false (and (header-value dh "content-type:") (string-contains? (header-value dh "content-type:") "text/event-stream")))
    (check-equal? calls 0)
    (define unauthorized
      (sync/timeout 5 (http-client-request (make-http-client (format "http://127.0.0.1:~a/public/mcp" port)) "tools/list")))
    (check-true (exn:fail:http:authorization? unauthorized))
    (check-equal? (exn:fail:http:authorization-status unauthorized) 401)
    (check-equal? (exn:fail:http:authorization-body unauthorized) #"")
    (check-equal? (hash-ref (authentication-challenge-parameters
                            (car (exn:fail:http:authorization-challenges unauthorized))) "resource_metadata")
                  (protected-resource-metadata-url resource))
    (define insufficient
      (sync/timeout 5 (http-client-request (make-http-client (format "http://127.0.0.1:~a/public/mcp" port) #:token "limited")
                                           "tools/call" params)))
    (check-true (exn:fail:http:authorization? insufficient))
    (check-equal? (exn:fail:http:authorization-status insufficient) 403)
    (check-equal? (exn:fail:http:authorization-request-token insufficient) "limited")
    (check-equal? (exn:fail:http:authorization-resource insufficient) (format "http://127.0.0.1:~a/public/mcp" port))
    (check-equal? (hash-ref (hash-ref (string->json (bytes->string/utf-8 (exn:fail:http:authorization-body insufficient))) 'error) 'code) -32001)
    (check-equal? calls 0)
    (check-exn exn:fail:mcp? (lambda () (dispatch rt "tools/call" params #:principal (principal '()))))
    (define-values (ok oh ob) (fetch "/public/mcp" "POST" (cons "Authorization: Bearer good" base-headers) data))
    (check-true (regexp-match? #rx#"200" ok))
    (check-true (string-contains? (header-value oh "content-type:") "text/event-stream"))
    (check-true (regexp-match? #rx#"ok" ob))
    (check-equal? calls 1)
    (check-equal? (hash-ref (dispatch rt "tools/call" params #:principal (principal '("read"))) 'content)
                  (list (text-content "ok"))))
  stop)
