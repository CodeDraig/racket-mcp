#lang racket/base
(require rackunit racket/async-channel mcp)

;; Deliberately stop host callbacks while another request polls/cancels the task.
;; Cancellation must prevent both the stage transition and its change outbox.
(for* ([kind '(branch jump complete changes)] [cancel? '(#f #t)])
  (define entered (make-async-channel))
  (define release (make-semaphore 0))
  (define calls 0)
  (define (block value)
    (set! calls (add1 calls))
    (async-channel-put entered (cons (current-thread) (current-store-connection)))
    (semaphore-wait release)
    value)
  (define result (text-result "done"))
  (define program
    (make-workflow "blocked" "1" "control-stage-lock"
      (list (workflow-stage 'start (if (eq? kind 'changes) 'complete kind) #t
                (lambda (_env)
                  (case kind [(branch) (block 0)] [(jump) (block (void))]
                             [(complete) (block result)] [else result]))
                (case kind [(branch) '(finish)] [(jump) 'finish] [else #f]) #f)
            (workflow-stage 'finish 'complete #t (lambda (_env) result) #f #f))
      #:changes (lambda (_args _result) (if (eq? kind 'changes) (block '("changed")) '()))))
  (define tool (make-tool "blocked" '() (lambda (_args) (error 'test "workflow handler bypassed"))
                          #:workflow program #:execution 'task))
  (define store (open-memory-store))
  (define rt (make-runtime (make-interface #:tools (list tool)) #:store store))
  (define caps (hasheq 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
  (define (call method params)
    (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps))))
  (define (request-with-timeout method params)
    (define answers (make-async-channel))
    (parameterize ([current-custodian (runtime-custodian rt)])
      (thread (lambda () (async-channel-put answers (call method params)))))
    (sync/timeout 2 answers))
  (dynamic-wind void
    (lambda ()
      (define task (call "tools/call" (hasheq 'name "blocked")))
      (define entry (sync/timeout 5 entered))
      (check-not-false entry)
      (unless entry (error 'test "host callback did not start"))
      (check-false (cdr entry))
      (define params (hasheq 'taskId (hash-ref task 'taskId)))
      (define polled (request-with-timeout "tasks/get" params))
      (check-equal? (and polled (hash-ref polled 'status)) "working")
      (when cancel?
        (check-equal? (request-with-timeout "tasks/cancel" params) (hasheq 'resultType "complete")))
      (semaphore-post release)
      (check-not-false (sync/timeout 5 (car entry)))
      (check-equal? calls 1)
      (define final (call "tasks/get" params))
      (check-equal? (hash-ref final 'status) (if cancel? "cancelled" "completed"))
      (define task-row (load-instance store (hash-ref task 'taskId)))
      (define flow (load-instance store (hash-ref (stored-instance-state task-row) 'workflow)))
      (define state (stored-instance-state flow))
      (check-equal? (hash-ref state 'status) (if cancel? "working" "completed"))
      (when cancel?
        (check-equal? (hash-ref state 'position) 0)
        (check-false (hash-has-key? state 'result))
        (check-false (hash-has-key? (hash-ref state 'values) 'start)))
      (unless cancel? (check-equal? (hash-ref final 'result) result))
      (check-equal? (length (list-instances store #:operation "change-outbox"))
                    (if (and (eq? kind 'changes) (not cancel?)) 1 0)))
    (lambda ()
      (custodian-shutdown-all (runtime-custodian rt))
      (close-store! store))))
