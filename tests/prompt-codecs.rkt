#lang racket/base
(require rackunit racket/file mcp)
(define integer-text (make-string-codec "integer-text" "1" Integer number->string string->number))
(define json-text (make-string-codec "json-text" "1" Any json->string string->json))
(define defaults 0)
(define codec-expressions 0)
(prompt (numbers [base Integer #:codec (begin (set! codec-expressions (add1 codec-expressions)) integer-text)]
                 [next Integer #:codec integer-text #:default (begin (set! defaults (add1 defaults)) (add1 base))]
                 [maybe Any #:codec json-text #:optional])
  (role "user" (text-content (format "~s" (list base next (if (missing? maybe) 'absent maybe))))))
(check-equal? codec-expressions 1)
(define rt (make-runtime (make-interface #:prompts (list numbers))))
(define (get args)
  (dispatch rt "prompts/get" (hasheq '_meta (request-meta) 'name "numbers" 'arguments args)))
(check-equal? (hash-ref (get (hasheq 'base "4")) 'messages) (role "user" (text-content "(4 5 absent)")))
(check-equal? defaults 1)
(check-equal? (hash-ref (get (hasheq 'base "4" 'next "8" 'maybe "false")) 'messages) (role "user" (text-content "(4 8 #f)")))
(check-equal? defaults 1)
(check-equal? (encode-prompt-arguments numbers (hasheq 'base 4 'next 8 'maybe #f)) (hasheq 'base "4" 'next "8" 'maybe "false"))
(check-equal? (encode-prompt-arguments numbers (hasheq 'base 4 'maybe json-null)) (hasheq 'base "4" 'maybe "null"))
(check-true (missing? (hash-ref (bind-arguments (prompt-descriptor-arguments numbers) (hasheq 'base "1")) 'maybe)))
(check-equal? (hash-ref (bind-arguments (prompt-descriptor-arguments numbers) (hasheq 'base "1" 'maybe "null")) 'maybe) json-null)
(check-exn exn:fail:mcp? (lambda () (get (hasheq 'base 4))))
(define invalid (dispatch-message rt (hasheq 'jsonrpc "2.0" 'id 1 'method "prompts/get"
                                          'params (hasheq '_meta (request-meta) 'name "numbers" 'arguments (hasheq 'base "bad")))))
(check-equal? (hash-ref (hash-ref invalid 'error) 'code) -32602)
(check-exn exn:fail? (lambda () (encode-string-value (make-string-codec "bad" "1" Integer values string->number) 1)))
(check-exn exn:fail? (lambda () (make-prompt "bad" (list (prompt-argument 'x Integer #f #f #f)) values)))
(prompt (one [n Integer #:codec integer-text]) (role "user" (text-content (number->string n))))
(define dynamic-one (make-prompt "dynamic-one" (list (prompt-argument 'n Integer #f #f integer-text))
                                 (lambda (bound) (role "user" (text-content (number->string (hash-ref bound 'n)))))))
(check-equal? ((prompt-descriptor-handler one) (bind-arguments (prompt-descriptor-arguments one) (hasheq 'n "3")))
              ((prompt-descriptor-handler dynamic-one) (bind-arguments (prompt-descriptor-arguments dynamic-one) (hasheq 'n "3"))))
(check-exn #rx"requires a string codec" (lambda () (make-prompt "bad" (list (argument 'n Integer #f #f)) values)))
(check-exn #rx"duplicate argument" (lambda () (make-prompt "bad" (list (prompt-argument 'n Integer #f #f integer-text) (argument 'n String #f #f)) values)))
(define checkpoints 0)
(prompt (durable [n Integer #:codec integer-text]) #:workflow "1"
  (checkpoint [saved Integer] (begin (set! checkpoints (add1 checkpoints)) (add1 n)))
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
  (role "user" (text-content (number->string saved))))
(define dir (make-temporary-file "mcp-prompt-codecs-~a" 'directory (current-directory)))
(define path (build-path dir "state.sqlite"))
(define store (open-sqlite-store path))
(define durable-runtime (make-runtime (make-interface #:prompts (list durable)) #:store store))
(define params (hasheq '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))) 'name "durable" 'arguments (hasheq 'n "4")))
(define pending (dispatch durable-runtime "prompts/get" params))
(custodian-shutdown-all (runtime-custodian durable-runtime))
(close-store! store)
(set! store (open-sqlite-store path))
(define changed (struct-copy prompt-descriptor durable
                             [arguments (list (prompt-argument 'n Integer #f #f (make-string-codec "integer-text" "2" Integer number->string string->number)))]))
(define changed-runtime (make-runtime (make-interface #:prompts (list changed)) #:store store))
(define retry (hash-set* params 'requestState (hash-ref pending 'requestState) 'inputResponses (hasheq 'answer (hasheq 'action "decline"))))
(check-exn exn:fail:recovery? (lambda () (dispatch changed-runtime "prompts/get" retry)))
(set! durable-runtime (make-runtime (make-interface #:prompts (list durable)) #:store store))
(check-equal? (hash-ref (dispatch durable-runtime "prompts/get" retry) 'messages) (role "user" (text-content "5")))
(check-equal? checkpoints 1)
(custodian-shutdown-all (runtime-custodian changed-runtime))
(custodian-shutdown-all (runtime-custodian durable-runtime))
(custodian-shutdown-all (runtime-custodian rt))
(close-store! store)
(delete-directory/files dir)
