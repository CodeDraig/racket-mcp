#lang racket/base
(require rackunit racket/async-channel mcp mcp/stdio mcp/subscription)
(tool (echo [x String]) (text-result x))
(define rt (make-runtime (make-interface #:tools (list echo))))
(define-values (server-in client-out) (make-pipe))
(define-values (client-in server-out) (make-pipe))
(define server (thread (lambda () (serve-stdio rt #:input server-in #:output server-out))))
(define client (make-stdio-client client-in client-out))
(define handle (client-request client "subscriptions/listen" (hasheq 'notifications (hasheq 'toolsListChanged #t 'promptsListChanged #t))))
(define first (sync/timeout 5 (request-handle-notifications handle)))
(check-not-false first)
(check-equal? (hash-ref first 'method) "notifications/subscriptions/acknowledged")
(check-equal? (hash-ref (hash-ref first 'params) 'notifications) (hasheq 'toolsListChanged #t))
(publish-change! (runtime-subscriptions rt) "notifications/tools/list_changed" (hasheq))
(define next (sync/timeout 5 (request-handle-notifications handle)))
(check-equal? (hash-ref next 'method) "notifications/tools/list_changed")
(request-cancel! handle)
(define closed (sync/timeout 5 handle))
(check-true (exn:fail:request-cancelled? closed))
(define remote (client-request client "subscriptions/listen" (hasheq 'notifications (hasheq 'toolsListChanged #t))))
(check-not-false (sync/timeout 2 (request-handle-notifications remote)))
(close-subscriptions! (runtime-subscriptions rt))
(check-equal? (hash-ref (hash-ref (sync/timeout 2 remote) 'result) 'resultType) "complete")
(close-output-port client-out) (thread-wait server) (close-output-port server-out) (client-close! client)
