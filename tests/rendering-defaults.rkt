#lang racket/base
(require rackunit racket/file mcp)
(define defaults 0)
(define (once)
  (set! defaults (add1 defaults))
  (when (> defaults 1) (error 'default "default evaluated again")) 7)
(define codec (make-string-codec "integer-text" "1" Integer number->string string->number))
(define input (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
(resource (child) #:uri "render-default:///child" #:workflow "1"
  (await-input [answer Any] input) "child")
(prompt (parent-prompt [n Integer #:codec codec #:default (once)])
  (role "user" (text-content (number->string n)) (embed (child))))
(tool (parent-tool [n Integer #:default (once)])
  (hasheq 'resultType "complete" 'content (list (text-content (number->string n)) (embed (child)))))
(resource (parent-resource [n Integer #:default (once)]) #:uri "render-default:///parent"
  #:depends-on (list n)
  (text-presentation (number->string n) (embed (child))))
(workflow (parent-workflow [n Integer #:default (once)]) #:version "1"
  (await-input [gate Any] input)
  (hasheq 'resultType "complete" 'content (list (text-content (number->string n)) (embed (child)))))
(prompt (workflow-prompt [n Integer #:codec codec #:default (once)]) #:workflow "1"
  (await-input [gate Any] input)
  (role "user" (text-content (number->string n)) (embed (child))))
(resource (workflow-resource [n Integer #:default (once)]) #:uri "render-default:///workflow" #:depends-on (list n) #:workflow "1"
  (await-input [gate Any] input)
  (text-presentation (number->string n) (embed (child))))
(define iface (make-interface #:tools (list parent-tool parent-workflow) #:prompts (list parent-prompt workflow-prompt)
                             #:resources (list child parent-resource workflow-resource)))
(for ([method '("tools/call" "prompts/get" "resources/read" "tools/call" "prompts/get" "resources/read")]
      [target (list (hasheq 'name "parent-tool") (hasheq 'name "parent-prompt") (hasheq 'uri "render-default:///parent")
                    (hasheq 'name "parent-workflow") (hasheq 'name "workflow-prompt") (hasheq 'uri "render-default:///workflow"))])
  (test-case (string-append method " restores parent bindings after SQLite restart")
    (set! defaults 0)
    (define directory (make-temporary-file "mcp-render-defaults-~a" 'directory))
    (define path (build-path directory "state.sqlite"))
    (define store (open-sqlite-store path))
    (define rt (make-runtime iface #:store store))
    (define (call params [who "alice"])
      (dispatch rt method (hash-set params '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq)))) #:principal who))
    (dynamic-wind void
      (lambda ()
        (define initial (call target))
        (define waiting
          (if (hash-has-key? (hash-ref initial 'inputRequests) 'gate)
              (call (hash-set* target 'requestState (hash-ref initial 'requestState)
                              'inputResponses (hasheq 'gate (hasheq 'action "decline"))))
              initial))
        (check-equal? defaults 1)
        (define retry (hash-set* target 'requestState (hash-ref waiting 'requestState)
          'inputResponses (hasheq 'e0/r0/answer (hasheq 'action "decline"))))
        (custodian-shutdown-all (runtime-custodian rt)) (close-store! store)
        (set! store (open-sqlite-store path)) (set! rt (make-runtime iface #:store store))
        (define done (call retry))
        (check-equal? (hash-ref done 'resultType) "complete")
        (check-regexp-match #rx"7" (json->string done))
        (check-regexp-match #rx"child" (json->string done))
        (check-exn exn:fail? (lambda () (call retry "bob")))
        (unless (equal? method "resources/read")
          (check-exn exn:fail? (lambda () (call (hash-set retry 'arguments (hasheq 'n (if (equal? method "prompts/get") "8" 8)))))))
        (check-equal? (call retry) done)
        (check-equal? defaults 1))
      (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store) (delete-directory/files directory)))))

(test-case "older render records retain explicit argument compatibility"
  (define store (open-memory-store))
  (define rt (make-runtime iface #:store store))
  (define (call params) (dispatch rt "tools/call" (hash-set params '_meta
    (request-meta #:capabilities (hasheq 'elicitation (hasheq))))))
  (dynamic-wind void
    (lambda ()
      (set! defaults 0)
      (define params (hasheq 'name "parent-tool" 'arguments (hasheq 'n 9)))
      (define waiting (call params))
      (define handle (hash-ref waiting 'requestState))
      (define instance (load-instance store handle))
      (void (update-instance! store instance (hash-remove (stored-instance-state instance) 'bindings)))
      (define done (call (hash-set* params 'requestState handle 'inputResponses (hasheq 'e0/r0/answer (hasheq 'action "decline")))))
      (check-equal? (hash-ref done 'resultType) "complete")
      (check-regexp-match #rx"9" (json->string done))
      (check-equal? defaults 0))
    (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store))))
