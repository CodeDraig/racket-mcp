#lang racket/base
(require net/url)
(provide https-uri! identifier-url! redirect-uri! current-oauth-loopback-http? oauth-secure-url?)
(define current-oauth-loopback-http? (make-parameter #f))
(define (oauth-secure-url? u #:loopback? [loopback? (current-oauth-loopback-http?)])
  (and (url-host u) (not (url-user u)) (not (url-fragment u))
       (or (equal? (url-scheme u) "https")
           (and loopback? (equal? (url-scheme u) "http")
                (member (string-downcase (url-host u)) '("localhost" "127.0.0.1" "::1"))))))

(define (https-uri! value who #:loopback? [loopback? (current-oauth-loopback-http?)])
  (define u (string->url value))
  (unless (oauth-secure-url? u #:loopback? loopback?)
    (error who "expected HTTPS URL without credentials or fragment"))
  value)
(define (identifier-url! identifier who)
  (https-uri! identifier who)
  (define u (string->url identifier))
  (unless (null? (url-query u)) (error who "identifier must not contain a query"))
  u)
(define (redirect-uri! uri)
  (unless (string? uri) (raise-argument-error 'authorization "absolute redirect URI" uri))
  (define u (string->url uri))
  (unless (and (url-scheme u) (not (url-fragment u)) (not (url-user u))
               (cond [(equal? (url-scheme u) "https") (url-host u)]
                     [(equal? (url-scheme u) "http") (member (url-host u) '("127.0.0.1" "::1" "localhost"))]
                     [else #t]))
    (error 'authorization "invalid redirect URI; HTTP redirects require loopback"))
  uri)
