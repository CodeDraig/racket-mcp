#lang racket/base
(require rackunit racket/list racket/file racket/async-channel db mcp mcp/http mcp/authorization)

(define clock (make-manual-clock #:seconds 100))
(check-equal? (clock) 100000)
(parameterize ([current-mcp-clock clock])
  (check-equal? (mcp-current-seconds) 100)
  (check-equal? (manual-clock-advance! clock 1/1000) 100001)
  (check-equal? (mcp-current-seconds) 100))
(for ([bad (list +inf.0 -inf.0 +nan.0 #f 'time)])
  (check-exn exn:fail:contract? (lambda () (make-manual-clock #:seconds bad))))
(for ([bad (list -1 +inf.0 #f)])
  (check-exn exn:fail:contract? (lambda () (manual-clock-advance! clock bad))))
(check-exn exn:fail:contract? (lambda () (current-mcp-clock (lambda (x) x))))
(check-exn exn:fail:contract?
  (lambda () (parameterize ([current-mcp-clock (lambda () +inf.0)]) (mcp-current-seconds))))
(define concurrent (make-manual-clock))
(define workers (for/list ([i (in-range 10)]) (thread (lambda () (for ([j (in-range 100)]) (manual-clock-advance! concurrent 1/1000))))))
(for ([worker workers]) (check-not-false (sync/timeout 5 worker)))
(check-equal? (concurrent) 1000)

(set! clock (make-manual-clock #:seconds 100))
(define reads 0)
(resource (cached) #:uri "clock:///cached" #:ttl-ms 10000
  (set! reads (add1 reads)) (number->string (mcp-current-seconds)))
(define input (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
(resource (child) #:uri "clock:///child" #:workflow "1"
  (await-input [answer Any] input)
  "child")
(prompt (parent) (role "user" (embed (child))))
(tool (time-now) (text-result (number->string (mcp-current-seconds))))
(workflow (timed) #:version "1"
  (await-input [answer Any] input)
  (text-result (number->string (mcp-current-seconds))))
(workflow (timed-task) #:version "1" #:execution task
  (checkpoint [started Number] (mcp-current-seconds))
  (await-input [answer Any] input)
  (text-result (format "~a -> ~a" started (mcp-current-seconds))))
(define recovery-entered (make-semaphore 0))
(define interrupt-once? #t)
(workflow (recover-clock) #:version "1" #:execution task
  (checkpoint [time Number]
    (begin (when interrupt-once?
             (set! interrupt-once? #f)
             (semaphore-post recovery-entered)
             (sync never-evt))
           (mcp-current-seconds)))
  (text-result (number->string time)))
(define iface (make-interface #:tools (list time-now timed timed-task recover-clock) #:resources (list cached child) #:prompts (list parent)))
(define path (make-temporary-file "mcp-clock-~a.sqlite"))
(define store (open-sqlite-store path))
(define rt (make-runtime iface #:store store #:clock clock #:page-size 1 #:cursor-ttl 2))
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define (call method params [principal "alice"])
  ;; Caller time must not override the runtime's selected clock.
  (parameterize ([current-mcp-clock (lambda () 9000000000000)])
    (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps)) #:principal principal)))
(define (poll-task id status)
  (let loop ([tries 100])
    (define value (call "tasks/get" (hasheq 'taskId id)))
    (cond [(equal? (hash-ref value 'status) status) value]
          [(zero? tries) (error 'test "task did not reach ~a: ~s" status value)]
          [else (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 tries))])))
(dynamic-wind void
  (lambda ()
    (check-eq? (runtime-clock rt) clock)
    (check-equal? (hash-ref (call "tools/call" (hasheq 'name "time-now")) 'content) (list (text-content "100")))
    (define waiting (call "tools/call" (hasheq 'name "timed")))
    (define rendering (call "prompts/get" (hasheq 'name "parent")))
    (define task (call "tools/call" (hasheq 'name "timed-task")))
    (define id (hash-ref task 'taskId))
    (define paused (poll-task id "input_required"))
    (check-equal? (hash-ref paused 'createdAt) "1970-01-01T00:01:40Z")
    (check-equal? (hash-ref paused 'lastUpdatedAt) "1970-01-01T00:01:40Z")
    (check-equal? (stored-instance-expires (load-instance store id)) 86500)
    (check-equal? (stored-instance-expires (load-instance store (hash-ref rendering 'requestState))) 86500)
    (check-equal? (hash-ref (call "resources/read" (hasheq 'uri "clock:///cached")) 'ttlMs) 10000)
    (define cursor (hash-ref (call "tools/list" (hasheq)) 'nextCursor))
    (check-equal? (remove-duplicates (query-list (state-store-connection store) "SELECT recorded FROM journal")) '(100))
    (void (manual-clock-advance! clock 1))
    (check-equal? (hash-ref (call "resources/read" (hasheq 'uri "clock:///cached")) 'ttlMs) 9000)
    (check-equal? reads 1)
    (check-true (hash? (call "tools/list" (hasheq 'cursor cursor))))
    ;; HTTP authentication and request workers also use the runtime clock.
    (define confirmation (make-async-channel))
    (define principal (verified-principal "alice" "https://issuer.example" "https://api.example/mcp" '() 102))
    (define authenticator
      (make-bearer-authenticator (lambda (_) principal) #:issuer "https://issuer.example" #:audience "https://api.example/mcp"))
    (define stop (serve-http rt #:port 0 #:confirmation confirmation #:authenticate authenticator
                 #:resource-metadata (protected-resource-metadata "https://api.example/mcp" '("https://issuer.example"))))
    (dynamic-wind void
      (lambda ()
        (define port (sync/timeout 5 confirmation))
        (when (exn? port) (raise port))
        (check-true (exact-positive-integer? port))
        (define client (make-http-client (format "http://127.0.0.1:~a/mcp" port) #:token "token"))
        (check-equal? (hash-ref (hash-ref (http-client-call client "tools/call" (hasheq 'name "time-now")) 'result) 'content) (list (text-content "101")))
        (void (manual-clock-advance! clock 1))
        (check-exn exn:fail:http:authorization? (lambda () (http-client-call client "tools/call" (hasheq 'name "time-now")))))
      stop)
    (check-exn exn:fail:mcp? (lambda () (call "tools/list" (hasheq 'cursor cursor))))
    (check-exn exn:fail:mcp? (lambda () (call "tools/call" (hasheq 'name "time-now") principal)))
    (define interrupted (call "tools/call" (hasheq 'name "recover-clock")))
    (check-not-false (sync/timeout 5 recovery-entered))
    ;; Resume using new runtime/store objects, with the same explicit clock.
    (custodian-shutdown-all (runtime-custodian rt))
    (close-store! store)
    (set! store (open-sqlite-store path))
    (set! rt (make-runtime iface #:store store #:clock clock))
    (define recovered (poll-task (hash-ref interrupted 'taskId) "completed"))
    (check-equal? (hash-ref recovered 'lastUpdatedAt) "1970-01-01T00:01:42Z")
    (check-equal? (hash-ref (hash-ref recovered 'result) 'content) (list (text-content "102")))
    (check-equal? (hash-ref (call "tasks/get" (hasheq 'taskId id)) 'createdAt) "1970-01-01T00:01:40Z")
    (void (call "tasks/update" (hasheq 'taskId id 'inputResponses (hasheq 'answer (hasheq 'action "decline")))))
    (define completed (poll-task id "completed"))
    (check-equal? (hash-ref completed 'lastUpdatedAt) "1970-01-01T00:01:42Z")
    (check-equal? (hash-ref (hash-ref completed 'result) 'content) (list (text-content "100 -> 102")))
    (check-not-false (member 102 (query-list (state-store-connection store) "SELECT recorded FROM journal")))
    (parameterize ([current-mcp-clock clock])
      (define outbox (record-committed-change! store "alice" '("changed")))
      (check-equal? (stored-instance-expires outbox) (+ 102 31536000)))
    (void (manual-clock-advance! clock 86400))
    (check-exn exn:fail:mcp? (lambda () (call "tasks/get" (hasheq 'taskId id))))
    (check-exn exn:fail? (lambda () (call "tools/call" (hasheq 'name "timed" 'requestState (hash-ref waiting 'requestState)))))
    (check-exn exn:fail:mcp? (lambda () (call "prompts/get" (hasheq 'name "parent" 'requestState (hash-ref rendering 'requestState))))))
  (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store) (delete-file path)))
