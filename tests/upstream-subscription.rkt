#lang racket/base
(require rackunit racket/async-channel mcp mcp/upstream mcp/upstream-subscription mcp/scenario mcp/stdio mcp/subscription)
(for ([transport '(local stdio http)])
  (define version "old")
  (define resource (make-resource "document" "remote:///{id}" (lambda (_) version)
    #:arguments (list (argument 'id String #f #f)) #:depends-on (lambda (_) '("changed"))))
  (call-with-scenario-session (make-interface #:resources (list resource))
    (lambda (upstream)
      (define listens 0)
      (define (request method params)
        (when (equal? method "subscriptions/listen") (set! listens (add1 listens)))
        (scenario-request upstream method params))
      (define snapshot (capture-snapshot (lambda (method params) (scenario-call upstream method params))))
      (define source (make-upstream-interface snapshot (lambda (method params) (scenario-call upstream method params))))
      (define mounted (view source #:uris (hash "remote:///{id}" "local:///{id}")))
      (call-with-scenario-session mounted
        (lambda (local)
          (define listener (scenario-request local "subscriptions/listen"
            (hasheq 'notifications (hasheq 'resourceSubscriptions '("local:///doc")))))
          (check-equal? (hash-ref (sync/timeout 2 (request-handle-notifications listener)) 'method)
                        "notifications/subscriptions/acknowledged")
          (define retained #f)
          (define terminal
            (call-with-upstream-resource-subscription (scenario-session-runtime local) source snapshot request
              '("remote:///doc" "remote:///doc")
              (lambda (subscription)
                (set! retained subscription)
                (check-equal? (upstream-resource-subscription-accepted subscription) '("remote:///doc"))
                (set! version "new")
                (runtime-report-change! (scenario-session-runtime upstream) "remote-owner" '("changed"))
                (define notification (sync/timeout 2 (request-handle-notifications listener)))
                (check-equal? (hash-ref notification 'method) "notifications/resources/updated")
                (check-equal? (hash-ref (hash-ref notification 'params) 'uri) "local:///doc")
                (check-equal? (hash-ref (hash-ref (hash-ref notification 'params) '_meta) 'io.modelcontextprotocol/subscriptionId)
                              (request-handle-id listener))
                (define read (hash-ref (scenario-call local "resources/read" (hasheq 'uri "local:///doc")) 'result))
                (check-equal? (hash-ref (car (hash-ref read 'contents)) 'text) "new")
                (close-subscriptions! (runtime-subscriptions (scenario-session-runtime upstream)))
                (sync/timeout 2 subscription))
              #:principal "local-owner" #:timeout 2))
          (check-equal? (hash-ref (hash-ref terminal 'result) 'resultType) "complete")
          (check-eq? (sync/timeout 0 retained) terminal)
          (check-equal? listens 1)
          (unless (eq? transport 'local)
            (define lost
              (call-with-upstream-resource-subscription (scenario-session-runtime local) source snapshot request '("remote:///doc")
                (lambda (subscription)
                  (scenario-disconnect! upstream)
                  (sync/timeout 2 subscription))
                #:principal "local-owner" #:timeout 2))
            (check-true (exn? lost))
            (check-false (exn:fail:request-cancelled? lost))
            (check-equal? listens 2)
            (scenario-reconnect! upstream)
            (check-equal? listens 2))
          ;; The forwarding scope owns its upstream request, not local listeners.
          (check-false (sync/timeout 0 listener))
          (request-cancel! listener))
        #:transport transport #:principal "local-owner"))
    #:transport transport #:principal "remote-owner"))

;; Deterministic protocol-ordering and failure fixtures use ordinary request handles.
(define resource (make-resource "document" "remote:///doc" (lambda () "data")))
(define remote (make-runtime (make-interface #:resources
  (list resource (make-resource "other" "remote:///other" (lambda () "other"))))))
(define snapshot (capture-snapshot (lambda (m p) (dispatch remote m (hash-set p '_meta (request-meta))))))
(define source (make-upstream-interface snapshot (lambda (_m _p) (error 'test "unexpected resource read"))))
(define local (make-runtime source))
(define id 77)
(define (params fields [tag id]) (hash-set fields '_meta (hasheq 'io.modelcontextprotocol/subscriptionId tag)))
(define (notice method fields [tag id]) (hasheq 'jsonrpc "2.0" 'method method 'params (params fields tag)))
(define ack (notice "notifications/subscriptions/acknowledged" (hasheq 'notifications (hasheq 'resourceSubscriptions '("remote:///doc")))))
(define update (notice "notifications/resources/updated" (hasheq 'uri "remote:///doc")))
(define complete (hasheq 'jsonrpc "2.0" 'id id 'result (params (hasheq 'resultType "complete"))))
(define (exercise messages outcome proc #:timeout [timeout 1] #:uris [uris '("remote:///doc")]
                  #:runtime [target local] #:queue-observer [observe-queue void])
  (define cancellations 0)
  (define ready (make-semaphore 0))
  (define result (box outcome))
  (define queue (make-async-channel))
  (for ([message (in-list messages)]) (async-channel-put queue message))
  (observe-queue queue)
  (when outcome (semaphore-post ready))
  (define peer (request-handle id ready result
    (lambda ()
      (set! cancellations (add1 cancellations))
      (unless (sync/timeout 0 (semaphore-peek-evt ready))
        (set-box! result (exn:fail:request-cancelled "fixture cancellation" (current-continuation-marks) id))
        (semaphore-post ready))) queue))
  (define (request method arguments)
    (if (equal? method "subscriptions/listen") peer
        (request-handle 1 (make-semaphore 1)
          (box (hasheq 'result (hash-ref snapshot (string->symbol method)))) void (make-async-channel))))
  (define returned (call-with-upstream-resource-subscription target source snapshot request uris proc
                     #:principal "owner" #:timeout timeout))
  (check-true (> cancellations 0))
  returned)
(dynamic-wind void
  (lambda ()
    ;; Stop while one forwarding pass is in flight, with another notice queued.
    (define entered (make-semaphore 0))
    (define release (make-semaphore 0))
    (define passes 0)
    (define original (car (interface-descriptor-resources source)))
    (define guarded
      (struct-copy resource-descriptor original
        [depends-on
         (lambda (arguments)
           (set! passes (add1 passes))
           (when (= passes 1) (semaphore-post entered) (semaphore-wait release))
           ((resource-descriptor-depends-on original) arguments))]))
    (call-with-scenario-session (make-interface #:resources (list guarded))
      (lambda (session)
        (define listener (scenario-request session "subscriptions/listen"
          (hasheq 'notifications (hasheq 'resourceSubscriptions '("remote:///doc")))))
        (define local-notices (request-handle-notifications listener))
        (check-equal? (hash-ref (sync/timeout 2 local-notices) 'method) "notifications/subscriptions/acknowledged")
        (define peer-notices #f)
        (define stopped
          (exercise (list ack) #f
            (lambda (subscription)
              (async-channel-put peer-notices update)
              (check-not-false (sync/timeout 2 entered))
              (async-channel-put peer-notices update)
              (stop-upstream-resource-subscription! subscription)
              (semaphore-post release)
              (sync/timeout 2 subscription))
            #:runtime (scenario-session-runtime session)
            #:queue-observer (lambda (queue) (set! peer-notices queue))))
        (check-true (exn:fail:request-cancelled? stopped))
        (check-equal? passes 1)
        (check-equal? (hash-ref (sync/timeout 2 local-notices) 'method) "notifications/resources/updated")
        (check-false (sync/timeout 0 local-notices))
        (request-cancel! listener))
      #:principal "owner")
    (define opened? #f)
    (define mismatched (hash-set snapshot 'server/discover
      (hash-set (hash-ref snapshot 'server/discover) 'supportedVersions '("different"))))
    (check-exn #rx"pinned discovery changed"
      (lambda ()
        (call-with-upstream-resource-subscription local source mismatched
          (lambda (method _arguments)
            (when (equal? method "subscriptions/listen") (set! opened? #t))
            (request-handle 1 (make-semaphore 1)
              (box (hasheq 'result (hash-ref snapshot (string->symbol method)))) void (make-async-channel)))
          '("remote:///doc") void #:principal "owner")))
    (check-false opened?)
    (define cancelled 0)
    (check-exn #rx"snapshot request timed out"
      (lambda ()
        (call-with-upstream-resource-subscription local source snapshot
          (lambda (_method _arguments)
            (request-handle 1 (make-semaphore 0) (box #f)
              (lambda () (set! cancelled (add1 cancelled))) (make-async-channel)))
          '("remote:///doc") void #:principal "owner" #:timeout 0.02)))
    (check-equal? cancelled 1)
    ;; Queued acknowledgement/change precede an already-ready terminal result.
    (check-equal? (exercise (list ack update) complete (lambda (s) (sync/timeout 2 s))) complete)
    ;; Acceptance is a subset, not an echo of everything originally requested.
    (define requested '("remote:///doc" "remote:///other"))
    (check-equal?
      (exercise (list ack update) complete
        (lambda (s)
          (check-equal? (upstream-resource-subscription-accepted s) '("remote:///doc"))
          (sync/timeout 2 s)) #:uris requested)
      complete)
    (define unaccepted (notice "notifications/resources/updated" (hasheq 'uri "remote:///other")))
    (define other-keys (upstream-resource-change-keys source "remote:///other"))
    (define loads 0)
    (define (cached-other)
      (cache-ref! (runtime-cache local) "owner" "other-probe" other-keys 60000
        (lambda () (set! loads (add1 loads)) "retained")))
    (check-equal? (cached-other) "retained")
    (define rejected (exercise (list ack unaccepted) #f (lambda (s) (sync/timeout 2 s)) #:uris requested))
    (check-true (exn:fail? rejected))
    (check-regexp-match #rx"unaccepted resource change" (exn-message rejected))
    (check-equal? (cached-other) "retained")
    (check-equal? loads 1)
    ;; The probe actually participates in the same invalidation path.
    (check-equal? (runtime-report-change! local "owner" other-keys) '("other-probe"))
    (check-equal? (cached-other) "retained")
    (check-equal? loads 2)
    (for ([filter (list (hasheq) (hasheq 'resourceSubscriptions '()))])
      (define empty-ack (notice "notifications/subscriptions/acknowledged" (hasheq 'notifications filter)))
      (check-equal?
        (exercise (list empty-ack) complete
          (lambda (s)
            (check-equal? (upstream-resource-subscription-accepted s) '())
            (sync/timeout 2 s)) #:uris requested)
        complete)
      (check-true (exn:fail? (exercise (list empty-ack update) #f (lambda (s) (sync/timeout 2 s)) #:uris requested))))
    (for ([bad (list update
                    (notice "notifications/subscriptions/acknowledged" (hasheq 'notifications (hasheq)) 999)
                    (notice "notifications/subscriptions/acknowledged" (hasheq 'notifications (hasheq 'resourceSubscriptions '("foreign:///doc")))) )])
      (define ran? #f)
      (check-exn #rx"expected acknowledgement|incorrect subscription ID|unrequested filter"
        (lambda () (exercise (list bad) #f (lambda (_) (set! ran? #t)))))
      (check-false ran?))
    (for ([bad (list (notice "notifications/resources/updated" (hasheq 'uri "foreign:///doc"))
                    (notice "notifications/resources/updated" (hasheq 'uri "remote:///doc") 999)
                    ack)])
      (check-true (exn? (exercise (list ack bad) #f (lambda (s) (sync/timeout 2 s))))))
    (check-true (exn? (exercise (list ack) (hasheq 'result (hasheq 'resultType "task")) (lambda (s) (sync/timeout 2 s)))))
    (check-exn #rx"acknowledgement timed out" (lambda () (exercise '() #f void #:timeout 0.02)))
    (define stopped #f)
    (check-true (exn:fail:request-cancelled?
      (exercise (list ack) #f (lambda (s) (set! stopped s) (stop-upstream-resource-subscription! s) (sync/timeout 2 s)))))
    (check-true (exn:fail:request-cancelled? (sync/timeout 0 stopped)))
    (define escaped #f)
    (check-false
      (with-handlers ([(lambda (_) #t) values])
        (exercise (list ack) #f (lambda (s) (set! escaped s) (raise #f)))))
    (check-true (exn:fail:request-cancelled? (sync/timeout 0 escaped))))
  (lambda () (custodian-shutdown-all (runtime-custodian local)) (custodian-shutdown-all (runtime-custodian remote))))
