#lang racket/base
(require rackunit mcp/schema)

;; Authored boundary cases complement the pinned optional suite. Apply every
;; expectation to both pattern keywords so object-key matching cannot diverge.
(define cases
  (list
   (list "^\\\\t$" "\\t" #t) (list "^\\\\t$" "\t" #f)
   (list "^\\{Letter\\}$" "{Letter}" #t) (list "^\\{Letter\\}$" "{L}" #f)
   (list "^\\\\u0041$" "\\u0041" #t) (list "^\\\\u0041$" "A" #f)
   (list "^\\.$" "." #t) (list "^\\.$" "\n" #f)
   (list "^.$" "\n" #f) (list "^.$" "\r" #f)
   (list "^.$" "\u2028" #f) (list "^.$" "\u2029" #f) (list "^.$" "\u000b" #t)
   (list "^abc$" "abc\n" #f)
   (list "^[^#]*$" "https://example.test/schema#fragment" #f)
   (list "^[^#]*$" "" #t) (list "^[^#]*$" "#" #f)
   (list "^[^#]+$" "abc" #t) (list "^[^#]+$" "a#b" #f)
   (list "^.*$" "a\nb" #f) (list "^.*$" "" #t)
   (list "^\\S+$" "a b" #f) (list "^\\S+$" "abc" #t)
   (list "^\\S?$" "" #t) (list "^\\S{2}$" "a " #f)
   (list "^[\\s\\S]$" "\n" #t) (list "^[\\s\\S]$" "🐲" #t)
   (list "^[^\\s]$" "\u00a0" #f) (list "^[^\\s]$" "x" #t)
   (list "^[a\\S]$" "\ufeff" #f) (list "^[a\\S]$" "a" #t)
   (list "^[\\S]$" "\u2003" #f) (list "^[\\S]$" "b" #t)
   (list "^[\\cA-\\cC]$" "\u0002" #t)
   (list "^[\\b]$" "\b" #t) (list "^[\\b]$" "b" #f)
   (list "^\\0$" "\u0000" #t)
   (list "^\\u0041$" "A" #t) (list "^\\x41$" "A" #t)
   (list "^[\\u0061-\\u007a]+$" "abcz" #t) (list "^[\\u0061-\\u007a]+$" "A" #f)
   (list "^\\u{1F432}+$" "🐲🐲" #t) (list "^\\uD83D\\uDC32+$" "🐲🐲" #t)
   (list "[]" "" #f) (list "[]" "x" #f) (list "^[^]$" "\n" #t)
   (list "^[]*$" "" #t) (list "^[]*$" "x" #f)
   (list "^[]+$" "" #f) (list "^[]+$" "x" #f)
   (list "^[]?$" "" #t) (list "^[]?$" "x" #f)
   (list "^[]{0}$" "" #t) (list "^[]{0}$" "x" #f)
   (list "^[[]$" "[" #t)
   (list "^\\P{Letter}$" "1" #t)
   (list "^[\\p{Letter}]$" "é" #t) (list "^[\\P{Letter}]$" "1" #t)
   (list "^[^\\p{Letter}]$" "é" #f) (list "^[^\\p{Letter}]$" "\uff40" #t)
   (list "^[\uff00-\uffff]$" "\uff40" #t) (list "^[\uff00-\uffff]$" "\ufeff" #f)
   (list "^[^\ufeff]$" "\uff40" #t) (list "^[^\ufeff]$" "\ufeff" #f)
   (list "^.$" "\uff40" #t) (list "^.$" "🐲" #t)
   (list "^\\s$" "\u0085" #f) (list "^\\S$" "\u0085" #t)
   (list "^\\s$" "\u200b" #f) (list "^\\S$" "\u200b" #t)
   (list "^[α-ω]$" "ρ" #t) (list "^[α-ω]$" "Ω" #f)
   (list "^[a\\-z]$" "-" #t) (list "^[a\\-z]$" "m" #f)
   (list "^[-az]$" "-" #t) (list "^[a-z-]$" "-" #t) (list "^[a-]$" "-" #t)
   (list "^\\babc\\b$" "abc" #t) (list "^\\Babc$" "abc" #f)
   (list "\\b" "é" #f) (list "\\ba" "éa" #t)
   (list "^a{2,3}$" "aaa" #t) (list "^a{2,3}$" "a" #f)
   (list "^\\(\\?i\\)$" "(?i)" #t)))
(for ([test (in-list cases)])
  (define pattern (car test))
  (define value (cadr test))
  (define expected (caddr test))
  (check-equal? (valid? (hasheq 'pattern pattern) value) expected (format "pattern ~s / ~s" pattern value))
  (check-equal? (valid? (hasheq 'patternProperties (hash (string->symbol pattern) #t) 'additionalProperties #f)
                       (hash (string->symbol value) 0))
                expected (format "patternProperties ~s / ~s" pattern value)))

(for ([pattern '("\\1" "(?i:abc)" "(?>abc)" "\\c" "\\xZZ" "\\u{}" "\\uD800"
                 "\\uD83D\\u0041" "\\u{110000}" "\\01" "[[:alpha:]]" "\\p{Script=Greek}"
                 "{Letter}" "x}" "a{,3}" "[\\d-a]" "[a-\\s]" "[z-a]")])
  (check-exn exn:fail? (lambda () (valid? (hasheq 'pattern pattern) "x")) pattern))
