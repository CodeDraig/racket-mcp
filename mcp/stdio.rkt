#lang racket/base
(require racket/async-channel racket/port "json.rkt" "runtime.rkt" "subscription.rkt")
(provide serve-stdio make-stdio-client client-request client-call client-close!
         (struct-out request-handle) request-cancel!)
(struct request-handle (id ready result cancel notifications) #:transparent
  #:property prop:evt (lambda (self) (wrap-evt (semaphore-peek-evt (request-handle-ready self))
                                             (lambda (_) (unbox (request-handle-result self))))))
(define (request-cancel! handle) ((request-handle-cancel handle)))
(define (serve-stdio rt #:input [in (current-input-port)] #:output [out (current-output-port)] #:workers [limit 32])
  (define lock (make-semaphore 1))
  (define slots (make-semaphore limit))
  (define running (make-hash))
  (define guard (make-semaphore 1))
  (define owner (make-custodian))
  (define (send message) (when message (call-with-semaphore lock (lambda () (write-json message out) (newline out) (flush-output out)))))
  (define (reject id code message)
    (send (hash-set (hasheq 'jsonrpc "2.0" 'error (hasheq 'code code 'message message)) 'id id)))
  (define (cancel! id)
    (define entry (call-with-semaphore guard (lambda () (hash-ref running id #f))))
    (when entry
      (semaphore-post (vector-ref entry 1))
      (parameterize ([current-custodian owner])
        (thread (lambda () (sync (alarm-evt (+ (current-inexact-milliseconds) 200))) (custodian-shutdown-all (vector-ref entry 0)))))))
  (dynamic-wind void
    (lambda ()
      (let loop ()
        (define line (read-json-line in))
        (unless (eof-object? line)
          (define message (with-handlers ([exn:fail? (lambda (_) (send (hasheq 'jsonrpc "2.0" 'error (hasheq 'code -32700 'message "Parse error"))) #f)]) (string->json line)))
          (when message
            (define id (and (hash? message) (hash-ref message 'id missing)))
            (cond
              [(and (hash? message) (equal? (hash-ref message 'method #f) "notifications/cancelled") (missing? id))
               (define params (hash-ref message 'params (hasheq))) (when (hash? params) (cancel! (hash-ref params 'requestId #f)))]
              [(missing? id) (dispatch-message rt message)]
              [(not (semaphore-try-wait? slots)) (reject id -32000 "Concurrent request limit exceeded")]
              [else
               (define child (make-custodian owner))
               (define cancelled (make-semaphore 0))
               (define entry (vector child cancelled #f))
               (define responded? (box #f))
               (define duplicate? (call-with-semaphore guard (lambda () (if (hash-has-key? running id) #t (begin (hash-set! running id entry) #f)))))
               (if duplicate? (begin (reject id -32600 "Duplicate active request ID") (semaphore-post slots) (custodian-shutdown-all child))
                   (let ([worker
                          (parameterize ([current-custodian child])
                            (thread (lambda ()
                              (parameterize ([current-output-port (current-error-port)]
                                             [current-cancellation-event (semaphore-peek-evt cancelled)]
                                             [current-cancelled? (lambda () (and (sync/timeout 0 (semaphore-peek-evt cancelled)) #t))])
                                (define result (dispatch-message rt message #:notify send))
                                (when (or (not ((current-cancelled?))) (equal? (hash-ref message 'method #f) "subscriptions/listen"))
                                  (send result) (set-box! responded? #t))))))])
                     (vector-set! entry 2 worker)
                     (parameterize ([current-custodian owner])
                       (thread (lambda ()
                         (thread-wait worker)
                         (when (and (sync/timeout 0 (semaphore-peek-evt cancelled)) (not (unbox responded?)))
                           (send (hasheq 'jsonrpc "2.0" 'method "notifications/cancelled" 'params (hasheq 'requestId id))))
                         (call-with-semaphore guard (lambda () (hash-remove! running id)))
                         (semaphore-post slots)
                         (custodian-shutdown-all child))))))]))
          (loop)))
      (close-subscriptions! (runtime-subscriptions rt))
      (define active (call-with-semaphore guard (lambda () (hash-values running))))
      (for ([entry (in-list active)]) (when (thread? (vector-ref entry 2)) (thread-wait (vector-ref entry 2)))))
    (lambda () (custodian-shutdown-all owner))))
(struct stdio-client (in out pending lock reader next-id closed?) #:mutable)
(define (make-stdio-client in out)
  (define c (stdio-client in out (make-hash) (make-semaphore 1) #f 0 #f))
  (set-stdio-client-reader! c
    (thread (lambda ()
              (with-handlers ([exn:fail? (lambda (e) (client-close! c e))])
                (let loop ()
                  (define line (read-json-line in))
                  (if (eof-object? line) (client-close! c (exn:fail "Transport closed" (current-continuation-marks)))
                      (let* ([m (string->json line)] [id (hash-ref m 'id missing)])
                        (call-with-semaphore (stdio-client-lock c)
                          (lambda () (define handle (hash-ref (stdio-client-pending c) id #f))
                            (cond [handle (hash-remove! (stdio-client-pending c) id)
                                          (set-box! (request-handle-result handle) m) (semaphore-post (request-handle-ready handle))]
                                  [(hash-has-key? m 'method)
                                   (define params (hash-ref m 'params (hasheq)))
                                   (define subscription-id (hash-ref (hash-ref params '_meta (hasheq)) 'io.modelcontextprotocol/subscriptionId (hash-ref params 'requestId missing)))
                                   (define target (hash-ref (stdio-client-pending c) subscription-id #f))
                                   (when target
                                     (if (equal? (hash-ref m 'method) "notifications/cancelled")
                                         (begin (hash-remove! (stdio-client-pending c) subscription-id) (set-box! (request-handle-result target) m) (semaphore-post (request-handle-ready target)))
                                         (unless (sync/timeout 0 (async-channel-put-evt (request-handle-notifications target) m))
                                           (error 'client "notification queue overflow; re-listen and refresh"))))])) )
                        (loop)))))))) c)
(define (client-send! c value) (write-json value (stdio-client-out c)) (newline (stdio-client-out c)) (flush-output (stdio-client-out c)))
(define (client-request c method [params (hasheq)] #:capabilities [caps (hasheq)])
  (call-with-semaphore (stdio-client-lock c)
    (lambda ()
      (when (stdio-client-closed? c) (error 'client-request "client is closed"))
      (define id (add1 (stdio-client-next-id c))) (set-stdio-client-next-id! c id)
      (define handle (request-handle id (make-semaphore 0) (box #f)
                                    (lambda () (call-with-semaphore (stdio-client-lock c)
                                                 (lambda () (client-send! c (hasheq 'jsonrpc "2.0" 'method "notifications/cancelled" 'params (hasheq 'requestId id))))))
                                    (make-async-channel 64)))
      (hash-set! (stdio-client-pending c) id handle)
      (client-send! c (hasheq 'jsonrpc "2.0" 'id id 'method method 'params (hash-set params '_meta (request-meta #:capabilities caps #:extra (hash-ref params '_meta (hasheq)))))) handle)))
(define (client-call c method [params (hasheq)] #:capabilities [caps (hasheq)])
  (define result (sync (client-request c method params #:capabilities caps))) (if (exn? result) (raise result) result))
(define (client-close! c [reason (exn:fail "Client closed" (current-continuation-marks))])
  (call-with-semaphore (stdio-client-lock c)
    (lambda () (unless (stdio-client-closed? c)
                 (set-stdio-client-closed?! c #t)
                 (for ([h (in-hash-values (stdio-client-pending c))]) (set-box! (request-handle-result h) reason) (semaphore-post (request-handle-ready h)))
                 (hash-clear! (stdio-client-pending c))))))
