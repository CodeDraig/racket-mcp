#lang racket/base
(require rackunit racket/file racket/async-channel mcp mcp/upstream)
(define bridge (make-upstream-bridge #:identity "peer" #:version "1" #:credential-id (lambda (_) "account")))
(define snapshot (hasheq 'pinned "snapshot"))
(define store (open-memory-store))
(define capabilities (hasheq 'elicitation (hasheq)))
(define calls 0)
(define sentinel (gensym 'network-failure))
(define (lost _method _params) (set! calls (add1 calls)) (raise sentinel))
(define (invoke peer key [token #f] [responses (hasheq)] [credential "account"] [pin snapshot])
  (bridge-upstream-request bridge store pin peer "tools/call" (hasheq 'name "work")
    #:principal "alice" #:credential-id credential #:key key #:state token #:responses responses #:capabilities capabilities))
(dynamic-wind void
  (lambda ()
    (define handle #f)
    (check-exn
     (lambda (e)
       (and (exn:fail:upstream-recovery? e)
            (eq? (exn:fail:upstream-recovery-cause e) sentinel)
            (begin (set! handle (exn:fail:upstream-recovery-handle e)) #t)))
     (lambda () (invoke lost "uncertain")))
    (check-exn exn:fail:upstream-recovery? (lambda () (invoke lost "uncertain")))
    (check-equal? calls 1)
    (check-exn exn:fail:mcp?
      (lambda () (recover-upstream-request! bridge store snapshot handle #:principal "bob" #:credential-id "account" #:action 'retry)))
    (check-exn exn:fail:mcp? (lambda () (invoke lost "uncertain" #f (hasheq) "other-account")))
    (check-exn exn:fail:mcp? (lambda () (invoke lost "uncertain" #f (hasheq) "account" (hasheq 'pinned "changed"))))
    (check-equal? calls 1)
    (define observed (hasheq 'result (text-result "observed completion")))
    (check-equal? (recover-upstream-request! bridge store snapshot handle #:principal "alice" #:credential-id "account"
                                            #:action 'outcome #:outcome observed) observed)
    (check-equal? (invoke lost "uncertain") observed)
    (check-equal? calls 1)
    (check-exn exn:fail? (lambda () (recover-upstream-request! bridge store snapshot handle #:principal "alice" #:credential-id "account" #:action 'retry)))
    (define retry-handle #f)
    (check-exn (lambda (e) (and (exn:fail:upstream-recovery? e)
                              (begin (set! retry-handle (exn:fail:upstream-recovery-handle e)) #t)))
               (lambda () (invoke lost "retry")))
    (define authorization (recover-upstream-request! bridge store snapshot retry-handle #:principal "alice" #:credential-id "account" #:action 'retry))
    (define good-calls 0)
    (define (good _m _p) (set! good-calls (add1 good-calls)) (text-result "retried"))
    (define retried (invoke good "retry" (hash-ref (hash-ref authorization 'result) 'requestState)))
    (check-equal? retried (hasheq 'result (text-result "retried")))
    (check-equal? (invoke good "retry") retried)
    (check-equal? good-calls 1)
    (check-true (for/or ([event (in-list (instance-events store retry-handle))])
                  (equal? (hash-ref event 'kind #f) "upstream-recovery"))))
  (lambda () (close-store! store)))
