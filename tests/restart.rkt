#lang racket/base
(require rackunit racket/file racket/port racket/runtime-path racket/string mcp)
(define-runtime-path worker "restart-worker.rkt")
(define dir (make-temporary-file "mcp-restart-~a" 'directory (current-directory)))
(define db (build-path dir "state.sqlite"))
(define marker (build-path dir "mutation.txt"))
(define (run)
  (define-values (process out in err) (subprocess #f #f #f (find-executable-path "racket") worker db marker))
  (close-output-port in)
  (define stdout (port->string out)) (define stderr (port->string err))
  (subprocess-wait process) (close-input-port out) (close-input-port err)
  (values (subprocess-status process) stdout stderr))
(dynamic-wind void
  (lambda ()
    (define-values (first first-out first-err) (run))
    (check-equal? first 9 first-err)
    (define-values (second handle second-err) (run))
    (check-equal? second 8 second-err)
    (check-equal? (file->lines marker) '("mutation"))
    (define store (open-sqlite-store db))
    (define id (string-trim handle))
    (check-equal? (hash-ref (hash-ref (stored-instance-state (load-instance store id)) 'values) 'saved) 42)
    (void (recover-workflow! store id 'mutation 'outcome #:principal "alice" #:outcome 7))
    (close-store! store)
    (define-values (third result third-err) (run))
    (check-equal? third 0 third-err)
    (check-equal? (hash-ref (hash-ref (string->json result) 'structuredContent) 'mutation) 7)
    (check-equal? (file->lines marker) '("mutation")))
  (lambda () (delete-directory/files dir)))
