#lang racket/base
(require racket/file racket/port racket/path file/sha1 rackunit)
(current-check-handler (lambda (failure) (raise failure)))
(define dir (make-temporary-file "mcp-stamp-loading-~a" 'directory))
(define source (build-path dir "application.rkt"))
(define artifact (build-path dir "compiled" "application_rkt.zo"))
(define (write-build value)
  (display-to-file "#lang racket/base\n" source #:exists 'truncate)
  (parameterize ([current-namespace (make-base-namespace)])
    (define code (compile `(module application racket/base (provide value) (define value ,value))))
    (define digest (bytes->hex-string (sha256-bytes (open-input-bytes (call-with-output-bytes (lambda (out) (write code out)))))))
    (define metadata (module-compiled-name (compile `(module mcp-executable racket/base
      (provide identity) (define identity ,digest))) '(application mcp-executable)))
    (define stamped (module-compiled-submodules code #t (list metadata)))
    (make-directory* (path-only artifact))
    (call-with-output-file artifact (lambda (out) (write stamped out)) #:exists 'truncate)
    digest))
(dynamic-wind void
  (lambda ()
    (define old (write-build "old"))
    (parameterize ([current-namespace (make-base-namespace)])
      (check-equal? (dynamic-require source 'value) "old")
      (printf "metadata already declared: ~a\n" (module-declared? `(submod ,source mcp-executable) #f))
      (define newer (write-build "new"))
      (check-not-equal? old newer)
      (define read-id (dynamic-require `(submod ,source mcp-executable) 'identity))
      (printf "read old identity: ~a; read new identity: ~a\n" (equal? read-id old) (equal? read-id newer))
      (check-equal? read-id old)))
  (lambda () (delete-directory/files dir)))
