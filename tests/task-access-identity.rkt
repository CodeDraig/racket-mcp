#lang racket/base
(require racket/list db mcp mcp/tasks "private/review-support.rkt")
(start-evidence! "g4-g5")
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define meta (request-meta #:capabilities caps))
(define form (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
(test-case "CD23 ownership must precede policy callbacks containing saved arguments"
  (workflow (private-job [secret String]) #:version "1" #:execution task
    (await-input [answer Any] form) (text-result "done"))
  (define callbacks '())
  (define deny-bob? #f)
  (define store (open-memory-store))
  (define rt (make-runtime (make-interface #:tools (list private-job)) #:store store
    #:authorize (lambda (who method params)
      (when (equal? method "tools/call")
        (set! callbacks (cons (hasheq 'principal who 'params params) callbacks)))
      (not (and deny-bob? (equal? who "bob") (equal? method "tools/call"))))))
  (define (call method params who)
    (dispatch rt method (hash-set params '_meta meta) #:principal who))
  (dynamic-wind void
    (lambda ()
      (define id (hash-ref (call "tools/call" (hasheq 'name "private-job" 'arguments (hasheq 'secret "DUMMY-PRIVATE-ARGUMENT")) "alice") 'taskId))
      (check-equal? (hash-ref (settled store id) 'status) "input_required")
      (define before (load-instance store id))
      (set! callbacks '())
      (define foreign-get (attempt (lambda () (call "tasks/get" (hasheq 'taskId id) "bob"))))
      (define foreign-update (attempt (lambda () (call "tasks/update" (hasheq 'taskId id 'inputResponses (hasheq 'answer (hasheq 'action "decline"))) "bob"))))
      (define exposed callbacks)
      (set! deny-bob? #t)
      (define denied-update (attempt (lambda () (call "tasks/update" (hasheq 'taskId id) "bob"))))
      (record! "CD23" (hasheq 'foreignGet foreign-get 'foreignUpdate foreign-update 'deniedUpdate denied-update
        'callbacksBeforeOwnership exposed 'recordUnchanged (equal? before (load-instance store id))))
      (check-equal? exposed '())
      (check-equal? (hash-ref denied-update 'code) (hash-ref foreign-get 'code)))
    (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store))))
(test-case "CD26 code incompatibility must not promise uncertain-effect recovery"
  (define flow (make-workflow "identity-job" "1" "flow/1"
    (list (workflow-stage 'answer 'input Any (lambda (_) form) #f #f)
          (workflow-stage 'done 'complete Any (lambda (_) (text-result "done")) #f #f))))
  (define (interface program)
    (make-interface #:tools (list (make-tool "identity-job" '() void #:workflow program #:execution 'task))))
  (define store (open-memory-store))
  (define original (make-runtime (interface flow) #:store store))
  (define changed #f)
  (dynamic-wind void
    (lambda ()
      (define id (hash-ref (dispatch original "tools/call" (hasheq '_meta meta 'name "identity-job") #:principal "alice") 'taskId))
      (check-equal? (hash-ref (settled store id) 'status) "input_required")
      (set! changed (make-runtime (interface (struct-copy workflow-descriptor flow [fingerprint "flow/2"])) #:store store))
      (define update (attempt (lambda () (dispatch changed "tasks/update"
        (hasheq '_meta meta 'taskId id 'inputResponses (hasheq 'answer (hasheq 'action "decline"))) #:principal "alice"))))
      ;; New contract rejects incompatible input before a task transition.
      (check-true (hash-ref update 'raised))
      (define untouched (settled store id))
      (check-equal? (hash-ref untouched 'status) "input_required")
      (resume-task! (struct-copy workflow-descriptor flow [fingerprint "flow/2"]) store id "alice")
      (let loop ([remaining 500])
        (when (and (positive? remaining) (equal? (hash-ref (get-task store id "alice") 'status) "input_required"))
          (sync (alarm-evt (+ (current-inexact-milliseconds) 5))) (loop (sub1 remaining))))
      (define failed (settled store id))
      (define instance (load-instance store id))
      (define retry (attempt (lambda () (retry-runtime-task! original id #:principal "alice" #:capabilities caps))))
      (record! "CD26" (hasheq 'update update 'task failed 'recoveryPayloadPresent (hash-has-key? (stored-instance-state instance) 'recovery) 'retry retry))
      (check-equal? (hash-ref failed 'status) "failed")
      (check-false (regexp-match? #rx"manual recovery" (hash-ref (hash-ref failed 'error) 'message))))
    (lambda () (when changed (custodian-shutdown-all (runtime-custodian changed)))
      (custodian-shutdown-all (runtime-custodian original)) (close-store! store))))
(test-case "CD04 one provenance-deficient non-task row blocks automatic startup recovery"
  (define store (open-memory-store))
  (define row (create-instance! store "alice" "unrelated-history" (hasheq) "1" "history/1" (+ (current-seconds) 60) (hasheq 'status "completed")))
  (query-exec (state-store-connection store) "UPDATE instances SET state_marks=NULL WHERE handle=?" (stored-instance-handle row))
  (define startup (attempt (lambda () (define rt (make-runtime (make-interface) #:store store))
    (custodian-shutdown-all (runtime-custodian rt)) "started")))
  (define bypass (attempt (lambda () (define rt (make-runtime (make-interface) #:store store #:recover-tasks? #f))
    (custodian-shutdown-all (runtime-custodian rt)) "started")))
  (record! "CD04" (hasheq 'startup startup 'bypassRecovery bypass 'rowCount (query-value (state-store-connection store) "SELECT count(*) FROM instances")))
  (check-true (hash-ref startup 'raised))
  (check-regexp-match #rx"provenance" (hash-ref startup 'message))
  (check-false (hash-ref bypass 'raised))
  (close-store! store))
(finish!)
