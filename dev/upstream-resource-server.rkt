#lang racket/base
(require racket/async-channel mcp mcp/scenario mcp/upstream mcp/upstream-subscription mcp/stdio mcp/http)
(module+ main
  (define version 0)
  (define peer-runtime #f)
  (define document (make-resource "document" "remote:///doc"
    (lambda () (number->string version)) #:depends-on (lambda (_) '("document"))))
  (define publish (make-tool "publish" '()
    (lambda (_)
      (set! version (add1 version))
      (runtime-report-change! peer-runtime "remote-owner" '("document"))
      (text-result (number->string version)))))
  (call-with-scenario-session (make-interface #:resources (list document) #:tools (list publish))
    (lambda (peer)
      (set! peer-runtime (scenario-session-runtime peer))
      (define (request method params) (scenario-request peer method params))
      (define (call method params) (scenario-call peer method params))
      (define snapshot (capture-snapshot call))
      (define source (make-upstream-interface snapshot call))
      (define local (make-runtime (view source #:uris (hash "remote:///doc" "local:///doc"))))
      (dynamic-wind void
        (lambda ()
          (call-with-upstream-resource-subscription local source snapshot request '("remote:///doc")
            (lambda (_subscription)
              (if (member "http" (vector->list (current-command-line-arguments)))
                  (let ([confirmation (make-async-channel)])
                    (define stop (serve-http local #:port 0 #:confirmation confirmation #:keepalive-seconds 0.05))
                    (dynamic-wind void
                      (lambda ()
                        (define port (sync confirmation))
                        (when (exn? port) (raise port))
                        (printf "http://127.0.0.1:~a/mcp\n" port)
                        (flush-output)
                        (sync never-evt)) stop))
                  (serve-stdio local)))
            #:principal 'local))
        (lambda () (custodian-shutdown-all (runtime-custodian local)))))
    #:transport 'stdio #:principal "remote-owner"))
