#lang racket/base
(require racket/string racket/random net/base64 net/url "../clock.rkt" "oauth-uri-policy.rkt" "oauth-types.rkt" "principal.rkt")
(provide begin-authorization finish-authorization refresh-credential)
(define (base64url bytes) (string-replace (string-replace (string-trim (bytes->string/utf-8 (base64-encode bytes #"")) "=") "+" "-") "/" "_"))
(define (begin-authorization registration metadata)
  (identifier-url! (oauth-registration-issuer registration) 'begin-authorization)
  (https-uri! (oauth-registration-resource registration) 'begin-authorization)
  (redirect-uri! (oauth-registration-redirect-uri registration))
  (check-scopes! (oauth-registration-scopes registration))
  (unless (and (string? (oauth-registration-client-id registration))
               (positive? (string-length (oauth-registration-client-id registration))))
    (error 'begin-authorization "nonempty client ID is required"))
  (unless (equal? (oauth-registration-issuer registration) (hash-ref metadata 'issuer #f)) (error 'begin-authorization "issuer mismatch"))
  (https-uri! (hash-ref metadata 'token_endpoint #f) 'begin-authorization)
  (unless (member "S256" (hash-ref metadata 'code_challenge_methods_supported '())) (error 'begin-authorization "authorization server does not advertise PKCE S256"))
  (define verifier (base64url (crypto-random-bytes 32)))
  (define state (base64url (crypto-random-bytes 32)))
  (define challenge (base64url (sha256-bytes (string->bytes/utf-8 verifier))))
  (define endpoint (string->url (https-uri! (hash-ref metadata 'authorization_endpoint) 'begin-authorization)))
  (define query (list (cons 'response_type "code") (cons 'client_id (oauth-registration-client-id registration))
                      (cons 'redirect_uri (oauth-registration-redirect-uri registration)) (cons 'resource (oauth-registration-resource registration))
                      (cons 'state state)
                      (cons 'code_challenge challenge) (cons 'code_challenge_method "S256")))
  (values (url->string (struct-copy url endpoint [query (append (url-query endpoint) query
                                              (if (null? (oauth-registration-scopes registration)) '()
                                                  (list (cons 'scope (string-join (oauth-registration-scopes registration) " ")))))]))
          (oauth-pending registration metadata state verifier)))
(define (token->credential registration token clock [old-refresh #f] [old-scopes #f])
  (unless (and (hash? token) (not (hash-has-key? token 'error))
               (string? (hash-ref token 'token_type #f))
               (equal? (string-downcase (hash-ref token 'token_type)) "bearer")
               (string? (hash-ref token 'access_token #f))
               (regexp-match? #px"^[A-Za-z0-9._~+/-]+=*$" (hash-ref token 'access_token))
               (exact-nonnegative-integer? (hash-ref token 'expires_in 0)))
    (error 'oauth "invalid token response"))
  (define refresh (hash-ref token 'refresh_token old-refresh))
  (unless (or (not refresh) (and (string? refresh) (regexp-match? #px"^[ -~]+$" refresh)))
    (error 'oauth "invalid refresh token"))
  (define scopes
    (if (hash-has-key? token 'scope)
        (let ([scope (hash-ref token 'scope)])
          (unless (string? scope) (error 'oauth "invalid token scope"))
          (check-scopes! (string-split scope " ")))
        (or old-scopes (oauth-registration-scopes registration))))
  (oauth-credential (oauth-registration-issuer registration) (oauth-registration-resource registration)
                    (hash-ref token 'access_token) refresh
                    (+ (clock) (hash-ref token 'expires_in 0)) scopes))
(define (finish-authorization pending response exchange #:clock [clock mcp-current-seconds])
  (unless (equal? (hash-ref response 'state #f) (oauth-pending-state pending)) (error 'finish-authorization "OAuth state mismatch"))
  (define registration (oauth-pending-registration pending))
  ;; A present issuer always requires exact comparison, even when unadvertised.
  ;; Only servers advertising support must include it (MCP 2026-07-28).
  (when (or (hash-has-key? response 'iss)
            (hash-ref (oauth-pending-metadata pending)
                      'authorization_response_iss_parameter_supported #f))
    (unless (equal? (hash-ref response 'iss #f) (oauth-registration-issuer registration))
      (error 'finish-authorization "OAuth response issuer mismatch")))
  (when (hash-has-key? response 'error) (error 'finish-authorization "authorization declined: ~a" (hash-ref response 'error)))
  (unless (and (string? (hash-ref response 'code #f)) (positive? (string-length (hash-ref response 'code))))
    (error 'finish-authorization "nonempty authorization code is required"))
  (define token (exchange (https-uri! (hash-ref (oauth-pending-metadata pending) 'token_endpoint) 'finish-authorization)
                          (hasheq 'grant_type "authorization_code" 'code (hash-ref response 'code)
                                  'client_id (oauth-registration-client-id registration) 'redirect_uri (oauth-registration-redirect-uri registration)
                                  'resource (oauth-registration-resource registration) 'code_verifier (oauth-pending-verifier pending))))
  (token->credential registration token clock))
(define (refresh-credential registration credential metadata exchange #:clock [clock mcp-current-seconds])
  (unless (and (equal? (oauth-registration-issuer registration) (oauth-credential-issuer credential))
               (equal? (oauth-registration-resource registration) (oauth-credential-resource credential))
               (equal? (hash-ref metadata 'issuer #f) (oauth-credential-issuer credential))) (error 'refresh-credential "credential issuer/resource mismatch"))
  (unless (oauth-credential-refresh-token credential) (error 'refresh-credential "no refresh token"))
  (token->credential registration
                     (exchange (https-uri! (hash-ref metadata 'token_endpoint) 'refresh-credential)
                               (hasheq 'grant_type "refresh_token" 'client_id (oauth-registration-client-id registration)
                                       'refresh_token (oauth-credential-refresh-token credential) 'resource (oauth-registration-resource registration)))
                     clock (oauth-credential-refresh-token credential) (oauth-credential-scopes credential)))
