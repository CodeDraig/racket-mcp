#lang racket/base
(require rackunit racket/file net/base64 mcp)
(define parents 0)
(define request (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
(resource (leaf) #:uri "demo:///leaf" #:workflow "1"
  (await-input [answer Any] request)
  "Leaf")
(resource (middle) #:uri "demo:///middle"
  (set! parents (add1 parents))
  (text-presentation "Before " (embed (leaf)) " after"))
(prompt (outer) (role "user" (embed (middle))))
(resource (binary) #:uri "demo:///binary" #:workflow "1"
  (binary-presentation #"\0\377\1" #:mime-type "image/png"))
(resource (json) #:uri "demo:///json" (json-presentation (hasheq 'ok #t)))
(define file (make-temporary-file "mcp-presentation-~a.sqlite"))
(define store (open-sqlite-store file))
(define interface (make-interface #:prompts (list outer) #:resources (list leaf middle binary json)))
(define (runtime) (make-runtime interface #:store store))
(define meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))))
(define params (hasheq '_meta meta 'name "outer"))
(define initial (dispatch (runtime) "prompts/get" params))
(check-equal? (hash-keys (hash-ref initial 'inputRequests)) '(e0/r0/e0/r0/answer))
(close-store! store)
(set! store (open-sqlite-store file))
(define done (dispatch (runtime) "prompts/get"
                       (hash-set* params 'requestState (hash-ref initial 'requestState)
                                  'inputResponses (hasheq 'e0/r0/e0/r0/answer (hasheq 'action "decline")))))
(check-equal? (hash-ref (hash-ref (hash-ref (car (hash-ref done 'messages)) 'content) 'resource) 'text) "Before Leaf after")
(check-equal? parents 1)
(define (read uri) (car (hash-ref (dispatch (runtime) "resources/read" (hasheq '_meta meta 'uri uri)) 'contents)))
(define binary-result (read "demo:///binary"))
(check-equal? (base64-decode (string->bytes/utf-8 (hash-ref binary-result 'blob))) #"\0\377\1")
(check-equal? (hash-ref binary-result 'mimeType) "image/png")
(define json-result (read "demo:///json"))
(check-equal? (hash-ref json-result 'mimeType) "application/json")
(check-equal? (string->json (hash-ref json-result 'text)) (hasheq 'ok #t))
(define (uncertain)
  (parameterize ([current-workflow-invocation-key "same-child-invocation"])
    (dispatch (runtime) "resources/read" (hasheq '_meta meta 'uri "demo:///middle"))))
(define pending (uncertain))
(check-equal? (uncertain) pending)
(check-equal? parents 2)
(resource (cycle-a) #:uri "cycle:///a" (text-presentation (embed (cycle-b))))
(resource (cycle-b) #:uri "cycle:///b" (text-presentation (embed (cycle-a))))
(define cyclic-runtime (make-runtime (make-interface #:resources (list cycle-a cycle-b)) #:store store))
(check-exn exn:fail:mcp? (lambda () (dispatch cyclic-runtime "resources/read" (hasheq '_meta meta 'uri "cycle:///a"))))
(close-store! store)
(delete-file file)
