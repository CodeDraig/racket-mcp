#lang racket/base
(require rackunit racket/file mcp/workflow mcp/storage mcp/schema mcp/descriptor)
(define path (make-temporary-file "mcp-state-~a.sqlite" #f (current-directory)))
(define store (open-sqlite-store path))
(define count 0)
(define flow
  (make-workflow "approve" "1" "build1"
    (list (workflow-stage 'prepared 'checkpoint Integer (lambda (env) (set! count (add1 count)) 42) #f #f)
          (workflow-stage 'answer 'input Any (lambda (env) (hasheq 'mode "form" 'message "Approve?" 'requestedSchema (object-schema (hasheq 'ok Boolean)))) #f #f)
          (workflow-stage 'done 'complete Any (lambda (env) (structured-result env)) #f #f))))
(define first (run-workflow flow store (hasheq) #:principal "alice"))
(check-equal? (hash-ref first 'resultType) "input_required")
(define handle (hash-ref first 'requestState))
(check-equal? count 1)
(close-store! store)
(set! store (open-sqlite-store path))
(check-equal? (run-workflow flow store (hasheq) #:principal "alice" #:state handle) first)
(check-equal? count 1)
(check-exn exn:fail? (lambda () (run-workflow flow store (hasheq) #:principal "bob" #:state handle)))
(define result (run-workflow flow store (hasheq) #:principal "alice" #:state handle #:responses (hasheq 'answer (hasheq 'action "accept" 'content (hasheq 'ok #t)))))
(check-equal? (hash-ref result 'resultType) "complete")
(check-equal? (run-workflow flow store (hasheq) #:principal "alice" #:state handle) result)
(check-equal? count 1)
(define calls 0)
(define unsafe
  (make-workflow "mutate" "1" "build1"
    (list (workflow-stage 'write 'effect Integer (lambda (env) 7) 'external 'manual)
          (workflow-stage 'done 'complete Any (lambda (env) (structured-result (hash-ref env 'write))) #f #f)) #:key (lambda (_) "one")))
(define adapters (hasheq 'external (effect-adapter 'manual (lambda (input key tx) (set! calls (add1 calls)) (error 'adapter "crashed after mutation")))))
(check-exn exn:fail? (lambda () (run-workflow unsafe store (hasheq) #:principal "alice" #:adapters adapters)))
(define recovery-handle #f)
(check-exn (lambda (e) (and (exn:fail:recovery? e) (begin (set! recovery-handle (exn:fail:recovery-handle e)) #t)))
           (lambda () (run-workflow unsafe store (hasheq) #:principal "alice" #:adapters adapters)))
(check-equal? calls 1)
(check-exn exn:fail? (lambda () (recover-workflow! store recovery-handle 'write 'outcome #:principal "alice" #:outcome "wrong")))
(void (recover-workflow! store recovery-handle 'write 'outcome #:principal "alice" #:outcome 7))
(check-equal? (hash-ref (run-workflow unsafe store (hasheq) #:principal "alice" #:adapters adapters) 'structuredContent) 7)
(check-equal? calls 1)
(check-exn exn:fail? (lambda () (recover-workflow! store recovery-handle 'write 'retry #:principal "alice")))
(check-true (>= (length (instance-events store recovery-handle)) 3))
(close-store! store)
(delete-file path)
