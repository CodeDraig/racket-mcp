#lang racket/base
(require rackunit racket/port mcp/private/sse)
(define (event bytes [limit 1048576]) (read-sse-event (make-sse-reader (open-input-bytes bytes) #:max-bytes limit)))
(check-equal? (event #"data: one\ndata:  two\n\n") (sse-event "message" "one\n two"))
(check-equal? (event #"event: message\rdata: true\r\r") (sse-event "message" "true"))
(check-equal? (event #"event: custom\r\ndata: true\r\n\r\n") (sse-event "custom" "true"))
(check-equal? (event (string->bytes/utf-8 "\uFEFF: keep-alive\n\ndata: 雪\n\n")) (sse-event "message" "雪"))
(check-equal? (event #"data\n\n") (sse-event "message" ""))
(check-equal? (event #"data:\ttrue\n\n") (sse-event "message" "\ttrue"))
(check-true (eof-object? (event #"data: partial\n")))
(check-exn #rx"byte limit" (lambda () (event #"data: 123456789" 8)))
(check-exn #rx"byte limit" (lambda () (event #"data: 1\ndata: 2\n\n" 12)))
(check-exn #rx"byte limit" (lambda () (event #":123456789" 8)))
(check-exn #rx"byte limit" (lambda () (event (string->bytes/utf-8 "data: 雪\n\n") 9)))
(check-exn exn:fail? (lambda () (event #"data: \377\n\n")))
;; CR dispatch must not wait for LF or another packet.
(define-values (in out) (make-pipe))
(void (write-bytes #"data: true\r\r" out))
(define result (make-channel))
(define worker (thread (lambda () (channel-put result (read-sse-event (make-sse-reader in))))))
(check-equal? (sync/timeout 1 result) (sse-event "message" "true"))
(close-output-port out) (close-input-port in) (kill-thread worker)
