#lang racket/base
(require rackunit racket/list racket/file racket/runtime-path mcp)
(define evaluations 0)
(define executions 0)
(tool (omitted) (text-result "no structured output"))
(tool (anything) #:output Any (structured-result #f))
(tool (nothing) #:output (begin (set! evaluations (add1 evaluations)) #f)
  (structured-result json-null))
(tool (failed) #:output #f (error-result "expected failure"))
(define dynamic (make-tool "dynamic" '() (lambda (_) (structured-result 42)) #:output #f))
(define absent (make-tool "absent" '() (lambda (_) (text-result "ok")) #:output missing))
(define input-any (make-tool "input-any" '() (lambda (v) (structured-result v)) #:input-schema #t #:raw? #t))
(define input-none (make-tool "input-none" '() (lambda (_) (set! executions (add1 executions)) (text-result "bad")) #:input-schema #f))
(define rt (make-runtime (make-interface #:tools (list omitted anything nothing failed dynamic absent input-any input-none))))
(define (call name [arguments (hasheq)])
  (dispatch rt "tools/call" (hasheq '_meta (request-meta) 'name name 'arguments arguments)))
(check-equal? evaluations 1)
(check-false (tool-descriptor-output-schema omitted))
(check-false (tool-descriptor-output-schema absent))
(check-equal? (tool-descriptor-output-schema anything) (hasheq))
(check-equal? (tool-descriptor-output-schema nothing) (hasheq 'not (hasheq)))
(check-equal? (tool-descriptor-output-schema dynamic) (tool-descriptor-output-schema nothing))
(check-equal? (hash-ref (call "anything") 'structuredContent) #f)
(check-false (hash-has-key? (call "omitted") 'structuredContent))
(check-not-exn (lambda () (call "absent")))
(check-exn #rx"output failed" (lambda () (call "nothing")))
(check-exn #rx"output failed" (lambda () (call "dynamic")))
(check-true (hash-ref (call "failed") 'isError))
(check-equal? (hash-ref (call "input-any" (hasheq 'extra #f)) 'structuredContent) (hasheq 'extra #f))
(check-exn exn:fail:mcp? (lambda () (call "input-none")))
(check-equal? executions 0)
(check-equal? evaluations 1)
(check-exn #rx"input schema must declare type object" (lambda () (make-tool "invalid" '() void #:input-schema String)))
(check-exn #rx"input schema must declare type object" (lambda () (make-tool "invalid" '() void #:input-schema (hasheq '$ref "#"))))
(check-exn #rx"input schema must declare type object" (lambda () (make-interface #:tools (list (struct-copy tool-descriptor omitted [input-schema #t])))))
(check-exn #rx"stored output schema" (lambda () (make-interface #:tools (list (struct-copy tool-descriptor omitted [output-schema #t])))))
(define wire (hash-ref (dispatch rt "tools/list" (hasheq '_meta (request-meta))) 'tools))
(define (named name) (findf (lambda (d) (equal? (hash-ref d 'name) name)) wire))
(check-false (hash-has-key? (named "omitted") 'outputSchema))
(check-false (hash-has-key? (named "absent") 'outputSchema))
(check-equal? (hash-ref (named "anything") 'outputSchema) (hasheq))
(check-equal? (hash-ref (named "nothing") 'outputSchema) (hasheq 'not (hasheq)))
(define-runtime-path schema-path "../vendor/protocol/schema/2026-07-28/schema.json")
(define tool-schema (hash-set (string->json (file->string schema-path)) '$ref "#/$defs/Tool"))
(for ([definition (in-list wire)])
  (check-true (valid? tool-schema definition) (hash-ref definition 'name)))
(custodian-shutdown-all (runtime-custodian rt))

(define bad-headers
  (object-schema (hasheq 'x (hash-set String 'x-mcp-header "X")
                        'y (hash-set String 'x-mcp-header "x"))))
(check-exn exn:fail? (lambda () (make-tool "headers" '() void #:input-schema bad-headers)))
(check-exn exn:fail?
           (lambda () (make-interface #:tools (list (struct-copy tool-descriptor omitted [input-schema bad-headers])))))
