#lang racket/base
(require "../json.rkt")
(provide progress-token? make-progress-tracker observe-progress!
         call-with-progress-scope emit-progress!)
(define (progress-token? token) (or (string? token) (exact-integer? token)))
(struct progress-tracker (token last lock) #:transparent)
(define (make-progress-tracker token)
  (unless (or (missing? token) (progress-token? token))
    (raise-argument-error 'progress "string or integer progress token" token))
  (progress-tracker (if (string? token) (string->immutable-string token) token)
                    (box #f) (make-semaphore 1)))
(define (observe-progress! tracker params [deliver void])
  (unless (and (hash? params)
               (not (missing? (progress-tracker-token tracker)))
               (equal? (hash-ref params 'progressToken missing) (progress-tracker-token tracker))
               (rational? (hash-ref params 'progress #f))
               (or (not (hash-has-key? params 'total)) (rational? (hash-ref params 'total)))
               (or (not (hash-has-key? params 'message)) (string? (hash-ref params 'message))))
    (error 'progress "Invalid or unrelated progress notification"))
  (call-with-semaphore (progress-tracker-lock tracker)
    (lambda ()
      (define value (hash-ref params 'progress))
      (define previous (unbox (progress-tracker-last tracker)))
      (unless (or (not previous) (> value previous))
        (error 'progress "Progress must strictly increase"))
      (set-box! (progress-tracker-last tracker) value)
      (deliver))))
(struct progress-scope (tracker notify active owner) #:transparent)
(define current-scope (make-parameter #f))
(define (call-with-progress-scope token notify thunk)
  (define parent (current-scope))
  (if (and parent (unbox (progress-scope-active parent))
           (not (thread-dead? (progress-scope-owner parent))) (equal? token (progress-tracker-token (progress-scope-tracker parent)))
           (eq? notify (progress-scope-notify parent)))
      (thunk)
      (let ([scope (progress-scope (make-progress-tracker token) notify (box #t) (current-thread))])
        (parameterize ([current-scope scope])
          (dynamic-wind void thunk
            (lambda ()
              (call-with-semaphore (progress-tracker-lock (progress-scope-tracker scope))
                (lambda () (set-box! (progress-scope-active scope) #f)))))))))
(define (emit-progress! params)
  (define scope (or (current-scope) (error 'progress! "No active request")))
  (observe-progress! (progress-scope-tracker scope) params
    (lambda ()
      (unless (and (unbox (progress-scope-active scope)) (not (thread-dead? (progress-scope-owner scope))))
        (error 'progress! "Request has completed"))
      ((progress-scope-notify scope) (hasheq 'jsonrpc "2.0" 'method "notifications/progress" 'params params)))))
