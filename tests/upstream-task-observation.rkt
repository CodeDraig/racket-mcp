#lang racket/base
(require rackunit racket/async-channel mcp mcp/upstream)
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define snapshot
  (hasheq 'server/discover (hasheq 'supportedVersions '("2026-07-28") 'capabilities
    (hasheq 'tools (hasheq) 'resources (hasheq) 'extensions (hash-ref caps 'extensions)))
    'tools/list (hasheq 'tools (list (hasheq 'name "work" 'inputSchema (hasheq 'type "object")
      'outputSchema (object-schema (hasheq 'value Integer) #:required '("value")))))
    'resources/list (hasheq 'resources (list (hasheq 'name "document" 'uri "remote:///doc")))
    'resources/templates/list (hasheq 'resourceTemplates '()) 'prompts/list (hasheq 'prompts '())))
(define base (hasheq 'taskId "private-task" 'status "working" 'createdAt "2026-09-07T00:00:00Z"
                     'lastUpdatedAt "2026-09-07T00:00:00Z" 'ttlMs 60000))
(define polls 0)
(define credential "credential-a")
(define authorized? #t)
(define (peer method params)
  (cond [(hash-ref snapshot (string->symbol method) #f) => values]
        [(equal? method "tools/call") (hash-set base 'resultType "task")]
        [else (set! polls (add1 polls)) (error 'peer "observation must not poll or mutate the peer")]))
(define source (make-upstream-interface snapshot peer #:bridge
  (make-upstream-bridge #:identity "observation" #:version "1" #:credential-id (lambda (_) credential))))
(define store (open-memory-store))
(define clock (make-manual-clock #:seconds 100))
(define rt (make-runtime (view source #:uris (hash "remote:///doc" "local:///doc")) #:store store #:clock clock
  #:authorize (lambda (_principal _method _params) authorized?)))
(define id (hash-ref (dispatch rt "tools/call" (hasheq 'name "work" '_meta (request-meta #:capabilities caps)) #:principal "alice") 'taskId))
(define events (make-async-channel))
(define (observe detail [principal "alice"] [capabilities caps])
  (runtime-observe-upstream-task! rt id detail #:principal principal #:capabilities capabilities))
(define (revision) (stored-instance-revision (load-instance store id)))
(dynamic-wind void
  (lambda ()
    (parameterize ([current-custodian (runtime-custodian rt)])
      (thread (lambda () (dispatch rt "subscriptions/listen"
        (hasheq '_meta (request-meta #:capabilities caps) 'notifications (hasheq 'taskIds (list id)))
        #:principal "alice" #:id 99 #:notify (lambda (event) (async-channel-put events event))))))
    (check-equal? (hash-ref (sync/timeout 2 events) 'method) "notifications/subscriptions/acknowledged")
    (define initial-revision (revision))
    (check-exn exn:fail:mcp? (lambda () (observe base "bob")))
    (check-exn exn:fail:mcp? (lambda () (observe base "alice" (hasheq))))
    (set! credential "credential-b")
    (check-exn exn:fail:mcp? (lambda () (observe base)))
    (set! credential "credential-a")
    (set! authorized? #f)
    (check-exn exn:fail:mcp? (lambda () (observe base)))
    (set! authorized? #t)
    (check-exn exn:fail:mcp? (lambda () (observe (hash-set base 'taskId "foreign-task"))))
    (check-equal? (revision) initial-revision)
    (check-equal? polls 0)
    (define working (observe base))
    (check-equal? (hash-ref working 'taskId) id)
    (check-equal? (hash-ref (hash-ref (sync/timeout 2 events) 'params) 'taskId) id)
    (define working-revision (revision))
    (check-equal? (observe (hash-set base '_meta (hasheq 'io.modelcontextprotocol/subscriptionId "upstream-only"))) working)
    (check-equal? (revision) working-revision)
    (check-false (sync/timeout 0 events))
    (define form (hasheq 'method "elicitation/create" 'params (hasheq 'mode "form" 'message "Continue?"
      'requestedSchema (object-schema (hasheq)))))
    (define input (observe (hash-set* base 'status "input_required" 'inputRequests (hasheq 'remote-input form))))
    (check-equal? (hash-ref input 'status) "input_required")
    (check-equal? (hash-count (hash-ref input 'inputRequests)) 1)
    (check-false (hash-has-key? (hash-ref input 'inputRequests) 'remote-input))
    (check-equal? (hash-ref (hash-ref (sync/timeout 2 events) 'params) 'inputRequests) (hash-ref input 'inputRequests))
    (define prior (revision))
    (define (completion value)
      (hash-set* base 'status "completed" 'result
        (hasheq 'resultType "complete" 'structuredContent (hasheq 'value value)
          'content (list (hasheq 'type "resource_link" 'name "document" 'uri "remote:///doc")))))
    (check-exn exn:fail:mcp? (lambda () (observe (completion "invalid"))))
    (check-equal? (revision) prior)
    (check-false (sync/timeout 0 events))
    (define completed (observe (completion 7)))
    (check-equal? (hash-ref completed 'status) "completed")
    (check-equal? (hash-ref (car (hash-ref (hash-ref completed 'result) 'content)) 'uri) "local:///doc")
    (define notification (hash-ref (sync/timeout 2 events) 'params))
    (check-equal? (hash-ref notification 'taskId) id)
    (check-equal? (hash-ref (car (hash-ref (hash-ref notification 'result) 'content)) 'uri) "local:///doc")
    (define terminal-revision (revision))
    (check-equal? (observe base) completed)
    (check-equal? (revision) terminal-revision)
    (check-false (sync/timeout 0 events))
    ;; An observation is not evidence that an interrupted mutation succeeded.
    (define uncertain-id (hash-ref (dispatch rt "tools/call"
      (hasheq 'name "work" '_meta (request-meta #:capabilities caps)) #:principal "alice") 'taskId))
    (store-transaction store
      (lambda ()
        (define instance (load-instance store uncertain-id))
        (update-instance! store instance
          (hash-set (stored-instance-state instance) 'command
            (hasheq 'status "intent" 'method "tasks/update" 'params (hasheq 'taskId "private-task" 'inputResponses (hasheq)))))))
    (define failed (runtime-observe-upstream-task! rt uncertain-id (completion 7) #:principal "alice" #:capabilities caps))
    (check-equal? (hash-ref failed 'status) "failed")
    (check-regexp-match #rx"uncertain" (hash-ref (hash-ref failed 'error) 'message))
    (define failed-revision (stored-instance-revision (load-instance store uncertain-id)))
    (check-equal? (runtime-observe-upstream-task! rt uncertain-id (completion 7) #:principal "alice" #:capabilities caps) failed)
    (check-equal? (stored-instance-revision (load-instance store uncertain-id)) failed-revision)
    (check-equal? (length (filter (lambda (event) (equal? (hash-ref event 'kind #f) "upstream-task-recovery-required"))
                                 (instance-events store uncertain-id))) 1)
    (check-equal? polls 0))
  (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store)))
