#lang racket/base
(require rackunit racket/path mcp/private/module-imports)
(define owner (make-resolved-module-path (path->complete-path "/declared/owner.rkt")))
(define relative (module-path-index-join "child.rkt" #f))
(check-equal? (resolved-module-path-name (resolve-module-import owner relative))
              (build-path (path-only (resolved-module-path-name owner)) "child.rkt"))
(define other-owner (make-resolved-module-path (path->complete-path "/elsewhere/owner.rkt")))
(check-equal? (resolved-module-path-name (resolve-module-import other-owner relative))
              (build-path (path-only (resolved-module-path-name other-owner)) "child.rkt"))
(define self (module-path-index-join #f #f))
(check-equal? (resolve-module-import owner self) owner)
(define nested (module-path-index-join "leaf.rkt" (module-path-index-join "sub/other.rkt" self)))
(check-equal? (resolved-module-path-name (resolve-module-import owner nested))
              (build-path (path-only (resolved-module-path-name owner)) "sub" "leaf.rkt"))
