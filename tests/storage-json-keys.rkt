#lang racket/base
(require rackunit racket/file mcp mcp/private/render-provenance)

(for ([sqlite? '(#f #t)])
  (test-case (format "keyed storage normalizes decimals and preserves rendering provenance; sqlite ~a" sqlite?)
    (define path (and sqlite? (make-temporary-file "mcp-storage-json-keys-~a.sqlite")))
    (define store (if path (open-sqlite-store path) (open-memory-store)))
    (define args (hasheq 'n 0.5 'nested (list (hasheq 'v 1.0))
      'trusted (mark-render-value (hasheq '$mcp/embedding 0 'uri "storage:///leaf") "embedding")
      'ordinary (hasheq '$mcp/embedding 1 'uri "storage:///ordinary")))
    (define (create arguments [principal "alice"] [operation "job"])
      (create-instance! store principal operation arguments "1" "job/1" (+ (current-seconds) 60)
                        (hasheq 'status "working") #:key "same-key"))
    (dynamic-wind void
      (lambda ()
        (define original (create args))
        (define id (stored-instance-handle original))
        (check-equal? (hash-ref (stored-instance-arguments original) 'n) 1/2)
        (when path
          (close-store! store)
          (set! store (open-sqlite-store path)))
        (define retry (create args))
        (check-equal? (stored-instance-handle retry) id)
        (check-equal? (stored-instance-revision retry) (stored-instance-revision original))
        (check-equal? (length (instance-events store id)) 1)
        (check-equal? (render-value-kind (hash-ref (stored-instance-arguments retry) 'trusted)) "embedding")
        (check-false (render-value-kind (hash-ref (stored-instance-arguments retry) 'ordinary)))
        (check-exn #rx"different arguments" (lambda () (create (hash-set args 'n 0.75))))
        (check-equal? (load-instance store id) original)
        (check-not-equal? (stored-instance-handle (create args "bob")) id)
        (check-not-equal? (stored-instance-handle (create args "alice" "other")) id))
      (lambda () (close-store! store) (when path (delete-file path))))))
