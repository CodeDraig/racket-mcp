(module bootstrap '#%kernel
  (#%require (only '#%kernel))
  (define-values (seen) (make-hasheq))
  (define-values (old-eval) (current-eval))
  (current-eval
    (lambda (expression)
      (let-values ([(code) (if (compiled-expression? expression) expression (compile expression))])
        (let-values ([(identity) (current-module-declare-name)])
          (begin0 (old-eval code)
            (if (if identity (compiled-module-expression? code) #f)
                (let-values ([(name) (module-compiled-name code)]
                             [(owner) (resolved-module-path-name identity)])
                  (hash-set! seen
                    (if (pair? name)
                        (make-resolved-module-path
                          (cons (if (pair? owner) (car owner) owner) (cdr name)))
                        identity)
                    code)) (void)))))))
  (define-values (target) (vector-ref (current-command-line-arguments) 0))
  (dynamic-require (string->path target) 'mcp-interface)
  (define-values (imports) (dynamic-require 'mcp/private/module-imports 'resolved-module-imports))
  (define-values (tree) (dynamic-require 'mcp/private/module-code-tree 'module-code-tree))
  (define-values (keys)
    (lambda (table)
      (letrec-values ([(loop) (lambda (i out)
                       (if i (loop (hash-iterate-next table i)
                                   (cons (hash-iterate-key table i) out)) out))])
        (loop (hash-iterate-first table) '()))))
  (for-each
    (lambda (identity)
      (for-each (lambda (entry) (hash-set! seen (car entry) (cdr entry)))
        (tree identity (hash-ref seen identity))))
    (keys seen))
  (define-values (visited) (make-hasheq))
  (define-values (visit)
    (lambda (identity)
      (if (hash-ref visited identity #f) (void)
          (begin
            (hash-set! visited identity #t)
            (if (hash-ref seen identity #f) (void)
                (begin (write (list 'missing (resolved-module-path-name identity) (module-predefined? identity))) (newline)))
            (if (module-declared? identity #f) (for-each visit (imports identity)) (void))))))
  (visit (module-path-index-resolve (module-path-index-join (string->path target) #f)))
)
