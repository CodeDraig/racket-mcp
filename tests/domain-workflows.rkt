#lang racket/base
(require rackunit mcp)
(define executions 0)
(define request (hasheq 'mode "form" 'message "Approve?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
(prompt (conversation [name String]) #:workflow "1"
  (checkpoint [saved String] (begin (set! executions (add1 executions)) name))
  (await-input [answer Any] request)
  (role "user" (text-content (string-append "Hello " saved))))
(resource (report [name String]) #:uri "report:///{name}" #:workflow "1"
  (await-input [answer Any] request)
  (string-append "Report " name))
(define store (open-memory-store))
(define interface (make-interface #:prompts (list conversation) #:resources (list report)))
(define authorized? #t)
(define rt (make-runtime interface #:store store #:authorize (lambda (principal method params) authorized?)))
(define meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))))
(define p (hasheq '_meta meta 'name "conversation" 'arguments (hasheq 'name "Ada")))
(check-exn exn:fail:mcp? (lambda () (dispatch rt "prompts/get" (hash-set p '_meta (request-meta)))))
(check-equal? executions 0)
(define initial (dispatch rt "prompts/get" p))
(check-equal? (hash-ref initial 'resultType) "input_required")
(check-false (hash-has-key? initial 'ttlMs))
(define retry (hash-set* p 'requestState (hash-ref initial 'requestState) 'inputResponses (hasheq 'answer (hasheq 'action "decline"))))
(set! authorized? #f)
(check-exn exn:fail:mcp? (lambda () (dispatch rt "prompts/get" retry)))
(set! authorized? #t)
(define done (dispatch rt "prompts/get" retry))
(check-equal? (hash-ref done 'messages) (role "user" (text-content "Hello Ada")))
(check-equal? executions 1)
(check-equal? (dispatch rt "prompts/get" retry) done)
(define rp (hasheq '_meta meta 'uri "report:///Ada"))
(define pending (dispatch rt "resources/read" rp))
(check-equal? (hash-ref pending 'resultType) "input_required")
(check-exn exn:fail? (lambda () (dispatch rt "resources/read" (hash-set rp 'requestState (hash-ref initial 'requestState)))))
(define finished (dispatch rt "resources/read" (hash-set* rp 'requestState (hash-ref pending 'requestState) 'inputResponses (hasheq 'answer (hasheq 'action "cancel")))))
(check-equal? (hash-ref (car (hash-ref finished 'contents)) 'text) "Report Ada")
(close-store! store)
