#lang racket/base
(require racket/list racket/string "../json.rkt")
(provide manifest->markdown)
(define (backtick-count text)
  (for/fold ([longest 0]) ([run (in-list (regexp-match* #px"`+" text))]) (max longest (string-length run))))
(define (code text)
  (define rendered (if (or (string? text) (symbol? text) (path? text)) (format "~a" text) (format "~s" text)))
  (define flattened (regexp-replace* #px"[\r\n]" rendered (lambda (_) "\\n")))
  (define delimiter (make-string (add1 (backtick-count flattened)) #\`))
  (format "~a ~a ~a" delimiter flattened delimiter))
(define (prose text)
  (apply string-append
         (for/list ([ch (in-string (format "~a" text))])
           (if (memv ch '(#\\ #\` #\* #\_ #\{ #\} #\[ #\] #\( #\) #\# #\+ #\- #\. #\! #\| #\< #\>))
               (string #\\ ch) (string ch)))))
(define (representation value)
  (if (json-value? value) (json->string value) (format "~s" value)))
(define (described value)
  (if (hash-ref value 'known? #f)
      (code (representation (hash-ref value 'value)))
      (format "dynamic expression ~a" (code (hash-ref value 'expression "unknown")))))
(define (manifest->markdown manifest #:title [title "MCP interface"])
  (unless (and (list? manifest) (andmap hash? manifest))
    (raise-argument-error 'manifest->markdown "(listof hash?)" manifest))
  (define out (open-output-string))
  (define (paragraph format-string . values) (apply fprintf out (string-append format-string "\n\n") values))
  (define (schema-section heading description)
    (paragraph "### ~a" heading)
    (cond [(hash-ref description 'known? #f)
           (define value (hash-ref description 'value))
           (define text (representation value))
           (define fence (make-string (max 3 (add1 (backtick-count text))) #\`))
           (paragraph "~a~a\n~a\n~a" fence (if (json-value? value) "json" "racket") text fence)]
          [else (paragraph "~a" (described description))]))
  (paragraph "# Interface: ~a" (code title))
  (paragraph "Generated from static declarations. Dynamic expressions have not been evaluated.")
  (for ([entry (in-list manifest)])
    (define kind (hash-ref entry 'kind))
    (define metadata (hash-ref entry 'metadata (hasheq)))
    (paragraph "## ~a ~a" (prose kind) (code (hash-ref entry 'name)))
    (paragraph "Source: ~a." (code (format "~a:~a" (hash-ref entry 'source "unknown") (hash-ref entry 'line "unknown"))))
    (when (hash-has-key? metadata 'description)
      (define description (hash-ref metadata 'description))
      (paragraph "~a" (if (and (hash-ref description 'known? #f) (string? (hash-ref description 'value)))
                           (prose (hash-ref description 'value)) (described description))))
    (for ([key (in-list (sort (hash-keys metadata) symbol<?))] #:unless (memq key '(description output)))
      (paragraph "**~a:** ~a" (prose key) (described (hash-ref metadata key))))
    (define arguments (hash-ref entry 'arguments '()))
    (unless (null? arguments)
      (paragraph "### Arguments")
      (for ([argument (in-list arguments)])
        (fprintf out "- ~a — ~a; schema: ~a"
                 (code (hash-ref argument 'name)) (if (hash-ref argument 'required) "required" "optional")
                 (described (hash-ref argument 'schema)))
        (for ([key '(default codec)] #:when (hash-has-key? argument key))
          (fprintf out "; ~a: ~a" key (described (hash-ref argument key))))
        (newline out))
      (newline out))
    (for ([key '(schema input-schema)] [heading '("Schema" "Input schema")]
          #:when (hash-has-key? entry key))
      (schema-section heading (hash-ref entry key)))
    (when (hash-has-key? metadata 'output) (schema-section "Output schema" (hash-ref metadata 'output)))
    (when (eq? kind 'completion)
      (define target (hash-ref entry 'target (hasheq 'known? #f)))
      (paragraph "Completes argument ~a on ~a." (code (hash-ref entry 'argument "unknown"))
                 (if (hash-ref target 'known? #f)
                     (format "~a ~a" (prose (hash-ref target 'kind)) (code (hash-ref target 'name)))
                     (described target))))
    (define requirements (hash-ref entry 'runtime-requirements '()))
    (unless (null? requirements)
      (paragraph "Runtime requirements: ~a." (string-join (map code requirements) ", ")))
    (define references (hash-ref entry 'resource-references '()))
    (unless (null? references)
      (paragraph "### Resource references")
      (paragraph "References visible in handler and workflow-stage syntax:")
      (for ([ref (in-list references)])
        (fprintf out "- ~a at ~a.\n" (code (or (hash-ref ref 'name #f) "unknown"))
                 (code (format "~a:~a" (hash-ref ref 'source "unknown") (hash-ref ref 'line "unknown")))))
      (newline out))
    (define stages (hash-ref entry 'workflow-stages '()))
    (unless (null? stages)
      (paragraph "### Workflow stages")
      (for ([stage (in-list stages)] [i (in-naturals 1)])
        (fprintf out "~a. ~a — ~a" i (code (hash-ref stage 'id)) (prose (hash-ref stage 'kind)))
        (case (hash-ref stage 'kind)
          [(effect) (fprintf out "; adapter ~a; policy ~a" (code (hash-ref stage 'adapter-or-targets)) (code (hash-ref stage 'policy)))]
          [(branch jump) (fprintf out "; targets ~a" (code (hash-ref stage 'adapter-or-targets)))])
        (fprintf out "; schema: ~a.\n" (described (hash-ref stage 'schema))))
      (newline out)))
  (get-output-string out))
