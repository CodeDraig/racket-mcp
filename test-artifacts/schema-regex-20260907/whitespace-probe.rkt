#lang racket/base
(require "../../mcp/private/pattern.rkt")
(define yes (schema-pattern "^\\s$"))
(define no (schema-pattern "^\\S$"))
(define checked 0)
(for ([n (in-range #x110000)] #:unless (<= #xd800 n #xdfff))
  (define c (integer->char n))
  (define value (string c))
  (define expected (or (eq? (char-general-category c) 'zs)
                       (and (memv n '(9 10 11 12 13 8232 8233 65279)) #t)))
  (unless (and (equal? (regexp-match? yes value) expected)
               (equal? (regexp-match? no value) (not expected)))
    (error 'whitespace "mismatch at U+~x" n))
  (set! checked (add1 checked)))
(printf "Whitespace and complement agree with Unicode categories for all ~a scalar values.\n" checked)
