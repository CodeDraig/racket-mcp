#lang racket/base
(require racket/list "../json.rkt" "../storage.rkt" "../error.rkt")
(provide make-pagination paginate)
(struct snapshot (tokens items binding expires weight) #:transparent)
(struct pagination (lock cursors snapshots page-size ttl limit byte-limit clock) #:transparent)
(define (make-pagination #:page-size [size 100] #:ttl [ttl 60] #:limit [limit 1024]
                         #:max-bytes [bytes 16777216] #:clock [clock current-seconds])
  (for ([value (list size ttl limit bytes)])
    (unless (exact-positive-integer? value) (raise-argument-error 'make-pagination "exact-positive-integer?" value)))
  (pagination (make-semaphore 1) (make-hash) (make-hasheq) size ttl limit bytes clock))
(define (forget! pager snapshot)
  (for ([token (in-vector (snapshot-tokens snapshot))]) (hash-remove! (pagination-cursors pager) token))
  (hash-remove! (pagination-snapshots pager) snapshot))
(define (prune! pager)
  (for ([s (in-list (hash-keys (pagination-snapshots pager)))]
         #:when (<= (snapshot-expires s) ((pagination-clock pager))))
    (forget! pager s)))
(define (page pager key items offset tokens)
  (define end (min (vector-length items) (+ offset (pagination-page-size pager))))
  (define result (hasheq 'resultType "complete" 'ttlMs 0 'cacheScope "private"
                         key (for/list ([i (in-range offset end)]) (vector-ref items i))))
  (if (< end (vector-length items))
      (hash-set result 'nextCursor (vector-ref tokens (sub1 (quotient end (pagination-page-size pager))))) result))
(define (paginate pager key items binding cursor)
  (cond [(not (missing? cursor))
         (unless (string? cursor) (mcp-error -32602 "Pagination cursor must be a string"))
         (call-with-semaphore (pagination-lock pager)
           (lambda ()
             (prune! pager)
             (define found (hash-ref (pagination-cursors pager) cursor #f))
             (unless (and found (equal? binding (snapshot-binding (car found))))
               (mcp-error -32602 "Unknown, expired, or unrelated pagination cursor; restart listing"))
             (page pager key (snapshot-items (car found)) (cdr found) (snapshot-tokens (car found)))))]
        [(<= (length items) (pagination-page-size pager)) (page pager key (list->vector items) 0 #())]
        [else
         ;; Snapshot wire data so application mutation cannot change later pages.
         ;; The encoding also supplies the retained-data weight for eviction.
         (define encoded (json->string items))
         (define weight (+ (bytes-length (string->bytes/utf-8 encoded))
                           (bytes-length (string->bytes/utf-8 (format "~s" binding)))))
         (define count (quotient (sub1 (length items)) (pagination-page-size pager)))
         (when (or (> count (pagination-limit pager)) (> weight (pagination-byte-limit pager)))
           (mcp-error -32603 "Listing exceeds configured pagination capacity"))
         (define data (list->vector (string->json encoded #:max-bytes (pagination-byte-limit pager))))
         (define tokens (for/vector ([i (in-range count)]) (string->immutable-string (opaque-handle))))
         (call-with-semaphore (pagination-lock pager)
           (lambda ()
             (prune! pager)
             (let evict ()
               (when (or (> (+ count (hash-count (pagination-cursors pager))) (pagination-limit pager))
                         (> (+ weight (for/sum ([s (in-hash-keys (pagination-snapshots pager))]) (snapshot-weight s))) (pagination-byte-limit pager)))
                 (forget! pager (argmin snapshot-expires (hash-keys (pagination-snapshots pager))))
                 (evict)))
             (define s (snapshot tokens data binding (+ ((pagination-clock pager)) (pagination-ttl pager)) weight))
             (hash-set! (pagination-snapshots pager) s #t)
             (for ([token (in-vector tokens)] [i (in-naturals 1)])
               (hash-set! (pagination-cursors pager) token (cons s (* i (pagination-page-size pager)))))
             (page pager key data 0 tokens)))]))
