#lang racket/base
(require rackunit mcp mcp/uri-template mcp/completion syntax/macro-testing)
(shape Document [id String] [pages Integer])
(define d (make-Document "abc" 3))
(check-equal? (Document-pages d) 3)
(check-equal? (json->Document (Document->json d)) d)
(check-exn exn:fail? (lambda () (make-Document "abc" "bad")))
(resource (document [id String]) #:uri "document:///{id}" (string-append "Document " id))
(check-exn exn:fail:syntax? (lambda () (convert-compile-time-error (document "a" "b"))))
(check-exn exn:fail:syntax? (lambda () (convert-compile-time-error (schema Bad #hasheq((type . "bogus"))))))
(tool (lookup [id String]) (hasheq 'resultType "complete" 'content (list (link (document id)) (embed (document id)))))
(define base (make-interface #:tools (list lookup) #:resources (list document)))
(define mounted (view base #:namespace "docs/" #:uris (hash "document:///{id}" "archive:///{id}")))
(define result (dispatch (make-runtime mounted) "tools/call" (hasheq '_meta (request-meta) 'name "docs/lookup" 'arguments (hasheq 'id "a b"))))
(check-equal? (hash-ref (car (hash-ref result 'content)) 'uri) "archive:///a%20b")
(check-equal? (hash-ref (car (hash-ref result 'content)) 'name) "docs/document")
(check-equal? (hash-ref (hash-ref (cadr (hash-ref result 'content)) 'resource) 'text) "Document a b")
(check-exn exn:fail? (lambda () (parameterize ([current-interface (view base #:exclude '("document"))]) (link (document "x")))))
(check-equal? (uri-template-expand "{/path*}{?q,lang}" (hasheq 'path '("a b" "c") 'q "x+y" 'lang "en")) "/a%20b/c?q=x%2By&lang=en")
(check-equal? (uri-template-expand "{+path}" (hasheq 'path "/a/b")) "/a/b")
(check-exn exn:fail? (lambda () (uri-template-matcher "/{x}{y}")))
(check-equal? (length (role "user" (text-content "one") (text-content "two"))) 2)
(prompt (choose [id String]) (role "user" (text-content id)))
(define complete-id (completion-descriptor choose 'id (lambda (prefix context) '("alpha"))))
(define completion-interface (make-interface #:prompts (list choose) #:completions (list complete-id)))
(define renamed (view completion-interface #:rename (hash "choose" "select")))
(check-equal?
 (hash-ref (hash-ref (dispatch (make-runtime renamed) "completion/complete"
                             (hasheq '_meta (request-meta) 'ref (hasheq 'type "ref/prompt" 'name "select")
                                     'argument (hasheq 'name "id" 'value "a"))) 'completion) 'values)
 '("alpha"))
(check-equal? (interface-descriptor-completions (view completion-interface #:exclude '("choose"))) '())
