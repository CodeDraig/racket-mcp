#lang racket/base
(require rackunit mcp mcp/upstream mcp/scenario mcp/stdio)
(for ([transport '(local stdio http)])
  (define version "old")
  (define reads 0)
  (define remote
    (make-runtime (make-interface #:resources
      (list (make-resource "document" "remote:///{id}"
        (lambda (id) (set! reads (add1 reads)) (string-append id ":" version))
        #:arguments (list (argument 'id String #f #f)))))))
  (dynamic-wind void
    (lambda ()
      (define (request method params) (dispatch remote method (hash-set params '_meta (request-meta))))
      (define snapshot (capture-snapshot request))
      (define source (make-upstream-interface snapshot request))
      (define other (make-upstream-interface snapshot request))
      (define keys (upstream-resource-change-keys source "remote:///a%20b"))
      (check-true (json-value? keys))
      (check-not-equal? keys (upstream-resource-change-keys other "remote:///a%20b"))
      (check-not-equal? keys (upstream-resource-change-keys source "remote:///different"))
      (check-exn exn:fail? (lambda () (upstream-resource-change-keys source "unknown:///id")))
      (check-exn exn:fail? (lambda () (upstream-resource-change-keys (runtime-interface remote) "remote:///id")))
      (check-equal? reads 0)
      ;; Caching is an explicit local test policy; upstream defaults remain zero TTL.
      (define cached (make-interface #:resources
        (for/list ([resource (in-list (interface-descriptor-resources source))])
          (check-equal? (resource-descriptor-ttl-ms resource) 0)
          (struct-copy resource-descriptor resource [ttl-ms 1000]))))
      (define mounted (view cached #:uris (hash "remote:///{id}" "local:///{id}")))
      (check-equal? keys (upstream-resource-change-keys mounted "local:///a%20b"))
      (call-with-scenario-session mounted
        (lambda (session)
          (define rt (scenario-session-runtime session))
          (define (read-as principal)
            (dispatch rt "resources/read" (hasheq 'uri "local:///a%20b" '_meta (request-meta)) #:principal principal))
          (define alice-before (read-as "alice"))
          (define bob-before (read-as "bob"))
          (check-equal? reads 2)
          (define subscription (scenario-request session "subscriptions/listen"
            (hasheq 'notifications (hasheq 'resourceSubscriptions '("local:///a%20b")))))
          (define notices (request-handle-notifications subscription))
          (check-equal? (hash-ref (sync/timeout 2 notices) 'method) "notifications/subscriptions/acknowledged")
          (set! version "new")
          ;; An identical snapshot from a separately installed upstream has no effect.
          (check-equal? (runtime-report-change! rt "alice" (upstream-resource-change-keys other "remote:///a%20b")) '())
          (check-false (sync/timeout 0 notices))
          (check-equal? (read-as "alice") alice-before)
          (check-equal? reads 2)
          (check-equal? (runtime-report-change! rt "alice" keys) '("local:///a%20b"))
          (define changed (sync/timeout 2 notices))
          (check-equal? (hash-ref changed 'method) "notifications/resources/updated")
          (check-equal? (hash-ref (hash-ref changed 'params) 'uri) "local:///a%20b")
          (check-equal? (hash-ref (hash-ref (hash-ref changed 'params) '_meta) 'io.modelcontextprotocol/subscriptionId)
                        (request-handle-id subscription))
          (define alice-after (hash-ref (scenario-call session "resources/read" (hasheq 'uri "local:///a%20b")) 'result))
          (check-equal? (hash-ref (car (hash-ref alice-after 'contents)) 'text) "a b:new")
          (check-equal? reads 3)
          (check-equal? (read-as "bob") bob-before)
          (check-equal? reads 3)
          (request-cancel! subscription))
        #:transport transport #:principal "alice"))
    (lambda () (custodian-shutdown-all (runtime-custodian remote)))))
