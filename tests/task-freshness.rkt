#lang racket/base
(require rackunit racket/async-channel mcp mcp/subscription)
(resource (document) #:uri "doc:///one" #:depends-on '("effect" "complete") "data")
(workflow (edit) #:version "1" #:execution task #:changes [outcome '("complete")]
  (perform [written Integer] #:adapter writer #:policy idempotent 1)
  (await-input [answer Any] (hasheq 'mode "form" 'message "Done?" 'requestedSchema (object-schema (hasheq))))
  (text-result "done"))
(define store (open-memory-store))
(define rt (make-runtime (make-interface #:resources (list document) #:tools (list edit)) #:store store
                        #:adapters (hasheq 'writer (effect-adapter 'idempotent (lambda (input key connection) (committed-result input '("effect")))))))
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define (call method params) (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps)) #:principal "alice"))
(define queue (make-async-channel))
(define listener (thread (lambda ()
  (dispatch rt "subscriptions/listen" (hasheq '_meta (request-meta) 'notifications (hasheq 'resourceSubscriptions '("doc:///one")))
            #:id 99 #:principal "alice" #:notify (lambda (m) (async-channel-put queue m))))))
(check-equal? (hash-ref (sync/timeout 2 queue) 'method) "notifications/subscriptions/acknowledged")
(define task (call "tools/call" (hasheq 'name "edit" 'arguments (hasheq))))
(define id (hash-ref task 'taskId))
(define (await-status status)
  (let loop ([tries 200])
    (define result (call "tasks/get" (hasheq 'taskId id)))
    (cond [(equal? (hash-ref result 'status) status) result]
          [(zero? tries) (error 'test "task did not reach ~a: ~a" status result)]
          [else (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 tries))])))
(void (await-status "input_required"))
(check-equal? (hash-ref (sync/timeout 2 queue) 'method) "notifications/resources/updated")
(void (call "tasks/update" (hasheq 'taskId id 'inputResponses (hasheq 'answer (hasheq 'action "decline")))))
(void (await-status "completed"))
(check-equal? (hash-ref (sync/timeout 2 queue) 'method) "notifications/resources/updated")
(check-equal? (length (list-instances store #:operation "change-outbox")) 2)
(check-true (andmap (lambda (i) (equal? (hash-ref (stored-instance-state i) 'status) "delivered")) (list-instances store #:operation "change-outbox")))
(close-subscriptions! (runtime-subscriptions rt))
(thread-wait listener)
(custodian-shutdown-all (runtime-custodian rt)) (close-store! store)
