'(module example racket/base
   (#%module-begin
    (module configure-runtime '#%kernel
      (#%module-begin (#%require racket/runtime-config) (#%app configure '#f)))
    (#%require "../main.rkt")
    (#%provide comp-op)
    (define-syntaxes (comp-op) (#%app nonterm-var3))
    (define-values (lifted/1) (#%app void))
    (define-values
     (comp-op)
     (lambda (in)
       (let-values (((in-v) in))
         (let-values (((in^-tmp result-tmp)
                       (let-values (((s) (#%app text-rep-str in-v))
                                    ((init-ix) (#%app text-rep-ix in-v)))
                         (let-values (((tail-len)
                                       (#%app
                                        -
                                        (#%app string-length s)
                                        init-ix)))
                           (let-values (((has-c)
                                         (lambda (offset)
                                           (#%app < offset tail-len)))
                                        ((c)
                                         (lambda (offset)
                                           (#%app
                                            string-ref
                                            s
                                            (#%app + init-ix offset))))
                                        ((succeed)
                                         (lambda (offset)
                                           (#%app
                                            values
                                            (#%app step-input* in-v offset)
                                            (#%app void)))))
                             (if (#%app has-c '0)
                               (let-values (((c-int)
                                             (#%app
                                              char->integer
                                              (#%app c '0))))
                                 (if (#%app < c-int '62)
                                   (if (#%app eq? c-int '33)
                                     (#%app
                                      string-rt
                                      '"="
                                      (#%app step-input* in-v '1))
                                     (if (#%app eq? c-int '60)
                                       (if (#%app has-c '1)
                                         (let-values (((c-int)
                                                       (#%app
                                                        char->integer
                                                        (#%app c '1))))
                                           (if (#%app eq? c-int '61)
                                             (#%app succeed '2)
                                             (#%app succeed '1)))
                                         (#%app succeed '1))
                                       (if (#%app eq? c-int '61)
                                         (#%app
                                          string-rt
                                          '"="
                                          (#%app step-input* in-v '1))
                                         (#%app fail))))
                                   (if (#%app eq? c-int '62)
                                     (if (#%app has-c '1)
                                       (let-values (((c-int)
                                                     (#%app
                                                      char->integer
                                                      (#%app c '1))))
                                         (if (#%app eq? c-int '61)
                                           (#%app succeed '2)
                                           (#%app succeed '1)))
                                       (#%app succeed '1))
                                     (if (#%app eq? c-int '105)
                                       (if (#%app has-c '1)
                                         (let-values (((c-int)
                                                       (#%app
                                                        char->integer
                                                        (#%app c '1))))
                                           (if (#%app eq? c-int '110)
                                             (#%app succeed '2)
                                             (if (#%app eq? c-int '115)
                                               (#%app succeed '2)
                                               (#%app fail))))
                                         (#%app fail))
                                       (if (#%app eq? c-int '110)
