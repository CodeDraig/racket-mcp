#lang racket/base
(require racket/async-channel mcp mcp/stdio mcp/http mcp/subscription)
(define rt #f)
(tool (publish)
  (publish-change! (runtime-subscriptions rt) "notifications/tools/list_changed" (hasheq))
  (text-result "published"))
(tool (close-listeners)
  (close-subscriptions! (runtime-subscriptions rt))
  (text-result "closed"))
(tool (echo) (text-result "alive"))
(set! rt (make-runtime (make-interface #:tools (list publish close-listeners echo))))
(module+ main
  (if (member "http" (vector->list (current-command-line-arguments)))
      (let ([confirmation (make-async-channel)])
        (define stop (serve-http rt #:port 0 #:confirmation confirmation #:keepalive-seconds 0.05))
        (define port (sync confirmation))
        (when (exn? port) (raise port))
        (printf "http://127.0.0.1:~a/mcp\n" port)
        (flush-output)
        (sync never-evt))
      (serve-stdio rt)))
