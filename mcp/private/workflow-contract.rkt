#lang racket/base
(require racket/list "workflow-types.rkt" "../schema.rkt" "../codec.rkt")
(provide check-workflow-program! check-workflow-descriptor!)
;; Validation inspects data and callback arities; it never executes stage/key or
;; codec procedures. Used before construction, installation and direct execution.
(define (check-workflow-program! name version fingerprint stages key changes [who 'make-workflow])
  (for ([value (in-list (list name version fingerprint))] [field '(name version fingerprint)])
    (unless (and (string? value) (positive? (string-length value)))
      (error who "workflow ~a must be a nonempty string" field)))
  (unless (and (list? stages) (pair? stages) (andmap workflow-stage? stages))
    (error who "workflow requires a nonempty list of stages"))
  (when key
    (unless (and (procedure? key) (procedure-arity-includes? key 1))
      (error who "workflow key must accept the arguments map")))
  (for ([stage (in-list stages)])
    (unless (and (symbol? (workflow-stage-id stage)) (symbol-interned? (workflow-stage-id stage)))
      (error who "stage ID must be an interned symbol"))
    (unless (and (procedure? (workflow-stage-procedure stage))
                 (procedure-arity-includes? (workflow-stage-procedure stage) 1))
      (error who "stage procedure must accept the environment map")))
  (unless (and (procedure? changes) (procedure-arity-includes? changes 2)) (error who "changes must accept arguments and completed result"))
  (unless (= (length stages) (length (remove-duplicates (map workflow-stage-id stages)))) (error who "duplicate stage IDs"))
  (define effect-policies (make-hasheq))
  (for ([s (in-list stages)])
    (when (eq? (workflow-stage-kind s) 'effect)
      (define adapter (workflow-stage-adapter s))
      (define policy (workflow-stage-policy s))
      (unless (and (symbol? adapter) (memq policy '(transactional idempotent manual)))
        (error who "effect requires a named adapter and supported policy"))
      (when (and (hash-has-key? effect-policies adapter) (not (eq? policy (hash-ref effect-policies adapter))))
        (error who "conflicting policies for the same effect adapter"))
      (hash-set! effect-policies adapter policy))
    (unless (memq (workflow-stage-kind s) '(checkpoint input input-group effect complete branch jump task-boundary)) (error who "invalid stage kind"))
    (unless (or (eq? (workflow-stage-kind s) 'effect) (not (workflow-stage-policy s)))
      (error who "effect policy is only valid on an effect stage"))
    (when (and (memq (workflow-stage-kind s) '(checkpoint input complete task-boundary))
               (workflow-stage-adapter s))
      (error who "adapter or destination is not valid for this stage kind"))
    (define schema (workflow-stage-schema s))
    (when (and (value-codec? schema) (not (memq (workflow-stage-kind s) '(checkpoint effect))))
      (error who "value codecs belong on checkpoint or effect stages"))
    (check-schema! (if (value-codec? schema) (value-codec-schema schema) schema)))
  (define identities
    (append-map (lambda (s)
                  (if (eq? (workflow-stage-kind s) 'input-group)
                      (let ([ids (workflow-stage-adapter s)])
                        (unless (and (list? ids) (pair? ids) (andmap (lambda (id) (and (symbol? id) (symbol-interned? id))) ids)
                                     (hash? (workflow-stage-schema s))
                                     (hash? (hash-ref (workflow-stage-schema s) 'properties #f))
                                     (andmap (lambda (id) (hash-has-key? (hash-ref (workflow-stage-schema s) 'properties) id)) ids))
                          (error who "input group requires named response schemas"))
                        (cons (workflow-stage-id s) ids))
                      (list (workflow-stage-id s)))) stages))
  (unless (= (length identities) (length (remove-duplicates identities))) (error who "duplicate persistent value identity"))
  (for ([s (in-list stages)])
    (define targets (case (workflow-stage-kind s)
                      [(branch) (workflow-stage-adapter s)]
                      [(jump) (list (workflow-stage-adapter s))]
                      [else '()]))
    (when (and (eq? (workflow-stage-kind s) 'branch) (null? targets))
      (error who "branch requires at least one destination"))
    (unless (and (list? targets) (for/and ([target (in-list targets)]) (member target (map workflow-stage-id stages))))
      (error who "unresolved control-flow destination")))
  ;; Follow declared edges without evaluating a selector. Cycles are visited
  ;; once; this checks structural completion, not termination of host code.
  (define stage-vector (list->vector stages))
  (define positions (for/hasheq ([stage (in-list stages)] [index (in-naturals)])
                      (values (workflow-stage-id stage) index)))
  (define visited (make-hasheqv))
  (define completion? #f)
  (let visit ([position 0])
    (when (= position (vector-length stage-vector))
      (error who "reachable workflow path has no completion stage"))
    (unless (hash-ref visited position #f)
      (hash-set! visited position #t)
      (define stage (vector-ref stage-vector position))
      (case (workflow-stage-kind stage)
        [(complete) (set! completion? #t)]
        [(branch) (for ([target (in-list (workflow-stage-adapter stage))]) (visit (hash-ref positions target)))]
        [(jump) (visit (hash-ref positions (workflow-stage-adapter stage)))]
        [else (visit (add1 position))])))
  (unless completion? (error who "workflow has no reachable completion stage"))
  (define codecs (filter value-codec? (map workflow-stage-schema stages)))
  (make-codec-registry codecs)
  codecs)

(define (check-workflow-descriptor! workflow [who 'workflow])
  (unless (workflow-descriptor? workflow) (raise-argument-error who "workflow-descriptor?" workflow))
  (void (check-workflow-program! (workflow-descriptor-name workflow) (workflow-descriptor-version workflow)
    (workflow-descriptor-fingerprint workflow) (workflow-descriptor-stages workflow)
    (workflow-descriptor-key workflow) (workflow-descriptor-changes workflow) who)))
