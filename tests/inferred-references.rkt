#lang racket/base
(require rackunit mcp)
(module provider racket/base
  (require mcp)
  (provide document)
  (resource (document [id String]) #:uri "doc:///{id}" id))
(module consumer mcp/lang
  (require (rename-in (submod ".." provider) [document imported-document]))
  (provide touches)
  (define touches 0)
  (define-syntax-rule (document-link id) (link (imported-document id)))
  (tool (open [id String])
    (set! touches (add1 touches))
    (hasheq 'resultType "complete" 'content (list (document-link id))))
  (prompt (show [id String]) (role "user" (link (later id))))
  (resource (index) #:uri "index:///" (link (imported-document "index")))
  ;; Forward declarations resolve only when the interface is constructed.
  (resource (later [id String]) #:uri "later:///{id}" id)
  (tool (shadow [imported-document String]) (text-result imported-document))
  (tool (internal)
    (define imported-document "local")
    (text-result imported-document))
  (tool (quoted) (text-result (symbol->string 'imported-document)))
  (mount (make-interface #:resources (list imported-document))))
(require (prefix-in c: (submod "." consumer))
         (submod "." provider))
(define iface c:mcp-interface)
(define refs (interface-resource-references iface))
(define (named descriptors name get-name)
  (for/first ([d (in-list descriptors)] #:when (equal? name (get-name d))) d))
(define open (named (interface-descriptor-tools iface) "open" tool-descriptor-name))
(define show (car (interface-descriptor-prompts iface)))
(define later (named (interface-descriptor-resources iface) "later" resource-descriptor-name))
(define index (named (interface-descriptor-resources iface) "index" resource-descriptor-name))
(check-equal? c:touches 0)
(check-equal? (hash-count refs) 3)
(check-equal? (hash-ref refs open) (list document))
(check-equal? (hash-ref refs show) (list later))
(check-equal? (hash-ref refs index) (list document))
(for ([name '("shadow" "internal" "quoted")])
  (check-false (hash-has-key? refs (named (interface-descriptor-tools iface) name tool-descriptor-name))))
(check-exn #rx"references an absent resource: document"
           (lambda () (view iface #:exclude '("document"))))
(check-exn #rx"references an absent resource: later"
           (lambda () (view iface #:exclude '("later"))))
(check-not-exn (lambda () (view iface #:exclude '("document" "open" "index"))))
(define mapped (view iface #:namespace "public/" #:uris (hash "doc:///{id}" "public:///{id}")))
(define mapped-open (named (interface-descriptor-tools mapped) "public/open" tool-descriptor-name))
(check-equal? (resource-descriptor-uri (car (hash-ref (interface-resource-references mapped) mapped-open))) "public:///{id}")
(check-equal? c:touches 0)
(define rt (make-runtime mapped))
(define result (dispatch rt "tools/call" (hasheq '_meta (request-meta) 'name "public/open" 'arguments (hasheq 'id "a b"))))
(check-equal? (hash-ref (car (hash-ref result 'content)) 'uri) "public:///a%20b")
(check-equal? c:touches 1)
(custodian-shutdown-all (runtime-custodian rt))
