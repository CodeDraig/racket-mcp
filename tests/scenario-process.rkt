#lang racket/base
(require rackunit racket/file racket/runtime-path racket/string mcp mcp/scenario mcp/stdio)
(define-runtime-path approval "../examples/approval.rkt")
(define-runtime-path http-fixture "../dev/subscription-server.rkt")
(define directory (make-temporary-file "process-scenario-~a" 'directory))
(define database (build-path directory "state.sqlite"))
(define racket (find-executable-path "racket"))
(define retained #f)
(dynamic-wind void
  (lambda ()
    (define application (build-path directory "approval.rkt"))
    (define marker (build-path directory "checkpoint.txt"))
    (display-to-file
      (string-replace (file->string approval) "(string-append \"Hello, \" name)"
        (format "(begin (call-with-output-file ~s #:exists 'append (lambda (out) (displayln \"checkpoint\" out))) (string-append \"Hello, \" name))"
                (path->string marker))) application)
    (call-with-scenario-process (list racket application "--state" database)
      (lambda (session)
        (set! retained session)
        (define first-pid (scenario-process-pid session))
        (check-true (scenario-process-running? session))
        (define args (hasheq 'name "approve" 'arguments (hasheq 'name "Ada")))
        (define pending (hash-ref (scenario-process-call session "tools/call" args) 'result))
        (check-equal? (hash-ref pending 'resultType) "input_required")
        (scenario-process-kill! session)
        (check-false (scenario-process-running? session))
        (scenario-process-kill! session)
        (check-exn #rx"not running" (lambda () (scenario-process-request session "server/discover")))
        (scenario-process-restart! session)
        (check-true (scenario-process-running? session))
        (check-not-equal? first-pid (scenario-process-pid session))
        (define final
          (hash-ref (scenario-process-call session "tools/call"
            (hash-set (hash-set args 'requestState (hash-ref pending 'requestState))
                      'inputResponses (hasheq 'answer (hasheq 'action "decline")))) 'result))
        (check-equal? (hash-ref final 'structuredContent)
                      (hasheq 'greeting "Hello, Ada" 'answer (hasheq 'action "decline"))))
      #:capabilities (hasheq 'elicitation (hasheq)))
    (check-equal? (file->lines marker) '("checkpoint"))
    (check-false (scenario-process-running? retained))
    (check-exn #rx"closed" (lambda () (scenario-process-restart! retained)))
    (for ([transport '(stdio http)])
      (call-with-scenario-process
        (append (list racket http-fixture) (if (eq? transport 'http) '("http") '()))
        (lambda (session)
          (define h (scenario-process-request session "subscriptions/listen"
            (hasheq 'notifications (hasheq 'toolsListChanged #t))))
          (check-equal? (hash-ref (sync/timeout 3 (request-handle-notifications h)) 'method)
                        "notifications/subscriptions/acknowledged")
          (if (eq? transport 'http) (scenario-process-restart! session) (scenario-process-kill! session))
          (define failed (sync/timeout 2 h))
          (check-true (exn? failed))
          (check-false (exn:fail:request-cancelled? failed))
          (unless (eq? transport 'http) (scenario-process-restart! session))
          (check-eq? (sync/timeout 0 h) failed)
          (check-equal? (hash-ref (hash-ref (scenario-process-call session "tools/call" (hasheq 'name "echo")) 'result) 'content)
                        (list (text-content "alive"))))
        #:transport transport #:shutdown-timeout 0.3))
    (for ([raised (in-list (list #f 'caller-failure))])
      (define escaped #f)
      (define observed
        (with-handlers ([(lambda (_) #t) values])
          (call-with-scenario-process (list racket http-fixture)
            (lambda (session) (set! escaped session) (raise raised)))))
      (check-eq? observed raised)
      (check-false (scenario-process-running? escaped))
      (check-true (exact-integer? (scenario-process-status escaped))))
    (for ([bad (in-list (list '() '(42) (vector racket) '("missing-mcp-scenario-executable")))])
      (check-exn exn:fail? (lambda () (call-with-scenario-process bad void))))
    (check-exn exn:fail? (lambda () (call-with-scenario-process (list racket approval) void #:stderr-limit 0)))
    (check-exn exn:fail? (lambda () (call-with-scenario-process (list racket approval) void #:timeout +inf.0)))
    ;; A valid response written immediately before exit must survive pipe draining.
    (define once (build-path directory "once.rkt"))
    (display-to-file
      "#lang racket/base\n(require json)\n(define req (read-json))\n(write-json (hasheq 'jsonrpc \"2.0\" 'id (hash-ref req 'id) 'result (hasheq 'resultType \"complete\")))\n(newline)(flush-output)\n" once)
    (call-with-scenario-process (list racket once)
      (lambda (session)
        (check-equal? (hash-ref (scenario-process-call session "ping") 'result) (hasheq 'resultType "complete"))
        (scenario-process-kill! session)
        (check-true (exact-integer? (scenario-process-status session)))))
    ;; Stderr capture stays bounded even when a child exceeds pipe capacity.
    (define noisy (build-path directory "noisy.rkt"))
    (display-to-file "#lang racket/base\n(display (make-string 100000 #\\x) (current-error-port))\n(flush-output (current-error-port))\n" noisy)
    (call-with-scenario-process (list racket noisy)
      (lambda (session)
        (define h (scenario-process-request session "server/discover"))
        (check-true (exn? (sync/timeout 3 h)))
        (scenario-process-kill! session)
        (check-equal? (scenario-process-stderr session) (make-bytes 37 120)))
      #:stderr-limit 37))
  (lambda () (delete-directory/files directory)))
