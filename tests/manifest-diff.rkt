#lang racket/base
(require rackunit racket/list mcp/cli mcp/json)
(define (arg name required) (hasheq 'name name 'required required 'schema (hasheq 'known? #t 'value #t)))
(define tool (hasheq 'kind 'tool 'name 'open 'source "old.rkt" 'line 1
                    'arguments (list (arg 'id #t) (arg 'verbose #f))
                    'input-schema (hasheq 'known? #t 'value (hasheq 'source 1))
                    'metadata (hasheq)))
(define (report old new) (car (manifest-diff (list old) (list new))))
(define (change old new) (hash-ref (report old new) 'change))
(check-equal? (change tool (hash-set* tool 'source "new.rkt" 'line 20 'position 200)) "static-manifest-unchanged")
(check-equal? (hash-ref (report tool tool) 'behavior) "not-compared")
(check-equal? (hash-ref (report tool tool) 'changed-fields) '())
(check-not-false (member "input-schema" (hash-ref (report tool tool) 'unchanged-fields)))
(define required (hash-set tool 'arguments (list (arg 'id #t) (arg 'verbose #t))))
(check-equal? (change tool required) "breaking-contract-change")
(check-equal? (hash-ref (report tool required) 'reasons) '("Argument verbose is newly required."))
(check-equal? (change tool (hash-set tool 'arguments (append (hash-ref tool 'arguments) (list (arg 'new #t))))) "breaking-contract-change")
(check-equal? (change tool (hash-set tool 'arguments (append (hash-ref tool 'arguments) (list (arg 'new #f))))) "review-required")
(check-equal? (change tool (hash-set tool 'input-schema (hasheq 'known? #t 'value (hasheq 'source 2)))) "review-required")
(check-equal? (change tool (hash-set tool 'metadata (hasheq 'description (hasheq 'known? #t 'value "changed")))) "review-required")
(define resource (hasheq 'kind 'resource 'name 'document 'metadata (hasheq 'uri (hasheq 'known? #t 'value "doc:///"))))
(check-equal? (change resource (hash-set resource 'metadata (hasheq 'uri (hasheq 'known? #t 'value "other:///")))) "breaking-contract-change")
(check-equal? (change resource (hash-set resource 'metadata (hasheq 'uri (hasheq 'known? #f 'expression "uri")))) "review-required")
(define stage (hasheq 'id 'done 'kind 'complete 'source "old.rkt" 'line 2 'schema (hasheq 'known? #t 'value #t)))
(define workflow (hash-set* tool 'kind 'workflow 'workflow-stages (list stage) 'metadata (hasheq 'version (hasheq 'known? #t 'value "1"))))
(check-equal? (change workflow (hash-set workflow 'workflow-stages (list (hash-set* stage 'source "new.rkt" 'line 9)))) "static-manifest-unchanged")
(check-equal? (hash-ref (report workflow workflow) 'workflow-compatibility) "not-established-from-manifest")
(define changed-version (hash-set workflow 'metadata (hasheq 'version (hasheq 'known? #t 'value "2"))))
(define changed-stage (hash-set workflow 'workflow-stages (list (hash-set stage 'id 'different))))
(check-equal? (hash-ref (report workflow changed-version) 'workflow-compatibility) "incompatible-version")
(check-equal? (hash-ref (report workflow changed-stage) 'workflow-compatibility) "review-required")
(check-equal? (length (manifest-diff (list workflow) (list tool))) 1)
(check-equal? (hash-ref (report workflow tool) 'workflow-compatibility) "workflow-removed")
(check-equal? (hash-ref (report tool workflow) 'workflow-compatibility) "new-workflow")
(define ref (hasheq 'name 'document 'source "provider.rkt" 'line 1 'position 10))
(define referencing (hash-set tool 'resource-references (list ref)))
(check-equal? (change referencing (hash-set tool 'resource-references (list (hash-set ref 'line 40)))) "static-manifest-unchanged")
(check-equal? (change referencing (hash-set tool 'resource-references (list (hash-set ref 'source "other-provider.rkt")))) "review-required")
(check-exn #rx"duplicate declaration identity" (lambda () (manifest-diff (list tool workflow) '())))
(check-exn exn:fail:contract? (lambda () (manifest-diff #f '())))
(define removed (manifest-diff (list tool resource) (list resource)))
(check-equal? (sort (map (lambda (entry) (hash-ref entry 'change)) removed) string<?) '("breaking-removal" "static-manifest-unchanged"))
(check-equal? (manifest-diff (list resource tool) (list resource)) removed)
(check-not-exn (lambda () (json->string removed)))

(check-equal? (change (hash-remove tool 'arguments) required) "review-required")
(check-equal? (change (hash-set tool 'arguments (list (arg 'id #t) (hash-remove (arg 'verbose #f) 'required))) required) "review-required")
