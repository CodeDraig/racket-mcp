#lang racket/base
(require rackunit racket/file racket/path racket/port racket/runtime-path racket/string mcp/json)
(define-runtime-path worker "captured-build-worker.rkt")
(define directory (make-temporary-file "mcp-captured-build-~a" 'directory))
(define application (build-path directory "application.rkt"))
(define helper (build-path directory "helper.rkt"))
(define database (build-path directory "state.sqlite"))
(define completed (build-path directory "completed.txt"))
(define (write-helper value)
  (call-with-output-file helper #:exists 'truncate
    (lambda (out)
      (fprintf out "#lang racket/base\n(provide helper)\n(define (helper) ~s)\n" value))))
(define (run mode [state #f])
  (define-values (process out in err)
    (apply subprocess #f #f #f (find-executable-path "racket") worker application database mode
           (if state (list state) '())))
  (close-output-port in)
  (define watchdog (thread (lambda () (unless (sync/timeout 30 process) (subprocess-kill process #t)))))
  (define stdout (port->string out))
  (define stderr (port->string err))
  (subprocess-wait process) (thread-wait watchdog)
  (close-input-port out) (close-input-port err)
  (values (subprocess-status process) stdout stderr))
(define (call [state #f])
  (define-values (status stdout stderr) (run "sealed" state))
  (unless (zero? status) (error 'captured-build-restart "worker failed: ~a" stderr))
  (string->json (string-trim stdout)))
(dynamic-wind void
  (lambda ()
    (write-helper "before")
    (call-with-output-file application
      (lambda (out)
        (displayln "#lang racket/base\n(require mcp \"helper.rkt\")\n(provide execute)" out)
        (write
          `(workflow (work) #:version "1"
             (checkpoint [saved String] (helper))
             (await-input [answer Any]
               (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
             (text-result
               (begin
                 (call-with-output-file ,(path->string completed) #:exists 'append
                   (lambda (out) (displayln (helper) out)))
                 (helper)))) out)
        (newline out)
        (displayln
          "(define (execute database state)
             (define store (open-sqlite-store database))
             (dynamic-wind void
               (lambda ()
                 (with-handlers ([exn:fail:recovery? (lambda (e) (hasheq 'rejected #t 'message (exn-message e)))])
                   (run-workflow (tool-descriptor-workflow work) store (hasheq)
                     #:principal \"alice\" #:state state
                     #:responses (if state (hasheq 'answer (hasheq 'action \"accept\" 'content (hasheq 'ok #t))) (hasheq)))))
               (lambda () (close-store! store))))" out)))
    (define-values (unsealed-status _out unsealed-error) (run "unsealed"))
    (check-not-equal? unsealed-status 0)
    (check-true (string-contains? unsealed-error "executable capture is not sealed"))
    (check-false (file-exists? completed))
    (define initial (call))
    (check-equal? (hash-ref initial 'resultType) "input_required")
    (define state (hash-ref initial 'requestState))
    (define unchanged (call state))
    (check-equal? (hash-ref unchanged 'resultType) "complete")
    (check-equal? (file->string completed) "before\n")
    (define pending (call))
    (check-equal? (hash-ref pending 'resultType) "input_required")
    (write-helper "after")
    (define rejected-pending (call (hash-ref pending 'requestState)))
    (check-true (hash-ref rejected-pending 'rejected #f))
    (check-equal? (file->string completed) "before\n")
    (define rejected (call state))
    (check-true (hash-ref rejected 'rejected #f))
    (check-equal? (file->string completed) "before\n")
    (define fresh (call))
    (check-equal? (hash-ref fresh 'resultType) "input_required")
    (define fresh-complete (call (hash-ref fresh 'requestState)))
    (check-equal? (hash-ref fresh-complete 'resultType) "complete")
    (check-equal? (file->string completed) "before\nafter\n"))
  (lambda () (delete-directory/files directory)))
