#lang racket/base
(require rackunit racket/async-channel mcp mcp/scenario mcp/stdio mcp/subscription mcp/authorization mcp/http)
(define reads 0)
(resource (secret [id String]) #:uri "private:///{id}"
  (set! reads (add1 reads)) "secret")
(tool (echo) (text-result "ok"))
(define iface
  (view (make-interface #:resources (list secret) #:tools (list echo))
    #:uris (hash "private:///{id}" "mapped:///{id}") #:require-scopes '("read")))
(define (who scopes) (verified-principal "alice" "https://issuer.example" "https://api.example" scopes 100))
(for ([config '((local #f) (stdio #f) (http #f) (http #t))])
  (define clock (make-manual-clock))
  (define permitted #t)
  (define (run principal proc)
    (call-with-scenario-session iface proc #:principal principal #:clock clock
      #:transport (car config) #:sse? (cadr config)
      #:authorize (lambda (_principal method _params)
                    (or permitted (not (member method '("resources/read" "tools/list")))))))
  (define (reject session filter code)
    (define h (scenario-request session "subscriptions/listen" (hasheq 'notifications filter)))
    (define outcome (sync/timeout 2 h))
    (define response
      (if (exn:fail:http:authorization? outcome)
          (string->json (bytes->string/utf-8 (exn:fail:http:authorization-body outcome)))
          outcome))
    (check-equal? (hash-ref (hash-ref response 'error) 'code) code)
    (check-false (sync/timeout 0 (request-handle-notifications h))))
  (run (who '())
    (lambda (session)
      ;; A remapped resource keeps its declaration's scope requirement.
      (reject session (hasheq 'resourceSubscriptions '("mapped:///one")) -32001)))
  (run (who '("read"))
    (lambda (session)
      (for ([filter (in-list (list (hasheq 'toolsListChanged "yes")
                                   (hasheq 'promptsListChanged 1)
                                   (hasheq 'resourcesListChanged 'null)
                                   (hasheq 'resourceSubscriptions #f)
                                   (hasheq 'resourceSubscriptions "mapped:///one")
                                   (hasheq 'resourceSubscriptions '("mapped:///one" 42))))])
        (reject session filter -32602))
      (set! permitted #f)
      (reject session (hasheq 'toolsListChanged #t) -32001)
      (reject session (hasheq 'resourceSubscriptions '("mapped:///one")) -32001)
      (set! permitted #t)
      (define h (scenario-request session "subscriptions/listen"
        (hasheq 'notifications (hasheq 'toolsListChanged #t 'resourceSubscriptions '("mapped:///one" "mapped:///one")))))
      (define notices (request-handle-notifications h))
      (define ack (sync/timeout 2 notices))
      (check-equal? (hash-ref (hash-ref ack 'params) 'notifications)
                    (hasheq 'toolsListChanged #t 'resourceSubscriptions '("mapped:///one")))
      (define hub (runtime-subscriptions (scenario-session-runtime session)))
      (define (publish)
        (publish-change! hub "notifications/resources/updated" (hasheq 'uri "mapped:///one"))
        (publish-change! hub "notifications/tools/list_changed" (hasheq)))
      (define (expect-events)
        (check-equal? (hash-ref (sync/timeout 2 notices) 'method) "notifications/resources/updated")
        (check-equal? (hash-ref (sync/timeout 2 notices) 'method) "notifications/tools/list_changed"))
      (publish)
      (expect-events)
      (set! permitted #f)
      (publish)
      (check-false (sync/timeout 0.1 notices))
      (set! permitted #t)
      (publish)
      (expect-events)
      (void (manual-clock-advance! clock 101))
      (publish)
      (check-false (sync/timeout 0.1 notices))
      (close-subscriptions! hub)
      (check-equal? (hash-ref (hash-ref (sync/timeout 2 h) 'result) 'resultType) "complete"))))
(check-equal? reads 0)
