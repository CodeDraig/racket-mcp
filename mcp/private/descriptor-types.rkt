#lang racket/base
(require "../schema.rkt")
(provide (struct-out server-descriptor) (struct-out argument) (struct-out prompt-argument)
         (struct-out tool-descriptor) (struct-out resource-descriptor) (struct-out prompt-descriptor)
         (struct-out interface-descriptor) (struct-out scoped-interface) (struct-out resource-ref)
         rename-prompt-descriptor prompt-declaration-identity
         interface-requirements interface-adapter-bindings interface-resource-references interface-adapter-restrictions)
(struct server-descriptor (name version instructions) #:transparent
  #:guard
  (lambda (name version instructions who)
    (unless (and (string? name) (string? version) (or (not instructions) (string? instructions)))
      (error who "server name/version must be strings; instructions must be a string or #f"))
    (values name version (or instructions ""))))
(struct argument (name schema optional? default) #:transparent)
(struct prompt-argument argument (codec) #:transparent)
(struct tool-descriptor (name description arguments input-schema output-schema handler annotations workflow execution raw? changes) #:transparent)
(struct resource-descriptor (name uri description mime-type handler arguments matcher identity workflow renderer depends-on ttl-ms) #:transparent
  #:property prop:procedure
  (lambda (self . args) (resource-ref self args)))
(struct prompt-descriptor (name description arguments handler workflow) #:transparent)
(struct mounted-prompt-descriptor prompt-descriptor (identity) #:transparent)
(define (prompt-declaration-identity prompt)
  (if (mounted-prompt-descriptor? prompt) (mounted-prompt-descriptor-identity prompt) prompt))
(define (rename-prompt-descriptor prompt name)
  (mounted-prompt-descriptor name (prompt-descriptor-description prompt)
    (prompt-descriptor-arguments prompt) (prompt-descriptor-handler prompt)
    (prompt-descriptor-workflow prompt) (prompt-declaration-identity prompt)))
(struct interface-descriptor (server tools resources prompts completions) #:transparent)
(struct scoped-interface interface-descriptor (requirements adapters references restrictions) #:transparent)
(define (interface-requirements interface)
  (if (scoped-interface? interface) (scoped-interface-requirements interface) (hasheq)))
(define (interface-adapter-bindings interface)
  (if (scoped-interface? interface) (scoped-interface-adapters interface) (hasheq)))
(define (interface-resource-references interface)
  (if (scoped-interface? interface) (scoped-interface-references interface) (hasheq)))
(define (interface-adapter-restrictions interface)
  (if (scoped-interface? interface) (scoped-interface-restrictions interface) (hasheq)))
(struct resource-ref (declaration arguments) #:transparent
  #:guard
  (lambda (declaration arguments who)
    (unless (resource-descriptor? declaration)
      (raise-argument-error who "resource-descriptor?" declaration))
    (unless (list? arguments) (raise-argument-error who "list?" arguments))
    (define declared (resource-descriptor-arguments declaration))
    (unless (= (length arguments) (length declared))
      (error who "incorrect resource-reference arity"))
    (for ([argument (in-list declared)] [value (in-list arguments)])
      (unless (valid? (argument-schema argument) value)
        (error who "invalid reference argument ~a" (argument-name argument))))
    (values declaration arguments)))
