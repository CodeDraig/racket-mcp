#lang racket/base
(require "private/workflow-contract.rkt" (submod "codec.rkt" private) "private/workflow-types.rkt" "completion.rkt" "private/handler-info.rkt" "private/adapter-policy.rkt")
(require racket/list racket/match "schema.rkt" "json.rkt" "uri-template.rkt" "header-schema.rkt" "rendering.rkt" "codec.rkt" "error.rkt" "presentation.rkt" "effect.rkt" (only-in "authorization.rkt" check-scopes!))
(provide (struct-out server-descriptor) (struct-out argument) (struct-out prompt-argument) (struct-out tool-descriptor)
         (struct-out resource-descriptor) (struct-out prompt-descriptor)
         (struct-out interface-descriptor) (struct-out resource-ref) (struct-out request-context)
         interface-requirements interface-adapter-bindings interface-adapter-restrictions interface-effect-summary interface-resource-references make-interface make-tool make-resource make-prompt bind-arguments encode-prompt-arguments prompt-codec-fingerprint
         text-content text-result structured-result error-result resource-link
         current-request-context current-interface current-resource-resolver resource-uri link embed
         interface-requires-state?)
(struct server-descriptor (name version instructions) #:transparent
  #:guard
  (lambda (name version instructions who)
    (unless (and (string? name) (string? version) (or (not instructions) (string? instructions)))
      (error who "server name/version must be strings; instructions must be a string or #f"))
    (values name version (or instructions ""))))
(struct argument (name schema optional? default) #:transparent)
(struct prompt-argument argument (codec) #:transparent)
(struct tool-descriptor (name description arguments input-schema output-schema handler annotations workflow execution raw? changes) #:transparent)
(struct resource-descriptor (name uri description mime-type handler arguments matcher identity workflow renderer depends-on ttl-ms) #:transparent
  #:property prop:procedure
  (lambda (self . args) (resource-ref self args)))
(struct prompt-descriptor (name description arguments handler workflow) #:transparent)
(struct mounted-prompt-descriptor prompt-descriptor (identity) #:transparent)
(define (prompt-declaration-identity prompt)
  (if (mounted-prompt-descriptor? prompt) (mounted-prompt-descriptor-identity prompt) prompt))
(define (rename-prompt-descriptor prompt name)
  (mounted-prompt-descriptor name (prompt-descriptor-description prompt)
    (prompt-descriptor-arguments prompt) (prompt-descriptor-handler prompt)
    (prompt-descriptor-workflow prompt) (prompt-declaration-identity prompt)))
(module* prompt-identity #f
  (provide rename-prompt-descriptor))
(struct interface-descriptor (server tools resources prompts completions) #:transparent)
(struct scoped-interface interface-descriptor (requirements adapters references restrictions) #:transparent)
(define (interface-requires-state? interface)
  (for/or ([declarations (in-list (list (interface-descriptor-tools interface)
                                      (interface-descriptor-resources interface)
                                      (interface-descriptor-prompts interface)))]
           [workflow-of (in-list (list tool-descriptor-workflow resource-descriptor-workflow prompt-descriptor-workflow))]
           [handler-of (in-list (list tool-descriptor-handler resource-descriptor-handler prompt-descriptor-handler))])
    (for/or ([declaration (in-list declarations)])
      (or (and (workflow-of declaration) #t)
          (handler-requires-state? (handler-of declaration))))))
(define (interface-requirements interface)
  (if (scoped-interface? interface) (scoped-interface-requirements interface) (hasheq)))
(define (interface-adapter-bindings interface)
  (if (scoped-interface? interface) (scoped-interface-adapters interface) (hasheq)))
(define (interface-resource-references interface)
  (if (scoped-interface? interface) (scoped-interface-references interface) (hasheq)))
(define (interface-adapter-restrictions interface)
  (if (scoped-interface? interface) (scoped-interface-restrictions interface) (hasheq)))
(define (interface-effect-summary interface)
  (append-map
    (lambda (declarations kind name-of workflow-of)
      (for/list ([declaration (in-list declarations)])
        (define allowed (hash-ref (interface-adapter-restrictions interface) declaration #f))
        (define summary
          (hasheq 'kind kind 'name (name-of declaration) 'hostEffects "unknown"
                  'declaredAdapters (map symbol->string (declared-adapters (workflow-of declaration)))
                  'adapterPolicy (if allowed "allowlist" "unrestricted")))
        (if allowed (hash-set summary 'allowedAdapters (map symbol->string allowed)) summary)))
    (list (interface-descriptor-tools interface) (interface-descriptor-resources interface) (interface-descriptor-prompts interface))
    '("tool" "resource" "prompt")
    (list tool-descriptor-name resource-descriptor-name prompt-descriptor-name)
    (list tool-descriptor-workflow resource-descriptor-workflow prompt-descriptor-workflow)))
(struct resource-ref (declaration arguments) #:transparent
  #:guard
  (lambda (declaration arguments who)
    (unless (resource-descriptor? declaration)
      (raise-argument-error who "resource-descriptor?" declaration))
    (unless (list? arguments) (raise-argument-error who "list?" arguments))
    (define declared (resource-descriptor-arguments declaration))
    (unless (= (length arguments) (length declared))
      (error who "incorrect resource-reference arity"))
    (for ([argument (in-list declared)] [value (in-list arguments)])
      (unless (valid? (argument-schema argument) value)
        (error who "invalid reference argument ~a" (argument-name argument))))
    (values declaration arguments)))
(struct request-context (principal capabilities request-id cancelled? notify) #:transparent)
(define current-request-context (make-parameter #f))
(define current-interface (make-parameter #f))
(define current-resource-resolver (make-parameter (lambda (_) (error 'embed "no active resource resolver"))))
(define (check-arguments! who arguments)
  (unless (and (list? arguments) (andmap argument? arguments))
    (raise-argument-error who "list of argument descriptors" arguments))
  (define seen (make-hasheq))
  (for ([a (in-list arguments)])
    (unless (symbol? (argument-name a)) (error who "argument name must be a symbol"))
    (unless (symbol-interned? (argument-name a))
      (error who "argument name must be an interned symbol"))
    (when (hash-has-key? seen (argument-name a)) (error who "duplicate argument: ~a" (argument-name a)))
    (hash-set! seen (argument-name a) #t)
    (unless (boolean? (argument-optional? a)) (error who "argument optional flag must be a boolean"))
    (when (argument-default a)
      (unless (and (procedure? (argument-default a)) (procedure-arity-includes? (argument-default a) 1))
        (error who "argument default must accept previously bound arguments"))
      (unless (argument-optional? a) (error who "argument with a default must be optional")))
    (check-schema! (argument-schema a))))
(define (schema-object schema)
  (cond [(eq? schema #t) (hasheq)]
        [(eq? schema #f) (hasheq 'not (hasheq))]
        [else schema]))
(define (check-tool-input! schema)
  (check-schema! schema)
  (unless (and (hash? schema) (equal? (hash-ref schema 'type #f) "object"))
    (error 'make-tool "input schema must declare type object at its root")))
(define (check-tool-output! schema)
  (when schema
    (check-schema! schema)
    (unless (hash? schema) (error 'make-tool "stored output schema must be an object or absent"))))
(define (check-header! who name description)
  (unless (and (string? name) (positive? (string-length name)))
    (error who "expected nonempty wire name"))
  (unless (string? description) (error who "description must be a string")))
(define (check-procedure! who role value arity)
  (unless (and (procedure? value) (procedure-arity-includes? value arity))
    (error who "~a must accept ~a positional argument(s) without required keywords" role arity)))
(define (check-workflow! who workflow)
  (unless (or (not workflow) (workflow-descriptor? workflow))
    (error who "workflow must be a workflow descriptor or #f"))
  (when workflow (check-workflow-descriptor! workflow who)))
(define (check-annotations! who annotations)
  (unless (hash? annotations) (error who "annotations must be a JSON object"))
  ;; Bound host-value traversal before encoding: mutable cyclic hashes must not
  ;; make interface construction recurse forever. Unknown fields remain data.
  (define active (make-hasheq))
  (define nodes 0)
  (define (visit value depth)
    (set! nodes (add1 nodes))
    (when (or (> nodes 50000) (> depth 128))
      (error who "annotation construction limit exceeded"))
    (cond [(hash? value)
           (when (hash-ref active value #f) (error who "cyclic annotation value"))
           (hash-set! active value #t)
           (for ([(key child) (in-hash value)])
             (unless (and (symbol? key) (symbol-interned? key))
               (error who "annotation object keys must be interned symbols"))
             (visit child (add1 depth)))
           (hash-remove! active value)]
          [(list? value) (for ([child (in-list value)]) (visit child (add1 depth)))]
          [(rational? value) (void (json->string value))]
          [(not (or (string? value) (boolean? value) (eq? value json-null)))
           (error who "annotations contain a non-JSON value")]))
  (visit annotations 0)
  (for ([key '(readOnlyHint destructiveHint idempotentHint openWorldHint)])
    (when (and (hash-has-key? annotations key) (not (boolean? (hash-ref annotations key))))
      (error who "annotation ~a must be a boolean" key)))
  (when (and (hash-has-key? annotations 'title) (not (string? (hash-ref annotations 'title))))
    (error who "annotation title must be a string")))
(define (check-tool-contract! who tool)
  (check-header! who (tool-descriptor-name tool) (tool-descriptor-description tool))
  (check-procedure! who "tool handler" (tool-descriptor-handler tool) 1)
  (check-workflow! who (tool-descriptor-workflow tool))
  (unless (boolean? (tool-descriptor-raw? tool)) (error who "raw? must be a boolean"))
  (define execution (tool-descriptor-execution tool))
  (unless (memq execution '(mrtr task task-optional))
    (error who "execution must be mrtr, task, or task-optional"))
  (when (and (not (eq? execution 'mrtr)) (not (tool-descriptor-workflow tool)))
    (error who "task execution requires a workflow"))
  (check-procedure! who "changes" (tool-descriptor-changes tool) 2)
  (check-annotations! who (tool-descriptor-annotations tool)))
(define (check-resource-contract! who resource)
  (check-header! who (resource-descriptor-name resource) (resource-descriptor-description resource))
  (unless (string? (resource-descriptor-mime-type resource)) (error who "MIME type must be a string"))
  (check-workflow! who (resource-descriptor-workflow resource))
  (unless (and (resource-descriptor-workflow resource) (not (resource-descriptor-handler resource)))
    (check-procedure! who "resource handler" (resource-descriptor-handler resource)
                      (length (resource-descriptor-arguments resource))))
  (check-procedure! who "resource matcher" (resource-descriptor-matcher resource) 1)
  (check-procedure! who "depends-on" (resource-descriptor-depends-on resource) 1)
  (unless (exact-nonnegative-integer? (resource-descriptor-ttl-ms resource))
    (error who "ttl-ms must be an exact nonnegative integer"))
  (define renderer (resource-descriptor-renderer resource))
  (when renderer
    (unless (resource-renderer? renderer) (error who "expected a named resource renderer"))
    (unless (equal? (resource-descriptor-mime-type resource) (resource-renderer-mime-type renderer))
      (error who "resource and renderer MIME types disagree"))))
(define (check-prompt-contract! who prompt)
  (check-header! who (prompt-descriptor-name prompt) (prompt-descriptor-description prompt))
  (check-workflow! who (prompt-descriptor-workflow prompt))
  (unless (and (prompt-descriptor-workflow prompt) (not (prompt-descriptor-handler prompt)))
    (check-procedure! who "prompt handler" (prompt-descriptor-handler prompt) 1))
  (for ([a (in-list (prompt-descriptor-arguments prompt))])
    (cond [(prompt-argument? a)
           (unless (string-codec? (prompt-argument-codec a)) (error who "expected an explicit string codec"))
           (check-string-codec! (prompt-argument-codec a) who)]
          [else
           (define type (and (hash? (argument-schema a)) (hash-ref (argument-schema a) 'type #f)))
           (when (and type (not (member "string" (if (list? type) type (list type)))))
             (error who "non-string argument ~a requires a string codec" (argument-name a)))])))
(define (make-tool name arguments handler #:description [description ""] #:output [output missing] #:annotations [annotations (hasheq)] #:workflow [workflow #f] #:execution [execution 'mrtr]
                   #:input-schema [input-schema missing] #:raw? [raw? #f] #:changes [changes (lambda (_args _result) '())])
  (check-arguments! 'make-tool arguments)
  (define normalized-output (if (missing? output) #f (schema-object output)))
  (check-tool-output! normalized-output)
  (define input
    (cond [(missing? input-schema)
           (object-schema (for/hasheq ([a (in-list arguments)]) (values (argument-name a) (argument-schema a)))
                          #:required (for/list ([a (in-list arguments)] #:unless (argument-optional? a)) (symbol->string (argument-name a))))]
          [(boolean? input-schema) (hash-set (schema-object input-schema) 'type "object")]
          [else input-schema]))
  (check-tool-input! input) (header-bindings input)
  (define descriptor (tool-descriptor name description arguments
                   input normalized-output handler annotations workflow execution raw? changes))
  (check-tool-contract! 'make-tool descriptor)
  descriptor)
(define (make-resource name uri handler #:description [description ""] #:mime-type [mime-type #f] #:render [renderer #f]
                       #:arguments [arguments '()] #:matcher [matcher #f] #:workflow [workflow #f] #:depends-on [depends-on (lambda (_args) '())] #:ttl-ms [ttl-ms 0])
  (check-arguments! 'make-resource arguments)
  (check-resource-template! uri arguments)
  (when renderer
    (unless (resource-renderer? renderer) (error 'make-resource "expected a named resource renderer"))
    (when (and mime-type (not (equal? mime-type (resource-renderer-mime-type renderer))))
      (error 'make-resource "resource and renderer MIME types disagree")))
  (define descriptor
    (resource-descriptor name uri description (or mime-type (and renderer (resource-renderer-mime-type renderer)) "text/plain")
                         handler arguments (or matcher (uri-template-matcher uri)) (gensym 'resource) workflow renderer depends-on ttl-ms))
  (check-resource-contract! 'make-resource descriptor)
  descriptor)
(define (check-resource-template! uri arguments)
  (for ([variable (in-list (uri-template-variables uri))])
    (unless (memq variable (map argument-name arguments))
      (error 'resource "URI template references an undeclared argument: ~a" variable))))
(define (make-prompt name arguments handler #:description [description ""] #:workflow [workflow #f])
  (check-arguments! 'make-prompt arguments)
  (define descriptor (prompt-descriptor name description arguments handler workflow))
  (check-prompt-contract! 'make-prompt descriptor)
  descriptor)
(define (prompt-codec-fingerprint descriptor)
  (json->string
   (for/list ([a (in-list (prompt-descriptor-arguments descriptor))] #:when (prompt-argument? a))
     (define codec (prompt-argument-codec a))
     (hasheq 'argument (symbol->string (argument-name a)) 'name (string-codec-name codec)
             'version (string-codec-version codec) 'schema (string-codec-schema codec)))))
(define (encode-prompt-arguments descriptor arguments)
  (unless (hash? arguments) (raise-argument-error 'encode-prompt-arguments "hash?" arguments))
  (for/hasheq ([(name value) (in-hash arguments)] #:unless (missing? value))
    (define a (findf (lambda (a) (eq? name (argument-name a))) (prompt-descriptor-arguments descriptor)))
    (unless a (error 'encode-prompt-arguments "unknown argument ~a" name))
    (unless (valid? (argument-schema a) value) (error 'encode-prompt-arguments "invalid argument ~a" name))
    (define wire (if (prompt-argument? a) (encode-string-value (prompt-argument-codec a) value) value))
    (unless (string? wire) (error 'encode-prompt-arguments "non-string argument requires a codec"))
    (values name wire)))
(define (make-interface #:server [server #f] #:tools [tools '()] #:resources [resources '()] #:prompts [prompts '()] #:completions [completions '()] #:requirements [requirements (hasheq)] #:adapter-bindings [adapters (hasheq)] #:references [references (hasheq)] #:adapter-restrictions [restrictions (hasheq)])
  (when server
    (unless (server-descriptor? server) (raise-argument-error 'make-interface "server-descriptor? or #f" server))
    (unless (and (string? (server-descriptor-name server))
                 (string? (server-descriptor-version server))
                 (string? (server-descriptor-instructions server)))
      (error 'make-interface "server name, version and instructions must be strings")))
  (for ([values (in-list (list tools resources prompts completions))]
        [predicate (in-list (list tool-descriptor? resource-descriptor? prompt-descriptor? completion-descriptor?))]
        [kind '(tools resources prompts completions)])
    (unless (and (list? values) (andmap predicate values))
      (error 'make-interface "~a must be a list of matching descriptors" kind)))

  (for ([descriptors (in-list (list tools resources prompts))]
        [arguments-of (in-list (list tool-descriptor-arguments resource-descriptor-arguments prompt-descriptor-arguments))])
    (for ([descriptor (in-list descriptors)])
      (check-arguments! 'make-interface (arguments-of descriptor))))
  (for ([tool (in-list tools)])
    (check-tool-contract! 'make-interface tool)
    (check-tool-input! (tool-descriptor-input-schema tool))
    (header-bindings (tool-descriptor-input-schema tool))
    (check-tool-output! (tool-descriptor-output-schema tool)))
  (for ([prompt (in-list prompts)]) (check-prompt-contract! 'make-interface prompt))
  (for ([resource (in-list resources)])
    (check-resource-contract! 'make-interface resource)
    (check-resource-template! (resource-descriptor-uri resource) (resource-descriptor-arguments resource)))
  (for ([xs (list tools resources prompts)] [name (list tool-descriptor-name resource-descriptor-uri prompt-descriptor-name)])
    (define seen (make-hash))
    (for ([x (in-list xs)]) (when (hash-has-key? seen (name x)) (error 'make-interface "duplicate published identity: ~a" (name x))) (hash-set! seen (name x) #t)))
  (for* ([index (in-range (length resources))]
         [other (in-list (drop resources (add1 index)))])
    (define resource (list-ref resources index))
    (define witness (uri-matchers-overlap (resource-descriptor-matcher resource) (resource-descriptor-matcher other)))
    (when (string? witness)
      (error 'make-interface "overlapping resource URI routes ~a and ~a; both match ~s"
             (resource-descriptor-uri resource) (resource-descriptor-uri other) witness)))
  (define completion-routes (make-hasheq))
  (define checked-completions
   (for/list ([completion (in-list completions)])
    (unless (completion-descriptor? completion)
      (raise-argument-error 'make-interface "completion-descriptor?" completion))
    (define original (completion-descriptor-target completion))
    (define target
      (if (resource-descriptor? original)
          (let ([candidates
                 (filter (lambda (resource)
                           (eq? (resource-descriptor-identity resource)
                                (resource-descriptor-identity original))) resources)])
            (when (null? candidates) (error 'make-interface "completion references an absent resource"))
            (unless (null? (cdr candidates))
              (error 'make-interface "completion references an ambiguous mounted resource"))
            (car candidates))
          (if (prompt-descriptor? original)
              (let ([candidates
                     (filter (lambda (prompt)
                               (eq? (prompt-declaration-identity prompt)
                                    (prompt-declaration-identity original))) prompts)])
                (when (null? candidates) (error 'make-interface "completion references an absent prompt"))
                (unless (null? (cdr candidates))
                  (error 'make-interface "completion references an ambiguous mounted prompt"))
                (car candidates)) original)))
    (define argument-name* (completion-descriptor-argument completion))
    (define arguments
      (cond [(resource-descriptor? target)
             (unless (memq target resources) (error 'make-interface "completion references an absent resource"))
             (resource-descriptor-arguments target)]
            [(prompt-descriptor? target)
             (unless (memq target prompts) (error 'make-interface "completion references an absent prompt"))
             (prompt-descriptor-arguments target)]
            [else (error 'make-interface "completion target must be a resource or prompt")]))
    (unless (memq argument-name* (map argument-name arguments))
      (error 'make-interface "completion references an unknown argument: ~a" argument-name*))
    (define previous (hash-ref completion-routes target '()))
    (when (memq argument-name* previous)
      (error 'make-interface "duplicate completion for argument: ~a" argument-name*))
    (hash-set! completion-routes target (cons argument-name* previous))
    (if (eq? target original) completion
        (struct-copy completion-descriptor completion [target target]))))
  (unless (hash? requirements) (raise-argument-error 'make-interface "hash?" requirements))
  (define declarations (append tools resources prompts))
  (define checked
    (for/hasheq ([(target scopes) (in-hash requirements)])
      (unless (memq target declarations) (error 'make-interface "scope requirement references an absent declaration"))
      (check-scopes! scopes)
      (values target (remove-duplicates (map string->immutable-string scopes)))))
  (unless (hash? adapters) (raise-argument-error 'make-interface "hash?" adapters))
  (define checked-adapters
    (for/hasheq ([(target bindings) (in-hash adapters)])
      (unless (memq target declarations) (error 'make-interface "adapter binding references an absent declaration"))
      (values target (check-adapter-bindings bindings))))
  (unless (hash? restrictions) (raise-argument-error 'make-interface "hash?" restrictions))
  (define checked-restrictions
    (for/hasheq ([(target allowed) (in-hash restrictions)])
      (unless (memq target declarations) (error 'make-interface "adapter restriction references an absent declaration"))
      (values target (check-allowed-adapters allowed))))
  (unless (hash? references) (raise-argument-error 'make-interface "hash?" references))
  (define collected-references
    (for/fold ([collected (for/hasheq ([(source targets) (in-hash references)])
                           (values source targets))])
              ([source (in-list declarations)])
      (define handler
        (cond [(tool-descriptor? source) (tool-descriptor-handler source)]
              [(resource-descriptor? source) (resource-descriptor-handler source)]
              [else (prompt-descriptor-handler source)]))
      (define workflow
        (cond [(tool-descriptor? source) (tool-descriptor-workflow source)]
              [(resource-descriptor? source) (resource-descriptor-workflow source)]
              [else (prompt-descriptor-workflow source)]))
      (define inferred (append (handler-resource-references handler)
                               (handler-resource-references workflow)))
      (if (null? inferred) collected
          (hash-update collected source (lambda (targets) (append targets inferred)) '()))))
  (define checked-references
    (for/hasheq ([(source targets) (in-hash collected-references)])
      (unless (memq source declarations) (error 'make-interface "resource-reference source is an absent declaration"))
      (define source-name
        (cond [(tool-descriptor? source) (tool-descriptor-name source)]
              [(resource-descriptor? source) (resource-descriptor-name source)]
              [else (prompt-descriptor-name source)]))
      (unless (and (list? targets) (andmap resource-descriptor? targets))
        (error 'make-interface "resource references must be a list of resource descriptors"))
      (define resolved
        (for/list ([target (in-list targets)])
          (define candidates
            (filter (lambda (resource) (eq? (resource-descriptor-identity resource) (resource-descriptor-identity target))) resources))
          (when (null? candidates)
            (error 'make-interface "declaration ~a references an absent resource: ~a" source-name (resource-descriptor-name target)))
          (unless (null? (cdr candidates))
            (error 'make-interface "declaration ~a references an ambiguous mounted resource: ~a" source-name (resource-descriptor-name target)))
          (car candidates)))
      (values source (remove-duplicates resolved eq?))))
  (scoped-interface server tools resources prompts checked-completions checked checked-adapters checked-references checked-restrictions))
(define (bind-arguments arguments input)
  (unless (hash? input) (error 'bind-arguments "arguments must be an object"))
  (for/fold ([bound (hasheq)]) ([a (in-list arguments)])
    (define supplied (hash-ref input (argument-name a) missing))
    (define v (cond [(not (missing? supplied)) (if (prompt-argument? a) (with-handlers ([exn:fail? (lambda (e) (mcp-error -32602 (format "Invalid string argument ~a" (argument-name a))))])
                      (decode-string-value (prompt-argument-codec a) supplied)) supplied)]
                    [(argument-default a) ((argument-default a) bound)]
                    [(argument-optional? a) missing]
                    [else (error 'bind-arguments "missing argument ~a" (argument-name a))]))
    (unless (or (missing? v) (valid? (argument-schema a) v)) (error 'bind-arguments "invalid argument ~a" (argument-name a)))
    (hash-set bound (argument-name a) v)))
(define (text-content text) (hasheq 'type "text" 'text text))
(define (text-result text) (hasheq 'resultType "complete" 'content (list (text-content text))))
(define (structured-result value #:content [content '()]) (hasheq 'resultType "complete" 'content content 'structuredContent value))
(define (error-result message) (hash-set (text-result message) 'isError #t))
(define (resource-link ref)
  (define d (resolve-resource ref))
  (hasheq 'type "resource_link" 'uri (resource-uri ref) 'name (resource-descriptor-name d) 'mimeType (resource-descriptor-mime-type d)))
(define (resolve-resource ref)
  (define original (resource-ref-declaration ref))
  (cond
    [(current-interface)
     (define candidates
       (filter (lambda (d) (eq? (resource-descriptor-identity original)
                                (resource-descriptor-identity d)))
               (interface-descriptor-resources (current-interface))))
     (cond [(null? candidates) (error 'resource-uri "referenced resource is absent from the interface")]
           [(pair? (cdr candidates)) (error 'resource-uri "referenced resource has ambiguous mounts in the interface")]
           [else (car candidates)])]
    [else original]))
(define (resource-uri ref)
  (define original (resource-ref-declaration ref))
  (define d (resolve-resource ref))
  (uri-template-expand (resource-descriptor-uri d)
                       (for/hasheq ([a (in-list (resource-descriptor-arguments original))] [v (in-list (resource-ref-arguments ref))])
                         (values (argument-name a) v))))
(define link resource-link)
(define (embed ref)
  (if (current-render-capture) (deferred-embedding (resource-uri ref)) ((current-resource-resolver) ref)))
