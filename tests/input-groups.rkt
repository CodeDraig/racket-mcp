#lang racket/base
(require rackunit racket/file mcp)
(define evaluations 0)
(define (form field)
  (set! evaluations (add1 evaluations))
  (hasheq 'mode "form" 'message "Enter a value" 'requestedSchema (object-schema (hasheq field String))))
(workflow (collect) #:version "1"
  (await-input ([name Any (form 'name)] [color Any (form 'color)]))
  (structured-result (hasheq 'name name 'color color)))
(define path (make-temporary-file "mcp-inputs-~a.sqlite"))
(define store (open-sqlite-store path))
(define params (hasheq '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))) 'name "collect"))
(define (call p) (dispatch (make-runtime (make-interface #:tools (list collect)) #:store store) "tools/call" p))
(define first (call params))
(check-equal? (sort (hash-keys (hash-ref first 'inputRequests)) symbol<?) '(color name))
(check-equal? evaluations 2)
(define retry (hash-set params 'requestState (hash-ref first 'requestState)))
(check-exn exn:fail:mcp? (lambda () (call (hash-set retry 'inputResponses (hasheq 'name (hasheq 'action "accept" 'content (hasheq 'name 1)))))))
(define name-answer (hasheq 'action "accept" 'content (hasheq 'name "Ada")))
(define partial (call (hash-set retry 'inputResponses (hasheq 'name name-answer))))
(check-equal? (hash-keys (hash-ref partial 'inputRequests)) '(color))
(check-equal? (hash-ref partial 'requestState) (hash-ref first 'requestState))
(close-store! store)
(set! store (open-sqlite-store path))
(check-equal? (call retry) partial)
(check-equal? evaluations 2)
(check-exn exn:fail:mcp? (lambda () (call (hash-set retry 'inputResponses (hasheq 'name (hasheq 'action "decline"))))))
(define result (call (hash-set retry 'inputResponses (hasheq 'color (hasheq 'action "cancel")))))
(check-equal? (hash-ref result 'structuredContent) (hasheq 'name name-answer 'color (hasheq 'action "cancel")))
(check-equal? (call retry) result)
(check-equal? evaluations 2)
(close-store! store)
(delete-file path)
