#lang racket/base
(require rackunit racket/async-channel mcp mcp/stdio mcp/subscription mcp/private/progress)
(define events '())
(define (record m) (set! events (append events (list m))))
(define (p value [token 0]) (hasheq 'progressToken token 'progress value))
(check-exn exn:fail? (lambda () (emit-progress! (p 1))))
(call-with-progress-scope 0 record
  (lambda ()
    (emit-progress! (p 0))
    (call-with-progress-scope 0 record (lambda () (emit-progress! (p 1/2))))
    (check-exn #rx"increase" (lambda () (emit-progress! (p 1/2))))
    (check-exn #rx"increase" (lambda () (emit-progress! (p 0))))
    (for ([bad (list (p 1 "foreign") (p +inf.0) (p +nan.0)
                     (hash-set (p 1) 'total #f) (hash-set (p 1) 'message 42))])
      (check-exn exn:fail? (lambda () (emit-progress! bad))))
    (emit-progress! (hash-set (p 1) 'total 1))))
(check-equal? (map (lambda (m) (hash-ref (hash-ref m 'params) 'progress)) events) '(0 1/2 1))

(define late-ready (make-semaphore 0))
(define late-result (make-async-channel))
(define rt (make-runtime (make-interface #:tools
  (list
   (make-tool "progress" '()
     (lambda (_)
       (progress! (current-progress-token) 0)
       (progress! (current-progress-token) 1/2 #:total 1 #:message "half")
       (progress! (current-progress-token) 1 #:total 1)
       (text-result "done")))
   (make-tool "late" '()
     (lambda (_)
       (thread (lambda ()
                 (sync late-ready)
                 (async-channel-put late-result
                   (with-handlers ([exn:fail? values]) (progress! 0 1) 'incorrectly-emitted))))
       (text-result "done")))
   (make-tool "wrong" '() (lambda (_) (progress! "foreign" 1) (text-result "bad")))))))
(define (invoke name [token 0])
  (dispatch-message rt (hasheq 'jsonrpc "2.0" 'id 1 'method "tools/call"
    'params (hasheq 'name name 'arguments (hasheq) '_meta (request-meta #:extra (hasheq 'progressToken token))))
    #:notify record))
(set! events '())
(check-equal? (hash-ref (hash-ref (invoke "progress") 'result) 'resultType) "complete")
(check-equal? (map (lambda (m) (hash-ref (hash-ref m 'params) 'progressToken)) events) '(0 0 0))
(check-equal? (length events) 3)
(check-true (hash-has-key? (invoke "wrong") 'error))
(check-equal? (length events) 3)
(check-true (hash-has-key? (invoke "late") 'result))
(semaphore-post late-ready)
(check-true (exn:fail? (sync/timeout 2 late-result)))
(check-equal? (length events) 3)
(check-equal? (hash-ref (hash-ref (invoke "progress" #f) 'error) 'code) -32602)
(custodian-shutdown-all (runtime-custodian rt))

;; Each client request starts its own monotonic sequence, including reuse of 0.
(define (client-sequence values)
  (define-values (in peer-out) (make-pipe))
  (define out (open-output-bytes))
  (define c (make-stdio-client in out))
  (dynamic-wind void
    (lambda ()
      (define h (client-request c "ping" (hasheq '_meta (hasheq 'progressToken 0))))
      (for ([n (in-list values)])
        (write-json (hasheq 'jsonrpc "2.0" 'method "notifications/progress" 'params (p n)) peer-out)
        (newline peer-out))
      (write-json (hasheq 'jsonrpc "2.0" 'id (request-handle-id h) 'result (hasheq 'resultType "complete")) peer-out)
      (newline peer-out) (flush-output peer-out)
      (sync/timeout 2 h))
    (lambda () (client-close! c) (close-output-port peer-out))))
(check-true (hash? (client-sequence '(0 1/2 1))))
(check-true (exn:fail? (client-sequence '(0 0))))
(check-true (exn:fail? (client-sequence '(1 0))))
(check-true (exn:fail? (client-sequence '("bad"))))

;; Concurrent callers cannot overtake an earlier notification blocked in output.
(define entered (make-semaphore 0))
(define release (make-semaphore 0))
(define delivered (make-async-channel))
(call-with-progress-scope "concurrent"
  (lambda (m)
    (define n (hash-ref (hash-ref m 'params) 'progress))
    (when (= n 1) (semaphore-post entered) (sync release))
    (async-channel-put delivered n))
  (lambda ()
    (define first (thread (lambda () (emit-progress! (p 1 "concurrent")))))
    (check-not-false (sync/timeout 2 entered))
    (define second (thread (lambda () (emit-progress! (p 2 "concurrent")))))
    (check-false (sync/timeout 0 delivered))
    (semaphore-post release)
    (check-not-false (sync/timeout 2 (thread-dead-evt first)))
    (check-not-false (sync/timeout 2 (thread-dead-evt second)))))
(check-equal? (sync/timeout 2 delivered) 1)
(check-equal? (sync/timeout 2 delivered) 2)
