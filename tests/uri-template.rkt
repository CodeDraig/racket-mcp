#lang racket/base
(require rackunit mcp mcp/uri-template)
(check-equal? (uri-template-variables "/{9.a}/{x}{?Some%20Thing,x}") '(9.a x Some%20Thing))
(for ([template '("{x:0}" "{x:10000}" "{x:01}" "{x,,y}" "{}" "{x" "x}" "{x..y}" "a b" "%zz" "{!x}")])
  (check-exn exn:fail? (lambda () (check-uri-template! template))))
(check-equal? (uri-template-expand "café/{x}" (hasheq 'x "é")) "caf%C3%A9/%C3%A9")
(check-equal? (uri-template-expand "{+x:1}" (hasheq 'x "%C3%A9more")) "%C3%A9")
(check-equal? (uri-template-expand "{x:1}" (hasheq 'x "%C3%A9more")) "%25C3%25A9")
(check-equal? (uri-template-expand "{+x:2}" (hasheq 'x "a%2Fmore")) "a%2F")
(check-equal? (uri-template-expand "{x,y,z}" (hasheq 'x missing 'y json-null 'z #f)) "false")
(check-equal? (uri-template-expand "{?x}" (hasheq 'x (list missing json-null ""))) "?x=")
(define match-uri (uri-template-matcher "doc:///{id}:{part}"))
(check-equal? (match-uri "doc:///a%3Ab:part") (hasheq 'id "a:b" 'part "part"))
(for ([uri '("doc:///a:b:part" "doc:///a%GG:part" "doc:///a%FF:part" "doc:///a+b:part" "doc:///a,b:part" "doc:///a%:part")])
  (check-false (match-uri uri)))
(check-equal? ((uri-template-matcher "café/{id}") "caf%C3%A9/a") (hasheq 'id "a"))
(check-equal? ((uri-template-matcher "{9.a}") "name") (hasheq '9.a "name"))
(for ([template '("{a}{b}" "{a}-{b}" "{a}%2F{b}" "{a}/{a}" "{+a}" "{a:1}" "{a*}" "{a,b}")])
  (check-exn #rx"explicit matcher" (lambda () (uri-template-matcher template))))
;; An explicit inverse adapter does not make malformed template syntax valid.
(check-exn exn:fail? (lambda () (make-resource "bad" "bad:///{" values #:matcher values)))
(check-exn #rx"undeclared argument"
  (lambda () (make-resource "bad" "bad:///{unknown}" values #:matcher values)))
(check-exn exn:fail:syntax?
  (lambda () (expand #'(resource (bad [id String]) #:uri "bad:///{unknown}" id))))
(resource (document [id String]) #:uri "document:///{id}" id)
(define iface (make-interface #:resources (list document)))
(check-exn #rx"preserve template variables" (lambda () (view iface #:uris (hash "document:///{id}" "other:///"))))
(check-exn #rx"preserve template variables" (lambda () (view iface #:uris (hash "document:///{id}" "other:///{renamed}"))))
(define mapped (view iface #:uris (hash "document:///{id}" "other:///{id}")))
(check-equal? (parameterize ([current-interface mapped]) (resource-uri (document "a:b"))) "other:///a%3Ab")
