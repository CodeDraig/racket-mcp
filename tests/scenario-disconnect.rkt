#lang racket/base
(require rackunit racket/async-channel mcp mcp/scenario mcp/stdio mcp/http mcp/subscription)
(define request-started (make-async-channel))
(define task-started (make-async-channel))
(define release-task (make-semaphore 0))
(define invocations 0)
(tool (blocked)
  (set! invocations (add1 invocations))
  (async-channel-put request-started (current-thread))
  (sync never-evt))
(tool (echo) (text-result "connected"))
(workflow (tasked) #:version "1" #:execution task
  (checkpoint [value String]
    (begin (async-channel-put task-started (current-thread))
           (sync release-task) "survived"))
  (text-result value))
(define iface (make-interface #:tools (list blocked echo tasked)))
(define caps (hasheq 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(for ([config '((stdio #f) (http #f) (http #t))])
  (define retained #f)
  (call-with-scenario-session iface
    (lambda (session)
      (set! retained session)
      (check-true (scenario-session-connected? session))
      (define original-runtime (scenario-session-runtime session))
      (define original-store (scenario-session-store session))
      (define task (hash-ref (scenario-call session "tools/call" (hasheq 'name "tasked")) 'result))
      (define task-worker (sync/timeout 2 task-started))
      (check-true (thread? task-worker))
      (define listener (scenario-request session "subscriptions/listen"
        (hasheq 'notifications (hasheq 'toolsListChanged #t))))
      (check-equal? (hash-ref (sync/timeout 2 (request-handle-notifications listener)) 'method)
                    "notifications/subscriptions/acknowledged")
      (define before invocations)
      (define pending (scenario-request session "tools/call" (hasheq 'name "blocked") #:timeout #f))
      (define worker (sync/timeout 2 request-started))
      (check-true (thread? worker))
      (scenario-disconnect! session)
      (check-false (scenario-session-connected? session))
      (scenario-disconnect! session)
      (define lost (sync/timeout 2 pending))
      (check-true (exn? lost))
      (check-false (exn:fail:request-cancelled? lost))
      (check-false (exn:fail:request-timeout? lost))
      (check-false (exn:fail:http:timeout? lost))
      (define lost-listener (sync/timeout 2 listener))
      (check-true (exn? lost-listener))
      (check-false (exn:fail:request-cancelled? lost-listener))
      (check-not-false (sync/timeout 2 worker))
      (check-false (thread-dead? task-worker))
      (check-exn #rx"disconnected" (lambda () (scenario-call session "tools/call" (hasheq 'name "echo"))))
      (scenario-reconnect! session)
      (scenario-reconnect! session)
      (check-true (scenario-session-connected? session))
      (check-eq? original-runtime (scenario-session-runtime session))
      (check-eq? original-store (scenario-session-store session))
      (check-eq? lost (sync/timeout 0 pending))
      (check-equal? invocations (add1 before))
      (check-equal? (hash-ref (hash-ref (scenario-call session "tools/call" (hasheq 'name "echo")) 'result) 'content)
                    (list (text-content "connected")))
      (define fresh-listener (scenario-request session "subscriptions/listen"
        (hasheq 'notifications (hasheq 'toolsListChanged #t))))
      (check-equal? (hash-ref (sync/timeout 2 (request-handle-notifications fresh-listener)) 'method)
                    "notifications/subscriptions/acknowledged")
      (publish-change! (runtime-subscriptions original-runtime) "notifications/tools/list_changed" (hasheq))
      (check-equal? (hash-ref (sync/timeout 2 (request-handle-notifications fresh-listener)) 'method)
                    "notifications/tools/list_changed")
      (check-false (sync/timeout 0 (request-handle-notifications listener)))
      (check-eq? lost-listener (sync/timeout 0 listener))
      (request-cancel! fresh-listener)
      (semaphore-post release-task)
      (check-not-false (sync/timeout 2 task-worker))
      (define final (hash-ref (scenario-call session "tasks/get" (hasheq 'taskId (hash-ref task 'taskId))) 'result))
      (check-equal? (hash-ref final 'status) "completed")
      (check-equal? (hash-ref (hash-ref final 'result) 'content) (list (text-content "survived"))))
    #:transport (car config) #:sse? (cadr config) #:capabilities caps)
  (check-false (scenario-session-connected? retained))
  (check-exn #rx"closed" (lambda () (scenario-disconnect! retained)))
  (check-exn #rx"closed" (lambda () (scenario-reconnect! retained))))
(call-with-scenario-session iface
  (lambda (session)
    (check-exn #rx"no transport" (lambda () (scenario-disconnect! session)))
    (check-true (scenario-session-connected? session))))
