#lang racket/base
(require rackunit mcp/interaction)
(define request (hasheq 'method "elicitation/create" 'params (hasheq 'mode "form")))
(define rounds (list (hasheq 'resultType "input_required" 'requestState "opaque-not-json" 'inputRequests (hasheq 'first request))
                     (hasheq 'resultType "input_required" 'inputRequests (hasheq 'second request))
                     (hasheq 'resultType "input_required" 'requestState "state-only")
                     (hasheq 'content '())))
(define sent '())
(define actions '("decline" "cancel"))
(define (answer _)
  (define action (car actions)) (set! actions (cdr actions)) (hasheq 'action action))
(define result
  (run-interaction (lambda (method params)
    (set! sent (append sent (list params)))
    (define result (car rounds)) (set! rounds (cdr rounds)) (hasheq 'result result))
    "tools/call" (hasheq 'name "test" 'arguments (hasheq 'x #f)) #:elicit answer #:navigate answer))
(check-equal? result (hasheq 'result (hasheq 'content '())))
(check-equal? (length sent) 4)
(check-equal? (hash-ref (cadr sent) 'requestState) "opaque-not-json")
(check-equal? (hash-ref (cadr sent) 'inputResponses) (hasheq 'first (hasheq 'action "decline")))
(check-false (hash-has-key? (caddr sent) 'requestState))
(check-equal? (hash-ref (caddr sent) 'inputResponses) (hasheq 'second (hasheq 'action "cancel")))
(check-equal? (hash-ref (cadddr sent) 'requestState) "state-only")
(check-false (hash-has-key? (cadddr sent) 'inputResponses))
(check-equal? actions '())
(for ([params (in-list sent)]) (check-equal? (hash-ref params 'arguments) (hasheq 'x #f)))
(define calls 0)
(check-exn #rx"uncertain" (lambda ()
  (run-interaction (lambda (_method _params) (set! calls (add1 calls)) (error 'peer "uncertain"))
    "tools/call" (hasheq) #:elicit answer #:navigate answer)))
(check-equal? calls 1)
(for ([limit '(0 -1 1.5)])
  (check-exn exn:fail:contract? (lambda ()
    (run-interaction void "tools/call" (hasheq) #:max-rounds limit #:elicit answer #:navigate answer))))
(for ([bad (list (hasheq 'resultType "input_required")
                 (hasheq 'resultType "input_required" 'requestState #f)
                 (hasheq 'resultType "input_required" 'inputRequests '()))])
  (define attempts 0)
  (check-exn #rx"refusing automatic retry" (lambda ()
    (run-interaction (lambda (_m _p) (set! attempts (add1 attempts)) bad)
      "tools/call" (hasheq) #:elicit answer #:navigate answer)))
  (check-equal? attempts 1))
