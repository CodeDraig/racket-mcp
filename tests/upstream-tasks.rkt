#lang racket/base
(require rackunit racket/file racket/async-channel mcp mcp/upstream)
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define snapshot
  (hasheq 'server/discover (hasheq 'supportedVersions '("2026-07-28") 'capabilities
                                  (hasheq 'tools (hasheq) 'resources (hasheq) 'extensions (hash-ref caps 'extensions)))
          'tools/list (hasheq 'tools (list (hasheq 'name "work" 'inputSchema (hasheq 'type "object"))))
          'resources/list (hasheq 'resources (list (hasheq 'name "doc" 'uri "up:///doc")))
          'resources/templates/list (hasheq 'resourceTemplates '()) 'prompts/list (hasheq 'prompts '())))
(define form (hasheq 'method "elicitation/create" 'params
  (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq)))))
(define base (hasheq 'taskId "private-peer-id" 'status "working"
                     'createdAt "2026-09-07T18:00:00Z" 'lastUpdatedAt "2026-09-07T18:00:00Z" 'ttlMs 1000))
(define directory (make-temporary-file "mcp-upstream-tasks-~a" 'directory))
(define (exercise store)
  (define clock (make-manual-clock #:seconds 100))
  (define sent '())
  (define phase 'input)
  (define permitted? #t)
  (define credential "account-a")
  (define (peer method params)
    (cond [(hash-ref snapshot (string->symbol method) #f) => values]
          [else
           (set! sent (append sent (list (cons method params))))
           (case (string->symbol method)
             [(tools/call) (hash-set base 'resultType "task")]
             [(tasks/get)
              (check-equal? (hash-ref params 'taskId) "private-peer-id")
              (case phase
                [(input) (hash-set* base 'resultType "complete" 'status "input_required" 'inputRequests (hasheq 'a form 'b form))]
                [(cancelled) (hash-set* base 'resultType "complete" 'status "cancelled")]
                [else (hash-set* base 'resultType "complete" 'status "completed" 'result
                        (hasheq 'resultType "complete" 'content
                          (list (hasheq 'type "resource_link" 'uri "up:///doc" 'name "doc"))))])]
             [(tasks/update)
              (check-equal? (hash-ref params 'taskId) "private-peer-id")
              (check-equal? (hash-count (hash-ref params 'inputResponses)) 2)
              (set! phase 'completed) (hasheq 'resultType "complete")]
             [(tasks/cancel) (set! phase 'cancelled) (hasheq 'resultType "complete")])]))
  (define interface (view (make-upstream-interface snapshot peer
    #:bridge (make-upstream-bridge #:identity "peer" #:version "1" #:credential-id (lambda (_) credential)))
    #:namespace "local-" #:uris (hash "up:///doc" "local:///doc")))
  (define rt (make-runtime interface #:store store #:clock clock
                          #:authorize (lambda (_ method params) (or permitted? (not (equal? method "tools/call"))))))
  (define (call method params [principal "alice"])
    (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps)) #:principal principal))
  (define (create key)
    (parameterize ([current-workflow-invocation-key key]) (call "tools/call" (hasheq 'name "local-work"))))
  (dynamic-wind void
    (lambda ()
      (define discovered (call "server/discover" (hasheq)))
      (check-true (hash-has-key? (hash-ref (hash-ref discovered 'capabilities) 'extensions) 'io.modelcontextprotocol/tasks))
      (define receipt (create "one"))
      (define id (hash-ref receipt 'taskId))
      (check-not-equal? id "private-peer-id")
      (check-equal? (create "one") receipt)
      (check-equal? (length sent) 1)
      (define params (hasheq 'taskId id))
      (define notifications (make-async-channel))
      (parameterize ([current-custodian (runtime-custodian rt)])
        (thread (lambda ()
          (dispatch rt "subscriptions/listen"
            (hasheq '_meta (request-meta #:capabilities caps) 'notifications (hasheq 'taskIds (list id)))
            #:principal "alice" #:id 42 #:notify (lambda (message) (async-channel-put notifications message))))))
      (define acknowledgement (sync/timeout 3 notifications))
      (check-not-false acknowledgement)
      (check-equal? (hash-ref acknowledgement 'method) "notifications/subscriptions/acknowledged")
      (check-exn exn:fail? (lambda () (call "tasks/get" params "bob")))
      (set! permitted? #f)
      (check-exn exn:fail? (lambda () (call "tasks/get" params)))
      (set! permitted? #t)
      (set! credential "account-b")
      (check-exn exn:fail? (lambda () (call "tasks/get" params)))
      (set! credential "account-a")
      (check-equal? (length sent) 1)
      (define awaiting (call "tasks/get" params))
      (check-equal? (hash-ref awaiting 'taskId) id)
      (define ids (hash-keys (hash-ref awaiting 'inputRequests)))
      (check-equal? (length ids) 2)
      (check-false (member 'a ids))
      (check-equal? (call "tasks/get" params) awaiting)
      (define first (hasheq (car ids) (hasheq 'action "decline")))
      (check-equal? (call "tasks/update" (hash-set params 'inputResponses first)) (hasheq 'resultType "complete"))
      (check-equal? (length sent) 3)
      (check-exn exn:fail? (lambda () (call "tasks/update" (hash-set params 'inputResponses (hasheq (car ids) (hasheq 'action "cancel"))))))
      (check-equal? (call "tasks/update" (hash-set params 'inputResponses (hasheq (cadr ids) (hasheq 'action "cancel"))))
                    (hasheq 'resultType "complete"))
      (define finished (call "tasks/get" params))
      (check-equal? (hash-ref finished 'status) "completed")
      (check-equal? (hash-ref (car (hash-ref (hash-ref finished 'result) 'content)) 'uri) "local:///doc")
      (define terminal-notification
        (let loop ()
          (define message (sync/timeout 3 notifications))
          (unless message (error 'test "missing terminal task notification"))
          (if (equal? (hash-ref (hash-ref message 'params) 'status #f) "completed") message (loop))))
      (check-equal? (hash-ref (hash-ref terminal-notification 'params) 'taskId) id)
      (check-equal? (hash-ref (car (hash-ref (hash-ref (hash-ref terminal-notification 'params) 'result) 'content)) 'uri) "local:///doc")
      (define total (length sent))
      (check-equal? (call "tasks/get" params) finished)
      (check-false (sync/timeout 0 notifications))
      (void (call "tasks/update" (hash-set params 'inputResponses first)))
      (void (call "tasks/cancel" params))
      (check-equal? (create "one") receipt)
      (check-equal? (length sent) total)
      ;; Rebuilding the runtime must not run a local workflow worker for a remote task.
      (custodian-shutdown-all (runtime-custodian rt))
      (set! rt (make-runtime interface #:store store #:clock clock))
      (check-equal? (call "tasks/get" params) finished)
      (define other (create "two"))
      (define other-params (hasheq 'taskId (hash-ref other 'taskId)))
      (void (call "tasks/cancel" other-params))
      (check-equal? (hash-ref (call "tasks/get" other-params) 'status) "cancelled")
      (define before-expiry (length sent))
      (manual-clock-advance! clock 2)
      (check-exn #rx"expired" (lambda () (create "one")))
      (check-equal? (length sent) before-expiry))
    (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store))))
(dynamic-wind void
  (lambda () (exercise (open-memory-store)) (exercise (open-sqlite-store (build-path directory "state.sqlite"))))
  (lambda () (delete-directory/files directory)))
