#lang racket/base
(require rackunit racket/file mcp)
(define constructed 0)
(define children '())
(define request (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
(resource (child [name String]) #:uri "child:///{name}" #:workflow "1"
  (checkpoint [value String] (begin (set! children (append children (list name))) name))
  (await-input [answer Any] request)
  (string-append "Child " value))
(prompt (parent)
  (set! constructed (add1 constructed))
  (role "user" (text-content "Before") (embed (child "one")) (embed (child "two")) (text-content "After")))
(define path (make-temporary-file "mcp-render-~a.sqlite"))
(define store (open-sqlite-store path))
(define allowed? #t)
(define (rt) (make-runtime (make-interface #:prompts (list parent) #:resources (list child)) #:store store
                          #:authorize (lambda (p method params) (or (not (equal? method "resources/read")) allowed?))))
(define params (hasheq '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))) 'name "parent"))
(define first (dispatch (rt) "prompts/get" params #:principal "alice"))
(check-equal? children '("one"))
(check-equal? constructed 1)
(check-equal? (hash-keys (hash-ref first 'inputRequests)) '(e0/r0/answer))
(define retry (hash-set params 'requestState (hash-ref first 'requestState)))
(close-store! store)
(set! store (open-sqlite-store path))
(define second (dispatch (rt) "prompts/get" (hash-set retry 'inputResponses (hasheq 'e0/r0/answer (hasheq 'action "decline"))) #:principal "alice"))
(check-equal? children '("one" "two"))
(check-equal? constructed 1)
(check-equal? (hash-keys (hash-ref second 'inputRequests)) '(e1/r0/answer))
(check-exn exn:fail:mcp? (lambda () (dispatch (rt) "prompts/get" retry #:principal "bob")))
(check-exn exn:fail:mcp? (lambda () (dispatch (rt) "prompts/get" (hash-set retry 'inputResponses (hasheq 'e0/r0/answer (hasheq 'action "cancel"))) #:principal "alice")))
(set! allowed? #f)
(check-exn exn:fail:mcp? (lambda () (dispatch (rt) "prompts/get" retry #:principal "alice")))
(set! allowed? #t)
(define done (dispatch (rt) "prompts/get" (hash-set retry 'inputResponses (hasheq 'e1/r0/answer (hasheq 'action "cancel"))) #:principal "alice"))
(define messages (hash-ref done 'messages))
(check-equal? (length messages) 4)
(check-equal? (hash-ref (hash-ref (hash-ref (cadr messages) 'content) 'resource) 'text) "Child one")
(check-equal? (hash-ref (hash-ref (hash-ref (caddr messages) 'content) 'resource) 'text) "Child two")
(check-equal? (dispatch (rt) "prompts/get" retry #:principal "alice") done)
(check-equal? children '("one" "two"))
(check-equal? constructed 1)
(close-store! store)
(delete-file path)

;; Markers captured before and after a workflow suspension keep distinct IDs.
(resource (instant [value String]) #:uri "instant:///{value}" value)
(workflow (staged) #:version "1"
  (checkpoint [before Any] (embed (instant "one")))
  (await-input [gate Any] request)
  (hasheq 'resultType "complete" 'content (list before (embed (instant "two")))))
(define stage-store (open-memory-store))
(define stage-runtime (make-runtime (make-interface #:tools (list staged) #:resources (list instant)) #:store stage-store))
(define stage-params (hasheq '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))) 'name "staged"))
(define waiting (dispatch stage-runtime "tools/call" stage-params))
(define stage-result (dispatch stage-runtime "tools/call"
                               (hash-set* stage-params 'requestState (hash-ref waiting 'requestState)
                                          'inputResponses (hasheq 'gate (hasheq 'action "decline")))))
(check-equal? (map (lambda (content) (hash-ref (hash-ref content 'resource) 'text)) (hash-ref stage-result 'content)) '("one" "two"))
(close-store! stage-store)
