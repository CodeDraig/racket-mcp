#lang racket/base
(require rackunit net/url mcp/authorization mcp/http mcp/oauth mcp/oauth-http-client)
(define resource "https://api.example/mcp")
(define issuer "https://issuer.example")
(define redirect "http://127.0.0.1/callback")
(define calls 0)
(define browsers 0)
(define callback (box void))
(define (authorizer)
  (make-oauth-authorizer #:resource resource #:redirect-uri redirect
    #:pre-registered (hash issuer (oauth-registration issuer "client" redirect resource '("read")))
    #:fetch (lambda (url)
      (if (equal? url (protected-resource-metadata-url resource))
          (protected-resource-metadata resource (list issuer) #:scopes '("read"))
          (hasheq 'issuer issuer 'authorization_endpoint "https://issuer.example/authorize"
                  'token_endpoint "https://issuer.example/token" 'response_types_supported '("code")
                  'code_challenge_methods_supported '("S256"))))
    #:browse (lambda (url)
      (set! browsers (add1 browsers))
      ((unbox callback))
      (hasheq 'state (cdr (assq 'state (url-query (string->url url)))) 'iss issuer 'code "code"))
    #:exchange (lambda (_url _fields)
      (set! calls (add1 calls))
      (hasheq 'token_type "Bearer" 'access_token (format "token-~a" calls) 'refresh_token "refresh"
              'scope "read" 'expires_in 100))))
(define (failure token [origin resource] [scope-error? #f])
  (exn:fail:http:authorization "challenge" (current-continuation-marks) 401 '() #""
    (parse-authenticate (list (if scope-error? "Bearer error=insufficient_scope, scope=read" "Bearer"))) origin token))
(define client (make-http-client resource))
(define auth (authorizer))
(define first (authorize-http-client! client auth))
(check-equal? (http-client-token client) (oauth-credential-access-token first))
(check-equal? browsers 1)
(check-equal? calls 1)
(define second (authorize-http-client! client auth #:failure (failure (oauth-credential-access-token first))))
(check-equal? (http-client-token client) (oauth-credential-access-token second))
(check-equal? calls 2)
(check-equal? browsers 1)
;; A delayed rejection of token-1 cannot force another exchange of token-2.
(check-equal? (authorize-http-client! client auth #:failure (failure "token-1")) second)
(check-equal? (authorize-http-client! client auth #:failure (failure "token-1" resource #t)) second)
(check-equal? calls 2)
(check-exn #rx"different resource" (lambda () (authorize-http-client! client auth #:failure (failure #f "https://other.example/mcp"))))
(check-exn #rx"does not match" (lambda () (authorize-http-client! (make-http-client "https://other.example/mcp") auth)))
(check-equal? calls 2)
;; Detect changes made by application callbacks before token installation.
(define moved-client (make-http-client resource))
(set-box! callback (lambda () (set-http-client-url! moved-client (string->url "https://other.example/mcp"))))
(check-exn #rx"URL changed" (lambda () (authorize-http-client! moved-client (authorizer))))
(check-false (http-client-token moved-client))
(define changed-client (make-http-client resource #:token "original"))
(set-box! callback (lambda () (set-http-client-token! changed-client "newer-external-token")))
(check-exn #rx"credential changed" (lambda () (authorize-http-client! changed-client (authorizer))))
(check-equal? (http-client-token changed-client) "newer-external-token")
(check-exn exn:fail? (lambda () (make-http-client "https://api.example/mcp#fragment")))
