#lang racket/base
(require rackunit racket/file racket/async-channel mcp mcp/tasks)
(define directory (make-temporary-file "mcp-task-keys-~a" 'directory))
(define caps (hasheq 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define calls 0)
(define block? #t)
(define entered (make-semaphore))
(define release (make-semaphore))
(workflow (keyed [key String] [payload String]) #:version "1" #:execution task-optional
  #:key (lambda (args)
          (when (current-store-connection) (error 'key "key computation ran inside a transaction"))
          (hash-ref args 'key))
  (perform [saved String] #:adapter writer #:policy manual payload)
  (text-result saved))
(define (exercise store)
  (set! calls 0) (set! block? #t)
  (define clock (make-manual-clock #:seconds 100))
  (define adapters (hasheq 'writer (effect-adapter 'manual
     (lambda (value _key _connection)
       (set! calls (add1 calls))
       (when block? (semaphore-post entered) (semaphore-wait release))
       (when (equal? value "uncertain") (error 'writer "uncertain mutation"))
       value))))
  (define rt (make-runtime (make-interface #:tools (list keyed)) #:store store #:adapters adapters #:clock clock))
  (define arguments (hasheq 'key "one" 'payload "saved"))
  (define (call [args arguments] [principal "alice"] [task? #t])
    (dispatch rt "tools/call" (hasheq '_meta (request-meta #:capabilities (if task? caps (hasheq)))
                                     'name "keyed" 'arguments args) #:principal principal))
  (define (completed task [principal "alice"] [status "completed"])
    (let loop ([left 200])
      (define detail (parameterize ([current-mcp-clock clock]) (get-task store (hash-ref task 'taskId) principal)))
      (cond [(equal? (hash-ref detail 'status) status) detail]
            [(zero? left) (error 'test "task not completed: ~s" detail)]
            [else (sync (alarm-evt (+ (current-inexact-milliseconds) 5))) (loop (sub1 left))])))
  (dynamic-wind void
    (lambda ()
      (check-exn #rx"must own its storage transaction boundaries"
        (lambda ()
          (store-transaction store
            (lambda () (start-workflow-task (tool-descriptor-workflow keyed) store arguments "alice" #:adapters adapters)))))
      (check-equal? (list-instances store) '())
      (define first (call))
      (check-not-false (sync/timeout 2 entered))
      (define replies (make-async-channel))
      (define workers
        (for/list ([i (in-range 8)])
          (thread (lambda ()
                    (async-channel-put replies
                      (with-handlers ([(lambda (_) #t) values]) (call)))))))
      (for ([i (in-range 8)]) (check-equal? (sync/timeout 3 replies) first))
      (for ([worker workers])
        (unless (sync/timeout 1 worker) (kill-thread worker)))
      (check-equal? calls 1)
      (check-equal? (length (list-instances store)) 2)
      (check-exn #rx"different arguments" (lambda () (call (hash-set arguments 'payload "changed"))))
      (set! block? #f) (semaphore-post release)
      (check-equal? (hash-ref (completed first) 'result) (text-result "saved"))
      (check-equal? (call) first)
      (check-equal? (call arguments "alice" #f) (text-result "saved"))
      (check-equal? calls 1)
      (define foreign (call arguments "bob"))
      (check-not-equal? (hash-ref foreign 'taskId) (hash-ref first 'taskId))
      (void (completed foreign "bob"))
      (check-equal? calls 2)
      ;; Changing the client's Tasks capability must not fork the keyed work,
      ;; even while the original synchronous invocation owns an external effect.
      (set! block? #t)
      (define cross-arguments (hash-set arguments 'key "cross-mode"))
      (define sync-reply (make-async-channel))
      (define sync-worker
        (thread (lambda () (async-channel-put sync-reply
                            (with-handlers ([(lambda (_) #t) values])
                              (call cross-arguments "alice" #f))))))
      (check-not-false (sync/timeout 2 entered))
      (define shared-task (call cross-arguments))
      (check-equal? calls 3)
      (set! block? #f) (semaphore-post release)
      (define sync-result (sync/timeout 3 sync-reply))
      (unless sync-result (kill-thread sync-worker))
      (check-equal? sync-result (text-result "saved"))
      (check-equal? (hash-ref (completed shared-task) 'result) sync-result)
      (check-equal? (call cross-arguments) shared-task)
      (check-equal? calls 3)
      (define failed-arguments (hasheq 'key "failed" 'payload "uncertain"))
      (define failed-task (call failed-arguments))
      (define failed-result (completed failed-task "alice" "failed"))
      (check-equal? calls 4)
      (check-equal? (call failed-arguments) failed-task)
      (check-equal? (completed failed-task "alice" "failed") failed-result)
      (check-equal? calls 4)
      (define unkeyed
        (struct-copy workflow-descriptor (tool-descriptor-workflow keyed) [name "unkeyed"] [key #f]))
      (define (fresh)
        (parameterize ([current-mcp-clock clock])
          (start-workflow-task unkeyed store arguments "alice" #:adapters adapters #:custodian (runtime-custodian rt))))
      (define fresh-one (fresh))
      (void (completed fresh-one))
      (define fresh-two (fresh))
      (void (completed fresh-two))
      (check-not-equal? (hash-ref fresh-one 'taskId) (hash-ref fresh-two 'taskId))
      (check-equal? calls 6)
      ;; The same key cannot silently select a new executable.
      (check-exn exn:fail:recovery?
        (lambda ()
          (parameterize ([current-mcp-clock clock])
            (start-workflow-task
             (struct-copy workflow-descriptor (tool-descriptor-workflow keyed) [version "2"])
             store arguments "alice" #:adapters adapters #:custodian (runtime-custodian rt)))))
      (manual-clock-advance! clock 86400)
      (check-exn #rx"expired" (lambda () (call)))
      (check-equal? calls 6))
    (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store))))
(dynamic-wind void
  (lambda ()
    (exercise (open-memory-store))
    (exercise (open-sqlite-store (build-path directory "state.sqlite"))))
  (lambda () (delete-directory/files directory)))
