#lang racket/base
(require rackunit racket/tcp racket/port mcp/http mcp/stdio mcp/json)

;; Peers remain open after their response so success depends on client cleanup.
(define (with-peer send proc)
  (define owner (make-custodian))
  (define received (make-semaphore 0))
  (define closed (make-semaphore 0))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define listener (tcp-listen 0 4 #t "127.0.0.1"))
        (define-values (_ port _r _rp) (tcp-addresses listener #t))
        (thread
         (lambda ()
           (define-values (in out) (tcp-accept listener))
           (let loop ([size 0])
             (define line (read-line in 'any))
             (cond [(equal? line "") (read-bytes size in)]
                   [else
                    (define match (regexp-match #px"(?i:^content-length: *)([0-9]+)" line))
                    (loop (if match (string->number (cadr match)) size))]))
           (semaphore-post received)
           (with-handlers ([exn:fail? void]) (send out))
           (with-handlers ([exn:fail? (lambda (_) (semaphore-post closed))])
             (when (eof-object? (read-byte in)) (semaphore-post closed)))))
        (proc (format "http://127.0.0.1:~a/mcp" port) received)
        (check-not-false (sync/timeout 2 (semaphore-peek-evt closed)))))
    (lambda () (custodian-shutdown-all owner))))
(define (headers out)
  (display "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\n" out)
  (flush-output out))
(for ([phase '(headers request)])
  (with-peer (if (eq? phase 'headers) void headers)
    (lambda (url received)
      (define h (http-client-request (make-http-client url)
                                    "server/discover"
                                    #:header-timeout (if (eq? phase 'headers) 0.1 2)
                                    #:timeout (if (eq? phase 'request) 0.1 #f)))
      (define result (sync/timeout 2 h))
      (check-true (exn:fail:http:timeout? result))
      (check-eq? (exn:fail:http:timeout-phase result) phase)
      (request-cancel! h)
      (check-eq? (sync h) result))))
;; A subscription overrides the client's ordinary total deadline, but an
;; explicitly supplied per-request deadline still applies to a subscription.
(with-peer headers
  (lambda (url received)
    (define h (http-client-request (make-http-client url #:timeout 0.02) "subscriptions/listen"))
    (check-not-false (sync/timeout 2 received))
    (check-false (sync/timeout 0.06 h))
    (request-cancel! h)
    (define result (sync/timeout 2 h))
    (check-true (exn:fail? result))
    (check-regexp-match #rx"cancelled" (exn-message result))
    (request-cancel! h)
    (check-eq? (sync h) result)))
(with-peer headers
  (lambda (url received)
    (define h (http-client-request (make-http-client url) "subscriptions/listen" #:timeout 0.05))
    (check-true (exn:fail:http:timeout? (sync/timeout 2 h)))))

(define good (hasheq 'name "good" 'inputSchema (hasheq 'type "object")))
(define bad (hasheq 'name "bad" 'inputSchema (hasheq 'type "object" 'x-mcp-header "invalid")))
(define response (hasheq 'jsonrpc "2.0" 'id 1 'result (hasheq 'tools (list bad good))))
(with-peer
  (lambda (out)
    (define body (string->bytes/utf-8 (json->string response)))
    (fprintf out "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: ~a\r\n\r\n" (bytes-length body))
    (write-bytes body out) (flush-output out))
  (lambda (url received)
    (define client (make-http-client url))
    (define h (http-client-request client "tools/list"))
    (define result (sync/timeout 2 h))
    (check-equal? (hash-ref (hash-ref result 'result) 'tools) (list good))
    (check-equal? (hash-keys (http-client-schemas client)) '("good"))
    (request-cancel! h)
    (check-eq? (sync h) result)))
(for ([v (list 0 -1 +inf.0 +nan.0 "30")])
  (check-exn exn:fail:contract? (lambda () (make-http-client "http://localhost" #:timeout v)))
  (check-exn exn:fail:contract? (lambda () (make-http-client "http://localhost" #:header-timeout v))))

;; Race a complete discovery response against cancellation. Both contenders must
;; agree on the result and on whether its schema became visible.
(for ([iteration (in-range 20)])
  (define release (make-semaphore 0))
  (with-peer
    (lambda (out)
      (sync release)
      (headers out)
      (fprintf out "data: ~a\n\n" (json->string response))
      (flush-output out))
    (lambda (url received)
      (define client (make-http-client url))
      (define h (http-client-request client "tools/list"))
      (check-not-false (sync/timeout 2 received))
      (define cancel-worker (thread (lambda () (request-cancel! h))))
      (semaphore-post release)
      (define result (sync/timeout 2 h))
      (check-not-false result)
      (check-not-false (sync/timeout 2 (thread-dead-evt cancel-worker)))
      (check-eq? (sync h) result)
      (check-equal? (hash-has-key? (http-client-schemas client) "good") (hash? result))
      (check-false (hash-has-key? (http-client-schemas client) "bad")))))

(with-peer headers
  (lambda (url received)
    (define client (make-http-client url))
    (define params (hasheq '_meta (hasheq 'progressToken 0)))
    (define h (http-client-request client "ping" params))
    (check-not-false (sync/timeout 2 received))
    (check-exn #rx"already belongs" (lambda () (http-client-request client "ping" params)))
    (request-cancel! h)
    (check-true (exn:fail? (sync/timeout 2 h)))
    (check-not-exn (lambda () (request-cancel! (http-client-request client "ping" params))))))
