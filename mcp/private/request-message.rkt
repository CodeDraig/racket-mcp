#lang racket/base
(require "../json.rkt" "../error.rkt")
(provide check-client-message check-cancellation-params request-id?)
(define (request-id? id) (or (string? id) (exact-integer? id)))
(define (check-client-message message)
  (unless (and (hash? message) (equal? (hash-ref message 'jsonrpc #f) "2.0")
               (string? (hash-ref message 'method #f))
               (not (hash-has-key? message 'result)) (not (hash-has-key? message 'error))
               (or (not (hash-has-key? message 'id)) (request-id? (hash-ref message 'id)))
               (hash? (hash-ref message 'params (hasheq))))
    (mcp-error -32600 "Invalid Request"))
  (if (hash-has-key? message 'id) 'request 'notification))
(define (check-cancellation-params params)
  (unless (and (hash? params) (request-id? (hash-ref params 'requestId #f))
               (or (not (hash-has-key? params 'reason)) (string? (hash-ref params 'reason))))
    (mcp-error -32602 "Invalid cancellation parameters")))
