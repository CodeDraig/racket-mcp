#lang racket/base
(require rackunit racket/file racket/port racket/runtime-path mcp/json)
(define-runtime-path worker "render-provenance-worker.rkt")
(define directory (make-temporary-file "mcp-render-provenance-~a" 'directory))
(define (run)
  (define-values (process out in err)
    (subprocess #f #f #f (find-executable-path "racket") worker
      (build-path directory "state.sqlite") (build-path directory "reads") (build-path directory "token")))
  (close-output-port in)
  (unless (sync/timeout 10 process) (subprocess-kill process #t) (subprocess-wait process))
  (define stdout (port->string out)) (define stderr (port->string err))
  (close-input-port out) (close-input-port err)
  (check-equal? (subprocess-status process) 0 stderr)
  (string->json stdout))
(dynamic-wind void
  (lambda ()
    (check-equal? (hash-ref (run) 'resultType) "input_required")
    (define complete (run))
    (check-equal? (hash-ref (hash-ref complete 'structuredContent) 'literal)
                  (hasheq '$mcp/embedding 0 'uri "docs:///leaf"))
    (check-equal? (hash-ref (hash-ref (car (hash-ref complete 'content)) 'resource) 'text) "Leaf")
    (check-equal? (run) complete)
    (check-equal? (file->lines (build-path directory "reads")) '("read")))
  (lambda () (delete-directory/files directory)))
