#lang racket/base
(require rackunit racket/file racket/list racket/async-channel mcp mcp/tasks)
(workflow (repairable [value Integer]) #:version "1" #:execution task
  (checkpoint [saved Integer] value)
  (perform [effect Integer] #:adapter write #:policy manual saved)
  (text-result (number->string effect)))
(define caps (hasheq 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define dir (make-temporary-file "task-recovery-~a" 'directory))
(define path (build-path dir "state.sqlite"))
(define store (open-sqlite-store path))
(define count 0)
(define keys '())
(define fail? #t)
(define allowed? #t)
(define gate #f)
(define entered (make-semaphore))
(define adapters
  (hasheq 'write (effect-adapter 'manual
    (lambda (value key _connection)
      (set! count (add1 count))
      (set! keys (cons key keys))
      (if fail? (error 'effect "uncertain external result")
          (begin (when gate (semaphore-post entered) (semaphore-wait gate)) (+ value 1)))))))
(define iface (make-interface #:tools (list repairable)))
(define rt (make-runtime iface #:store store #:adapters adapters #:authorize (lambda (_principal _method _params) allowed?)))
(define (call method params)
  (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps)) #:principal "alice"))
(define (await-task id status)
  (let loop ([attempts 200])
    (define result (get-task store id "alice"))
    (cond [(equal? (hash-ref result 'status) status) result]
          [(zero? attempts) (error 'test "task did not reach ~a: ~s" status result)]
          [else (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 attempts))])))
(define (start)
  (define task (call "tools/call" (hasheq 'name "repairable" 'arguments (hasheq 'value 41))))
  (define id (hash-ref task 'taskId))
  (await-task id "failed")
  id)
(define (flow-id id) (hash-ref (stored-instance-state (load-instance store id)) 'workflow))
(dynamic-wind void
 (lambda ()
  (define id (start))
  (define failed (get-task store id "alice"))
  (define failed-revision (stored-instance-revision (load-instance store id)))
  (check-equal? (hash-ref (hash-ref failed 'error) 'message) "Workflow requires manual recovery")
  (check-equal? count 1)
  (check-exn #rx"record an outcome"
    (lambda () (retry-runtime-task! rt id #:principal "alice" #:capabilities caps)))
  (check-exn exn:fail? (lambda () (retry-runtime-task! rt id #:principal "bob" #:capabilities caps)))
  (check-exn exn:fail? (lambda () (retry-runtime-task! rt id #:principal "alice" #:capabilities (hasheq))))
  (recover-workflow! store (flow-id id) 'effect 'outcome #:outcome 99 #:principal "alice")
  (check-exn #rx"incompatible"
    (lambda () (retry-recovered-task!
      (struct-copy workflow-descriptor (tool-descriptor-workflow repairable) [fingerprint "different"])
      store id "alice" #:adapters adapters)))
  (set! allowed? #f)
  (check-exn #rx"not authorized" (lambda () (retry-runtime-task! rt id #:principal "alice" #:capabilities caps)))
  (check-equal? (length (filter (lambda (i) (equal? (stored-instance-operation i) "task:repairable")) (list-instances store))) 1)
  (set! allowed? #t)
  (define next (retry-runtime-task! rt id #:principal "alice" #:capabilities caps))
  (define new-id (hash-ref next 'taskId))
  (check-not-equal? id new-id)
  (define result (await-task new-id "completed"))
  (check-equal? (hash-ref (hash-ref result 'result) 'content) (list (text-content "99")))
  (check-equal? count 1)
  (check-equal? (get-task store id "alice") failed)
  (check-equal? (stored-instance-revision (load-instance store id)) failed-revision)
  (check-equal? (hash-ref (retry-runtime-task! rt id #:principal "alice" #:capabilities caps) 'taskId) new-id)
  ;; Replacement identity and old terminal outcome survive reopening SQLite.
  (custodian-shutdown-all (runtime-custodian rt))
  (close-store! store)
  (set! store (open-sqlite-store path))
  (set! rt (make-runtime iface #:store store #:adapters adapters))
  (check-equal? (hash-ref (retry-runtime-task! rt id #:principal "alice" #:capabilities caps) 'taskId) new-id)
  (check-equal? (get-task store id "alice") failed)
  ;; A retry repair retains the existing effect key; no new initial execution.
  (define retry-id (start))
  (define uncertain-key (car keys))
  (recover-workflow! store (flow-id retry-id) 'effect 'retry #:principal "alice")
  (set! fail? #f)
  (set! gate (make-semaphore))
  (define retried (retry-runtime-task! rt retry-id #:principal "alice" #:capabilities caps))
  (check-not-false (sync/timeout 5 entered))
  (define results (make-async-channel))
  (define callers
    (for/list ([i (in-range 8)])
      (thread (lambda ()
        (async-channel-put results
          (with-handlers ([exn:fail? values])
            (hash-ref (retry-runtime-task! rt retry-id #:principal "alice" #:capabilities caps) 'taskId)))))))
  (for ([caller (in-list callers)])
    (check-equal? (sync/timeout 5 results) (hash-ref retried 'taskId))
    (sync caller))
  (check-equal? count 3)
  (check-equal? (length (filter (lambda (e) (equal? (hash-ref e 'kind) "task-replacement")) (instance-events store retry-id))) 1)
  (semaphore-post gate)
  (define retried-result (await-task (hash-ref retried 'taskId) "completed"))
  (check-equal? (hash-ref (hash-ref retried-result 'result) 'content) (list (text-content "42")))
  (check-equal? (car keys) uncertain-key)
  (check-equal? count 3)
  (check-equal? (hash-ref (get-task store retry-id "alice") 'status) "failed")
  (set! gate #f)
  (set! fail? #t)
  (define abandoned (start))
  (recover-workflow! store (flow-id abandoned) 'effect 'abandon #:principal "alice")
  (check-exn #rx"record an outcome" (lambda () (retry-runtime-task! rt abandoned #:principal "alice" #:capabilities caps))))
 (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store) (delete-directory/files dir)))
