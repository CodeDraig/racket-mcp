#lang racket/base
(require compiler/cm mcp/private/module-observation mcp/private/module-imports)
(define namespace (make-empty-namespace))
(for ([name (list ''#%terminal ''#%futures ''#%place ''#%network ''#%extfl ''#%foreign ''#%linklet-expander ''#%linklet-primitive ''#%linklet ''#%expobs ''#%boot ''#%utils ''#%place-struct ''#%builtin ''#%flfxnum ''#%unsafe ''#%paramz ''#%read ''#%main ''#%runtime ''#%core ''#%kernel)])
 (namespace-attach-module (current-namespace) name namespace))
(parameterize ([current-namespace namespace]) (namespace-require ''#%kernel))
(module-cache-clear!)
(call-with-module-observation
 (lambda ()
  (parameterize ([current-namespace namespace])
   (dynamic-require '(file "/srv/data/code/racket-mcp/examples/greeter.rkt") 'mcp-interface)
   (define seen (make-hash))
   (define missing '())
   (define captured 0)
   (define (visit identity)
    (unless (hash-ref seen identity #f)
     (hash-set! seen identity #t)
     (if (observed-module-code identity namespace)
      (set! captured (add1 captured))
      (set! missing (cons (list (resolved-module-path-name identity) (module-predefined? identity)) missing)))
     (when (module-declared? identity #f)
      (for ([dep (resolved-module-imports identity)]) (visit dep)))))
   (visit (module-path-index-resolve (module-path-index-join '(file "/srv/data/code/racket-mcp/examples/greeter.rkt") #f)))
   (printf "captured: ~a\nmissing: ~s\n" captured missing))))
