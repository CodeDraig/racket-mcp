#lang racket/base
(require rackunit racket/runtime-path
         (only-in mcp/runtime make-runtime dispatch request-meta))
(module shared racket/base
  (provide events record!)
  (define events (box '()))
  (define (record! event) (set-box! events (append (unbox events) (list event)))))
(module language racket/base
  (require mcp/private/module-finalization (submod ".." shared)
           (for-syntax racket/base))
  (provide (except-out (all-from-out racket/base) #%module-begin)
           (rename-out [body #%module-begin]))
  (define-syntax-rule (body form ...)
    (module-begin/finish #:finish (record! 'finished) form ...)))
(module ordinary (submod ".." language)
  (require (submod ".." shared) (for-syntax racket/base))
  (provide value)
  (define value 42)
  (record! 'body)
  (begin-for-syntax (define expanded? #f))
  (define-syntax (once stx)
    (when expanded? (raise-syntax-error #f "expanded twice" stx))
    (set! expanded? #t)
    (syntax-local-lift-module-end-declaration #'(record! 'end))
    #'(record! 'once))
  (once))
(module failed-body (submod ".." language)
  (require (submod ".." shared))
  (record! 'body)
  (error 'fixture "body failed"))
(module failed-end (submod ".." language)
  (require (submod ".." shared) (for-syntax racket/base))
  (define-syntax (late stx)
    (syntax-local-lift-module-end-declaration #'(begin (record! 'end) (error 'fixture "end failed")))
    #'(record! 'body))
  (late))
(module nested-end (submod ".." language)
  (require (submod ".." shared) (for-syntax racket/base))
  (define-syntax (later stx)
    (syntax-local-lift-module-end-declaration #'(record! 'second-end))
    #'(record! 'first-end))
  (define-syntax (late stx)
    (syntax-local-lift-module-end-declaration #'(later))
    #'(record! 'body))
  (late))
(module hygiene (submod ".." language)
  (require (rename-in (submod ".." shared) [record! actual-record!]))
  (define (record! _) (error 'fixture "captured finish callback"))
  (define finished 'colliding)
  (actual-record! finished)
  (module+ helper (actual-record! 'submodule)))
(require (submod "." shared))
(define-runtime-path self "module-finalization.rkt")
(define (load name [export #f]) (dynamic-require `(submod ,self ,name) export))
(test-case "completion follows lifted forms and expansions happen once"
  (set-box! events '())
  (check-equal? (load 'ordinary 'value) 42)
  (check-equal? (unbox events) '(body once end finished)))
(test-case "failed ordinary initialization cannot reach completion"
  (set-box! events '())
  (check-exn #rx"body failed" (lambda () (load 'failed-body)))
  (check-equal? (unbox events) '(body)))
(test-case "failed module-end initialization cannot reach completion even on retry"
  (set-box! events '())
  (check-exn #rx"end failed" (lambda () (load 'failed-end)))
  (check-equal? (unbox events) '(body end))
  (load 'failed-end)
  (check-equal? (unbox events) '(body end)))
(test-case "completion follows recursively lifted end forms"
  (set-box! events '())
  (load 'nested-end)
  (check-equal? (unbox events) '(body first-end second-end finished)))
(test-case "finish binding is hygienic and does not execute submodules"
  (set-box! events '())
  (load 'hygiene)
  (check-equal? (unbox events) '(colliding finished))
  (dynamic-require `(submod ,self hygiene helper) #f)
  (check-equal? (unbox events) '(colliding finished submodule finished)))

(module mcp-language racket/base
  (require (except-in mcp/lang #%module-begin)
           (only-in mcp/lang [#%module-begin mcp-begin])
           mcp/private/module-finalization (submod ".." shared)
           (for-syntax racket/base))
  (provide (except-out (all-from-out mcp/lang) mcp-begin)
           (rename-out [body #%module-begin]))
  (define-syntax-rule (body form ...)
    (module-begin/finish #:finish (record! 'mcp-finished)
                        #:module-begin mcp-begin form ...)))
(module mcp-application (submod ".." mcp-language)
  (require (submod ".." shared) (for-syntax racket/base))
  (server #:name "finalization" #:version "1")
  (tool (hello) (text-result "hello"))
  (define-syntax (late stx)
    (syntax-local-lift-module-end-declaration #'(record! 'mcp-end))
    #'(record! 'mcp-body))
  (late))
(test-case "the actual MCP expander retains its manifest and declarations"
  (set-box! events '())
  (define manifest (dynamic-require `(submod ,self mcp-application manifest) 'manifest))
  (check-true (pair? manifest))
  (check-equal? (unbox events) '())
  (define interface (load 'mcp-application 'mcp-interface))
  (check-equal? (unbox events) '(mcp-body mcp-end mcp-finished))
  (define owner (make-custodian))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define result
          (dispatch (make-runtime interface) "tools/call"
                    (hasheq '_meta (request-meta) 'name "hello")))
        (check-equal? (hash-ref result 'content)
                      (list (hasheq 'type "text" 'text "hello")))))
    (lambda () (custodian-shutdown-all owner))))

(module failed-export (submod ".." language)
  (require racket/contract (submod ".." shared))
  (provide (contract-out [value integer?]))
  (define value "not an integer")
  (record! 'body))
(test-case "export contract failure cannot reach completion"
  (set-box! events '())
  (check-exn exn:fail:contract? (lambda () (load 'failed-export)))
  (check-equal? (unbox events) '(body)))
