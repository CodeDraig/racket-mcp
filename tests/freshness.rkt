#lang racket/base
(require rackunit mcp/freshness mcp/storage)
(define now 0)
(define cache (make-resource-cache #:clock (lambda () now)))
(define n 0)
(define (read principal) (cache-ref! cache principal "doc:1" '("table:docs") 100 (lambda () (set! n (add1 n)) n)))
(check-equal? (read "alice") 1)
(check-equal? (read "alice") 1)
(check-equal? (read "bob") 2)
(check-equal? (invalidate-keys! cache '("table:docs") #:principal "alice") '("doc:1"))
(check-equal? (read "alice") 3)
(check-equal? (read "bob") 2)
(set! now 101)
(check-equal? (read "bob") 4)
(define store (open-memory-store))
(check-exn exn:fail? (lambda () (store-transaction store (lambda () (record-committed-change! store "alice" '("x")) (error 'mutation "rollback")))))
(check-equal? (list-instances store #:operation "change-outbox") '())
(void (record-committed-change! store "alice" '("x")))
(define delivered '())
(drain-change-outbox! store (lambda (id principal keys) (set! delivered (cons keys delivered))))
(drain-change-outbox! store (lambda args (error 'test "duplicate delivery without crash")))
(check-equal? delivered '(("x")))
(close-store! store)
