#lang racket/base
(require rackunit racket/file mcp)
(shape Row [id String] [label String])
(define builds 0) (define renders 0) (define handlers 0)
(resource (leaf [id String]) #:uri "leaf:///{id}" #:workflow "1"
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
  id)
(define row-renderer
  (make-text-renderer "row" "1"
    (lambda (row) (set! renders (add1 renders)) (list (Row-label row) ":" (embed (leaf (Row-id row)))))))
(resource (row [id String]) #:uri "row:///{id}"
  #:render (begin (set! builds (add1 builds)) row-renderer)
  (set! handlers (add1 handlers))
  (make-Row id "record"))
(resource (json-row) #:uri "json:///row" #:render (make-json-renderer "json-row" "1" Row->json)
  (make-Row "a" "A"))
(resource (binary-row) #:uri "binary:///row" #:render (make-binary-renderer "bytes" "1" string->bytes/utf-8)
  "hello")
(check-equal? builds 1)
(check-exn exn:fail? (lambda () (make-text-renderer "bad" "1" #f)))
(check-equal? (resource-descriptor-mime-type json-row) "application/json")
(check-equal? (resource-descriptor-mime-type binary-row) "application/octet-stream")
(check-exn exn:fail? (lambda () (make-resource "bad" "bad:///" values #:mime-type "application/json" #:render row-renderer)))
(define iface (make-interface #:resources (list leaf row json-row binary-row)))
(define dir (make-temporary-file "mcp-renderers-~a" 'directory (current-directory)))
(define db (build-path dir "state.sqlite"))
(define store (open-sqlite-store db))
(define rt (make-runtime iface #:store store))
(define meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))))
(define request (hasheq '_meta meta 'uri "row:///a"))
(define pending (dispatch rt "resources/read" request))
(check-equal? (hash-ref pending 'resultType) "input_required")
(check-equal? handlers 1) (check-equal? renders 1)
(custodian-shutdown-all (runtime-custodian rt)) (close-store! store)
(set! store (open-sqlite-store db))
(set! rt (make-runtime iface #:store store))
(define retry (hash-set* request 'requestState (hash-ref pending 'requestState)
                         'inputResponses (for/hasheq ([key (in-hash-keys (hash-ref pending 'inputRequests))]) (values key (hasheq 'action "decline")))))
(define done (dispatch rt "resources/read" retry))
(check-equal? (hash-ref (car (hash-ref done 'contents)) 'text) "record:a")
(check-equal? handlers 1) (check-equal? renders 1)
(define changed (struct-copy resource-descriptor row [renderer (make-text-renderer "row" "2" (lambda (_) "changed"))]))
(define changed-rt (make-runtime (make-interface #:resources (list leaf changed)) #:store store))
(check-exn exn:fail? (lambda () (dispatch changed-rt "resources/read" retry)))
(define json-result (dispatch rt "resources/read" (hasheq '_meta meta 'uri "json:///row")))
(check-equal? (string->json (hash-ref (car (hash-ref json-result 'contents)) 'text)) (hasheq 'id "a" 'label "A"))
(define binary-result (dispatch rt "resources/read" (hasheq '_meta meta 'uri "binary:///row")))
(check-equal? (hash-ref (car (hash-ref binary-result 'contents)) 'blob) "aGVsbG8=")
;; A direct resource-workflow continuation also binds the renderer version.
(resource (durable) #:uri "durable:///" #:render (make-json-renderer "durable" "1" values) #:workflow "1"
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
  (hasheq 'ok #t))
(define flow-rt (make-runtime (make-interface #:resources (list durable)) #:store store))
(define flow-params (hasheq '_meta meta 'uri "durable:///"))
(define flow-pending (dispatch flow-rt "resources/read" flow-params))
(define revised (struct-copy resource-descriptor durable [renderer (make-json-renderer "durable" "2" values)]))
(define revised-rt (make-runtime (make-interface #:resources (list revised)) #:store store))
(check-exn exn:fail:recovery?
           (lambda () (dispatch revised-rt "resources/read" (hash-set flow-params 'requestState (hash-ref flow-pending 'requestState)))))
(for ([runtime (in-list (list rt changed-rt flow-rt revised-rt))]) (custodian-shutdown-all (runtime-custodian runtime)))
(close-store! store) (delete-directory/files dir)
