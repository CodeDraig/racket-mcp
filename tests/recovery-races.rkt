#lang racket/base
(require rackunit racket/async-channel racket/list mcp)
(define store (open-memory-store))
(define flow
  (make-workflow "recovery-race" "1" "race/1"
    (list (workflow-stage 'effect 'effect Integer (lambda (_) 1) 'adapter 'manual)
          (workflow-stage 'done 'complete Any (lambda (env) (structured-result env)) #f #f))))
(define entered (make-semaphore 0))
(define release (make-semaphore 0))
(define calls 0)
(define adapters
  (hasheq 'adapter (effect-adapter 'manual
                    (lambda (_ key connection)
                      (set! calls (add1 calls))
                      (semaphore-post entered)
                      (semaphore-wait release)
                      7))))
(define outcomes (make-async-channel))
(define (launch thunk)
  (thread (lambda () (async-channel-put outcomes (with-handlers ([exn:fail? values]) (thunk))))))
(define (next)
  (define result (sync/timeout 5 outcomes))
  (unless result (error 'test "concurrent execution timed out")) result)
(define first (launch (lambda () (run-workflow flow store (hasheq) #:principal "alice" #:adapters adapters))))
(check-not-false (sync/timeout 5 entered))
(define instance (car (list-instances store #:operation "recovery-race")))
(define handle (stored-instance-handle instance))
(for ([action '(outcome retry abandon)])
  (check-exn #rx"execution is active"
             (lambda () (recover-workflow! store handle 'effect action #:principal "alice" #:outcome 99))))
(check-equal? (stored-instance-revision (load-instance store handle)) (stored-instance-revision instance))
(define duplicate
  (launch (lambda () (run-workflow flow store (hasheq) #:state handle #:principal "alice" #:adapters adapters))))
(check-false (sync/timeout 0.05 outcomes))
(semaphore-post release)
(define result (next))
(check-false (exn? result))
(check-equal? (next) result)
(check-equal? calls 1)
(check-equal? (hash-ref (hash-ref result 'structuredContent) 'effect) 7)
;; Once the adapter exits with an uncertain outcome, exactly one concurrent
;; observed-outcome recovery can advance the stage.
(define failing (hasheq 'adapter (effect-adapter 'manual (lambda args (error 'adapter "uncertain")))))
(check-exn exn:fail? (lambda () (run-workflow flow store (hasheq 'run 2) #:principal "alice" #:adapters failing)))
(define uncertain (findf (lambda (i) (equal? (stored-instance-arguments i) (hasheq 'run 2))) (list-instances store)))
(for ([value '(11 12)])
  (launch (lambda () (recover-workflow! store (stored-instance-handle uncertain) 'effect 'outcome #:principal "alice" #:outcome value))))
(define recovered (list (next) (next)))
(check-equal? (length (filter exn:fail? recovered)) 1)
(check-equal? (length (filter stored-instance? recovered)) 1)
(define completed (run-workflow flow store (hasheq 'run 2) #:state (stored-instance-handle uncertain) #:principal "alice" #:adapters failing))
(check-not-false (member (hash-ref (hash-ref completed 'structuredContent) 'effect) '(11 12)))
(check-equal? (count (lambda (event) (equal? (hash-ref event 'kind) "recovery"))
                     (instance-events store (stored-instance-handle uncertain))) 1)
(close-store! store)
