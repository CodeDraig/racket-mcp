#lang racket/base
(require racket/list racket/async-channel mcp mcp/tasks mcp/clock mcp/upstream-bridge "private/review-support.rkt")
(start-evidence! "g6")
(define caps (hasheq 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define meta (request-meta #:capabilities caps))
(for ([expired? '(#f #t)])
  (test-case (format "CD24 terminal bookkeeping across task expiry: ~s" expired?)
    (define clock (make-manual-clock #:seconds 100))
    (parameterize ([current-mcp-clock clock])
      (define entered (make-semaphore)) (define release (make-semaphore))
      (define errors (open-output-string))
      (define execution-thread #f)
      (define flow (make-workflow "expiry-job" "1" "expiry/1"
        (list (workflow-stage 'pause 'checkpoint Integer (lambda (_) (set! execution-thread (current-thread)) (semaphore-post entered) (semaphore-wait release) 7) #f #f)
              (workflow-stage 'done 'complete Any (lambda (_) (text-result "done")) #f #f))))
      (define store (open-memory-store))
      (define rt (make-runtime (make-interface #:tools (list (make-tool "expiry-job" '() void #:workflow flow #:execution 'task))) #:store store #:clock clock))
      (dynamic-wind void
        (lambda ()
          (define id (parameterize ([current-error-port errors])
            (hash-ref (dispatch rt "tools/call" (hasheq '_meta meta 'name "expiry-job") #:principal "alice") 'taskId)))
          (require-event entered)
          (define workers (list execution-thread))
          (manual-clock-advance! clock (if expired? 86401 1))
          (semaphore-post release)
          (for ([worker workers]) (require-event (thread-dead-evt worker)))
          (define saved (hash-ref (stored-instance-state (load-instance store id)) 'task))
          (define access (attempt (lambda () (get-task store id "alice"))))
          (record! (if expired? "CD24-expired" "CD24-control")
            (hasheq 'task saved 'access access 'liveWorkers (length (filter (lambda (t) (not (thread-dead? t))) workers))
                    'workerStderr (get-output-string errors)))
          (check-equal? (hash-ref saved 'status) (if expired? "failed" "completed"))
          (check-equal? (get-output-string errors) "")
          (check-equal? (hash-ref access 'raised) expired?))
        (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store))))))
(for ([abandon? '(#f #t)])
  (test-case (format "CD25 competing recovery claimant, owner subsequently dies: ~s" abandon?)
    (define entered (make-semaphore)) (define release (make-semaphore))
    (define blocked? #t) (define completions 0)
    (define flow (make-workflow "claim-job" "1" "claim/1"
      (list (workflow-stage 'done 'complete Any (lambda (_)
        (when blocked? (semaphore-post entered) (semaphore-wait release))
        (set! completions (add1 completions)) (text-result "done")) #f #f))))
    (define iface (make-interface #:tools (list (make-tool "claim-job" '() void #:workflow flow #:execution 'task))))
    (define store (open-memory-store))
    (define first (make-runtime iface #:store store))
    (define second #f)
    (dynamic-wind void
      (lambda ()
        (define id (hash-ref (dispatch first "tools/call" (hasheq '_meta meta 'name "claim-job") #:principal "alice") 'taskId))
        (require-event entered)
        (set! second (make-runtime iface #:store store))
        (define candidates (filter thread? (custodian-managed-list (runtime-custodian second) (current-custodian))))
        (for ([worker candidates]) (require-event (thread-dead-evt worker)))
        (set! blocked? #f)
        (if abandon? (custodian-shutdown-all (runtime-custodian first)) (semaphore-post release))
        (when abandon? (sync (alarm-evt (+ (current-inexact-milliseconds) 100))))
        (define before (if abandon? (get-task store id "alice") (settled store id)))
        (define count-before completions)
        (when abandon?
          (resume-task! flow store id "alice" #:custodian (runtime-custodian second)))
        (define after (settled store id))
        (record! (if abandon? "CD25-abandoned-owner" "CD25-healthy-owner")
          (hasheq 'afterOwnerExit before 'completionsBeforeExplicitResume count-before 'afterExplicitResume after 'completions completions))
        (check-equal? completions 1)
        ;; A runtime that skipped the live claim does not schedule takeover.
        (check-equal? (hash-ref before 'status) (if abandon? "working" "completed"))
        (check-equal? count-before (if abandon? 0 1))
        (check-equal? (hash-ref after 'status) "completed"))
      (lambda () (when second (custodian-shutdown-all (runtime-custodian second)))
        (custodian-shutdown-all (runtime-custodian first)) (close-store! store)))))
(test-case "CD27 successful manual-stage revisit and explicit outcome recovery"
  (define calls 0) (define exit? #f)
  (define flow (make-workflow "manual-loop" "1" "manual/1"
    (list (workflow-stage 'work 'effect Integer (lambda (_) 7) 'writer 'manual)
          (workflow-stage 'route 'branch Integer (lambda (_) (if exit? 1 0)) '(work done) #f)
          (workflow-stage 'done 'complete Any (lambda (_) (text-result "done")) #f #f))))
  (define store (open-memory-store))
  (define adapters (hasheq 'writer (effect-adapter 'manual (lambda (value key _) (set! calls (add1 calls)) value))))
  (dynamic-wind void
    (lambda ()
      (define initial (attempt (lambda () (run-workflow flow store (hasheq) #:principal "alice" #:adapters adapters))))
      (define row (car (list-instances store #:operation "manual-loop")))
      (define position (hash-ref (stored-instance-state row) 'position))
      (define intent (hash-ref (hash-ref (stored-instance-state row) 'effects) 'work))
      (define repair (attempt (lambda ()
        (recover-workflow! store (stored-instance-handle row) 'work 'outcome #:outcome 7 #:principal "alice") "recorded")))
      (set! exit? #t)
      (define done (attempt (lambda () (run-workflow flow store (hasheq) #:principal "alice" #:adapters adapters #:state (stored-instance-handle row)))))
      (record! "CD27" (hasheq 'initial initial 'currentPosition position 'intentPosition (hash-ref intent 'position)
        'effectCalls calls 'explicitRecovery repair 'resumed done))
      (check-true (hash-ref initial 'raised))
      (check-false (hash-ref repair 'raised))
      (check-false (hash-ref done 'raised))
      (check-equal? calls 1))
    (lambda () (close-store! store))))
(test-case "CD33 adapter cancellation, keyed contention and retained outcomes"
  (define store (open-memory-store))
  (define owner (make-custodian))
  (define entered (make-semaphore)) (define release (make-semaphore))
  (define cancelled? #f) (define calls 0)
  (define bridge (make-upstream-bridge #:identity "duration" #:version "1" #:credential-id (lambda (_) "dummy-binding")))
  (define a (make-async-channel)) (define b (make-async-channel))
  (define (peer method params)
    (set! calls (add1 calls)) (semaphore-post entered) (semaphore-wait release) (text-result "done"))
  (define (invoke cancel)
    (bridge-upstream-request bridge store (hasheq) peer "tools/call" (hasheq 'name "work")
      #:principal "alice" #:credential-id "dummy-binding" #:key "same" #:cancelled? cancel))
  (dynamic-wind void
    (lambda ()
      (define first (parameterize ([current-custodian owner])
        (thread (lambda () (async-channel-put a (attempt (lambda () (invoke (lambda () cancelled?)))))))))
      (require-event entered)
      (define second (parameterize ([current-custodian owner])
        (thread (lambda () (async-channel-put b (attempt (lambda () (invoke (lambda () #f)))))))))
      (set! cancelled? #t)
      (sync (alarm-evt (+ (current-inexact-milliseconds) 120)))
      (define before (car (list-instances store)))
      (define still-a (not (thread-dead? first)))
      (define still-b (not (thread-dead? second)))
      (semaphore-post release)
      (define result-a (require-event a))
      (define result-b (require-event b))
      (define after (car (list-instances store)))
      (record! "CD33" (hasheq 'adapterStillRunningAfterCancellationFlag still-a 'contenderStillWaiting still-b
        'stateWhileBlocked (hash-ref (stored-instance-state before) 'status)
        'unrelatedStoreReadSucceeded #t 'first result-a 'contender result-b
        'finalState (hash-ref (stored-instance-state after) 'status) 'externalCalls calls))
      (check-true still-a)
      (check-true still-b)
      (check-equal? calls 1)
      (check-false (hash-ref result-b 'raised)))
    (lambda () (custodian-shutdown-all owner) (close-store! store))))
(test-case "CD33 interrupted upstream request retains uncertainty and cannot automatically replay"
  (define store (open-memory-store))
  (define owner (make-custodian)) (define entered (make-semaphore))
  (define calls 0)
  (define bridge (make-upstream-bridge #:identity "interruption" #:version "1" #:credential-id (lambda (_) "dummy-binding")))
  (define (peer method params) (set! calls (add1 calls)) (semaphore-post entered) (sync never-evt))
  (define (invoke)
    (bridge-upstream-request bridge store (hasheq) peer "tools/call" (hasheq 'name "work")
      #:principal "alice" #:credential-id "dummy-binding" #:key "same"))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner]) (thread invoke))
      (require-event entered)
      (custodian-shutdown-all owner)
      (define retry (attempt invoke))
      (record! "CD33-interrupted" (hasheq 'retry retry 'externalCalls calls
        'storedStatus (hash-ref (stored-instance-state (car (list-instances store))) 'status)))
      (check-true (hash-ref retry 'raised))
      (check-regexp-match #rx"uncertain" (hash-ref retry 'message))
      (check-equal? calls 1))
    (lambda () (custodian-shutdown-all owner) (close-store! store))))
(finish!)
