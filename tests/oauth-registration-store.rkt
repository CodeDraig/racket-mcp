#lang racket/base
(require rackunit racket/async-channel racket/port racket/string racket/tcp net/uri-codec mcp/oauth-http mcp/oauth-registration mcp/json mcp/storage mcp/oauth-registration-store
         racket/file racket/runtime-path
         (submod mcp/oauth-registration private))
(define (peer response proc)
  (define owner (make-custodian))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define listener (tcp-listen 0 4 #t "127.0.0.1"))
        (define-values (_ port _host _port) (tcp-addresses listener #t))
        (define request (make-async-channel))
        (define closed (make-async-channel))
        (thread
         (lambda ()
           (define-values (in out) (tcp-accept listener))
           (define first (read-line in 'any))
           (define headers
             (let loop ([lines '()])
               (define line (read-line in 'any))
               (if (equal? line "") (reverse lines) (loop (cons line lines)))))
           (define length
             (for/first ([h (in-list headers)] #:do [(define m (regexp-match #px"(?i:^Content-Length:) *([0-9]+)$" h))] #:when m)
               (string->number (cadr m))))
           (define body (read-bytes (or length 0) in))
           (async-channel-put request (list first headers body))
           (when response (write-bytes response out) (flush-output out))
           (async-channel-put closed (eof-object? (read-byte in)))
           (close-input-port in) (close-output-port out)))
        (proc (format "http://127.0.0.1:~a/meta?x=1" port) request closed)))
    (lambda () (custodian-shutdown-all owner))))
(define-runtime-path worker "oauth-registration-store-worker.rkt")
(define fields (hasheq 'application_type "native" 'redirect_uris '("http://localhost:3080/callback")
                       'token_endpoint_auth_method "client_secret_basic"))
(define (as issuer [endpoint "https://register.example/register"])
  (hasheq 'issuer issuer 'authorization_endpoint (string-append issuer "/authorize")
          'token_endpoint (string-append issuer "/token") 'registration_endpoint endpoint
          'response_types_supported '("code")))
(define issuer-a "https://a.example")
(define issuer-b "https://b.example")
(define (registered [secret "secret-A"] [expires 110])
  (hash-set (hash-set (hash-set fields 'client_id "same-client-id") 'client_secret secret)
            'client_secret_expires_at expires))
(define (result issuer [secret "secret-A"] [expires 110])
  (oauth-registration-result issuer (validate-oauth-registration-response fields (registered secret expires))))
(define dir (make-temporary-file "oauth-store-~a" 'directory))
(define path (build-path dir "credentials.sqlite"))
(define store #f)
(define now 100)
(define (clock) now)
(define calls 0)
(define (adapter metadata _fields)
  (set! calls (add1 calls))
  (result (hash-ref metadata 'issuer) (format "secret-~a" calls) 0))
(define (ensure metadata #:register [register adapter] #:fields [request fields] #:retry? [retry? #f])
  (ensure-oauth-registration! store metadata request #:register register #:clock clock #:retry-uncertain? retry?))
(define (child metadata request mode)
  (define-values (p out in err)
    (subprocess #f #f #f (find-executable-path "racket") worker path
                (json->string metadata) (json->string request) mode))
  (close-output-port in)
  (define output (port->string out))
  (define errors (port->string err))
  (subprocess-wait p)
  (close-input-port out) (close-input-port err)
  (values (subprocess-status p) output errors))
(dynamic-wind void
  (lambda ()
    (set! store (open-sqlite-store path))
    (check-exn #rx"outside a storage transaction"
      (lambda () (store-transaction store (lambda () (ensure (as issuer-a))))))
    (check-equal? calls 0)
    ;; Initial registration uses real native JSON HTTP and persists the secret.
    (define data (string->bytes/utf-8 (json->string (registered))))
    (peer (bytes-append (string->bytes/utf-8
          (format "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: ~a\r\n\r\n" (bytes-length data))) data)
      (lambda (url request closed)
        (define got (ensure-oauth-registration! store (as issuer-a url) fields
                      #:clock clock #:allow-loopback-http? #t))
        (check-equal? (oauth-registration-result-metadata got) (registered))
        (check-equal? (sync/timeout 2 closed) #t)))
    (close-store! store)
    (define-values (status output errors) (child (as issuer-a) fields "load"))
    (check-equal? status 0 errors)
    (check-equal? (string->json output) (registered))
    (set! store (open-sqlite-store path))
    (check-equal? (oauth-registration-result-metadata (ensure (as issuer-a))) (registered))
    (check-equal? calls 0)
    ;; Exact expiration boundary triggers replacement, not reuse.
    (set! now 110)
    (check-equal? (hash-ref (oauth-registration-result-metadata (ensure (as issuer-a))) 'client_secret) "secret-1")
    (check-equal? calls 1)
    (set! now 999999)
    (void (ensure (as issuer-a)))
    (check-equal? calls 1) ; zero expiry remains valid
    ;; Same client ID at another issuer must still obtain different credentials.
    (check-equal? (hash-ref (oauth-registration-result-metadata (ensure (as issuer-b))) 'client_secret) "secret-2")
    (check-equal? calls 2)
    (check-equal? (hash-ref (oauth-registration-result-metadata (ensure (as issuer-a))) 'client_secret) "secret-1")
    ;; Separate configuration at one issuer must not reuse another registration.
    (void (ensure (as issuer-a) #:fields (hash-set fields 'client_name "another app")))
    (check-equal? calls 3)
    (define issuer-c "https://c.example")
    (check-exn #rx"foreign issuer" (lambda () (ensure (as issuer-c) #:register (lambda (_m _f) (result issuer-a)))))
    (check-exn #rx"uncertain" (lambda () (ensure (as issuer-c))))
    (void (ensure (as issuer-c) #:retry? #t))
    (check-equal? calls 4)
    (define issuer-d "https://d.example")
    (check-exn #rx"expired" (lambda () (ensure (as issuer-d) #:register (lambda (_m _f) (result issuer-d "expired" 10)))))
    (check-exn #rx"uncertain" (lambda () (ensure (as issuer-d))))
    ;; A process exit after intent commit leaves no automatic replay path.
    (close-store! store)
    (define-values (killed _output _errors) (child (as "https://crash.example") fields "interrupt"))
    (check-equal? killed 9)
    (set! store (open-sqlite-store path))
    (check-exn #rx"uncertain" (lambda () (ensure (as "https://crash.example"))))
    (void (ensure (as "https://crash.example") #:retry? #t))
    (check-equal? calls 5)
    ;; A server-issued secret followed by process death is also uncertain.
    (peer (bytes-append (string->bytes/utf-8
          (format "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: ~a\r\n\r\n" (bytes-length data))) data)
      (lambda (url request closed)
        (define-values (code _out errors)
          (child (as "https://after-response.example" url) fields "interrupt-after-response"))
        (check-equal? code 9 errors)
        (check-not-false (sync/timeout 2 request))
        (check-equal? (sync/timeout 2 closed) #t)))
    (check-exn #rx"uncertain" (lambda () (ensure (as "https://after-response.example"))))
    (check-equal? calls 5)
    ;; Two SQLite connections coordinate while network work is outside a transaction.
    (define other (open-sqlite-store path))
    (define started (make-semaphore 0))
    (define release (make-semaphore 0))
    (define outcome (make-async-channel))
    (define concurrent-as (as "https://concurrent.example"))
    (define t (thread (lambda ()
      (with-handlers ([exn:fail? (lambda (e) (async-channel-put outcome e))])
        (async-channel-put outcome
          (ensure concurrent-as #:register (lambda (m f) (semaphore-post started)
                                            (semaphore-wait release) (adapter m f))))))))
    (check-not-false (sync/timeout 2 started))
    (check-exn #rx"already in progress"
      (lambda () (ensure-oauth-registration! other concurrent-as fields #:clock clock #:register adapter)))
    (semaphore-post release)
    (check-true (oauth-registration-result? (sync/timeout 2 outcome)))
    (thread-wait t)
    (void (ensure-oauth-registration! other concurrent-as fields #:clock clock #:register adapter))
    (check-equal? calls 6)
    (close-store! other))
  (lambda () (when store (close-store! store)) (delete-directory/files dir)))
