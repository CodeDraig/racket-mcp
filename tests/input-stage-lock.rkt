#lang racket/base
(require rackunit racket/async-channel mcp)

(for* ([group? '(#f #t)] [cancel? '(#f #t)])
  (define entered (make-async-channel))
  (define release (make-semaphore 0))
  (define calls 0)
  (define request (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
  (define requests (if group? (hasheq 'first request 'second request) request))
  (define program
    (make-workflow "blocked-input" "1" "input-stage-lock"
      (list (workflow-stage 'answer (if group? 'input-group 'input)
                (if group? (object-schema (hasheq 'first #t 'second #t)) #t)
                (lambda (_env)
                  (set! calls (add1 calls))
                  (async-channel-put entered (cons (current-thread) (current-store-connection)))
                  (semaphore-wait release)
                  requests)
                (and group? '(first second)) #f)
            (workflow-stage 'done 'complete #t (lambda (_env) (text-result "done")) #f #f))))
  (define tool (make-tool "blocked-input" '() (lambda (_args) (error 'test "workflow bypassed"))
                          #:workflow program #:execution 'task))
  (define store (open-memory-store))
  (define rt (make-runtime (make-interface #:tools (list tool)) #:store store))
  (define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
  (define (call method params)
    (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps)) #:principal "alice"))
  (define (bounded-call method params)
    (define answers (make-async-channel))
    (parameterize ([current-custodian (runtime-custodian rt)])
      (thread (lambda () (async-channel-put answers (call method params)))))
    (sync/timeout 2 answers))
  (dynamic-wind void
    (lambda ()
      (define task (call "tools/call" (hasheq 'name "blocked-input")))
      (define params (hasheq 'taskId (hash-ref task 'taskId)))
      (define entry (sync/timeout 5 entered))
      (check-not-false entry)
      (unless entry (error 'test "input callback did not start"))
      (check-false (cdr entry))
      (define polled (bounded-call "tasks/get" params))
      (check-equal? (and polled (hash-ref polled 'status)) "working")
      (when cancel?
        (check-equal? (bounded-call "tasks/cancel" params) (hasheq 'resultType "complete")))
      (semaphore-post release)
      (check-not-false (sync/timeout 5 (car entry)))
      (check-equal? calls 1)
      (check-equal? (hash-ref (call "tasks/get" params) 'status) (if cancel? "cancelled" "input_required"))
      (define task-row (load-instance store (hash-ref task 'taskId)))
      (define flow (load-instance store (hash-ref (stored-instance-state task-row) 'workflow)))
      (define state (stored-instance-state flow))
      (define pending-key (if group? 'pending-group 'pending-input))
      (check-equal? (hash-ref state 'position) 0)
      (cond
        [cancel?
         (check-equal? (hash-ref state 'status) "working")
         (check-false (hash-has-key? state pending-key))]
        [else
         (check-equal? (hash-ref state pending-key) requests)
         ;; A retry reads the persisted request without re-entering the callback.
         (define retry (run-workflow program store (hasheq) #:principal "alice" #:state (stored-instance-handle flow)))
         (check-equal? (hash-ref retry 'resultType) "input_required")
         (check-equal? (sort (hash-keys (hash-ref retry 'inputRequests)) symbol<?)
                       (if group? '(first second) '(answer)))
         (check-equal? calls 1)
         (define responses (for/hasheq ([id (in-list (if group? '(first second) '(answer)))])
                             (values id (hasheq 'action "decline"))))
         (check-equal? (call "tasks/update" (hash-set params 'inputResponses responses)) (hasheq 'resultType "complete"))
         (define final
           (let loop ([remaining 500])
             (define current (call "tasks/get" params))
             (cond [(equal? (hash-ref current 'status) "completed") current]
                   [(zero? remaining) (error 'test "task failed to complete: ~s" current)]
                   [else (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 remaining))])))
         (check-equal? (hash-ref final 'result) (text-result "done"))
         (check-equal? calls 1)]))
    (lambda ()
      (custodian-shutdown-all (runtime-custodian rt))
      (close-store! store))))
