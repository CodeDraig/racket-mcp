#lang racket/base
(require rackunit racket/async-channel mcp mcp/tasks mcp/authorization mcp/subscription)
(workflow (job) #:version "1" #:execution task
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
  (text-result "done"))
(define (who) (verified-principal "alice" "https://issuer.example" "https://api.example" '("read") (+ (current-seconds) 60)))
(define subscriber (who))
(define operator (who))
(define revoked? #f)
(define store (open-memory-store))
(define rt (make-runtime (view (make-interface #:tools (list job)) #:require-scopes '("read")) #:store store
  #:authorize (lambda (principal method params)
    (not (and revoked? (eq? principal subscriber) (equal? method "tasks/get"))))))
(define meta (request-meta #:capabilities (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq)))))
(define (call method params [principal operator] [notify void])
  (dispatch rt method (hash-set params '_meta meta) #:principal principal #:notify notify #:id "listen"))
(define task (call "tools/call" (hasheq 'name "job")))
(define id (hash-ref task 'taskId))
(let loop ([left 200])
  (unless (equal? (hash-ref (get-task store id (principal-key operator)) 'status) "input_required")
    (when (zero? left) (error 'test "task did not reach input boundary"))
    (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 left))))
(define denied-queue (make-async-channel))
(define allowed-queue (make-async-channel))
(define (listen principal queue)
  (thread (lambda () (call "subscriptions/listen" (hasheq 'notifications (hasheq 'taskIds (list id)))
    principal (lambda (event) (async-channel-put queue event))))))
(define denied-worker (listen subscriber denied-queue))
(define allowed-worker (listen operator allowed-queue))
(for ([queue (list denied-queue allowed-queue)])
  (define ack (sync/timeout 5 queue))
  (check-equal? (and ack (hash-ref ack 'method)) "notifications/subscriptions/acknowledged"))
(set! revoked? #t)
(void (call "tasks/update" (hasheq 'taskId id 'inputResponses (hasheq 'answer (hasheq 'action "decline")))))
(for ([expected '("working" "completed")])
  (define event (sync/timeout 5 allowed-queue))
  (check-equal? (and event (hash-ref (hash-ref event 'params) 'status)) expected))
;; The read waits for the publication transaction, so zero timeout below does
;; not race an in-flight decision for the other subscriber.
(check-equal? (hash-ref (get-task store id (principal-key operator)) 'status) "completed")
(check-false (sync/timeout 0 denied-queue))
(close-subscriptions! (runtime-subscriptions rt))
(check-not-false (sync/timeout 5 denied-worker))
(check-not-false (sync/timeout 5 allowed-worker))
(custodian-shutdown-all (runtime-custodian rt))
(close-store! store)
