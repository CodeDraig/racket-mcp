#lang racket/base
(require rackunit racket/async-channel mcp mcp/upstream mcp/upstream-subscription
         mcp/scenario mcp/stdio mcp/subscription)
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(workflow (work) #:version "1" #:execution task
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
  (hasheq 'resultType "complete" 'content (list (hasheq 'type "resource_link" 'uri "remote:///doc" 'name "doc"))))
(define resource (make-resource "doc" "remote:///doc" (lambda () "document")))
(define (next handle)
  (or (sync/timeout 3 (request-handle-notifications handle)) (error 'test "missing task notification")))
(for ([transport '(local stdio http)])
  (call-with-scenario-session (make-interface #:tools (list work) #:resources (list resource))
    (lambda (upstream)
      (define snapshot (capture-snapshot (lambda (m p) (scenario-call upstream m p))))
      (define polls 0)
      (define credential "remote-owner")
      (define (invoke m p)
        (when (equal? m "tasks/get") (set! polls (add1 polls)))
        (scenario-call upstream m p))
      (define source (make-upstream-interface snapshot invoke #:bridge
        (make-upstream-bridge #:identity "task-subscription" #:version "1" #:credential-id (lambda (_) credential))))
      (call-with-scenario-session (view source #:uris (hash "remote:///doc" "local:///doc"))
        (lambda (local)
          (define rt (scenario-session-runtime local))
          (define receipt (hash-ref (scenario-call local "tools/call" (hasheq 'name "work")) 'result))
          (define id (hash-ref receipt 'taskId))
          (define remote-id (hash-ref (stored-instance-state (load-instance (scenario-session-store local) id)) 'remoteId))
          ;; Wait for the peer's input boundary before opening the stream.
          (let loop ([remaining 200])
            (define detail (hash-ref (scenario-call upstream "tasks/get" (hasheq 'taskId remote-id)) 'result))
            (unless (equal? (hash-ref detail 'status) "input_required")
              (when (zero? remaining) (error 'test "peer did not reach input"))
              (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 remaining))))
          (define local-listener (scenario-request local "subscriptions/listen" (hasheq 'notifications (hasheq 'taskIds (list id)))))
          (check-equal? (hash-ref (next local-listener) 'method) "notifications/subscriptions/acknowledged")
          (define requests 0)
          (define (request m p) (set! requests (add1 requests)) (scenario-request upstream m p))
          (check-exn exn:fail? (lambda ()
            (call-with-upstream-task-subscription rt snapshot request (list id) void #:principal "foreign" #:capabilities caps)))
          (check-equal? requests 0)
          (set! credential "changed-credential")
          (check-exn exn:fail? (lambda ()
            (call-with-upstream-task-subscription rt snapshot request (list id) void #:principal "local-owner" #:capabilities caps)))
          (set! credential "remote-owner")
          (check-equal? requests 0)
          (check-exn exn:fail? (lambda ()
            (call-with-upstream-task-subscription rt (hash-set snapshot 'tools/list (hasheq 'tools '())) request (list id) void
              #:principal "local-owner" #:capabilities caps)))
          (check-equal? requests 0)
          (check-exn exn:fail? (lambda ()
            (call-with-upstream-task-subscription rt snapshot request (list id) void #:principal "local-owner" #:capabilities (hasheq))))
          (check-equal? requests 0)
          (define retained #f)
          (define terminal
            (call-with-upstream-task-subscription rt snapshot request (list id id)
              (lambda (subscription)
                (set! retained subscription)
                (check-true (upstream-task-subscription? subscription))
                (check-false (upstream-resource-subscription? subscription))
                (check-equal? (upstream-task-subscription-accepted subscription) (list id))
                ;; Complete through the peer, without a local task poll/update.
                (scenario-call upstream "tasks/update" (hasheq 'taskId remote-id 'inputResponses
                  (hasheq 'answer (hasheq 'action "decline"))))
                (define completed
                  (let loop ()
                    (define notice (next local-listener))
                    (define detail (hash-ref notice 'params))
                    (check-equal? (hash-ref detail 'taskId) id)
                    (check-equal? (hash-ref (hash-ref detail '_meta) 'io.modelcontextprotocol/subscriptionId)
                                  (request-handle-id local-listener))
                    (if (equal? (hash-ref detail 'status) "completed") detail (loop))))
                (check-equal? (hash-ref (car (hash-ref (hash-ref completed 'result) 'content)) 'uri) "local:///doc")
                (check-equal? polls 0)
                (close-subscriptions! (runtime-subscriptions (scenario-session-runtime upstream)))
                (sync/timeout 3 subscription))
              #:principal "local-owner" #:capabilities caps #:timeout 3))
          (check-equal? (hash-ref (hash-ref terminal 'result) 'resultType) "complete")
          (check-eq? (sync/timeout 0 retained) terminal)
          (check-equal? (hash-ref (hash-ref (scenario-call local "tasks/get" (hasheq 'taskId id)) 'result) 'status) "completed")
          (check-equal? polls 0)
          ;; Fresh subscription and local cancellation leave the stored task intact.
          (call-with-upstream-task-subscription rt snapshot request (list id)
            (lambda (subscription)
              (stop-upstream-task-subscription! subscription)
              (check-true (exn:fail:request-cancelled? (sync/timeout 3 subscription))))
            #:principal "local-owner" #:capabilities caps #:timeout 3)
          (check-false (sync/timeout 0 local-listener))
          ;; A connection's continued availability does not bypass credential checks.
          (call-with-upstream-task-subscription rt snapshot request (list id)
            (lambda (subscription)
              (set! credential "revoked")
              (define detail (hash-ref (scenario-call upstream "tasks/get" (hasheq 'taskId remote-id)) 'result))
              (publish-change! (runtime-subscriptions (scenario-session-runtime upstream)) "notifications/tasks"
                (hash-remove detail 'resultType) #:principal "remote-owner")
              (define failed (sync/timeout 3 subscription))
              (check-true (exn:fail:mcp? failed))
              (check-false (sync/timeout 0 (request-handle-notifications local-listener))))
            #:principal "local-owner" #:capabilities caps #:timeout 3)
          (set! credential "remote-owner")
          (request-cancel! local-listener))
        #:transport transport #:principal "local-owner" #:capabilities caps))
    #:transport transport #:principal "remote-owner" #:capabilities caps))
