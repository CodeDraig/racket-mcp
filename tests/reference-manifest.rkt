#lang racket/base
(require rackunit racket/list racket/runtime-path)
(module provider racket/base
  (require mcp)
  (provide document)
  (resource (document [id String]) #:uri "doc:///{id}" id)
  (error 'provider "must not instantiate while reading the manifest"))
(module application mcp/lang
  (server #:name "manifest-test" #:version "1")
  (require (rename-in (submod ".." provider) [document imported]))
  (define-syntax-rule (reference id) (link (imported id)))
  (tool (open [id String]) (hasheq 'content (list (reference id) (reference id))))
  (prompt (show [id String]) (role "user" (link (later id))))
  (resource (later [id String]) #:uri "later:///{id}" id)
  (workflow (durable [id String]) #:version "1"
    (checkpoint [uri String] (resource-uri (imported id)))
    (hasheq 'content (list (link (later id)))))
  (resource (durable-resource [id String]) #:uri "durable:///{id}" #:workflow "1"
    (resource-uri (imported id)))
  (tool (shadow [imported String]) (text-result imported))
  (tool (quoted) (text-result (symbol->string 'imported)))
  (error 'application "must not instantiate while reading the manifest"))
(define-runtime-path self "reference-manifest.rkt")
(define manifest (dynamic-require `(submod ,self application manifest) 'manifest))
(define (entry name) (findf (lambda (e) (eq? name (hash-ref e 'name))) manifest))
(define (refs name) (hash-ref (entry name) 'resource-references))
(check-equal? (map (lambda (r) (hash-ref r 'name)) (refs 'open)) '(document))
(check-equal? (map (lambda (r) (hash-ref r 'name)) (refs 'show)) '(later))
(check-equal? (sort (map (lambda (r) (hash-ref r 'name)) (refs 'durable)) symbol<?) '(document later))
(check-equal? (map (lambda (r) (hash-ref r 'name)) (refs 'durable-resource)) '(document))
(check-equal? (refs 'shadow) '())
(check-equal? (refs 'quoted) '())
(check-equal? (hash-ref (entry 'open) 'reference-analysis) 'lexical-handler-syntax)
(for ([ref (in-list (refs 'open))])
  (check-equal? (hash-ref ref 'source) (path->string self))
  (check-equal? (hash-ref ref 'line) 6)
  (check-true (exact-positive-integer? (hash-ref ref 'position)))
  (check-true (exact-nonnegative-integer? (hash-ref ref 'column))))
(check-equal? (dynamic-require `(submod ,self application manifest) 'manifest) manifest)
