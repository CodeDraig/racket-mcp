#lang racket/base
(require rackunit mcp/authorization web-server/http)
(define registration (oauth-registration "https://issuer.example" "https://client.example/id.json" "http://127.0.0.1/callback" "https://resource.example/mcp" '("read")))
(define metadata (hasheq 'issuer "https://issuer.example" 'authorization_endpoint "https://issuer.example/authorize" 'token_endpoint "https://issuer.example/token" 'code_challenge_methods_supported '("S256")))
(define-values (url pending) (begin-authorization registration metadata))
(check-true (regexp-match? #rx"code_challenge_method=S256" url))
(check-equal? (string-length (oauth-pending-verifier pending)) 43)
(check-exn exn:fail? (lambda () (finish-authorization pending (hasheq 'state "wrong" 'iss "https://issuer.example" 'code "x") void)))
(check-exn exn:fail? (lambda () (finish-authorization pending (hasheq 'state (oauth-pending-state pending) 'iss "https://other.example" 'code "x") void)))
(define credential (finish-authorization pending (hasheq 'state (oauth-pending-state pending) 'iss "https://issuer.example" 'code "x")
                                         (lambda (url body) (check-equal? (hash-ref body 'code_verifier) (oauth-pending-verifier pending))
                                           (hasheq 'access_token "token" 'token_type "Bearer" 'expires_in 60 'refresh_token "refresh")) #:clock (lambda () 100)))
(check-equal? (oauth-credential-expires credential) 160)
(define verifier (make-bearer-authenticator (lambda (_) (verified-principal "alice" "https://issuer.example" "https://resource.example/mcp" '("read") 200))
                                           #:issuer "https://issuer.example" #:audience "https://resource.example/mcp" #:clock (lambda () 100)))
(check-true (verified-principal? (verifier (list (header #"Authorization" #"Bearer token")))))
(check-false (verifier (list (header #"Authorization" #"Bearer token") (header #"authorization" #"Bearer token"))))
