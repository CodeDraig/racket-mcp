#lang racket/base
(require rackunit racket/list mcp mcp/tasks)
(define runs 0)
(define entered (make-semaphore))
(define release (make-semaphore))
(define worker-breaks #f)
(workflow (prepared [name String]) #:version "1" #:execution task
  (checkpoint [prefix String] (begin (set! runs (add1 runs)) name))
  (await-input [answer Any]
    (hasheq 'mode "form" 'message "Approve?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
  (if (equal? (hash-ref answer 'action) "accept")
      (begin
        (task-boundary launch)
        (checkpoint [done String] (begin (set! worker-breaks (break-enabled)) (semaphore-post entered) (semaphore-wait release) prefix))
        (text-result done))
      (text-result (hash-ref answer 'action))))
(define store (open-memory-store))
(define rt (make-runtime (make-interface #:tools (list prepared)) #:store store))
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define params (hasheq 'name "prepared" 'arguments (hasheq 'name "Ada")))
(define (call params [principal "alice"] [capabilities caps])
  (dispatch rt "tools/call" (hash-set params '_meta (request-meta #:capabilities capabilities)) #:principal principal))
(define (tasks) (filter (lambda (i) (hash-has-key? (stored-instance-state i) 'task)) (list-instances store)))
(dynamic-wind void
  (lambda ()
    (check-exn exn:fail:mcp? (lambda () (call params "alice" (hasheq 'elicitation (hasheq)))))
    (check-equal? (list-instances store) '())
    (define first (call params))
    (check-equal? (hash-ref first 'resultType) "input_required")
    (check-false (hash-has-key? first 'taskId))
    (check-equal? (tasks) '())
    (define retry (hash-set* params 'requestState (hash-ref first 'requestState)
                            'inputResponses (hasheq 'answer (hasheq 'action "accept" 'content (hasheq 'ok #t)))))
    (check-exn exn:fail? (lambda () (call retry "bob")))
    (define task (call retry))
    (check-equal? (hash-ref task 'resultType) "task")
    (check-false (hash-has-key? task 'requestState))
    (check-not-false (sync/timeout 2 entered))
    (check-true worker-breaks)
    ;; Retries must return the receipt while the task is blocked inside a stage.
    (define reply (make-channel))
    (define worker (thread (lambda () (channel-put reply (call retry)))))
    (define replayed (sync/timeout 2 reply))
    (unless replayed (kill-thread worker))
    (check-equal? replayed task)
    (thread-wait worker)
    (check-equal? (length (tasks)) 1)
    (check-equal? runs 1)
    (check-exn exn:fail:mcp?
      (lambda () (call (hash-set retry 'inputResponses (hasheq 'answer (hasheq 'action "decline"))))))
    (semaphore-post release)
    (define final
      (let loop ([left 200])
        (define current (get-task store (hash-ref task 'taskId) "alice"))
        (cond [(equal? (hash-ref current 'status) "completed") current]
              [(zero? left) (error 'test "task did not complete")]
              [else (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 left))])))
    (check-equal? (hash-ref (hash-ref final 'result) 'content) (list (text-content "Ada")))
    (check-equal? (call retry) task)
    (check-equal? (length (tasks)) 1)
    (for ([action '("decline" "cancel")])
      (define pending (call params))
      (define result (call (hash-set* params 'requestState (hash-ref pending 'requestState)
                                     'inputResponses (hasheq 'answer (hasheq 'action action)))))
      (check-equal? (hash-ref result 'resultType) "complete")
      (check-equal? (hash-ref result 'content) (list (text-content action))))
    (check-equal? (length (tasks)) 1))
  (lambda () (custodian-shutdown-all (runtime-custodian rt)) (close-store! store)))
