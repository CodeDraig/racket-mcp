#lang racket/base
(require rackunit racket/async-channel racket/port racket/string racket/tcp net/uri-codec mcp/oauth-http)
(define (peer response proc)
  (define owner (make-custodian))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define listener (tcp-listen 0 4 #t "127.0.0.1"))
        (define-values (_ port _host _port) (tcp-addresses listener #t))
        (define request (make-async-channel))
        (define closed (make-async-channel))
        (thread
         (lambda ()
           (define-values (in out) (tcp-accept listener))
           (define first (read-line in 'any))
           (define headers
             (let loop ([lines '()])
               (define line (read-line in 'any))
               (if (equal? line "") (reverse lines) (loop (cons line lines)))))
           (define length
             (for/first ([h (in-list headers)] #:do [(define m (regexp-match #px"(?i:^Content-Length:) *([0-9]+)$" h))] #:when m)
               (string->number (cadr m))))
           (define body (read-bytes (or length 0) in))
           (async-channel-put request (list first headers body))
           (when response (write-bytes response out) (flush-output out))
           (async-channel-put closed (eof-object? (read-byte in)))
           (close-input-port in) (close-output-port out)))
        (proc (format "http://127.0.0.1:~a/meta?x=1" port) request closed)))
    (lambda () (custodian-shutdown-all owner))))
(define-values (fetch exchange) (make-oauth-http-adapters #:allow-loopback-http? #t))
(peer #"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 11\r\n\r\n{\"ok\":true}"
  (lambda (url request closed)
    (check-equal? (fetch url) (hasheq 'ok #t))
    (define got (sync/timeout 2 request))
    (check-equal? (car got) "GET /meta?x=1 HTTP/1.1")
    (check-false (ormap (lambda (h) (string-prefix? (string-downcase h) "authorization:")) (cadr got)))
    (check-equal? (sync/timeout 2 closed) #t)))
(peer #"HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: 2\r\n\r\n{}"
  (lambda (url request closed)
    (check-equal? (exchange url (hasheq 'code "snow 雪 &+" 'client_id "https://client.example/id")) (hasheq))
    (define got (sync/timeout 2 request))
    (check-equal? (car got) "POST /meta?x=1 HTTP/1.1")
    (check-not-false (member "Content-Type: application/x-www-form-urlencoded" (cadr got)))
    (check-equal? (form-urlencoded->alist (bytes->string/utf-8 (caddr got)))
                  '((client_id . "https://client.example/id") (code . "snow 雪 &+")))
    (check-equal? (sync/timeout 2 closed) #t)))
(for ([code '(404 405)])
  (peer (string->bytes/utf-8 (format "HTTP/1.1 ~a Missing\r\nContent-Length: 0\r\n\r\n" code))
    (lambda (url request closed)
      (check-false (fetch url))
      (check-equal? (sync/timeout 2 closed) #t))))
(for ([code '(302 401 500)])
  (peer (string->bytes/utf-8 (format "HTTP/1.1 ~a Failure\r\nLocation: https://other.example/\r\nContent-Length: 4\r\n\r\noops" code))
    (lambda (url request closed)
      (check-exn (lambda (e) (and (exn:fail:oauth-http? e) (= (exn:fail:oauth-http-status e) code)
                                 (bytes=? (exn:fail:oauth-http-body e) #"oops")))
                 (lambda () (fetch url)))
      (check-equal? (sync/timeout 2 closed) #t))))
(peer #f
  (lambda (url request closed)
    (define-values (short-fetch _) (make-oauth-http-adapters #:allow-loopback-http? #t #:timeout 0.1))
    (check-exn #rx"timed out" (lambda () (short-fetch url)))
    (check-equal? (sync/timeout 2 closed) #t)))
(peer #"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 1000000\r\n\r\n123456789"
  (lambda (url request closed)
    (define-values (limited-fetch _) (make-oauth-http-adapters #:allow-loopback-http? #t #:max-response-bytes 8))
    (check-exn #rx"byte limit" (lambda () (limited-fetch url)))
    (check-equal? (sync/timeout 2 closed) #t)))
(peer #"HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 2\r\n\r\n{}"
  (lambda (url request closed)
    (check-exn #rx"application/json" (lambda () (fetch url)))
    (check-equal? (sync/timeout 2 closed) #t)))
(define-values (secure-fetch secure-exchange) (make-oauth-http-adapters))
(check-exn #rx"HTTPS" (lambda () (secure-fetch "http://127.0.0.1/")))
(check-exn #rx"HTTPS" (lambda () (fetch "http://example.com/")))
(check-exn #rx"HTTPS" (lambda () (secure-fetch "https://name:password@example.com/")))
(check-exn exn:fail? (lambda () (exchange "https://example.com" (hash 'code "x" "code" "y"))))
(peer #f
  (lambda (url request closed)
    (define caller (thread (lambda () (with-handlers ([exn:break? void]) (fetch url)))))
    (check-not-false (sync/timeout 2 request))
    (break-thread caller)
    (check-not-false (sync/timeout 2 (thread-dead-evt caller)))
    (check-equal? (sync/timeout 2 closed) #t)))
