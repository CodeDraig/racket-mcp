#lang racket/base
(require rackunit racket/file net/base64 mcp mcp/rendering)
(resource (pages) #:uri "docs:///pages"
  (resource-contents "First" (text-presentation "Second")))
(resource (mixed) #:uri "docs:///mixed"
  (resource-contents "Text" (binary-presentation #"\0\377" #:mime-type "image/png")))
(resource (empty) #:uri "docs:///empty" (resource-contents))
(resource (joined) #:uri "docs:///joined" (text-presentation "[" (embed (pages)) "]"))
(resource (as-json) #:uri "docs:///json" (json-presentation (hasheq 'pages (embed (pages)))))
(resource (invalid-text) #:uri "docs:///invalid" (text-presentation (embed (mixed))))
(prompt (read-pages) (role "user" (text-content "Before") (embed (pages)) (text-content "After")))
(prompt (read-mixed) (role "assistant" (embed (mixed))))
(prompt (read-empty) (role "user" (embed (empty))))
(tool (show-pages)
  (structured-result (hasheq 'pages (embed (pages))) #:content (list (text-content "Before") (embed (pages)) (text-content "After"))))
(define base (make-interface #:tools (list show-pages) #:prompts (list read-pages read-mixed read-empty)
  #:resources (list pages mixed empty joined as-json invalid-text)))
(for ([durable? '(#f #t)])
  (define store (and durable? (open-memory-store)))
  (define rt (make-runtime (view base #:namespace "mounted-" #:uris (hash "docs:///pages" "view:///pages")) #:store store))
  (define (call method params) (dispatch rt method (hash-set params '_meta (request-meta))))
  (define read-result (call "resources/read" (hasheq 'uri "view:///pages")))
  (check-equal? (map (lambda (c) (hash-ref c 'text)) (hash-ref read-result 'contents)) '("First" "Second"))
  (define messages (hash-ref (call "prompts/get" (hasheq 'name "mounted-read-pages")) 'messages))
  (check-equal? (length messages) 4)
  (check-equal? (map (lambda (m) (hash-ref m 'role)) messages) '("user" "user" "user" "user"))
  (check-equal? (map (lambda (m) (hash-ref (hash-ref (hash-ref m 'content) 'resource) 'uri)) (list (cadr messages) (caddr messages))) '("view:///pages" "view:///pages"))
  (define tool-result (call "tools/call" (hasheq 'name "mounted-show-pages")))
  (check-equal? (length (hash-ref tool-result 'content)) 4)
  (check-equal? (length (hash-ref (hash-ref tool-result 'structuredContent) 'pages)) 2)
  (define mixed-messages (hash-ref (call "prompts/get" (hasheq 'name "mounted-read-mixed")) 'messages))
  (check-equal? (length mixed-messages) 2)
  (check-equal? (base64-decode (string->bytes/utf-8 (hash-ref (hash-ref (hash-ref (cadr mixed-messages) 'content) 'resource) 'blob))) #"\0\377")
  (check-equal? (hash-ref (call "prompts/get" (hasheq 'name "mounted-read-empty")) 'messages) '())
  (define (text uri) (hash-ref (car (hash-ref (call "resources/read" (hasheq 'uri uri)) 'contents)) 'text))
  (check-equal? (text "docs:///joined") "[FirstSecond]")
  (check-equal? (length (hash-ref (string->json (text "docs:///json")) 'pages)) 2)
  (check-exn exn:fail? (lambda () (text "docs:///invalid")))
  (when store (close-store! store))
  (custodian-shutdown-all (runtime-custodian rt)))

(define constructions 0)
(define question (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
(resource (delayed) #:uri "docs:///delayed" #:workflow "1"
  (await-input [answer Any] question)
  (resource-contents "One" "Two"))
(prompt (durable-parent)
  (set! constructions (add1 constructions))
  (role "user" (text-content "Before") (embed (delayed)) (text-content "After")))
(define path (make-temporary-file "mcp-multi-content-~a.sqlite"))
(define store (open-sqlite-store path))
(define (runtime) (make-runtime (make-interface #:resources (list delayed) #:prompts (list durable-parent)) #:store store))
(define params (hasheq 'name "durable-parent" '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq)))))
(define initial (dispatch (runtime) "prompts/get" params))
(close-store! store)
(set! store (open-sqlite-store path))
(define resumed (hash-set* params 'requestState (hash-ref initial 'requestState)
  'inputResponses (hasheq 'e0/r0/answer (hasheq 'action "decline"))))
(define done (dispatch (runtime) "prompts/get" resumed))
(check-equal? (length (hash-ref done 'messages)) 4)
(check-equal? (map (lambda (m) (hash-ref (hash-ref (hash-ref m 'content) 'resource) 'text))
                 (list (cadr (hash-ref done 'messages)) (caddr (hash-ref done 'messages)))) '("One" "Two"))
(check-equal? (dispatch (runtime) "prompts/get" resumed) done)
(check-equal? constructions 1)
;; Old rendering records may have already discarded content. Do not silently
;; resume them under the new cardinality semantics.
(define old (create-instance! store "local" "render:test" (hasheq) "render/1" "fixture"
  (+ (current-seconds) 60) (hasheq 'kind "render" 'layout '() 'children '() 'history (hasheq))))
(check-exn #rx"version is incompatible"
  (lambda () (render-layout store #f #:operation "test" #:arguments (hasheq) #:principal "local"
    #:fingerprint "fixture" #:resolve void #:state (stored-instance-handle old))))
(close-store! store) (delete-file path)
