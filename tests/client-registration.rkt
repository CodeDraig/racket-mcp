#lang racket/base
(require rackunit mcp/authorization)
(define url "https://client.example/oauth/client.json")
(define redirect "http://127.0.0.1:4567/callback")
(define document (client-id-metadata-document url "Racket MCP" (list redirect "com.example.app:/callback")))
(check-equal? (hash-ref document 'client_id) url)
(check-equal? (hash-ref document 'token_endpoint_auth_method) "none")
(check-equal? (hash-ref document 'grant_types) '("authorization_code" "refresh_token"))
(check-equal? (hash-ref (client-id-metadata-document url "Without refresh" (list redirect)
                         #:extra (hasheq 'grant_types '("authorization_code"))) 'grant_types)
              '("authorization_code"))
(check-equal? (check-client-id-metadata! document url) document)
(for ([bad '("https://client.example" "http://client.example/id" "https://user@client.example/id"
              "https://client.example/id#fragment" "https://client.example/a/../id"
              "https://client.example/%2e/id" "https://client.example/%2E%2e/id")])
  (check-exn exn:fail? (lambda () (client-id-metadata-document bad "Client" (list redirect)))))
(check-exn #rx"exactly match" (lambda () (check-client-id-metadata! document "https://client.example/other.json")))
(for ([extra (list (hasheq 'client_secret "secret") (hasheq 'client_secret_expires_at 10)
                   (hasheq 'token_endpoint_auth_method "client_secret_basic")
                   (hasheq 'client_id url) (hasheq 'response_types '("token")))])
  (check-exn exn:fail? (lambda () (client-id-metadata-document url "Client" (list redirect) #:extra extra))))
(for ([bad (list "relative/callback" "https://client.example/callback#fragment" "http://public.example/callback")])
  (check-exn exn:fail? (lambda () (client-id-metadata-document url "Client" (list bad)))))
(define issuer "https://issuer.example")
(define resource "https://resource.example/mcp")
(define metadata (hasheq 'issuer issuer 'client_id_metadata_document_supported #t))
(define prereg (oauth-registration issuer "registered-client" redirect "https://previous.example/mcp" '("old")))
(define selected (select-oauth-registration metadata resource redirect '("read")
                   #:pre-registered (hash issuer prereg) #:client-metadata document #:client-metadata-url url))
(check-equal? (oauth-registration-client-id selected) "registered-client")
(check-equal? (oauth-registration-resource selected) resource)
(check-equal? (oauth-registration-scopes selected) '("read"))
(define portable (select-oauth-registration metadata resource redirect '("read") #:client-metadata document #:client-metadata-url url))
(check-equal? (oauth-registration-client-id portable) url)
(check-equal? (oauth-registration-issuer portable) issuer)
(define new-issuer "https://new.example")
(define moved (select-oauth-registration (hash-set metadata 'issuer new-issuer) resource redirect '()
                #:pre-registered (hash issuer prereg) #:client-metadata document #:client-metadata-url url))
(check-equal? (oauth-registration-issuer moved) new-issuer)
(check-equal? (oauth-registration-client-id moved) url)
(check-exn #rx"mismatch" (lambda ()
  (select-oauth-registration metadata resource redirect '() #:pre-registered (hash issuer (struct-copy oauth-registration prereg [issuer new-issuer]))
                             #:client-metadata document #:client-metadata-url url)))
(check-exn #rx"no client registration" (lambda ()
  (select-oauth-registration (hash-set metadata 'client_id_metadata_document_supported #f) resource redirect '()
                             #:client-metadata document #:client-metadata-url url)))
(check-exn #rx"redirect is absent" (lambda ()
  (select-oauth-registration metadata resource "http://127.0.0.1:9999/callback" '() #:client-metadata document #:client-metadata-url url)))
(define asked '())
(define manual (select-oauth-registration (hasheq 'issuer issuer) resource redirect '("write")
                 #:request-registration (lambda (iss uri) (set! asked (list iss uri)) prereg)))
(check-equal? asked (list issuer redirect))
(check-equal? (oauth-registration-scopes manual) '("write"))
