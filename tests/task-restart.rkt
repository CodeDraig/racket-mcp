#lang racket/base
(require rackunit racket/file racket/list racket/port racket/runtime-path mcp)
(define-runtime-path worker "task-restart-worker.rkt")
(define dir (make-temporary-file "mcp-task-restart-~a" 'directory (current-directory)))
(define (spawn db marker mode)
  (define-values (process out in err)
    (subprocess #f #f #f (find-executable-path "racket") worker db marker mode))
  (close-output-port in)
  (values process out err))
(define (run db marker mode)
  (define-values (process out err) (spawn db marker mode))
  (define stdout (port->string out))
  (define stderr (port->string err))
  (subprocess-wait process)
  (close-input-port out) (close-input-port err)
  (check-equal? (subprocess-status process) 0 stderr)
  (string->json stdout))
(dynamic-wind void
  (lambda ()
    (for ([mode '("resume" "deny")])
      (define db (build-path dir (string-append mode ".sqlite")))
      (define marker (path->string (build-path dir (string-append mode ".mutation"))))
      (define-values (process out err) (spawn db marker "start"))
      (dynamic-wind void
        (lambda ()
          (check-not-false (sync/timeout 10 out))
          (check-equal? (read-line out) "ready")
          (define inspector (open-sqlite-store db))
          (dynamic-wind void
            (lambda ()
              (define flow (findf (lambda (i) (equal? (stored-instance-operation i) "restartable")) (list-instances inspector)))
              (check-exn #rx"execution is active"
                         (lambda () (recover-workflow! inspector (stored-instance-handle flow) 'mutation 'outcome #:principal "alice" #:outcome 42))))
            (lambda () (close-store! inspector)))
          ;; A second process cannot enter the live worker's external effect.
          (check-equal? (hash-ref (run db marker "probe") 'status) "working")
          (check-equal? (length (file->lines (string-append marker ".attempts"))) 1))
        (lambda () (subprocess-kill process #t) (subprocess-wait process)
          (close-input-port out) (close-input-port err)))
      (define result (run db marker mode))
      (check-equal? (hash-ref result 'status) (if (equal? mode "deny") "failed" "completed"))
      (when (equal? mode "resume")
        (check-equal? (hash-ref (hash-ref result 'result) 'content) (list (text-content "42"))))
      (check-equal? (length (file->lines marker)) 1)
      (check-equal? (length (file->lines (string-append marker ".attempts"))) (if (equal? mode "deny") 1 2))))
  (lambda () (delete-directory/files dir)))
