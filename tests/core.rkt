#lang racket/base
(require rackunit racket/port racket/runtime-path mcp mcp/stdio syntax/macro-testing
         (prefix-in example: "../examples/greeter.rkt"))
(define-runtime-path example "../examples/greeter.rkt")
(define iface example:mcp-interface)
(define rt (make-runtime iface))
(define (request method [params (hasheq)]) (dispatch rt method (hash-set params '_meta (request-meta))))
(check-equal? (hash-ref (request "tools/call" (hasheq 'name "greet" 'arguments (hasheq 'name "Ada"))) 'content)
              (list (text-content "Hello, Ada")))
(check-equal? (hash-ref (request "server/discover") 'supportedVersions) '("2026-07-28"))
(check-exn exn:fail:mcp? (lambda () (request "tools/call" (hasheq 'name "greet" 'arguments (hasheq)))))
(check-exn exn:fail:syntax? (lambda () (convert-compile-time-error (tool (bad [x String] [x String]) (text-result x)))))
(define count 0)
(tool (defaults [x Integer #:default (begin (set! count (add1 count)) 2)] [y Integer #:default (+ x 1)] [z Boolean #:optional])
  (structured-result (list x y (missing? z))))
(define drt (make-runtime (make-interface #:tools (list defaults))))
(check-equal? (hash-ref (dispatch drt "tools/call" (hasheq '_meta (request-meta) 'name "defaults")) 'structuredContent) '(2 3 #t))
(check-equal? count 1)
(check-equal? (hash-ref (dispatch drt "tools/call" (hasheq '_meta (request-meta) 'name "defaults" 'arguments (hasheq 'x 8 'z #f))) 'structuredContent) '(8 9 #f))
(check-equal? count 1)
(check-equal? (string->json "[null,false,0.1,1e-3]") (list json-null #f 1/10 1/1000))
(check-equal? (json->string (string->json "[0.1,-0.0125,2e3]")) "[0.1,-0.0125,2000]")
(check-exn exn:fail? (lambda () (string->json "{\"x\":1,\"x\":2}")))
(check-exn exn:fail? (lambda () (string->json "[1,]")))
(check-exn exn:fail? (lambda () (string->json "true false")))
(check-true (valid? (hasheq 'multipleOf 1/10) 3/10))
(check-false (valid? (hasheq 'multipleOf 1/10) 31/100))
(check-true (valid? (hasheq 'allOf (list (hasheq 'properties (hasheq 'x Integer))) 'unevaluatedProperties #f) (hasheq 'x 1)))
(check-false (valid? (hasheq 'allOf (list (hasheq 'properties (hasheq 'x Integer))) 'unevaluatedProperties #f) (hasheq 'x 1 'y 2)))
(define-values (server-in client-out) (make-pipe))
(define-values (client-in server-out) (make-pipe))
(define worker (thread (lambda () (serve-stdio rt #:input server-in #:output server-out))))
(define client (make-stdio-client client-in client-out))
(define pending (for/list ([i (in-range 20)]) (client-request client "tools/call" (hasheq 'name "greet" 'arguments (hasheq 'name (number->string i))))))
(for ([h (in-list pending)] [i (in-naturals)])
  (define reply (sync/timeout 5 h))
  (check-not-false reply)
  (check-equal? (hash-ref (hash-ref reply 'result) 'content) (list (text-content (format "Hello, ~a" i)))))
(close-output-port client-out)
(thread-wait worker)
(client-close! client)
(close-output-port server-out)
(check-true (list? (dynamic-require `(submod ,example manifest) 'manifest)))
