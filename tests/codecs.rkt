#lang racket/base
(require rackunit racket/file mcp)
(shape Receipt [id Integer] [label String])
(define receipt (make-Receipt 7 "saved"))
(define registry (make-codec-registry (list Receipt-codec)))
(check-eq? (lookup-codec registry "Receipt" "1") Receipt-codec)
(check-equal? (decode-value Receipt-codec (encode-value Receipt-codec receipt)) receipt)
(check-exn exn:fail? (lambda () (lookup-codec registry "Receipt" "2")))
(check-exn exn:fail? (lambda () (decode-value Receipt-codec (hash-set (encode-value Receipt-codec receipt) 'version "2"))))
(check-exn exn:fail? (lambda () (make-codec-registry (list Receipt-codec (make-value-codec "Receipt" "1" Receipt Receipt->json json->Receipt)))))
(define computed 0)
(workflow (save-receipt) #:version "1"
  (checkpoint [saved Receipt-codec] (begin (set! computed (add1 computed)) receipt))
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
  (text-result (Receipt-label saved)))
(define path (make-temporary-file "mcp-codec-~a.sqlite"))
(define store (open-sqlite-store path))
(define (runtime) (make-runtime (make-interface #:tools (list save-receipt)) #:store store))
(define params (hasheq '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq))) 'name "save-receipt"))
(define pending (dispatch (runtime) "tools/call" params))
(close-store! store)
(set! store (open-sqlite-store path))
(define complete (dispatch (runtime) "tools/call" (hash-set* params 'requestState (hash-ref pending 'requestState) 'inputResponses (hasheq 'answer (hasheq 'action "decline")))))
(check-equal? (hash-ref complete 'content) (list (text-content "saved")))
(check-equal? computed 1)
(define flow
  (make-workflow "effect" "1" "executable"
                 (list (workflow-stage 'receipt 'effect Receipt-codec (lambda (_) 7) 'writer 'manual)
                       (workflow-stage 'done 'complete Any (lambda (env) (text-result (Receipt-label (hash-ref env 'receipt)))) #f #f))
                 #:key (lambda (_) "one")))
(define adapters (hasheq 'writer (effect-adapter 'manual (lambda (input key tx) (error 'writer "uncertain")))))
(check-exn exn:fail? (lambda () (run-workflow flow store (hasheq) #:principal "alice" #:adapters adapters)))
(define handle #f)
(check-exn (lambda (e) (and (exn:fail:recovery? e) (begin (set! handle (exn:fail:recovery-handle e)) #t)))
           (lambda () (run-workflow flow store (hasheq) #:principal "alice" #:adapters adapters)))
(check-exn exn:fail? (lambda () (recover-workflow! store handle 'receipt 'outcome #:outcome receipt #:principal "alice")))
(void (recover-workflow! store handle 'receipt 'outcome #:outcome receipt #:principal "alice" #:codecs registry))
(check-equal? (hash-ref (run-workflow flow store (hasheq) #:principal "alice" #:adapters adapters) 'content) (list (text-content "saved")))
(define revised-codec (make-value-codec "Receipt" "2" Receipt Receipt->json json->Receipt))
(define revised
  (make-workflow "effect" "1" "executable"
                 (cons (struct-copy workflow-stage (car (workflow-descriptor-stages flow)) [schema revised-codec])
                       (cdr (workflow-descriptor-stages flow)))))
(check-exn exn:fail:recovery? (lambda () (run-workflow revised store (hasheq) #:principal "alice" #:state handle)))
(close-store! store)
(delete-file path)
