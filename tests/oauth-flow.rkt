#lang racket/base
(require rackunit racket/list racket/string net/url mcp/authorization mcp/oauth)
(define resource "https://api.example/mcp")
(define redirect "http://127.0.0.1/callback")
(define document-url "https://client.example/id.json")
(define document (client-id-metadata-document document-url "Client" (list redirect)))
(define (fixture #:save-fails? [save-fails? (box #f)] #:exchange-fails? [exchange-fails? (box #f)]
                 #:load [load (lambda (_i _c _r) #f)])
  (define clock (box 100))
  (define issuer (box "https://issuer.example"))
  (define counts (make-hash '((browse . 0) (exchange . 0) (save . 0))))
  (define (count! key) (hash-update! counts key add1))
  (define desired '())
  (define saved '())
  (define authorizer
    (make-oauth-authorizer #:resource resource #:redirect-uri redirect
      #:client-metadata document #:client-metadata-url document-url
      #:clock (lambda () (unbox clock)) #:load load
      #:fetch (lambda (url)
        (if (equal? url (protected-resource-metadata-url resource))
            (protected-resource-metadata resource (list (unbox issuer)) #:scopes '("read"))
            (hasheq 'issuer (unbox issuer) 'authorization_endpoint (string-append (unbox issuer) "/authorize")
                    'token_endpoint (string-append (unbox issuer) "/token") 'response_types_supported '("code")
                    'code_challenge_methods_supported '("S256") 'client_id_metadata_document_supported #t)))
      #:browse (lambda (url)
        (count! 'browse)
        (define query (url-query (string->url url)))
        (set! desired (string-split (cond [(assq 'scope query) => cdr] [else ""]) " "))
        (check-equal? (cdr (assq 'resource query)) resource)
        (check-equal? (cdr (assq 'code_challenge_method query)) "S256")
        (hasheq 'state (cdr (assq 'state query)) 'iss (unbox issuer) 'code "code"))
      #:exchange (lambda (url fields)
        (count! 'exchange)
        (when (unbox exchange-fails?) (error 'fixture "uncertain exchange"))
        (check-equal? (hash-ref fields 'resource) resource)
        (check-equal? (hash-ref fields 'client_id) document-url)
        (define token (hasheq 'access_token (format "token-~a" (hash-ref counts 'exchange))
                              'refresh_token "refresh" 'token_type "Bearer" 'expires_in 10))
        (if (equal? (hash-ref fields 'grant_type) "authorization_code")
            (hash-set token 'scope (string-join desired " ")) token))
      #:save (lambda (iss client res credential)
        (count! 'save)
        (when (unbox save-fails?) (error 'fixture "save failed"))
        (set! saved (cons (list iss client res credential) saved)))))
  (values authorizer counts clock issuer (lambda () saved)))
(define-values (auth counts clock issuer saved) (fixture))
(define first (authorize-resource! auth))
(check-equal? (oauth-credential-scopes first) '("read"))
(check-equal? (map (lambda (key) (hash-ref counts key)) '(browse exchange save)) '(1 1 1))
(check-eq? (authorize-resource! auth) first)
(check-equal? (take (car (saved)) 3) (list (unbox issuer) document-url resource))
(set-box! clock 200)
(define replies (make-channel))
(for ([i (in-range 8)]) (thread (lambda () (channel-put replies (authorize-resource! auth)))))
(define refreshed (for/list ([i (in-range 8)]) (sync/timeout 3 replies)))
(check-true (andmap oauth-credential? refreshed))
(check-true (andmap (lambda (v) (equal? v (car refreshed))) refreshed))
(check-equal? (hash-ref counts 'exchange) 2)
(check-equal? (hash-ref counts 'browse) 1)
(check-equal? (oauth-credential-scopes (car refreshed)) '("read"))
(check-equal? (authorize-resource! auth #:rejected-token (oauth-credential-access-token first)) (car refreshed))
(check-equal? (hash-ref counts 'exchange) 2)
(define elevated
  (authorize-resource! auth #:scopes '("ignored")
    #:challenges (parse-authenticate '("Bearer error=insufficient_scope, scope=write"))))
(check-equal? (oauth-credential-scopes elevated) '("write"))
(check-equal? (hash-ref counts 'browse) 2)
(set-box! issuer "https://new-issuer.example")
(define moved (authorize-resource! auth))
(check-equal? (oauth-credential-issuer moved) (unbox issuer))
(check-equal? (hash-ref counts 'browse) 3)
;; Successful exchanges survive a transient persistence failure in this process.
(define failed-save (box #t))
(define-values (save-auth save-counts _sc _si _ss) (fixture #:save-fails? failed-save))
(check-exn #rx"save failed" (lambda () (authorize-resource! save-auth)))
(set-box! failed-save #f)
(check-true (oauth-credential? (authorize-resource! save-auth)))
(check-equal? (hash-ref save-counts 'exchange) 1)
(check-equal? (hash-ref save-counts 'save) 2)
;; An uncertain exchange cannot silently reuse a potentially consumed code/token.
(define failed-exchange (box #t))
(define-values (uncertain uc _uc _ui _us) (fixture #:exchange-fails? failed-exchange))
(check-exn #rx"uncertain exchange" (lambda () (authorize-resource! uncertain)))
(set-box! failed-exchange #f)
(check-exn #rx"explicit reauthorization" (lambda () (authorize-resource! uncertain)))
(check-equal? (hash-ref uc 'exchange) 1)
(check-true (oauth-credential? (authorize-resource! uncertain #:reauthorize? #t)))
(check-equal? (hash-ref uc 'exchange) 2)
(define-values (foreign fc _fc _fi _fs)
  (fixture #:load (lambda (_i _c _r) (oauth-credential "https://other.example" resource "token" #f 1000 '("read")))))
(check-exn #rx"does not match" (lambda () (authorize-resource! foreign)))
(check-equal? (hash-ref fc 'browse) 0)
(check-exn #rx"multiple Bearer" (lambda () (authorize-resource! auth #:challenges (parse-authenticate '("Bearer realm=a, Bearer realm=b")))))
