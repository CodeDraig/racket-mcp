#lang racket/base
(require "clock.rkt" "private/oauth-uri-policy.rkt" racket/list racket/string racket/random net/base64 net/url net/uri-codec web-server/http "json.rkt" "private/authenticate.rkt" "private/oauth-metadata.rkt")
(provide (all-from-out "private/authenticate.rkt" "private/oauth-metadata.rkt") (struct-out verified-principal) (struct-out oauth-registration) (struct-out oauth-pending)
         (struct-out oauth-credential) protected-resource-metadata bearer-challenge make-bearer-authenticator
         check-scopes! protected-resource-metadata-url scopes-allow? principal-key begin-authorization finish-authorization refresh-credential discover-authorization discover-authorization-for-resource authorization-metadata-urls
         client-id-metadata-document check-client-id-metadata! select-oauth-registration)
(struct verified-principal (subject issuer audience scopes expiry) #:transparent)
(struct oauth-registration (issuer client-id redirect-uri resource scopes) #:transparent)
(struct oauth-pending (registration metadata state verifier) #:transparent)
(struct oauth-credential (issuer resource access-token refresh-token expires scopes) #:transparent)
(define (principal-key principal)
  (if (verified-principal? principal)
      (json->string (hasheq 'issuer (verified-principal-issuer principal) 'subject (verified-principal-subject principal)))
      (format "~a" principal)))
(define (https-uri! value who #:loopback? [loopback? (current-oauth-loopback-http?)])
  (define u (string->url value))
  (unless (oauth-secure-url? u #:loopback? loopback?)
    (error who "expected HTTPS URL without credentials or fragment"))
  value)
(define (check-scopes! scopes)
  (unless (and (list? scopes)
               (for/and ([scope (in-list scopes)])
                 (and (string? scope) (positive? (string-length scope))
                      (for/and ([c (in-string scope)])
                        (define n (char->integer c))
                        (and (<= 33 n 126) (not (memv n '(34 92))))))))
    (raise-argument-error 'authorization "list of OAuth scope tokens" scopes))
  scopes)
(define (protected-resource-metadata-url resource)
  (https-uri! resource 'protected-resource-metadata-url)
  (define u (string->url resource))
  (define path (url-path u))
  (url->string
   (struct-copy url u [query '()] [fragment #f]
     [path (append (list (path/param ".well-known" '()) (path/param "oauth-protected-resource" '()))
                   (if (equal? path (list (path/param "" '()))) '() path))])))
(define (protected-resource-metadata resource issuers #:scopes [scopes '()])
  (https-uri! resource 'protected-resource-metadata)
  (unless (and (list? issuers) (pair? issuers))
    (raise-argument-error 'protected-resource-metadata "nonempty list of issuer URLs" issuers))
  (check-scopes! scopes)
  (hasheq 'resource resource 'authorization_servers (map (lambda (u) (https-uri! u 'protected-resource-metadata)) issuers)
          'scopes_supported scopes 'bearer_methods_supported '("header")))
(define (bearer-challenge metadata-url #:scopes [scopes '()] #:error [kind #f])
  (check-scopes! scopes)
  (unless (member kind '(#f "invalid_request" "invalid_token" "insufficient_scope"))
    (raise-argument-error 'bearer-challenge "Bearer error allocation or #f" kind))
  (https-uri! metadata-url 'bearer-challenge)
  (when (regexp-match? #px"[\"\\\\\r\n]" metadata-url) (error 'bearer-challenge "invalid challenge URI"))
  (string-append "Bearer resource_metadata=\"" metadata-url "\""
                 (if kind (string-append ", error=\"" kind "\"") "")
                 (if (null? scopes) "" (string-append ", scope=\"" (string-join scopes " ") "\""))))
(define (scopes-allow? principal required)
  (and (verified-principal? principal) (for/and ([scope (in-list required)]) (member scope (verified-principal-scopes principal))) #t))
(define (make-bearer-authenticator verify #:issuer issuer #:audience audience #:clock [clock mcp-current-seconds])
  (lambda (headers)
    (define values (for/list ([h (in-list headers)] #:when (bytes-ci-equal? (header-field h) #"authorization")) (bytes->string/utf-8 (header-value h))))
    (and (= (length values) 1)
         (let ([m (regexp-match #px"^(?i:Bearer) ([A-Za-z0-9._~+/-]+=*)$" (car values))])
           (and m (let ([principal (verify (cadr m))])
                    (and (verified-principal? principal) (equal? issuer (verified-principal-issuer principal))
                         (member audience (if (list? (verified-principal-audience principal)) (verified-principal-audience principal) (list (verified-principal-audience principal))))
                         (> (verified-principal-expiry principal) (clock)) principal)))))))
(define (bytes-ci-equal? a b) (string-ci=? (bytes->string/utf-8 a) (bytes->string/utf-8 b)))
(define (base64url bytes) (string-replace (string-replace (string-trim (bytes->string/utf-8 (base64-encode bytes #"")) "=") "+" "-") "/" "_"))
(define (identifier-url! identifier who)
  (https-uri! identifier who)
  (define u (string->url identifier))
  (unless (null? (url-query u)) (error who "identifier must not contain a query"))
  u)
(define (non-root-path u)
  (if (equal? (url-path u) (list (path/param "" '()))) '() (url-path u)))
(define (well-known-url u name #:append? [append? #f])
  (define path (non-root-path u))
  (define prefix (list (path/param ".well-known" '()) (path/param name '())))
  (url->string
   (struct-copy url u [path
     (if append?
         (append (if (and (pair? path) (equal? (last path) (path/param "" '()))) (drop-right path 1) path) prefix)
         (append prefix path))])))
(define (authorization-metadata-urls issuer)
  (define u (identifier-url! issuer 'authorization-metadata-urls))
  (remove-duplicates
   (append (list (well-known-url u "oauth-authorization-server")
                 (well-known-url u "openid-configuration"))
           (if (null? (non-root-path u)) '()
               (list (well-known-url u "openid-configuration" #:append? #t))))))
;; #f is the fetch adapter's explicit unavailable-document outcome. Exceptions,
;; malformed documents, and identity mismatches never become permissive fallback.
(define (fetch-first urls fetch who)
  (or (for/or ([url (in-list urls)]) (fetch url))
      (error who "no metadata document available")))
(define (resource-document! document expected)
  (unless (hash? document) (error 'discover-authorization "resource metadata must be an object"))
  (define resource (hash-ref document 'resource #f))
  (https-uri! resource 'discover-authorization)
  (when (and expected (not (equal? resource expected)))
    (error 'discover-authorization "protected resource identifier mismatch"))
  (define issuers (hash-ref document 'authorization_servers '()))
  (unless (and (list? issuers) (pair? issuers))
    (error 'discover-authorization "resource has no authorization server"))
  (for ([issuer (in-list issuers)]) (identifier-url! issuer 'discover-authorization))
  (check-scopes! (hash-ref document 'scopes_supported '()))
  document)
(define (discover-from-resource document fetch expected select-issuer)
  (resource-document! document expected)
  (define issuers (hash-ref document 'authorization_servers))
  (define issuer (select-issuer issuers))
  (unless (member issuer issuers) (error 'discover-authorization "selected issuer was not advertised"))
  (define urls (authorization-metadata-urls issuer))
  (define metadata
    (or (for/or ([url (in-list urls)] [index (in-naturals)])
          (define value (fetch url))
          (and value (validate-authorization-metadata! value issuer #:oidc? (positive? index))))
        (error 'discover-authorization "no metadata document available")))
  (check-scopes! (hash-ref metadata 'scopes_supported '()))
  (values document metadata))
(define (discover-authorization resource-metadata-url fetch #:resource [expected #f] #:select-issuer [select-issuer car])
  (https-uri! resource-metadata-url 'discover-authorization)
  (when expected (https-uri! expected 'discover-authorization))
  (discover-from-resource (fetch-first (list resource-metadata-url) fetch 'discover-authorization)
                          fetch expected select-issuer))
(define (discover-authorization-for-resource resource fetch #:metadata-url [metadata-url #f]
                                             #:select-issuer [select-issuer car])
  (define u (string->url (https-uri! resource 'discover-authorization-for-resource)))
  (define urls
    (if metadata-url
        (list (https-uri! metadata-url 'discover-authorization-for-resource))
        (remove-duplicates
         (list (protected-resource-metadata-url resource)
               (url->string (struct-copy url u [query '()]
                              [path (list (path/param ".well-known" '())
                                          (path/param "oauth-protected-resource" '()))]))))))
  (discover-from-resource (fetch-first urls fetch 'discover-authorization-for-resource)
                          fetch resource select-issuer))
(define (redirect-uri! uri)
  (unless (string? uri) (raise-argument-error 'authorization "absolute redirect URI" uri))
  (define u (string->url uri))
  (unless (and (url-scheme u) (not (url-fragment u)) (not (url-user u))
               (cond [(equal? (url-scheme u) "https") (url-host u)]
                     [(equal? (url-scheme u) "http") (member (url-host u) '("127.0.0.1" "::1" "localhost"))]
                     [else #t]))
    (error 'authorization "invalid redirect URI; HTTP redirects require loopback"))
  uri)
(define (client-id-url! id)
  (https-uri! id 'client-id-metadata #:loopback? #f)
  (define path (url-path (string->url id)))
  (unless (and (pair? path)
               (for/and ([part (in-list path)])
                 (not (member (path/param-path part) '(same up "." "..")))))
    (error 'client-id-metadata "client ID requires a path without dot segments"))
  id)
(define (check-client-id-metadata! document url)
  (client-id-url! url)
  (unless (and (hash? document) (equal? (hash-ref document 'client_id #f) url))
    (error 'client-id-metadata "document client_id must exactly match its URL"))
  (define name (hash-ref document 'client_name #f))
  (unless (and (string? name) (positive? (string-length name)))
    (error 'client-id-metadata "client_name is required"))
  (define redirects (hash-ref document 'redirect_uris #f))
  (unless (and (list? redirects) (pair? redirects))
    (error 'client-id-metadata "nonempty redirect_uris is required"))
  (for ([uri (in-list redirects)]) (redirect-uri! uri))
  (for ([key '(client_secret client_secret_expires_at)])
    (when (hash-has-key? document key) (error 'client-id-metadata "shared-secret fields are forbidden")))
  (unless (equal? (hash-ref document 'token_endpoint_auth_method "none") "none")
    (error 'client-id-metadata "this client supports metadata documents with token_endpoint_auth_method none"))
  (for ([entry '((grant_types "authorization_code") (response_types "code"))])
    (define supported (hash-ref document (car entry) (cdr entry)))
    (unless (and (list? supported) (andmap string? supported) (member (cadr entry) supported))
      (error 'client-id-metadata "document must support authorization code flow")))
  (unless (json-value? document) (error 'client-id-metadata "document must contain JSON values"))
  document)
(define (client-id-metadata-document url name redirects #:extra [extra (hasheq)])
  (unless (hash? extra) (raise-argument-error 'client-id-metadata-document "hash?" extra))
  (for ([key '(client_id client_name redirect_uris)])
    (when (hash-has-key? extra key) (error 'client-id-metadata-document "duplicate core metadata field")))
  (define document
    (for/fold ([result (hasheq 'client_id url 'client_name name 'redirect_uris redirects
                               'grant_types '("authorization_code") 'response_types '("code")
                               'token_endpoint_auth_method "none")]) ([(key value) (in-hash extra)])
      (hash-set result key value)))
  (check-client-id-metadata! document url))
(define (select-oauth-registration metadata resource redirect scopes
                                   #:pre-registered [registrations (hash)]
                                   #:client-metadata [document #f] #:client-metadata-url [document-url #f]
                                   #:request-registration [request-registration #f])
  (define issuer (hash-ref metadata 'issuer))
  (identifier-url! issuer 'select-oauth-registration)
  (https-uri! resource 'select-oauth-registration)
  (redirect-uri! redirect)
  (check-scopes! scopes)
  (define (check-registration value)
    (unless (and (oauth-registration? value) (equal? (oauth-registration-issuer value) issuer)
                 (equal? (oauth-registration-redirect-uri value) redirect)
                 (string? (oauth-registration-client-id value))
                 (positive? (string-length (oauth-registration-client-id value))))
      (error 'select-oauth-registration "pre-registration issuer, client ID, or redirect mismatch"))
    ;; Resource and scopes describe this authorization request, not the static
    ;; client registration. Never copy credentials from a different issuer.
    (struct-copy oauth-registration value [resource resource] [scopes scopes]))
  (define registered (hash-ref registrations issuer #f))
  (cond [registered (check-registration registered)]
        [(and document (eq? (hash-ref metadata 'client_id_metadata_document_supported #f) #t))
         (unless document-url (error 'select-oauth-registration "client metadata URL is required"))
         (check-client-id-metadata! document document-url)
         (unless (member redirect (hash-ref document 'redirect_uris))
           (error 'select-oauth-registration "redirect is absent from client metadata"))
         (oauth-registration issuer document-url redirect resource scopes)]
        [request-registration (check-registration (request-registration issuer redirect))]
        [else (error 'select-oauth-registration "no client registration for this issuer; configure pre-registration or supported client metadata")]))
(define (begin-authorization registration metadata)
  (identifier-url! (oauth-registration-issuer registration) 'begin-authorization)
  (https-uri! (oauth-registration-resource registration) 'begin-authorization)
  (redirect-uri! (oauth-registration-redirect-uri registration))
  (check-scopes! (oauth-registration-scopes registration))
  (unless (and (string? (oauth-registration-client-id registration))
               (positive? (string-length (oauth-registration-client-id registration))))
    (error 'begin-authorization "nonempty client ID is required"))
  (unless (equal? (oauth-registration-issuer registration) (hash-ref metadata 'issuer #f)) (error 'begin-authorization "issuer mismatch"))
  (https-uri! (hash-ref metadata 'token_endpoint #f) 'begin-authorization)
  (unless (member "S256" (hash-ref metadata 'code_challenge_methods_supported '())) (error 'begin-authorization "authorization server does not advertise PKCE S256"))
  (define verifier (base64url (crypto-random-bytes 32)))
  (define state (base64url (crypto-random-bytes 32)))
  (define challenge (base64url (sha256-bytes (string->bytes/utf-8 verifier))))
  (define endpoint (string->url (https-uri! (hash-ref metadata 'authorization_endpoint) 'begin-authorization)))
  (define query (list (cons 'response_type "code") (cons 'client_id (oauth-registration-client-id registration))
                      (cons 'redirect_uri (oauth-registration-redirect-uri registration)) (cons 'resource (oauth-registration-resource registration))
                      (cons 'state state)
                      (cons 'code_challenge challenge) (cons 'code_challenge_method "S256")))
  (values (url->string (struct-copy url endpoint [query (append (url-query endpoint) query
                                              (if (null? (oauth-registration-scopes registration)) '()
                                                  (list (cons 'scope (string-join (oauth-registration-scopes registration) " ")))))]))
          (oauth-pending registration metadata state verifier)))
(define (token->credential registration token clock [old-refresh #f] [old-scopes #f])
  (unless (and (hash? token) (not (hash-has-key? token 'error))
               (string? (hash-ref token 'token_type #f))
               (equal? (string-downcase (hash-ref token 'token_type)) "bearer")
               (string? (hash-ref token 'access_token #f))
               (regexp-match? #px"^[A-Za-z0-9._~+/-]+=*$" (hash-ref token 'access_token))
               (exact-nonnegative-integer? (hash-ref token 'expires_in 0)))
    (error 'oauth "invalid token response"))
  (define refresh (hash-ref token 'refresh_token old-refresh))
  (unless (or (not refresh) (and (string? refresh) (regexp-match? #px"^[ -~]+$" refresh)))
    (error 'oauth "invalid refresh token"))
  (define scopes
    (if (hash-has-key? token 'scope)
        (let ([scope (hash-ref token 'scope)])
          (unless (string? scope) (error 'oauth "invalid token scope"))
          (check-scopes! (string-split scope " ")))
        (or old-scopes (oauth-registration-scopes registration))))
  (oauth-credential (oauth-registration-issuer registration) (oauth-registration-resource registration)
                    (hash-ref token 'access_token) refresh
                    (+ (clock) (hash-ref token 'expires_in 0)) scopes))
(define (finish-authorization pending response exchange #:clock [clock mcp-current-seconds])
  (unless (equal? (hash-ref response 'state #f) (oauth-pending-state pending)) (error 'finish-authorization "OAuth state mismatch"))
  (define registration (oauth-pending-registration pending))
  (unless (equal? (hash-ref response 'iss #f) (oauth-registration-issuer registration)) (error 'finish-authorization "OAuth response issuer mismatch"))
  (when (hash-has-key? response 'error) (error 'finish-authorization "authorization declined: ~a" (hash-ref response 'error)))
  (unless (and (string? (hash-ref response 'code #f)) (positive? (string-length (hash-ref response 'code))))
    (error 'finish-authorization "nonempty authorization code is required"))
  (define token (exchange (https-uri! (hash-ref (oauth-pending-metadata pending) 'token_endpoint) 'finish-authorization)
                          (hasheq 'grant_type "authorization_code" 'code (hash-ref response 'code)
                                  'client_id (oauth-registration-client-id registration) 'redirect_uri (oauth-registration-redirect-uri registration)
                                  'resource (oauth-registration-resource registration) 'code_verifier (oauth-pending-verifier pending))))
  (token->credential registration token clock))
(define (refresh-credential registration credential metadata exchange #:clock [clock mcp-current-seconds])
  (unless (and (equal? (oauth-registration-issuer registration) (oauth-credential-issuer credential))
               (equal? (oauth-registration-resource registration) (oauth-credential-resource credential))
               (equal? (hash-ref metadata 'issuer #f) (oauth-credential-issuer credential))) (error 'refresh-credential "credential issuer/resource mismatch"))
  (unless (oauth-credential-refresh-token credential) (error 'refresh-credential "no refresh token"))
  (token->credential registration
                     (exchange (https-uri! (hash-ref metadata 'token_endpoint) 'refresh-credential)
                               (hasheq 'grant_type "refresh_token" 'client_id (oauth-registration-client-id registration)
                                       'refresh_token (oauth-credential-refresh-token credential) 'resource (oauth-registration-resource registration)))
                     clock (oauth-credential-refresh-token credential) (oauth-credential-scopes credential)))
