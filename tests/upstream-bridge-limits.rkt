#lang racket/base
(require rackunit mcp mcp/upstream)
(define snapshot (hasheq 'pin "1"))
(define bridge (make-upstream-bridge #:identity "peer" #:version "1" #:credential-id (lambda (_) "account") #:max-bytes 1024))
(define (exercise value predicate [inspect void])
  (define store (open-memory-store))
  (define calls 0)
  (define (peer _m _p) (set! calls (add1 calls)) value)
  (define (invoke)
    (bridge-upstream-request bridge store snapshot peer "tools/call" (hasheq 'name "work")
                             #:principal "owner" #:credential-id "account" #:key "one"))
  (dynamic-wind void
    (lambda ()
      (check-exn predicate invoke)
      (check-exn predicate invoke)
      (check-equal? calls 1)
      (inspect (stored-instance-state (car (list-instances store)))))
    (lambda () (close-store! store))))
(exercise (hasheq 'resultType "input_required" 'inputRequests
            (hasheq 'input (hasheq 'method "elicitation/create" 'params (hasheq 'mode "form" 'message 42))))
          #rx"valid elicitation")
(exercise (text-result (make-string 2048 #\x)) exn:fail:upstream-recovery?)
(exercise (hasheq 'resultType "task" 'taskId "remote-task-handle" 'status "working")
          (lambda (e) (and (exn:fail:mcp? e) (regexp-match? #rx"unsupported translation" (exn-message e))
                           (not (regexp-match? #rx"remote-task-handle" (exn-message e)))))
          (lambda (state)
            (check-equal? (hash-ref (hash-ref (hash-ref state 'outcome) 'result) 'taskId) "remote-task-handle")))
(define store (open-memory-store))
(define clock (make-manual-clock #:seconds 100))
(define calls 0)
(define failure (hasheq 'error (hasheq 'code -32005 'message "upstream refused")))
(define (peer _m _p) (set! calls (add1 calls)) failure)
(define (invoke)
  (parameterize ([current-mcp-clock clock])
    (bridge-upstream-request bridge store snapshot peer "tools/call" (hasheq 'name "work")
                             #:principal "owner" #:credential-id "account" #:key "one")))
(dynamic-wind void
  (lambda ()
    (check-equal? (invoke) failure)
    (check-equal? (invoke) failure)
    (check-equal? calls 1)
    (manual-clock-advance! clock 86400)
    (check-exn #rx"expired" invoke)
    (check-equal? calls 1))
  (lambda () (close-store! store)))
