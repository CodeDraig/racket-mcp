#lang racket/base
(require racket/string racket/port racket/async-channel
         mcp mcp/authorization mcp/oauth mcp/http mcp/private/http-wire "private/review-support.rkt")
(start-evidence! "g7")
(test-case "CD06/CD07 dummy credentials are absent from full-object diagnostics"
  (define registration (oauth-registration "https://issuer.invalid" "client" "http://127.0.0.1/cb" "https://resource.invalid/mcp" '()))
  (define credential (oauth-credential "https://issuer.invalid" "https://resource.invalid/mcp" "DUMMY-ACCESS" "DUMMY-REFRESH" 100 '()))
  (define pending (oauth-pending registration (hasheq) "DUMMY-STATE" "DUMMY-VERIFIER"))
  (define client (make-http-client "https://resource.invalid/mcp" #:token "DUMMY-HTTP-TOKEN"))
  (define failure (exn:fail:http:authorization "Authorization required" (current-continuation-marks)
    401 '() #"" '() "https://resource.invalid/mcp" "DUMMY-REQUEST-TOKEN"))
  ;; Printing redaction does not change transparent reflection or field access.
  (check-true (struct? credential))
  (check-equal? (oauth-credential-access-token credential) "DUMMY-ACCESS")
  (check-equal? (vector-ref (struct->vector credential) 3) "DUMMY-ACCESS")
  (check-equal? credential (oauth-credential "https://issuer.invalid" "https://resource.invalid/mcp" "DUMMY-ACCESS" "DUMMY-REFRESH" 100 '()))
  (define results
    (hasheq 'oauthAccessVisible (string-contains? (format "~s" credential) "DUMMY-ACCESS")
            'oauthRefreshVisible (string-contains? (format "~v" credential) "DUMMY-REFRESH")
            'pkceVerifierVisible (string-contains? (format "~s" pending) "DUMMY-VERIFIER")
            'httpTokenVisible (string-contains? (format "~v" client) "DUMMY-HTTP-TOKEN")
            'exceptionTokenVisible (string-contains? (format "~s" failure) "DUMMY-REQUEST-TOKEN")
            'messageTokenVisible (string-contains? (exn-message failure) "DUMMY-REQUEST-TOKEN")
            'rejectedTokenAccessorWorks (equal? (exn:fail:http:authorization-request-token failure) "DUMMY-REQUEST-TOKEN")))
  (record! "credential-printing" results)
  (for ([key '(oauthAccessVisible oauthRefreshVisible pkceVerifierVisible httpTokenVisible exceptionTokenVisible)])
    (check-false (hash-ref results key) (symbol->string key)))
  (check-false (hash-ref results 'messageTokenVisible))
  (check-true (hash-ref results 'rejectedTokenAccessorWorks)))
(test-case "CD21 internal HTTP failures have internal error classification with retained redacted diagnostics"
  (define failing? #t)
  (define rt (make-runtime (make-interface #:tools (list (make-tool "ok" '() (lambda (_) (text-result "ok")))))))
  (define logs (open-output-string))
  (define confirmation (make-async-channel))
  (define stop
    (parameterize ([current-error-port logs])
      (serve-http rt #:port 0 #:confirmation confirmation #:sse? #f
        #:authenticate (lambda (_) (if failing? (error 'dummy-auth "DUMMY-AUTH-FAILURE") "alice")))))
  (define port (require-event confirmation))
  (when (exn? port) (raise port))
  (define params (hasheq 'name "ok" '_meta (request-meta)))
  (define headers (map (lambda (kv) (string-append (car kv) ": " (cdr kv))) (request-headers "tools/call" params)))
  (define (send body)
    (define-values (status hs input)
      (bounded-http-sendrecv "127.0.0.1" "/" #:port port #:method "POST" #:headers headers #:data body))
    (define payload (dynamic-wind void (lambda () (port->bytes input)) (lambda () (close-input-port input))))
    (hasheq 'status (bytes->string/utf-8 status) 'body (string->json (bytes->string/utf-8 payload))))
  (dynamic-wind void
    (lambda ()
      (define internal (send (json->string (hasheq 'jsonrpc "2.0" 'id 1 'method "tools/call" 'params params))))
      (set! failing? #f)
      (define malformed (send "{"))
      (define logged? (regexp-match? #rx"phase=authentication category=failure" (get-output-string logs)))
      (check-false (string-contains? (get-output-string logs) "DUMMY-AUTH-FAILURE"))
      (check-regexp-match #rx"500" (hash-ref internal 'status))
      (check-regexp-match #rx"400" (hash-ref malformed 'status))
      (record! "http-error-mapping" (hasheq 'internal internal 'malformed malformed 'internalCauseLogged logged?))
      (check-equal? (hash-ref (hash-ref (hash-ref internal 'body) 'error) 'code) -32603)
      (check-equal? (hash-ref (hash-ref (hash-ref malformed 'body) 'error) 'code) -32700)
      (check-true logged?))
    (lambda () (stop) (custodian-shutdown-all (runtime-custodian rt)))))
(finish!)
