#lang racket/base
(require rackunit racket/list racket/runtime-path mcp/json mcp/uri-template)
(define-runtime-path fixtures "../vendor/uri-template-tests")
(for ([file (in-list '("spec-examples.json" "spec-examples-by-section.json" "extended-tests.json" "negative-tests.json"))])
  (define groups (call-with-input-file (build-path fixtures file) read-json))
  (for ([(group spec) (in-hash groups)])
    (define env (hash-ref spec 'variables))
    (for ([test (in-list (hash-ref spec 'testcases))])
      (define template (car test))
      (define expected (cadr test))
      (define label (format "~a ~a ~s" file group template))
      (with-check-info (['fixture label])
       (if (eq? expected #f)
          (check-exn exn:fail? (lambda () (uri-template-expand template env)) label)
          (check-not-false (member (uri-template-expand template env) (if (list? expected) expected (list expected))) label))))))
