#lang racket/base
(require rackunit racket/list racket/runtime-path racket/file mcp mcp/tasks mcp/stdio mcp/subscription)
(workflow (notify-job) #:version "1" #:execution task
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
  (text-result "done"))
(define-runtime-path task-schema-path "../vendor/tasks/schema/2026-07-28/schema.json")
(define task-schema (hash-set (string->json (file->string task-schema-path)) '$ref "#/$defs/TaskStatusNotification"))
(define store (open-memory-store))
(define rt (make-runtime (make-interface #:tools (list notify-job)) #:store store))
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define (local method params [principal 'local])
  (dispatch rt method (hash-set params '_meta (request-meta #:capabilities caps)) #:principal principal))
(define created (local "tools/call" (hasheq 'name "notify-job")))
(define id (hash-ref created 'taskId))
(let loop ([left 200])
  (unless (equal? (hash-ref (get-task store id "local") 'status) "input_required")
    (when (zero? left) (error 'test "task did not await input"))
    (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 left))))
(check-exn exn:fail? (lambda () (local "subscriptions/listen" (hasheq 'notifications (hasheq 'taskIds (list id))) "foreign")))
(check-exn exn:fail? (lambda () (local "subscriptions/listen" (hasheq 'notifications (hasheq 'taskIds #t)))))
(define-values (server-in client-out) (make-pipe))
(define-values (client-in server-out) (make-pipe))
(define server (thread (lambda () (serve-stdio rt #:input server-in #:output server-out))))
(define client (make-stdio-client client-in client-out))
(define listen
  (client-request client "subscriptions/listen" (hasheq 'notifications (hasheq 'taskIds (list id id))) #:capabilities caps))
(define (next)
  (define notification (sync/timeout 5 (request-handle-notifications listen)))
  (unless notification (error 'test "missing notification")) notification)
(define ack (next))
(check-equal? (hash-ref ack 'method) "notifications/subscriptions/acknowledged")
(check-equal? (hash-ref (hash-ref ack 'params) 'notifications) (hasheq 'taskIds (list id)))
;; An opted-in ID still cannot receive another principal's publication.
(publish-change! (runtime-subscriptions rt) "notifications/tasks" (hasheq 'taskId id 'status "failed") #:principal "foreign" #:principal-key (lambda (p) (format "~a" p)))
(check-false (sync/timeout 0 (request-handle-notifications listen)))
(void (client-call client "tasks/update" (hasheq 'taskId id 'inputResponses (hasheq 'answer (hasheq 'action "decline"))) #:capabilities caps))
(define working (next))
(define completed (next))
(for ([event (in-list (list working completed))] [status '("working" "completed")])
  (check-equal? (validate task-schema event) '())
  (check-equal? (hash-ref event 'method) "notifications/tasks")
  (define detail (hash-ref event 'params))
  (check-equal? (hash-ref detail 'taskId) id)
  (check-equal? (hash-ref detail 'status) status)
  (check-equal? (hash-ref (hash-ref detail '_meta) 'io.modelcontextprotocol/subscriptionId)
                (hash-ref (hash-ref (hash-ref ack 'params) '_meta) 'io.modelcontextprotocol/subscriptionId)))
(check-equal? (hash-ref (hash-ref (hash-ref completed 'params) 'result) 'content) (list (text-content "done")))
(void (client-call client "tasks/cancel" (hasheq 'taskId id) #:capabilities caps))
(check-false (sync/timeout 0 (request-handle-notifications listen)))
(request-cancel! listen)
(check-not-false (sync/timeout 5 listen))
(close-output-port client-out) (thread-wait server) (close-output-port server-out) (client-close! client)
(custodian-shutdown-all (runtime-custodian rt))
(close-store! store)
