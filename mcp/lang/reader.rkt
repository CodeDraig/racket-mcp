(module reader '#%kernel
  (#%require "../private/kernel-observation.rkt")
  (#%provide read read-syntax get-info get-interaction-info)
  (define-values (home)
    (variable-reference->module-path-index (#%variable-reference)))
  (define-values (resolve)
    (lambda (path) (module-path-index-resolve (module-path-index-join path home))))
  ;; Start before the ordinary observer or reader dependencies are loaded.
  (define-values (transfer!) (install-kernel-observation!))
  (define-values (install!)
    (dynamic-require (resolve "../private/module-observation.rkt") 'install-module-observation!))
  (install! '() transfer!)
  (define-values (reader) (resolve "../private/language-reader.rkt"))
  (define-values (read-procedure) (dynamic-require reader 'read))
  (define-values (read-syntax-procedure) (dynamic-require reader 'read-syntax))
  (define-values (get-info-procedure) (dynamic-require reader 'get-info))
  (define-values (read)
    (lambda (in modpath line col pos) (install!) (read-procedure in modpath line col pos)))
  (define-values (read-syntax)
    (lambda (src in modpath line col pos) (install!) (read-syntax-procedure src in modpath line col pos)))
  (define-values (get-info)
    (lambda (in modpath line col pos) (install!) (get-info-procedure in modpath line col pos)))
  (define-values (interaction-procedure) (dynamic-require reader 'get-interaction-info))
  (define-values (get-interaction-info)
    (lambda (data) (install!) (interaction-procedure data))))
