#lang racket/base
(require rackunit mcp mcp/authorization mcp/completion)
(define calls 0)
(resource (secret [id String]) #:uri "secret:///{id}" #:ttl-ms 60000
  (set! calls (add1 calls)) "Private")
(prompt (read-secret [id String]) (role "user" (embed (secret id))))
(tool (read-link [id String]) (hasheq 'resultType "complete" 'content (list (embed (secret id)))))
(define base (make-interface #:resources (list secret) #:prompts (list read-secret) #:tools (list read-link)
  #:completions (list (completion-descriptor read-secret 'id (lambda (_v _ctx) '("one"))))))
(define scoped (view base #:namespace "a/" #:uris (hash "secret:///{id}" "private:///{id}") #:require-scopes '("read")))
(define nested (mount-interfaces (view scoped #:namespace "b/" #:require-scopes '("audit" "read"))))
(define rt (make-runtime nested #:required-scopes (lambda (_m _p) '("base"))))
(define (principal scopes) (verified-principal "alice" "https://issuer.example" "https://api.example" scopes (+ (current-seconds) 60)))
(define all (principal '("read" "audit" "base")))
(define limited (principal '("audit" "base")))
(define (call runtime method params [who all])
  (dispatch runtime method (hash-set params '_meta (request-meta #:capabilities (hasheq 'elicitation (hasheq)
    'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))) #:principal who))
(check-equal? ((runtime-required-scopes rt) "resources/read" (hasheq 'uri "private:///one")) '("base" "read" "audit"))
(for ([entry (list (cons "resources/read" (hasheq 'uri "private:///one"))
                   (cons "tools/call" (hasheq 'name "b/a/read-link" 'arguments (hasheq 'id "one")))
                   (cons "prompts/get" (hasheq 'name "b/a/read-secret" 'arguments (hasheq 'id "one")))
                   (cons "completion/complete" (hasheq 'ref (hasheq 'type "ref/prompt" 'name "b/a/read-secret")
                     'argument (hasheq 'name "id" 'value "o"))))])
  (check-exn exn:fail:mcp? (lambda () (call rt (car entry) (cdr entry) limited))))
(check-equal? calls 0)
(check-equal? (hash-ref (car (hash-ref (call rt "resources/read" (hasheq 'uri "private:///one")) 'contents)) 'text) "Private")
;; Cached content cannot bypass the scope check on a later request.
(check-exn exn:fail:mcp? (lambda () (call rt "resources/read" (hasheq 'uri "private:///one") limited)))
(check-equal? calls 1)
(check-equal? (hash-ref (hash-ref (call rt "completion/complete"
  (hasheq 'ref (hasheq 'type "ref/prompt" 'name "b/a/read-secret") 'argument (hasheq 'name "id" 'value "o"))) 'completion) 'values) '("one"))
;; A forged reference discriminator must not bypass the target's scope lookup.
(check-exn exn:fail:mcp? (lambda () (call rt "completion/complete"
  (hasheq 'ref (hasheq 'type "ref/resource" 'name "b/a/read-secret") 'argument (hasheq 'name "id" 'value "o")) limited)))

;; Restrict only the resource using the data API. An unrestricted embedding
;; operation still has to authorize the child through the same interface.
(define child-rt (make-runtime (make-interface #:resources (list secret) #:tools (list read-link)
  #:requirements (hasheq secret '("read")))))
(check-exn exn:fail:mcp? (lambda () (call child-rt "tools/call" (hasheq 'name "read-link" 'arguments (hasheq 'id "one")) limited)))
(check-equal? calls 1)
(check-exn #rx"absent declaration" (lambda () (make-interface #:requirements (hasheq secret '("read")))))
(check-exn exn:fail? (lambda () (view base #:require-scopes '("bad scope"))))
(define policy (make-hasheq (list (cons secret '("read")))))
(define copied (make-interface #:resources (list secret) #:requirements policy))
(hash-set! policy secret '())
(check-equal? (hash-ref (interface-requirements copied) secret) '("read"))
(check-equal? (hash-count (interface-requirements (view copied #:exclude '("secret")))) 0)

(workflow (approve) #:version "1"
  (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq 'ok Boolean))))
  (text-result "done"))
(define store (open-memory-store))
(define workflow-rt (make-runtime (view (make-interface #:tools (list approve)) #:require-scopes '("read")) #:store store))
(define pending (call workflow-rt "tools/call" (hasheq 'name "approve")))
(define resume (hasheq 'name "approve" 'requestState (hash-ref pending 'requestState)
  'inputResponses (hasheq 'answer (hasheq 'action "decline"))))
(check-exn exn:fail:mcp? (lambda () (call workflow-rt "tools/call" resume limited)))
(check-equal? (hash-ref (call workflow-rt "tools/call" resume) 'content) (list (text-content "done")))

(workflow (later) #:version "1" #:execution task (text-result "done"))
(define task-rt (make-runtime (view (make-interface #:tools (list later)) #:namespace "task/" #:require-scopes '("read")) #:store store))
(define task (call task-rt "tools/call" (hasheq 'name "task/later")))
(define task-params (hasheq 'taskId (hash-ref task 'taskId)))
(for ([method '("tasks/get" "tasks/update" "tasks/cancel")])
  (check-exn exn:fail:mcp? (lambda () (call task-rt method task-params limited))))
(check-true (hash? (call task-rt "tasks/get" task-params)))
(define removed-rt (make-runtime (make-interface) #:store store #:recover-tasks? #f))
(check-exn #rx"absent from this interface" (lambda () (call removed-rt "tasks/get" task-params)))

(module fragment mcp/lang
  (define part (make-interface #:tools (list (make-tool "hello" '() (lambda (_) (text-result "hi"))))))
  (mount (view part #:require-scopes '("read"))))
(require (prefix-in fragment: (submod "." fragment)))
(define fragment-rt (make-runtime fragment:mcp-interface))
(check-exn exn:fail:mcp? (lambda () (call fragment-rt "tools/call" (hasheq 'name "hello") limited)))
(check-equal? (hash-ref (call fragment-rt "tools/call" (hasheq 'name "hello")) 'content) (list (text-content "hi")))
(for ([runtime (list rt child-rt workflow-rt task-rt removed-rt fragment-rt)])
  (custodian-shutdown-all (runtime-custodian runtime)))
(close-store! store)
