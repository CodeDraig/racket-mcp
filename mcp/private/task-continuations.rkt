#lang racket/base
(require "request-meta.rkt" "runtime-state.rkt" "runtime-policy.rkt" "../descriptor.rkt" "../storage.rkt"
         "../workflow.rkt" (submod "../workflow.rkt" private) (submod "../build.rkt" private)
         "../rendering.rkt" "../presentation.rkt" "../authorization.rkt" "../clock.rkt" "../error.rkt")
(provide check-managed-task!)
;; Read-only preflight: do not accept input or allocate a replacement until the
;; retained parent and every reachable rendering/child executable still match.
(define (check-managed-task! rt instance tool principal caps)
  (define store (runtime-store rt))
  (define owner (principal-key principal))
  (define state (stored-instance-state instance))
  (define adapters (operation-adapters rt tool))
  (define program (tool-descriptor-workflow tool))
  (define (check-row row operation version fingerprint)
    (unless (and row (equal? owner (stored-instance-principal row))
                 (> (stored-instance-expires row) (mcp-current-seconds))
                 (equal? operation (stored-instance-operation row))
                 (equal? version (stored-instance-version row))
                 (equal? fingerprint (stored-instance-fingerprint row)))
      (raise (exn:fail:recovery (format "Task workflow build is incompatible (handle ~a, executable/rendering identity)" (and row (stored-instance-handle row))) (current-continuation-marks) (and row (stored-instance-handle row)) #f))))
  (define fingerprint (workflow-executable-fingerprint program adapters))
  (define flow (load-instance store (hash-ref state 'workflow)))
  (check-row flow (workflow-descriptor-name program) (workflow-descriptor-version program) fingerprint)
  (check-row instance (string-append "task:" (workflow-descriptor-name program)) (workflow-descriptor-version program) fingerprint)
  (unless (equal? (stored-instance-arguments instance) (stored-instance-arguments flow))
    (mcp-error -32603 "Retained task arguments do not match its workflow"))
  (define visited (make-hash))
  (define (visit render method fp inherited depth)
    (when (>= depth 32) (mcp-error -32603 "Retained rendering depth limit"))
    (check-row render (string-append "render:" method) "render/3" (bind-build-identity fp))
    (unless (hash-ref visited (stored-instance-handle render) #f)
      (hash-set! visited (stored-instance-handle render) #t)
      (for ([child (in-list (hash-ref (stored-instance-state render) 'children))])
        (define uri (hash-ref child 'uri))
        (define params (hasheq 'uri uri '_meta (request-meta #:capabilities caps)))
        (unless ((runtime-authorize rt) principal "resources/read" params)
          (mcp-error -32001 "Retained embedded resource is not authorized"))
        (define matches (operation-targets (runtime-interface rt) store "resources/read" params))
        (unless (= (length matches) 1) (mcp-error -32603 "Retained resource binding is absent or ambiguous"))
        (define resource (car matches))
        (define effective (parameterize ([current-workflow-adapters inherited]) (operation-adapters rt resource)))
        (define renderer (renderer-fingerprint (resource-descriptor-renderer resource)))
        (define child-program (and (resource-descriptor-workflow resource)
          (workflow-add-fingerprint-suffix (resource-descriptor-workflow resource) (string-append ":renderer:" renderer))))
        (define child-fp (if child-program (workflow-executable-fingerprint child-program effective)
                             (string-append "render/1:renderer:" renderer)))
        (define key (format "~a/~a" (stored-instance-handle render) (hash-ref child '$mcp/embedding)))
        (when child-program
          (define operation (string-append "resources/read:" (workflow-descriptor-name child-program)))
          (define saved (find-instance-by-key store owner operation key))
          (when saved (check-row saved operation (workflow-descriptor-version child-program) child-fp)))
        (define child-token (hash-ref child 'state #f))
        (define nested (if (render-continuation? store child-token) (load-instance store child-token)
                           (find-instance-by-key store owner "render:resources/read" key)))
        (when nested (visit nested "resources/read" child-fp effective (add1 depth))))))
  (define token (hash-ref state 'continuation #f))
  (define root (if (render-continuation? store token) (load-instance store token)
                   (find-instance-by-key store owner "render:tools/call"
                     (string-append "workflow-render:" (stored-instance-handle flow)))))
  (when root (visit root "tools/call" fingerprint adapters 0)))
