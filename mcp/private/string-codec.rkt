#lang racket/base
(require "../schema.rkt" "../json.rkt" "codec-fields.rkt")
(provide (struct-out string-codec) make-string-codec encode-string-value decode-string-value check-string-codec!)
;; Prompt wire codecs map strings to JSON-representable domain values. Their
;; version participates in durable prompt compatibility, just like stage codecs.
(struct string-codec (name version schema encoder decoder) #:transparent)
(define (make-string-codec name version schema encoder decoder)
  (check-codec-fields! 'make-string-codec name version schema encoder decoder)
  (string-codec name version schema encoder decoder))
(define (check-string-codec! codec [who 'codec])
  (unless (string-codec? codec) (raise-argument-error who "string-codec?" codec))
  (check-codec-fields! who (string-codec-name codec) (string-codec-version codec)
                       (string-codec-schema codec) (string-codec-encoder codec) (string-codec-decoder codec)))
(define (encode-string-value codec value)
  (check-string-codec! codec 'encode-string-value)
  (unless (and (json-value? value) (valid? (string-codec-schema codec) value))
    (error 'encode-string-value "value failed string codec domain schema"))
  (define wire ((string-codec-encoder codec) value))
  (unless (string? wire) (error 'encode-string-value "encoder must produce a string"))
  wire)
(define (decode-string-value codec wire)
  (check-string-codec! codec 'decode-string-value)
  (unless (string? wire) (raise-argument-error 'decode-string-value "string?" wire))
  (define value ((string-codec-decoder codec) wire))
  (unless (and (json-value? value) (valid? (string-codec-schema codec) value))
    (error 'decode-string-value "decoded value failed string codec domain schema"))
  value)
