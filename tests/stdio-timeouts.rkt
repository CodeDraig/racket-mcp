#lang racket/base
(require rackunit racket/port mcp/stdio mcp/json)
(define (fixture #:outbound-limit [limit 64] #:timeout [timeout 30])
  (define-values (in peer-out) (make-pipe))
  (define-values (peer-in out) (make-pipe 1))
  (values (make-stdio-client in out #:outbound-limit limit #:timeout timeout) peer-in peer-out))
(define (read-wire in)
  (check-not-false (sync/timeout 2 in))
  (string->json (read-json-line in)))
(define (send out m) (write-json m out) (newline out) (flush-output out))
(define (reply h) (hasheq 'jsonrpc "2.0" 'id (request-handle-id h) 'result (hasheq 'resultType "complete")))

;; The handle is returned while even the first message is blocked in output.
(define-values (c peer-in peer-out) (fixture))
(define h (client-request c "tools/list" #:timeout 0.1))
(check-true (request-handle? h))
(check-not-false (sync/timeout 2 peer-in))
(define expired (sync/timeout 2 h))
(check-true (exn:fail:request-timeout? expired))
(check-equal? (exn:fail:request-timeout-seconds expired) 0.1)
(check-equal? (hash-ref (read-wire peer-in) 'id) (request-handle-id h))
(check-equal? (read-wire peer-in) (hasheq 'jsonrpc "2.0" 'method "notifications/cancelled" 'params (hasheq 'requestId (request-handle-id h))))
(send peer-out (reply h))
(request-cancel! h)
(check-eq? (sync h) expired)
(client-close! c) (close-input-port peer-in) (close-output-port peer-out)

;; A timeout before writing discards the operation, without sending it later or
;; cancelling an ID that was never issued. Its token is immediately reusable.
(define-values (queued qi qo) (fixture))
(define first (client-request queued "tools/list" #:timeout #f))
(check-not-false (sync/timeout 2 qi))
(define token (hasheq '_meta (hasheq 'progressToken "queued")))
(define abandoned (client-request queued "tools/call" token #:timeout 0.05))
(check-true (exn:fail:request-timeout? (sync/timeout 2 abandoned)))
(define replacement (client-request queued "tools/list" token #:timeout #f))
(check-equal? (hash-ref (read-wire qi) 'id) (request-handle-id first))
(check-equal? (hash-ref (read-wire qi) 'id) (request-handle-id replacement))
(send qo (reply first)) (send qo (reply replacement))
(check-equal? (sync/timeout 2 first) (reply first))
(check-equal? (sync/timeout 2 replacement) (reply replacement))
(check-false (sync/timeout 0 qi))
(client-close! queued) (close-input-port qi) (close-output-port qo)

(define-values (bounded bi bo) (fixture #:outbound-limit 1))
(define blocked (client-request bounded "tools/list" #:timeout #f))
(check-not-false (sync/timeout 2 bi))
(define waiting (client-request bounded "tools/list" #:timeout #f))
(check-exn #rx"Outbound queue limit" (lambda () (client-request bounded "tools/list")))
(check-false (sync/timeout 0 blocked))
(check-false (sync/timeout 0 waiting))
(client-close! bounded) (close-input-port bi) (close-output-port bo)

(define-values (subscription si so) (fixture #:timeout 0.02))
(define listener (client-request subscription "subscriptions/listen"))
(void (read-wire si))
(check-false (sync/timeout 0.06 listener))
(request-cancel! listener)
(check-true (exn:fail:request-cancelled? (sync/timeout 0 listener)))
(void (read-wire si))
(define limited (client-request subscription "subscriptions/listen" #:timeout 0.05))
(void (read-wire si))
(check-true (exn:fail:request-timeout? (sync/timeout 2 limited)))
(void (read-wire si))
(client-close! subscription) (close-input-port si) (close-output-port so)
(for ([bad '(0 -1 +inf.0 +nan.0 "30")])
  (check-exn exn:fail:contract? (lambda () (make-stdio-client (open-input-string "") (open-output-string) #:timeout bad))))
