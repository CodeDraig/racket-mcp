#lang racket/base
(require rackunit racket/tcp racket/port racket/string racket/list net/url net/uri-codec net/base64
         mcp/oauth mcp/authorization mcp/oauth-registration mcp/storage mcp/json)
(define resource "https://resource.example/mcp")
(define redirect "http://localhost:3080/callback")
(for ([method '(client_secret_basic client_secret_post none)])
  (define owner (make-custodian))
  (define store (open-memory-store))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define listener (tcp-listen 0 4 #t "127.0.0.1"))
        (define-values (_ port _host _port) (tcp-addresses listener #t))
        (define base (format "http://127.0.0.1:~a" port))
        (define now 100)
        (define issuer "https://a.example")
        (define registrations 0)
        (define tokens '())
        (define supported (list (symbol->string method)))
        (define cimd? #f)
        (thread (lambda ()
          (let loop ()
            (define-values (in out) (tcp-accept listener))
            (define first (read-line in 'any))
            (define headers (let read ([xs '()])
              (define line (read-line in 'any))
              (if (equal? line "") (reverse xs) (read (cons line xs)))))
            (define size (for/first ([h headers]
              #:do [(define m (regexp-match #px"(?i:^content-length:) *([0-9]+)$" h))] #:when m)
              (string->number (cadr m))))
            (define body (bytes->string/utf-8 (read-bytes (or size 0) in)))
            (define registering? (string-prefix? first "POST /register "))
            (define reply
              (if registering?
                (let ()
                  (set! registrations (add1 registrations))
                  (define r (hash-set (hash-set (string->json body)
                    'client_id (format "client +~a" registrations)) 'token_endpoint_auth_method (symbol->string method)))
                  (if (eq? method 'none) r
                      (hash-set (hash-set r 'client_secret (format "secret &~a" registrations))
                                'client_secret_expires_at (+ now 50))))
                (let ()
                  (set! tokens (append tokens (list (list headers (form-urlencoded->alist body)))))
                  (hasheq 'access_token (format "token-~a" (length tokens)) 'token_type "Bearer"
                          'refresh_token "refresh" 'expires_in 10))))
            (define data (string->bytes/utf-8 (json->string reply)))
            (fprintf out "HTTP/1.1 ~a OK\r\nContent-Type: application/json\r\nContent-Length: ~a\r\n\r\n"
                     (if registering? 201 200) (bytes-length data))
            (write-bytes data out) (flush-output out)
            (close-output-port out) (close-input-port in)
            (loop))))
        ;; The AS can replace the requested method; use its returned method.
        (define request (hasheq 'application_type "native" 'redirect_uris (list redirect)
                               'token_endpoint_auth_method "none"))
        (define (fetch url)
          (if (equal? url (protected-resource-metadata-url resource))
              (protected-resource-metadata resource (list issuer))
              (hasheq 'issuer issuer 'authorization_endpoint (string-append issuer "/authorize")
                      'token_endpoint (string-append base "/token") 'registration_endpoint (string-append base "/register")
                      'response_types_supported '("code") 'code_challenge_methods_supported '("S256")
                      'token_endpoint_auth_methods_supported supported 'client_id_metadata_document_supported cimd?)))
        (define browse-expire? #f)
        (define (browse url)
          (define query (url-query (string->url url)))
          (when browse-expire? (set! now (+ now 100)))
          (hasheq 'state (cdr (assq 'state query)) 'iss issuer 'code "code"))
        (define (make #:pre [pre (hash)] #:document [document #f])
          (make-oauth-authorizer #:resource resource #:redirect-uri redirect #:browse browse
            #:fetch fetch #:clock (lambda () now) #:allow-loopback-http? #t
            #:registration-store store #:registration-metadata request
            #:pre-registered pre #:client-metadata document
            #:client-metadata-url (and document "https://client.example/id.json")))
        (define auth (make))
        (check-true (oauth-credential? (authorize-resource! auth)))
        (check-equal? registrations 1)
        (define (check-token index generation grant)
          (define entry (list-ref tokens index))
          (define headers (car entry)) (define fields (cadr entry))
          (check-equal? (cdr (assq 'grant_type fields)) grant)
          (define header (for/first ([h headers] #:when (string-prefix? (string-downcase h) "authorization:")) h))
          (case method
            [(client_secret_basic)
             (check-equal? (base64-decode (string->bytes/utf-8 (substring header 21)))
               (string->bytes/utf-8 (format "client+%2B~a:secret+%26~a" generation generation)))
             (check-false (assq 'client_secret fields))]
            [(client_secret_post)
             (check-false header)
             (check-equal? (cdr (assq 'client_secret fields)) (format "secret &~a" generation))]
            [else (check-false header) (check-false (assq 'client_secret fields))])
          (unless (eq? method 'client_secret_basic)
            (check-equal? (cdr (assq 'client_id fields)) (format "client +~a" generation))))
        (check-token 0 1 "authorization_code")
        (set! now 120)
        (void (authorize-resource! auth))
        (check-equal? registrations 1)
        (check-token 1 1 "refresh_token")
        ;; New authorizer reloads registration and installs its secret.
        (void (authorize-resource! (make)))
        (check-equal? registrations 1)
        (check-token 2 1 "authorization_code")
        (set! issuer "https://b.example")
        (void (authorize-resource! auth))
        (check-equal? registrations 2)
        (check-token 3 2 "authorization_code")
        (unless (eq? method 'none)
          (set! now 170) ; expiry boundary for issuer B
          (void (authorize-resource! auth))
          (check-equal? registrations 3)
          (check-token 4 3 "authorization_code")
          ;; Secret expires while user is in browser: no token is transmitted.
          (set! issuer "https://expire.example")
          (set! browse-expire? #t)
          (check-exn #rx"expired before token exchange" (lambda () (authorize-resource! auth)))
          (check-equal? (length tokens) 5)
          (set! browse-expire? #f))
        ;; Unsupported returned method must fail before token exchange.
        (set! issuer "https://unsupported.example")
        (set! supported '("other"))
        (define before (length tokens))
        (check-exn #rx"does not support" (lambda () (authorize-resource! auth)))
        (check-equal? (length tokens) before)
        (set! supported (list (symbol->string method)))
        ;; Existing selection precedence remains intact even when DCR is enabled.
        (define before-reg registrations)
        (void (authorize-resource! (make #:pre (hash issuer (oauth-registration issuer "static" redirect resource '())))))
        (check-equal? registrations before-reg)
        (set! cimd? #t)
        (void (authorize-resource! (make #:document
          (client-id-metadata-document "https://client.example/id.json" "Client" (list redirect)))))
        (check-equal? registrations before-reg)
        (check-exn #rx"custom exchange" (lambda ()
          (make-oauth-authorizer #:resource resource #:redirect-uri redirect #:browse browse
            #:registration-store store #:registration-metadata request #:exchange void)))))
    (lambda () (close-store! store) (custodian-shutdown-all owner))))
