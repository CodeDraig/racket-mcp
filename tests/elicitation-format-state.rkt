#lang racket/base
(require rackunit racket/file mcp mcp/tasks)
(define (form kind)
  (hasheq 'mode "form" 'message "Enter a value"
          'requestedSchema (object-schema (hasheq 'value (hasheq 'type "string" 'format kind)))))
(define completions 0)
(define (record-answer answer)
  (set! completions (add1 completions))
  (structured-result answer))
(workflow (collect-format [kind String]) #:version "1"
  (await-input [answer Any] (form kind))
  (record-answer answer))
(workflow (collect-task) #:version "1" #:execution task
  (await-input [answer Any] (form "date"))
  (structured-result answer))
(define caps (hasheq 'elicitation (hasheq) 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define path (make-temporary-file "mcp-format-~a.sqlite"))
(define store (open-sqlite-store path))
(define interface (make-interface #:tools (list collect-format collect-task)))
(define runtime (make-runtime interface #:store store))
(define (call method params)
  (dispatch runtime method (hash-set params '_meta (request-meta #:capabilities caps)) #:principal "alice"))
(define (answer value) (hasheq 'action "accept" 'content (hasheq 'value value)))
(dynamic-wind void
  (lambda ()
    (for ([sample '(("date" "2023-02-29" "2024-02-29")
                   ("date-time" "2024-01-01T24:00:00Z" "2024-01-01T00:00:00Z")
                   ("email" "bad..local@example.test" "valid@example.test")
                   ("uri" "relative/path" "https://example.test/path"))])
      (define before completions)
      (define params (hasheq 'name "collect-format" 'arguments (hasheq 'kind (car sample))))
      (define first (call "tools/call" params))
      (define retry (hash-set params 'requestState (hash-ref first 'requestState)))
      (check-exn exn:fail:mcp?
        (lambda () (call "tools/call" (hash-set retry 'inputResponses (hasheq 'answer (answer (cadr sample)))))))
      (check-equal? completions before)
      (custodian-shutdown-all (runtime-custodian runtime))
      (close-store! store)
      (set! store (open-sqlite-store path))
      (set! runtime (make-runtime interface #:store store))
      (check-equal? (hash-ref (call "tools/call" retry) 'inputRequests) (hash-ref first 'inputRequests))
      (define result (call "tools/call" (hash-set retry 'inputResponses (hasheq 'answer (answer (caddr sample))))))
      (check-equal? (hash-ref result 'structuredContent) (answer (caddr sample)))
      (check-equal? completions (add1 before))
      (check-equal? (call "tools/call" retry) result)
      (check-equal? completions (add1 before)))
    (define created (call "tools/call" (hasheq 'name "collect-task")))
    (define task-params (hasheq 'taskId (hash-ref created 'taskId)))
    (define (await-status status)
      (let loop ([left 200])
        (define task (call "tasks/get" task-params))
        (cond [(equal? (hash-ref task 'status) status) task]
              [(zero? left) (error 'test "task did not reach ~a: ~s" status task)]
              [else (sync (alarm-evt (+ (current-inexact-milliseconds) 10))) (loop (sub1 left))])))
    (define waiting (await-status "input_required"))
    (check-exn exn:fail:mcp?
      (lambda () (call "tasks/update" (hash-set task-params 'inputResponses (hasheq 'answer (answer "2023-02-29"))))))
    (check-equal? (call "tasks/get" task-params) waiting)
    (void (call "tasks/update" (hash-set task-params 'inputResponses (hasheq 'answer (answer "2024-02-29")))))
    (check-equal? (hash-ref (hash-ref (await-status "completed") 'result) 'structuredContent) (answer "2024-02-29")))
  (lambda () (custodian-shutdown-all (runtime-custodian runtime)) (close-store! store) (delete-file path)))

;; Invalid requests never become durable pending inputs, including grouped input.
(for* ([group? '(#f #t)]
       [bad (list (hasheq 'mode "url" 'message "Open" 'url "not a URI" 'elicitationId "x")
                  (hash-set (form "date") 'requestedSchema (hasheq 'type "array")))])
  (define isolated (open-memory-store))
  (define program
    (make-workflow "bad-form" "1" "bad-form/1"
      (list (workflow-stage 'boundary (if group? 'input-group 'input)
                            (if group? (object-schema (hasheq 'input Any)) Any)
                            (lambda (_) (if group? (hasheq 'input bad) bad))
                            (and group? '(input)) #f)
            (workflow-stage 'done 'complete Any (lambda (_) (error 'test "completion ran")) #f #f))))
  (dynamic-wind void
    (lambda ()
      (check-exn #rx"invalid elicitation request" (lambda () (run-workflow program isolated (hasheq) #:principal "alice")))
      (define instances (list-instances isolated))
      (check-equal? (length instances) 1)
      (define state (stored-instance-state (car instances)))
      (check-false (hash-has-key? state 'pending-input))
      (check-false (hash-has-key? state 'pending-group))
      (check-equal? (hash-ref state 'position) 0))
    (lambda () (close-store! isolated))))
