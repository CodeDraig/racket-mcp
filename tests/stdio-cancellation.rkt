#lang racket/base
(require rackunit racket/port racket/async-channel mcp mcp/stdio mcp/subscription)
(define-values (in peer-out) (make-pipe))
(define-values (peer-in out) (make-pipe))
(define c (make-stdio-client in out #:request-limit 1 #:progress-token-limit 1))
(define (send m) (write-json m peer-out) (newline peer-out) (flush-output peer-out))
(define (next) (check-not-false (sync/timeout 2 peer-in)) (string->json (read-json-line peer-in)))
(define token-params (hasheq '_meta (hasheq 'progressToken 0)))
(define h (client-request c "ping" token-params))
(void (next))
(check-exn #rx"request limit" (lambda () (client-request c "ping")))
(request-cancel! h)
(define outcome (sync/timeout 0 h))
(check-true (exn:fail:request-cancelled? outcome))
(check-equal? (exn:fail:request-cancelled-request-id outcome) (request-handle-id h))
(check-equal? (hash-ref (next) 'method) "notifications/cancelled")
(request-cancel! h)
(check-eq? (sync h) outcome)
(check-false (sync/timeout 0 peer-in))
(check-exn #rx"already belongs" (lambda () (client-request c "ping" token-params)))
(check-exn #rx"token limit" (lambda () (client-request c "ping" (hasheq '_meta (hasheq 'progressToken 1)))))
;; Cancellation releases the active request slot. A late response only releases
;; the reserved token; it cannot replace the already observed cancellation.
(define barrier (client-request c "ping"))
(void (next))
(define (reply handle) (hasheq 'jsonrpc "2.0" 'id (request-handle-id handle) 'result (hasheq 'resultType "complete")))
(send (reply h)) (send (reply barrier))
(check-equal? (sync/timeout 2 barrier) (reply barrier))
(check-eq? (sync h) outcome)
(define reused (client-request c "ping" token-params))
(void (next))
(send (reply reused))
(check-equal? (sync/timeout 2 reused) (reply reused))
(request-cancel! reused)
(check-false (sync/timeout 0 peer-in))
(client-close! c)
(close-output-port peer-out) (close-input-port peer-in)

;; A server cancellation may close a subscription, never an ordinary request.
(for ([method '("subscriptions/listen" "ping")])
  (define-values (in peer-out) (make-pipe))
  (define c (make-stdio-client in (open-output-bytes)))
  (define h (client-request c method))
  (define closure (hasheq 'jsonrpc "2.0" 'method "notifications/cancelled" 'params (hasheq 'requestId (request-handle-id h))))
  (write-json closure peer-out) (newline peer-out) (flush-output peer-out)
  (define result (sync/timeout 2 h))
  (if (equal? method "subscriptions/listen") (check-equal? result closure) (check-true (exn:fail? result)))
  (client-close! c) (close-output-port peer-out))

;; Real server cancellation reaps an uncooperative ordinary worker without
;; emitting a forbidden notification. A subsequent response is the wire barrier.
(define started (make-async-channel))
(define rt (make-runtime (make-interface #:tools
  (list (make-tool "wait" '() (lambda (_) (async-channel-put started (current-thread)) (sync never-evt)))))))
(define-values (server-in writer) (make-pipe))
(define-values (reader server-out) (make-pipe))
(define server (thread (lambda () (serve-stdio rt #:input server-in #:output server-out))))
(define (write-message m) (write-json m writer) (newline writer) (flush-output writer))
(write-message (hasheq 'jsonrpc "2.0" 'id 1 'method "tools/call"
  'params (hasheq 'name "wait" 'arguments (hasheq) '_meta (request-meta))))
(define worker (sync/timeout 2 started))
(check-true (thread? worker))
(write-message (hasheq 'jsonrpc "2.0" 'method "notifications/cancelled" 'params (hasheq 'requestId 1)))
(check-not-false (sync/timeout 2 (thread-dead-evt worker)))
(write-message (hasheq 'jsonrpc "2.0" 'id 2 'method "server/discover" 'params (hasheq '_meta (request-meta))))
(check-not-false (sync/timeout 2 reader))
(check-equal? (hash-ref (string->json (read-json-line reader)) 'id) 2)
(close-output-port writer)
(check-not-false (sync/timeout 2 (thread-dead-evt server)))
(close-input-port reader) (close-input-port server-in) (close-output-port server-out)
(custodian-shutdown-all (runtime-custodian rt))

;; Cancellation resolves locally even when its wire message cannot be written.
(define-values (blocked-in unused-peer-out) (make-pipe))
(define-values (blocked-peer-in blocked-out) (make-pipe 1))
(define blocked (make-stdio-client blocked-in blocked-out))
(define handles (make-async-channel))
(define creator (thread (lambda () (async-channel-put handles (client-request blocked "ping")))))
(check-not-false (sync/timeout 2 blocked-peer-in))
(void (read-json-line blocked-peer-in))
(define blocked-handle (sync/timeout 2 handles))
(check-true (request-handle? blocked-handle))
(define canceller (thread (lambda () (request-cancel! blocked-handle))))
(check-not-false (sync/timeout 2 (thread-dead-evt canceller)))
(check-true (exn:fail:request-cancelled? (sync/timeout 0 blocked-handle)))
(client-close! blocked)
(check-not-false (sync/timeout 2 (thread-dead-evt creator)))
(close-input-port blocked-peer-in) (close-output-port unused-peer-out)
