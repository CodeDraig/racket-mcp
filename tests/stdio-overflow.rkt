#lang racket/base
(require rackunit racket/async-channel mcp/stdio mcp/json)
(define-values (in peer-out) (make-pipe))
(define-values (peer-in out) (make-pipe))
(define c (make-stdio-client in out #:notification-limit 2))
(define (send value) (write-json value peer-out) (newline peer-out) (flush-output peer-out))
(define (next-request) (string->json (read-json-line peer-in)))
(define (request method [params (hasheq)])
  (define h (client-request c method params))
  (next-request)
  h)
(define (reply h) (hasheq 'jsonrpc "2.0" 'id (request-handle-id h) 'result (hasheq 'resultType "complete")))
(define (change h)
  (hasheq 'jsonrpc "2.0" 'method "notifications/tools/list_changed"
          'params (hasheq '_meta (hasheq 'io.modelcontextprotocol/subscriptionId (request-handle-id h)))))
(define slow (request "subscriptions/listen"))
(define healthy (request "subscriptions/listen"))
(define ping (request "ping"))
(for ([i (in-range 3)]) (send (change slow)))
(send (change healthy))
(send (reply ping))
(define overflow (sync/timeout 2 slow))
(check-true (exn:fail:notification-overflow? overflow))
(check-equal? (exn:fail:notification-overflow-request-id overflow) (request-handle-id slow))
(check-equal? (sync/timeout 2 ping) (reply ping))
(check-equal? (sync/timeout 2 (request-handle-notifications healthy)) (change healthy))
(check-false (sync/timeout 0 healthy))
(check-not-false (sync/timeout 2 peer-in))
(check-equal? (next-request)
              (hasheq 'jsonrpc "2.0" 'method "notifications/cancelled"
                      'params (hasheq 'requestId (request-handle-id slow))))
;; Late traffic must not replace the local failure or reach another handle.
(send (reply slow))
(send (change slow))
(define replacement (request "subscriptions/listen"))
(send (change replacement))
(check-equal? (sync/timeout 2 (request-handle-notifications replacement)) (change replacement))
(check-eq? (sync/timeout 0 slow) overflow)

;; Retain overflowed progress tokens until the remote termination signal arrives.
(define progressing (request "ping" (hasheq '_meta (hasheq 'progressToken "token"))))
(for ([i (in-range 3)])
  (send (hasheq 'jsonrpc "2.0" 'method "notifications/progress"
                'params (hasheq 'progressToken "token" 'progress i))))
(check-true (exn:fail:notification-overflow? (sync/timeout 2 progressing)))
(check-not-false (sync/timeout 2 peer-in))
(void (next-request))
(check-exn #rx"already belongs" (lambda () (client-request c "ping" (hasheq '_meta (hasheq 'progressToken "token")))))
(send (reply progressing))
;; A response after the cancellation is a reader barrier, with no timing sleeps.
(define barrier (request "ping"))
(send (reply barrier))
(check-equal? (sync/timeout 2 barrier) (reply barrier))
(define reused (request "ping" (hasheq '_meta (hasheq 'progressToken "token"))))
(send (reply reused))
(check-equal? (sync/timeout 2 reused) (reply reused))
(client-close! c)
(check-true (exn:fail? (sync/timeout 0 healthy)))
(close-input-port peer-in) (close-output-port peer-out)
