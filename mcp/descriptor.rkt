#lang racket/base
(require "completion.rkt" "private/handler-info.rkt")
(require racket/list racket/match "schema.rkt" "json.rkt" "uri-template.rkt" "header-schema.rkt" "rendering.rkt" "codec.rkt" "error.rkt" "presentation.rkt" "effect.rkt" (only-in "authorization.rkt" check-scopes!))
(provide (struct-out server-descriptor) (struct-out argument) (struct-out prompt-argument) (struct-out tool-descriptor)
         (struct-out resource-descriptor) (struct-out prompt-descriptor)
         (struct-out interface-descriptor) (struct-out resource-ref) (struct-out request-context)
         interface-requirements interface-adapter-bindings interface-resource-references make-interface make-tool make-resource make-prompt bind-arguments encode-prompt-arguments prompt-codec-fingerprint
         text-content text-result structured-result error-result resource-link
         current-request-context current-interface current-resource-resolver resource-uri link embed)
(struct server-descriptor (name version instructions) #:transparent)
(struct argument (name schema optional? default) #:transparent)
(struct prompt-argument argument (codec) #:transparent)
(struct tool-descriptor (name description arguments input-schema output-schema handler annotations workflow execution raw? changes) #:transparent)
(struct resource-descriptor (name uri description mime-type handler arguments matcher identity workflow renderer depends-on ttl-ms) #:transparent
  #:property prop:procedure
  (lambda (self . args)
    (unless (= (length args) (length (resource-descriptor-arguments self))) (error 'resource "incorrect resource-reference arity"))
    (for ([a (in-list (resource-descriptor-arguments self))] [v (in-list args)])
      (unless (valid? (argument-schema a) v) (error 'resource "invalid reference argument ~a" (argument-name a))))
    (resource-ref self args)))
(struct prompt-descriptor (name description arguments handler workflow) #:transparent)
(struct interface-descriptor (server tools resources prompts completions) #:transparent)
(struct scoped-interface interface-descriptor (requirements adapters references) #:transparent)
(define (interface-requirements interface)
  (if (scoped-interface? interface) (scoped-interface-requirements interface) (hasheq)))
(define (interface-adapter-bindings interface)
  (if (scoped-interface? interface) (scoped-interface-adapters interface) (hasheq)))
(define (interface-resource-references interface)
  (if (scoped-interface? interface) (scoped-interface-references interface) (hasheq)))
(struct resource-ref (declaration arguments) #:transparent)
(struct request-context (principal capabilities request-id cancelled? notify) #:transparent)
(define current-request-context (make-parameter #f))
(define current-interface (make-parameter #f))
(define current-resource-resolver (make-parameter (lambda (_) (error 'embed "no active resource resolver"))))
(define (check-arguments! who arguments)
  (unless (and (list? arguments) (andmap argument? arguments))
    (raise-argument-error who "list of argument descriptors" arguments))
  (define seen (make-hasheq))
  (for ([a (in-list arguments)])
    (unless (symbol? (argument-name a)) (error who "argument name must be a symbol"))
    (when (hash-has-key? seen (argument-name a)) (error who "duplicate argument: ~a" (argument-name a)))
    (hash-set! seen (argument-name a) #t)
    (unless (boolean? (argument-optional? a)) (error who "argument optional flag must be a boolean"))
    (when (argument-default a)
      (unless (and (procedure? (argument-default a)) (procedure-arity-includes? (argument-default a) 1))
        (error who "argument default must accept previously bound arguments"))
      (unless (argument-optional? a) (error who "argument with a default must be optional")))
    (check-schema! (argument-schema a))))
(define (make-tool name arguments handler #:description [description ""] #:output [output #f] #:annotations [annotations (hasheq)] #:workflow [workflow #f] #:execution [execution 'mrtr]
                   #:input-schema [input-schema #f] #:raw? [raw? #f] #:changes [changes (lambda (_args _result) '())])
  (unless (memq execution '(mrtr task task-optional))
    (error 'make-tool "execution must be mrtr, task, or task-optional"))
  (when (and (not (eq? execution 'mrtr)) (not workflow))
    (error 'make-tool "task execution requires a workflow"))
  (unless (and (procedure? changes) (procedure-arity-includes? changes 2)) (error 'make-tool "changes must accept arguments and committed result"))
  (unless (and (string? name) (positive? (string-length name))) (error 'make-tool "expected nonempty wire name"))
  (check-arguments! 'make-tool arguments)
  (when output (check-schema! output))
  (define input (or input-schema
                    (object-schema (for/hasheq ([a (in-list arguments)]) (values (argument-name a) (argument-schema a)))
                                   #:required (for/list ([a (in-list arguments)] #:unless (argument-optional? a)) (symbol->string (argument-name a))))))
  (check-schema! input) (header-bindings input)
  (tool-descriptor name description arguments
                   input output handler annotations workflow execution raw? changes))
(define (make-resource name uri handler #:description [description ""] #:mime-type [mime-type #f] #:render [renderer #f]
                       #:arguments [arguments '()] #:matcher [matcher #f] #:workflow [workflow #f] #:depends-on [depends-on (lambda (_args) '())] #:ttl-ms [ttl-ms 0])
  (unless (and (string? name) (positive? (string-length name))) (error 'make-resource "expected nonempty wire name"))
  (check-arguments! 'make-resource arguments)
  (check-resource-template! uri arguments)
  (unless (exact-nonnegative-integer? ttl-ms) (error 'make-resource "ttl-ms must be an exact nonnegative integer"))
  (unless (and (procedure? depends-on) (procedure-arity-includes? depends-on 1)) (error 'make-resource "depends-on must accept bound arguments"))
  (when renderer
    (unless (resource-renderer? renderer) (error 'make-resource "expected a named resource renderer"))
    (when (and mime-type (not (equal? mime-type (resource-renderer-mime-type renderer))))
      (error 'make-resource "resource and renderer MIME types disagree")))
  (resource-descriptor name uri description (or mime-type (and renderer (resource-renderer-mime-type renderer)) "text/plain")
                       handler arguments (or matcher (uri-template-matcher uri)) (gensym 'resource) workflow renderer depends-on ttl-ms))
(define (check-resource-template! uri arguments)
  (for ([variable (in-list (uri-template-variables uri))])
    (unless (memq variable (map argument-name arguments))
      (error 'resource "URI template references an undeclared argument: ~a" variable))))
(define (make-prompt name arguments handler #:description [description ""] #:workflow [workflow #f])
  (unless (and (string? name) (positive? (string-length name))) (error 'make-prompt "expected nonempty wire name"))
  (check-arguments! 'make-prompt arguments)
  (for ([a (in-list arguments)])
    (cond [(prompt-argument? a)
           (unless (string-codec? (prompt-argument-codec a)) (error 'make-prompt "expected an explicit string codec"))]
          [else
           (define type (and (hash? (argument-schema a)) (hash-ref (argument-schema a) 'type #f)))
           (when (and type (not (member "string" (if (list? type) type (list type)))))
             (error 'make-prompt "non-string argument ~a requires a string codec" (argument-name a)))]))
  (prompt-descriptor name description arguments handler workflow))
(define (prompt-codec-fingerprint descriptor)
  (json->string
   (for/list ([a (in-list (prompt-descriptor-arguments descriptor))] #:when (prompt-argument? a))
     (define codec (prompt-argument-codec a))
     (hasheq 'argument (symbol->string (argument-name a)) 'name (string-codec-name codec)
             'version (string-codec-version codec) 'schema (string-codec-schema codec)))))
(define (encode-prompt-arguments descriptor arguments)
  (unless (hash? arguments) (raise-argument-error 'encode-prompt-arguments "hash?" arguments))
  (for/hasheq ([(name value) (in-hash arguments)] #:unless (missing? value))
    (define a (findf (lambda (a) (eq? name (argument-name a))) (prompt-descriptor-arguments descriptor)))
    (unless a (error 'encode-prompt-arguments "unknown argument ~a" name))
    (unless (valid? (argument-schema a) value) (error 'encode-prompt-arguments "invalid argument ~a" name))
    (define wire (if (prompt-argument? a) (encode-string-value (prompt-argument-codec a) value) value))
    (unless (string? wire) (error 'encode-prompt-arguments "non-string argument requires a codec"))
    (values name wire)))
(define (make-interface #:server [server #f] #:tools [tools '()] #:resources [resources '()] #:prompts [prompts '()] #:completions [completions '()] #:requirements [requirements (hasheq)] #:adapter-bindings [adapters (hasheq)] #:references [references (hasheq)])
  (for ([descriptors (in-list (list tools resources prompts))]
        [arguments-of (in-list (list tool-descriptor-arguments resource-descriptor-arguments prompt-descriptor-arguments))])
    (for ([descriptor (in-list descriptors)])
      (check-arguments! 'make-interface (arguments-of descriptor))))
  (for ([tool (in-list tools)])
    (check-schema! (tool-descriptor-input-schema tool))
    (when (tool-descriptor-output-schema tool) (check-schema! (tool-descriptor-output-schema tool))))
  (for ([resource (in-list resources)])
    (check-resource-template! (resource-descriptor-uri resource) (resource-descriptor-arguments resource)))
  (for ([xs (list tools resources prompts)] [name (list tool-descriptor-name resource-descriptor-uri prompt-descriptor-name)])
    (define seen (make-hash))
    (for ([x (in-list xs)]) (when (hash-has-key? seen (name x)) (error 'make-interface "duplicate published identity: ~a" (name x))) (hash-set! seen (name x) #t)))
  (for* ([index (in-range (length resources))]
         [other (in-list (drop resources (add1 index)))])
    (define resource (list-ref resources index))
    (define witness (uri-matchers-overlap (resource-descriptor-matcher resource) (resource-descriptor-matcher other)))
    (when (string? witness)
      (error 'make-interface "overlapping resource URI routes ~a and ~a; both match ~s"
             (resource-descriptor-uri resource) (resource-descriptor-uri other) witness)))
  (define completion-routes (make-hasheq))
  (for ([completion (in-list completions)])
    (unless (completion-descriptor? completion)
      (raise-argument-error 'make-interface "completion-descriptor?" completion))
    (define target (completion-descriptor-target completion))
    (define argument-name* (completion-descriptor-argument completion))
    (define arguments
      (cond [(resource-descriptor? target)
             (unless (memq target resources) (error 'make-interface "completion references an absent resource"))
             (resource-descriptor-arguments target)]
            [(prompt-descriptor? target)
             (unless (memq target prompts) (error 'make-interface "completion references an absent prompt"))
             (prompt-descriptor-arguments target)]
            [else (error 'make-interface "completion target must be a resource or prompt")]))
    (unless (memq argument-name* (map argument-name arguments))
      (error 'make-interface "completion references an unknown argument: ~a" argument-name*))
    (define previous (hash-ref completion-routes target '()))
    (when (memq argument-name* previous)
      (error 'make-interface "duplicate completion for argument: ~a" argument-name*))
    (hash-set! completion-routes target (cons argument-name* previous)))
  (unless (hash? requirements) (raise-argument-error 'make-interface "hash?" requirements))
  (define declarations (append tools resources prompts))
  (define checked
    (for/hasheq ([(target scopes) (in-hash requirements)])
      (unless (memq target declarations) (error 'make-interface "scope requirement references an absent declaration"))
      (check-scopes! scopes)
      (values target (remove-duplicates (map string->immutable-string scopes)))))
  (unless (hash? adapters) (raise-argument-error 'make-interface "hash?" adapters))
  (define checked-adapters
    (for/hasheq ([(target bindings) (in-hash adapters)])
      (unless (memq target declarations) (error 'make-interface "adapter binding references an absent declaration"))
      (values target (check-adapter-bindings bindings))))
  (unless (hash? references) (raise-argument-error 'make-interface "hash?" references))
  (define collected-references
    (for/fold ([collected (for/hasheq ([(source targets) (in-hash references)])
                           (values source targets))])
              ([source (in-list declarations)])
      (define handler
        (cond [(tool-descriptor? source) (tool-descriptor-handler source)]
              [(resource-descriptor? source) (resource-descriptor-handler source)]
              [else (prompt-descriptor-handler source)]))
      (define inferred (handler-resource-references handler))
      (if (null? inferred) collected
          (hash-update collected source (lambda (targets) (append targets inferred)) '()))))
  (define checked-references
    (for/hasheq ([(source targets) (in-hash collected-references)])
      (unless (memq source declarations) (error 'make-interface "resource-reference source is an absent declaration"))
      (define source-name
        (cond [(tool-descriptor? source) (tool-descriptor-name source)]
              [(resource-descriptor? source) (resource-descriptor-name source)]
              [else (prompt-descriptor-name source)]))
      (unless (and (list? targets) (andmap resource-descriptor? targets))
        (error 'make-interface "resource references must be a list of resource descriptors"))
      (define resolved
        (for/list ([target (in-list targets)])
          (define candidates
            (filter (lambda (resource) (eq? (resource-descriptor-identity resource) (resource-descriptor-identity target))) resources))
          (when (null? candidates)
            (error 'make-interface "declaration ~a references an absent resource: ~a" source-name (resource-descriptor-name target)))
          (unless (null? (cdr candidates))
            (error 'make-interface "declaration ~a references an ambiguous mounted resource: ~a" source-name (resource-descriptor-name target)))
          (car candidates)))
      (values source (remove-duplicates resolved eq?))))
  (scoped-interface server tools resources prompts completions checked checked-adapters checked-references))
(define (bind-arguments arguments input)
  (unless (hash? input) (error 'bind-arguments "arguments must be an object"))
  (for/fold ([bound (hasheq)]) ([a (in-list arguments)])
    (define supplied (hash-ref input (argument-name a) missing))
    (define v (cond [(not (missing? supplied)) (if (prompt-argument? a) (with-handlers ([exn:fail? (lambda (e) (mcp-error -32602 (format "Invalid string argument ~a" (argument-name a))))])
                      (decode-string-value (prompt-argument-codec a) supplied)) supplied)]
                    [(argument-default a) ((argument-default a) bound)]
                    [(argument-optional? a) missing]
                    [else (error 'bind-arguments "missing argument ~a" (argument-name a))]))
    (unless (or (missing? v) (valid? (argument-schema a) v)) (error 'bind-arguments "invalid argument ~a" (argument-name a)))
    (hash-set bound (argument-name a) v)))
(define (text-content text) (hasheq 'type "text" 'text text))
(define (text-result text) (hasheq 'resultType "complete" 'content (list (text-content text))))
(define (structured-result value #:content [content '()]) (hasheq 'resultType "complete" 'content content 'structuredContent value))
(define (error-result message) (hash-set (text-result message) 'isError #t))
(define (resource-link ref)
  (define d (resolve-resource ref))
  (hasheq 'type "resource_link" 'uri (resource-uri ref) 'name (resource-descriptor-name d) 'mimeType (resource-descriptor-mime-type d)))
(define (resolve-resource ref)
  (define original (resource-ref-declaration ref))
  (if (current-interface)
                (or (findf (lambda (d) (eq? (resource-descriptor-identity original) (resource-descriptor-identity d))) (interface-descriptor-resources (current-interface)))
                    (error 'resource-uri "referenced resource is absent from the interface")) original))
(define (resource-uri ref)
  (define original (resource-ref-declaration ref))
  (define d (resolve-resource ref))
  (uri-template-expand (resource-descriptor-uri d)
                       (for/hasheq ([a (in-list (resource-descriptor-arguments original))] [v (in-list (resource-ref-arguments ref))])
                         (values (argument-name a) v))))
(define link resource-link)
(define (embed ref)
  (if (current-render-capture) (deferred-embedding (resource-uri ref)) ((current-resource-resolver) ref)))
