#lang racket/base
(require rackunit racket/async-channel mcp mcp/authorization)
(define now 0)
(define version 0)
(define child-reads 0)
(define parent-reads 0)
(define secret "one")
(define deny? #f)
(resource (child) #:uri "cache:///child" #:depends-on '("child") #:ttl-ms 100
  (set! child-reads (add1 child-reads)) secret)
(resource (parent) #:uri "cache:///parent" #:depends-on '("parent") #:ttl-ms 1000
  (set! parent-reads (add1 parent-reads))
  (define contents (embed (child)))
  (set! now (+ now 10))
  (text-presentation "Parent: " contents))
(define rt (make-runtime (make-interface #:resources (list child parent))
  #:cache (make-resource-cache #:clock (lambda () now))
  #:cache-context (lambda (principal) (list principal version))
  #:authorize (lambda (principal method params)
                (not (and deny? (equal? (hash-ref params 'uri #f) "cache:///child"))))))
(define alice (verified-principal "alice" "issuer" "audience" '("read") (+ (current-seconds) 1000)))
(define alice-other (struct-copy verified-principal alice [scopes '("read" "extra")]))
(define (read-resource uri [principal alice])
  (dispatch rt "resources/read" (hasheq '_meta (request-meta) 'uri uri) #:principal principal))
(check-equal? (hash-ref (read-resource "cache:///parent") 'ttlMs) 90)
(check-equal? child-reads 1)
(check-equal? parent-reads 1)
(set! now 50)
(check-equal? (hash-ref (read-resource "cache:///parent") 'ttlMs) 50)
(check-equal? parent-reads 1)
(set! now 101)
(void (read-resource "cache:///parent"))
(check-equal? child-reads 2)
(check-equal? parent-reads 2)
;; Different scopes of the same principal cannot reuse the old authority context.
(void (read-resource "cache:///child" alice-other))
(check-equal? child-reads 3)
(set! secret "two")
(void (runtime-report-change! rt alice '("child")))
(check-equal? (hash-ref (car (hash-ref (read-resource "cache:///parent") 'contents)) 'text) "Parent: two")
(check-equal? parent-reads 3)
(void (read-resource "cache:///child" alice-other))
(check-equal? child-reads 5)
;; Recheck transitive authorization even when parent and child entries are fresh.
(set! deny? #t)
(check-exn exn:fail:mcp? (lambda () (read-resource "cache:///parent")))
(set! deny? #f)
(set! version 1)
(void (read-resource "cache:///parent"))
(check-equal? child-reads 6)
(check-exn exn:fail:mcp? (lambda () (read-resource "cache:///child" (struct-copy verified-principal alice [expiry 0]))))
;; Invalidation during loading prevents cache insertion and a positive wire TTL.
(define started (make-semaphore 0)) (define release (make-semaphore 0))
(resource (slow) #:uri "cache:///slow" #:depends-on '("slow") #:ttl-ms 100
  (semaphore-post started) (semaphore-wait release) "snapshot")
(define rt2 (make-runtime (make-interface #:resources (list slow))))
(define answer (make-async-channel))
(define worker (thread (lambda () (async-channel-put answer
  (dispatch rt2 "resources/read" (hasheq '_meta (request-meta) 'uri "cache:///slow") #:principal "alice")))))
(semaphore-wait started)
(void (runtime-report-change! rt2 "alice" '("slow")))
(semaphore-post release)
(check-equal? (hash-ref (sync/timeout 2 answer) 'ttlMs) 0)
(thread-wait worker)
(custodian-shutdown-all (runtime-custodian rt)) (custodian-shutdown-all (runtime-custodian rt2))
