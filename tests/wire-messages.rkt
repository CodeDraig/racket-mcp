#lang racket/base
(require rackunit racket/tcp racket/port racket/async-channel mcp/http mcp/stdio mcp/json
         mcp/private/wire-message)
(define good (hasheq 'jsonrpc "2.0" 'id 1 'result (hasheq 'resultType "complete")))
(define task (hash-set good 'result (hasheq 'resultType "task")))
(define caps (hasheq 'extensions (hasheq 'io.modelcontextprotocol/tasks (hasheq))))
(define invalid
  (list '() #f
        (hash-set good 'jsonrpc "1.0")
        (hash-set good 'id json-null)
        (hash-set good 'id 1/2)
        (hash-set good 'method "unexpected/request")
        (hash-set good 'error (hasheq 'code -1 'message "both"))
        (hash-remove good 'id)
        (hash-remove good 'result)
        (hash-set good 'result #f)
        (hash-set good 'result '())
        (hash-set good 'result (hasheq 'resultType "unknown"))
        (hash-set good 'result (hasheq 'resultType 3))
        (hash-set good 'result (hasheq '_meta #f))
        (hasheq 'jsonrpc "2.0" 'id 1 'error (hasheq 'code 1/2 'message "fraction"))
        (hasheq 'jsonrpc "2.0" 'id 1 'error (hasheq 'code -1 'message #f))
        (hasheq 'jsonrpc "2.0" 'id 1 'error #f)))
(for ([m (in-list invalid)])
  (check-exn exn:fail? (lambda () (check-server-message m))))
(check-eq? (check-server-message good #:expected-id 1) 'response)
(check-exn exn:fail? (lambda () (check-server-message good #:expected-id 2)))
(check-eq? (check-server-message (hash-set good 'result (hasheq))) 'response)
(check-exn exn:fail? (lambda () (check-result-capabilities! task (hasheq))))
(check-not-exn (lambda () (check-result-capabilities! task caps)))
(define idless (hasheq 'jsonrpc "2.0" 'error (hasheq 'code -32700 'message "Parse error")))
(check-eq? (check-server-message idless #:expected-id 1) 'uncorrelated-error)
(for ([params (list #f '() (hasheq '_meta #f))])
  (check-exn exn:fail? (lambda () (check-server-message (hasheq 'jsonrpc "2.0" 'method "notifications/progress" 'params params)))))

(define (http-outcome m sse? [capabilities (hasheq)])
  (define owner (make-custodian))
  (dynamic-wind void
    (lambda ()
      (parameterize ([current-custodian owner])
        (define listener (tcp-listen 0 4 #t "127.0.0.1"))
        (define-values (_ port _r _rp) (tcp-addresses listener #t))
        (thread
         (lambda ()
           (define-values (in out) (tcp-accept listener))
           (let loop ([size 0])
             (define line (read-line in 'any))
             (cond [(equal? line "") (read-bytes size in)]
                   [else (define match (regexp-match #px"(?i:^content-length: *)([0-9]+)" line))
                         (loop (if match (string->number (cadr match)) size))]))
           (define body (string->bytes/utf-8 (if sse? (format "data: ~a\n\n" (json->string m)) (json->string m))))
           (fprintf out "HTTP/1.1 200 OK\r\nContent-Type: ~a\r\nContent-Length: ~a\r\n\r\n"
                    (if sse? "text/event-stream" "application/json") (bytes-length body))
           (write-bytes body out) (flush-output out)
           (close-output-port out) (close-input-port in)))
        (sync/timeout 2 (http-client-request (make-http-client (format "http://127.0.0.1:~a" port))
                                           "server/discover" #:capabilities capabilities))))
    (lambda () (custodian-shutdown-all owner))))
(define (stdio-outcome m [capabilities (hasheq)] [after-request void])
  (define-values (in server-out) (make-pipe))
  (define out (open-output-bytes))
  (define c (make-stdio-client in out))
  (dynamic-wind void
    (lambda ()
      (define h (client-request c "server/discover" #:capabilities capabilities))
      (after-request)
      (write-json m server-out) (newline server-out) (flush-output server-out)
      (sync/timeout 2 h))
    (lambda () (client-close! c) (close-output-port server-out))))
(for ([m (in-list invalid)])
  (check-true (exn:fail? (stdio-outcome m)))
  (for ([sse? '(#f #t)]) (check-true (exn:fail? (http-outcome m sse?)))))
(for ([sse? '(#f #t)])
  (check-true (exn:fail? (http-outcome (hash-set good 'id 2) sse?)))
  (check-equal? (http-outcome good sse?) good)
  (check-equal? (http-outcome idless sse?) idless)
  (check-true (exn:fail? (http-outcome task sse?)))
  (check-equal? (http-outcome task sse? caps) task))
(check-equal? (stdio-outcome good) good)
(check-true (exn:fail? (stdio-outcome task)))
(check-equal? (stdio-outcome task caps) task)
(check-true (exn:fail? (stdio-outcome idless)))

;; Capability acceptance is bound to what was advertised on the request, not to
;; a mutable application hash changed while the request is outstanding.
(define mutable-caps (make-hasheq))
(check-true (exn:fail? (stdio-outcome task mutable-caps
  (lambda () (hash-set! mutable-caps 'extensions (hash-ref caps 'extensions))))))
(check-equal? (stdio-outcome task mutable-caps (lambda () (hash-clear! mutable-caps))) task)
