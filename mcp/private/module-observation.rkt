#lang racket/base
(require "module-code-tree.rkt" "compiled-identity.rkt")
;; This module deliberately imports no SDK or hashing libraries: command startup
;; installs its observer before those libraries are loaded. Evidence is scoped to
;; the actual module registry, never inferred from a source file after loading.
(provide call-with-module-observation install-module-observation! observed-module-code)
(struct observation (registries lock))
(define current-observations (make-parameter #f))
(define current-observing-evaluator (make-parameter #f))
(define current-observing-compiler (make-parameter #f))
(define (make-observing-compiler compiler)
  (lambda (expression immediate?)
    (compile-with-module-identity expression immediate? compiler)))
(define (observed-module-code identity [namespace (current-namespace)])
  (define observations (current-observations))
  (and observations
       (call-with-semaphore (observation-lock observations)
         (lambda ()
           (hash-ref (hash-ref (observation-registries observations)
                               (namespace-module-registry namespace) #hasheq())
                     identity #f)))))
(define (module-source? expression)
  (and (syntax? expression)
       (pair? (syntax-e expression))
       (identifier? (car (syntax-e expression)))
       (eq? (syntax-e (car (syntax-e expression))) 'module)))
(define (make-observing-evaluator observations original-eval)
  (lambda (expression)
    (define code (if (module-source? expression) (compile expression) expression))
    (define identity (current-module-declare-name))
    (define registry (namespace-module-registry (current-namespace)))
    (begin0 (original-eval code)
      (when (and identity (compiled-module-expression? code))
        (call-with-semaphore (observation-lock observations)
          (lambda ()
            (define modules (hash-ref! (observation-registries observations) registry make-hash))
            (for ([entry (in-list (module-code-tree identity code))])
              (hash-set! modules (car entry) (cdr entry)))))))))
;; Reader and language entry points cannot wrap the rest of module loading in a
;; thunk. Installation is parameter-local and idempotent for the current hook.
;; A caller-supplied replacement evaluator is preserved beneath the new wrapper.
(define (install-module-observation!)
  (unless (eq? (current-compile) (current-observing-compiler))
    (define compiler (make-observing-compiler (current-compile)))
    (current-observing-compiler compiler)
    (current-compile compiler))
  (unless (and (current-observations)
               (eq? (current-eval) (current-observing-evaluator)))
    (define observations
      (or (current-observations) (observation (make-ephemeron-hasheq) (make-semaphore 1))))
    (define observe (make-observing-evaluator observations (current-eval)))
    (current-observations observations)
    (current-observing-evaluator observe)
    (current-eval observe)))
(define (call-with-module-observation thunk #:seed [initial-seed '()] #:handoff [handoff #f])
  (define (check-seed seed)
    (unless (and (list? seed)
               (for/and ([entry (in-list seed)])
                 (and (pair? entry) (namespace? (car entry)) (list? (cdr entry))
                      (for/and ([code-entry (in-list (cdr entry))])
                        (and (pair? code-entry) (resolved-module-path? (car code-entry))
                             (compiled-module-expression? (cdr code-entry)))))))
    (raise-argument-error 'call-with-module-observation "namespace/code observation snapshot" seed)))
  (check-seed initial-seed)
  (define observations (observation (make-ephemeron-hasheq) (make-semaphore 1)))
  ;; A resolver can retain the kernel hook's parameterization after transfer.
  ;; Forward its later observations directly, without re-entering evaluation.
  (define receiving-target #f)
  (define (receive identity code namespace)
    (define target receiving-target)
    (when target
      (call-with-semaphore (observation-lock target)
        (lambda ()
          (when (eq? receiving-target target)
            (define modules (hash-ref! (observation-registries target)
                                       (namespace-module-registry namespace) make-hash))
            (for ([entry (in-list (module-code-tree identity code))])
              (hash-set! modules (car entry) (cdr entry))))))))
  (define transferred (if handoff (handoff receive) '()))
  (check-seed transferred)
  (define seed (append initial-seed transferred))
  ;; Direct observations take precedence over nested code retained by a parent.
  ;; A separately loaded submodule may have a distinct actual declaration.
  (for ([entry (in-list seed)])
    (define registry (namespace-module-registry (car entry)))
    (define modules (hash-ref! (observation-registries observations) registry make-hash))
    (for ([code-entry (in-list (cdr entry))])
      (hash-set! modules (car code-entry) (cdr code-entry))))
  (for ([entry (in-list seed)])
    (define modules (hash-ref (observation-registries observations)
                             (namespace-module-registry (car entry))))
    (for* ([code-entry (in-list (cdr entry))]
           [nested (in-list (module-code-tree (car code-entry) (cdr code-entry)))])
      (unless (hash-has-key? modules (car nested))
        (hash-set! modules (car nested) (cdr nested)))))
  (define (set-receiver! target)
    (call-with-semaphore (observation-lock observations)
      (lambda () (set! receiving-target target))))
  (define observe (make-observing-evaluator observations (current-eval)))
  (define compiler (make-observing-compiler (current-compile)))
  (parameterize ([current-eval observe] [current-observations observations]
                 [current-observing-evaluator observe]
                 [current-compile compiler] [current-observing-compiler compiler])
    (dynamic-wind
      (lambda () (set-receiver! observations))
      thunk
      (lambda () (set-receiver! #f)))))
