#lang racket/base
(require rackunit racket/file racket/port racket/system mcp/stdio)
(for ([compiled? '(#f #t)])
  (test-case (if compiled? "ordinary compiled direct entry" "ordinary source direct entry")
    (define directory (make-temporary-file "mcp-declared-cli-~a" 'directory))
    (define application (build-path directory "application.rkt"))
    (define helper (build-path directory "helper.rkt"))
    (define database (build-path directory "state.sqlite"))
    (define initialized (build-path directory "initialized"))
    (define completed (build-path directory "completed"))
    (define launches 0)
    (define (write-helper value)
      (call-with-output-file helper #:exists 'truncate
        (lambda (out) (fprintf out "#lang racket/base\n(provide helper)\n(define (helper) ~s)\n" value))))
    (define (compile!)
      (when compiled? (check-true (system* (find-executable-path "raco") "make" application))))
    (define (call build [state #f])
      (set! launches (add1 launches))
      (define-values (process out in err)
        (subprocess #f #f #f (find-executable-path "racket") application "--build-id" build "--state" database))
      (define client (make-stdio-client out in #:timeout 15))
      (dynamic-wind void
        (lambda ()
          (client-call client "tools/call"
            (if state (hasheq 'name "work" 'requestState state 'inputResponses (hasheq 'answer (hasheq 'action "decline"))) (hasheq 'name "work"))
            #:capabilities (hasheq 'elicitation (hasheq))))
        (lambda ()
          (client-close! client)
          (unless (sync/timeout 5 process) (subprocess-kill process #t))
          (subprocess-wait process)
          (check-equal? (subprocess-status process) 0 (port->string err))
          (close-input-port err)
          (check-equal? (length (file->lines initialized)) launches))))
    (define (pending build)
      (define result (hash-ref (call build) 'result))
      (check-equal? (hash-ref result 'resultType) "input_required")
      (hash-ref result 'requestState))
    (dynamic-wind void
      (lambda ()
        (write-helper "before")
        (call-with-output-file application
          (lambda (out)
            (display "#lang mcp\n(require \"helper.rkt\")\n(server #:name \"declared\" #:version \"1\")\n" out)
            (write `(call-with-output-file ,(path->string initialized) #:exists 'append (lambda (out) (displayln "once" out))) out)
            (newline out)
            (write `(workflow (work) #:version "1"
                      (await-input [answer Any] (hasheq 'mode "form" 'message "Continue?" 'requestedSchema (object-schema (hasheq))))
                      (text-result (begin (call-with-output-file ,(path->string completed) #:exists 'append
                                            (lambda (out) (displayln (helper) out))) (helper)))) out)
            (newline out)))
        (compile!)
        (define state (pending "app/1"))
        (check-equal? (hash-ref (hash-ref (call "app/1" state) 'result) 'resultType) "complete")
        (check-equal? (file->string completed) "before\n")
        (define old (pending "app/1"))
        (write-helper "changed-helper")
        (compile!)
        (check-equal? (hash-ref (hash-ref (call "app/2" old) 'error) 'code) -32603)
        (check-equal? (file->string completed) "before\n")
        (define fresh (pending "app/2"))
        (check-equal? (hash-ref (hash-ref (call "app/2" fresh) 'result) 'resultType) "complete")
        (check-equal? (file->string completed) "before\nchanged-helper\n"))
      (lambda () (delete-directory/files directory)))))
