#lang racket/base
(require rackunit racket/tcp racket/port openssl mcp/private/http-wire)
(define cert (vector-ref (current-command-line-arguments) 0))
(define key (vector-ref (current-command-line-arguments) 1))
(define owner (make-custodian))
(dynamic-wind void
  (lambda ()
    (parameterize ([current-custodian owner])
      (define context (ssl-make-server-context 'auto #:private-key (list 'pem key) #:certificate-chain cert))
      (define listener (tcp-listen 0 4 #t "127.0.0.1"))
      (define-values (_ port _r _rp) (tcp-addresses listener #t))
      (thread (lambda ()
        (let loop ()
          (define-values (raw-in raw-out) (tcp-accept listener))
          (with-handlers ([exn:fail? void])
            (define-values (in out) (ports->ssl-ports raw-in raw-out #:mode 'accept #:context context #:close-original? #t))
            (let headers () (unless (equal? (read-line in 'any) "") (headers)))
            (display "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n{}" out) (flush-output out)
            (close-output-port out) (close-input-port in))
          (close-input-port raw-in) (close-output-port raw-out) (loop))))
      (define (request host)
        (define-values (status headers in) (bounded-http-sendrecv host "/" #:ssl? #t #:port port))
        (begin0 (port->bytes in) (close-input-port in)))
      (parameterize ([ssl-default-verify-sources (list cert)])
        (check-equal? (request "localhost") #"{}")
        (check-exn exn:fail? (lambda () (request "127.0.0.1"))))
      (parameterize ([ssl-default-verify-sources '()])
        (check-exn exn:fail? (lambda () (request "localhost"))))))
  (lambda () (custodian-shutdown-all owner)))
